}

-- ============================================================
-- LINES IN FILES
-- A program is made of several files: the one being compiled, the
-- files it imports and the runtime. A line number says which file it
-- is in: line L of file number F is the number F * FILE_LINE_SPAN()
-- + L. The file being compiled is number 0, so its line numbers are
-- plain. The lexer numbers a file's lines this way (tokenize_file),
-- and the files' names are in a list, at their numbers
-- (SourceFile.files, then IRModule.files). A file may have up to
-- FILE_LINE_SPAN() - 1 lines.
-- ============================================================

fn FILE_LINE_SPAN() -> int { return 1000000 }

-- The name of the runtime in errors. Its line numbers are those of the
-- runtime/*.dm files joined, as gen_bootstrap.dm joins them.
fn PRELUDE_NAME() -> string { return "<runtime>" }

-- The name of the main that `test` writes to run a file's tests
fn TEST_MAIN_NAME() -> string { return "<test main>" }

-- Whether a name in the list of files is a file's. The compiler's own
-- sources are named in angle brackets.
fn is_file_name(name: string) -> bool {
    return starts_with(name, "<") == false
}

-- The line within its file
fn line_in_file(line: int) -> int {
    return line % FILE_LINE_SPAN()
}

-- The number of the file a line is in
fn file_of_line(line: int) -> int {
    return line / FILE_LINE_SPAN()
}

-- "NAME: " for a line of another file than the one being compiled,
-- which is how an error says where it is
fn file_prefix(files: List[string], line: int) -> string {
    let file = file_of_line(line)
    if file > 0 and file < files.len() {
        return files[file] + ": "
    }
    return ""
}

-- "line L" for a line an error at line `from` mentions, or "line L of
-- NAME" when the two are in different files
fn line_ref(files: List[string], line: int, from: int) -> string {
    let file = file_of_line(line)
    let text = "line " + int_to_string(line_in_file(line))
    if file != file_of_line(from) and file < files.len() {
        return text + " of " + files[file]
    }
    return text
}

-- The text of an error at a line: "Error: MESSAGE at line L", after
-- "NAME: " in another file than the one being compiled
fn error_at(files: List[string], msg: string, line: int) -> string {
    return file_prefix(files, line) + "Error: " + source_name(msg) + " at line " + int_to_string(line_in_file(line))
}

-- What the name of the type `dyn Trait` begins with: Dyn$Trait, a name
-- no source can write (see TRAITS in main_split.dm)
fn DYN_PREFIX() -> string { return "Dyn$" }

-- A type as source text, for source the compiler writes: `dyn Shape`
-- for Dyn$Shape
fn type_source_text(t: string) -> string {
    return string_replace(t, DYN_PREFIX(), "dyn ")
}

-- The text with each variable's name as it is in the source: without
-- the `$N` that a variable which shadows another has by the time IR
-- is generated (see SHADOWED NAMES in ast.dm)
fn source_name(text0: string) -> string {
    if string_contains(text0, "$") == false { return text0 }
    -- Dyn$Shape is the type the source writes `dyn Shape`
    let text = string_replace(text0, DYN_PREFIX(), "dyn ")
    let n = len(text)
    let mut out = ""
    let mut from = 0
    let mut i = 0
    while i < n {
        if byte_at(text, i) == 36 and i + 1 < n and byte_at(text, i + 1) >= 48 and byte_at(text, i + 1) <= 57 {
            out = out + substr(text, from, i - from)
            i = i + 1
            while i < n and byte_at(text, i) >= 48 and byte_at(text, i) <= 57 {
                i = i + 1
            }
            from = i
        } else {
            i = i + 1
        }
    }
    return out + substr(text, from, n - from)
}

fn keyword_lookup(name: string) -> int {
    if name == "fn" { return TK_FN() }
    if name == "let" { return TK_LET() }
    if name == "mut" { return TK_MUT() }
    if name == "if" { return TK_IF() }
    if name == "else" { return TK_ELSE() }
    if name == "match" { return TK_MATCH() }
    if name == "for" { return TK_FOR() }
    if name == "while" { return TK_WHILE() }
    if name == "loop" { return TK_LOOP() }
    if name == "break" { return TK_BREAK() }
    if name == "continue" { return TK_CONTINUE() }
    if name == "return" { return TK_RETURN() }
    if name == "struct" { return TK_STRUCT() }
    if name == "enum" { return TK_ENUM() }
    if name == "trait" { return TK_TRAIT() }
    if name == "impl" { return TK_IMPL() }
    if name == "import" { return TK_IMPORT() }
    if name == "module" { return TK_MODULE() }
    if name == "true" { return TK_TRUE() }
    if name == "false" { return TK_FALSE() }
    if name == "and" { return TK_AND() }
    if name == "or" { return TK_OR() }
    if name == "not" { return TK_NOT() }
    if name == "in" { return TK_IN() }
    if name == "const" { return TK_CONST() }
    if name == "with" { return TK_WITH() }
    if name == "self" { return TK_SELF() }
    if name == "region" { return TK_REGION() }
    if name == "as" { return TK_AS() }
    if name == "extern" { return TK_EXTERN() }
    if name == "comptime" { return TK_COMPTIME() }
    if name == "async" { return TK_ASYNC() }
    if name == "await" { return TK_AWAIT() }
    if name == "unsafe" { return TK_UNSAFE() }
    return TK_IDENT()
}

