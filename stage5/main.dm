fn OP_SIMD_DIV() -> int { return 105 }
fn OP_SIMD_EXTRACT() -> int { return 106 }
fn OP_PANIC() -> int { return 110 }
-- Debug info: the variable named `callee`, of type `alloc_type`, lives
-- in the storage `operand`. field_index is its number among the
-- function's parameters, from 1, or 0 for a local; field_type is "ref"
-- when the operand is the address of the value, passed by the caller.
-- It generates no code.
fn OP_DEBUG_VAR() -> int { return 120 }

-- IR Instruction
struct IRInst {
    id: int,
    op: int,
    result_type: string,
    has_result: bool,
    -- Binary operands
    lhs: IRValue,
    rhs: IRValue,
    -- Unary operand
    operand: IRValue,
    -- Alloca
    alloc_type: string,
    -- Load
    load_ptr: IRValue,
    load_type: string,
    -- Store
    store_ptr: IRValue,
    store_val: IRValue,
    -- GEP
    gep_base: IRValue,
    gep_indices: List[IRValue],
    -- Extract/Insert field
    field_base: IRValue,
    field_index: int,
    field_value: IRValue,
    field_type: string,
    -- Call
    callee: string,
    call_args: List[IRValue],
    -- Call ptr
    callee_val: IRValue,
    -- Cast
    cast_val: IRValue,
    cast_from: string,
    cast_to: string,
    -- Integer type of a binary operator's operands, for unsigned
    -- comparison and division; "" when not an integer operation
    operand_type: string,
    -- Phi
    phi_entries: List[PhiEntry],
    -- List new
    elem_type: string,
    -- SIMD
    simd_scalar: IRValue,
    simd_vec_type: string,
    simd_elements: List[IRValue],
    simd_vector: IRValue,
    simd_index: IRValue,
    -- Source location
    source_line: int,
    source_col: int
}

fn ir_inst_new(id: int, op: int) -> IRInst {
    let undef = ir_val_undef()
    return IRInst {
        id: id, op: op,
        result_type: "", has_result: false,
        lhs: undef, rhs: undef,
        operand: undef,
        alloc_type: "",
        load_ptr: undef, load_type: "",
        store_ptr: undef, store_val: undef,
        gep_base: undef, gep_indices: [],
        field_base: undef, field_index: 0, field_value: undef, field_type: "",
        callee: "", call_args: [],
        callee_val: undef,
        cast_val: undef, cast_from: "", cast_to: "",
        operand_type: "",
        phi_entries: [],
        elem_type: "",
        simd_scalar: undef, simd_vec_type: "", simd_elements: [],
        simd_vector: undef, simd_index: undef,
        source_line: 0, source_col: 0
    }
}

