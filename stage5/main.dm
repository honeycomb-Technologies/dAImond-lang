fn generate_identifier(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block
    let name = expr.name

    -- Check for "true" / "false" literals
    if name == "true" {
        return generate_literal_bool(g, b, expr_bool(true, 0, 0))
    }
    if name == "false" {
        return generate_literal_bool(g, b, expr_bool(false, 0, 0))
    }

    -- Check for "None" (Option None)
    if name == "None" {
        -- Build Option { has_value: 0, value: undef } as an aggregate value.
        -- Its type is that of the place it goes to, which the checker
        -- found; without it, the function's return type
        let mut opt_type = checked_ir_type(g, expr)
        if starts_with(opt_type, "Option[") == false {
            opt_type = g.current_return_type
        }
        if starts_with(opt_type, "Option[") == false {
            opt_type = "Option[i64]"
        }
        let insert_id = g.builder.next_id
        let mut insert_tag = ir_inst_new(insert_id, OP_INSERT_FIELD())
        insert_tag.field_base = ir_val_undef()
        insert_tag.field_value = ir_val_int(0)
        insert_tag.field_index = 0
        insert_tag.result_type = opt_type
        insert_tag.has_result = true
        b.instructions.push(insert_tag)
        g.builder.next_id = g.builder.next_id + 1
        return expr_result(g, b, insert_id)
    }

    -- Look up variable in scope
    if g.variable_map.contains(name) {
        let alloca_id = g.variable_map.get(name)
        let var_type = if g.variable_types.contains(name) {
            g.variable_types.get(name)
        } else {
            "i64"
        }

        -- For mut pointer vars (mut self): load struct through the param pointer.
        -- The param IS a pointer to the struct (no alloca was created).
        if g.param_ptr_map.contains(name) {
            let param_idx = g.param_ptr_map.get(name)
            let load_id = g.builder.next_id
            let mut load_struct = ir_inst_new(load_id, OP_LOAD())
            load_struct.load_ptr = ir_val_param(param_idx)
            load_struct.load_type = var_type
            load_struct.result_type = var_type
            load_struct.has_result = true
            b.instructions.push(load_struct)
            g.builder.next_id = g.builder.next_id + 1
            return expr_result(g, b, load_id)
        }

        let load_id = g.builder.next_id
        let mut load = ir_inst_new(load_id, OP_LOAD())
        load.load_ptr = ir_val_inst(alloca_id)
        load.load_type = var_type
        load.result_type = var_type
        load.has_result = true
        b.instructions.push(load)
        g.builder.next_id = g.builder.next_id + 1
        return expr_result(g, b, load_id)
    }

    -- Check for global constants (const SIZE = 4096, etc.)
    let mut gi = 0
    while gi < g.ir_mod.globals.len() {
        let glob = g.ir_mod.globals[gi]
        if glob.name == name and glob.has_init {
            let init = glob.init_value
            if init.kind == VAL_CONST_INT() {
                let id = g.builder.next_id
                let mut ai = ir_inst_new(id, OP_ALLOCA())
                ai.alloc_type = "i64"
                ai.result_type = "ptr(i64)"
                ai.has_result = true
                b.instructions.push(ai)
                let sid = id + 1
                let mut si = ir_inst_new(sid, OP_STORE())
                si.store_ptr = ir_val_inst(id)
                si.store_val = ir_val_int(init.int_val)
                si.has_result = false
                b.instructions.push(si)
                g.builder.next_id = sid + 1
                let lid = g.builder.next_id
                let mut li = ir_inst_new(lid, OP_LOAD())
                li.load_ptr = ir_val_inst(id)
                li.load_type = "i64"
                li.result_type = "i64"
                li.has_result = true
                b.instructions.push(li)
                g.builder.next_id = lid + 1
                return expr_result(g, b, lid)
            }
            if init.kind == VAL_CONST_FLOAT() {
                let id = g.builder.next_id
                let mut ai = ir_inst_new(id, OP_ALLOCA())
                ai.alloc_type = "f64"
                ai.result_type = "ptr(f64)"
                ai.has_result = true
                b.instructions.push(ai)
                let sid = id + 1
                let mut si = ir_inst_new(sid, OP_STORE())
                si.store_ptr = ir_val_inst(id)
                si.store_val = ir_val_float(init.float_val)
                si.has_result = false
                b.instructions.push(si)
                g.builder.next_id = sid + 1
                let lid = g.builder.next_id
                let mut li = ir_inst_new(lid, OP_LOAD())
                li.load_ptr = ir_val_inst(id)
                li.load_type = "f64"
                li.result_type = "f64"
                li.has_result = true
                b.instructions.push(li)
                g.builder.next_id = lid + 1
                return expr_result(g, b, lid)
            }
            if init.kind == VAL_CONST_BOOL() {
                let id = g.builder.next_id
                let mut ai = ir_inst_new(id, OP_ALLOCA())
                ai.alloc_type = "bool"
                ai.result_type = "ptr(bool)"
                ai.has_result = true
                b.instructions.push(ai)
                let sid = id + 1
                let mut si = ir_inst_new(sid, OP_STORE())
                si.store_ptr = ir_val_inst(id)
                si.store_val = ir_val_bool(init.bool_val)
                si.has_result = false
                b.instructions.push(si)
                g.builder.next_id = sid + 1
                let lid = g.builder.next_id
                let mut li = ir_inst_new(lid, OP_LOAD())
                li.load_ptr = ir_val_inst(id)
                li.load_type = "bool"
                li.result_type = "bool"
                li.has_result = true
                b.instructions.push(li)
                g.builder.next_id = lid + 1
                return expr_result(g, b, lid)
            }
            if init.kind == VAL_CONST_STRING() {
                let id = g.builder.next_id
                let mut ai = ir_inst_new(id, OP_ALLOCA())
                ai.alloc_type = "string"
                ai.result_type = "ptr(string)"
                ai.has_result = true
                b.instructions.push(ai)
                let sid = id + 1
                let mut si = ir_inst_new(sid, OP_STORE())
                si.store_ptr = ir_val_inst(id)
                si.store_val = ir_val_string(init.str_val)
                si.has_result = false
                b.instructions.push(si)
                g.builder.next_id = sid + 1
                let lid = g.builder.next_id
                let mut li = ir_inst_new(lid, OP_LOAD())
                li.load_ptr = ir_val_inst(id)
                li.load_type = "string"
                li.result_type = "string"
                li.has_result = true
                b.instructions.push(li)
                g.builder.next_id = lid + 1
                return expr_result(g, b, lid)
            }
        }
        gi = gi + 1
    }

    -- Check if the identifier is a known function name (function pointer reference).
    -- A function declared further down is not in the module yet, but
    -- its signature is registered.
    let mut is_function = g.fn_src_param_types.contains(name) and g.generic_fn_decls.contains(name) == false
    let mut fi = 0
    while fi < g.ir_mod.functions.len() and is_function == false {
        if g.ir_mod.functions[fi].name == name {
            is_function = true
        }
        fi = fi + 1
    }
    if is_function {
        -- The function as a value: the closure of the function that
        -- stands for it (see FUNCTION VALUES)
        if g.mut_param_fns.contains(name) {
            g = ir_type_error(g, "the function '" + name + "' has a 'mut' parameter, so it cannot be used as a value: call it in a lambda", expr.line)
            return expr_result(g, b, 0)
        }
        g = value_function(g, name)
        return emit_static_closure(g, b, value_function_name(name))
    }

    -- Unknown identifier: report it, then emit a placeholder to continue
    g = ir_type_error(g, "undefined variable '" + expr.name + "'", expr.line)
    let id = g.builder.next_id
    let mut inst = ir_inst_new(id, OP_ALLOCA())
    inst.alloc_type = "i64"
    inst.result_type = "ptr(i64)"
    inst.has_result = true
    b.instructions.push(inst)
    g.builder.next_id = id + 1
    return expr_result(g, b, id)
}

-- ============================================================
-- STATIC SOURCE TYPES
-- The dAImond source type of an expression, as written in the
-- program (e.g. "Parser", "List[Stmt]", "Map_string_i64",
-- "Box[Expr]"), or "" when it cannot be determined. Used to
-- dispatch field access and method calls on any receiver, not
-- just on variables.
-- ============================================================

fn strip_box_type(t: string) -> string {
    if starts_with(t, "Box[") { return extract_inner_type(t, "Box[") }
    return t
}

fn struct_field_src_type(gen: IRGenerator, struct_name: string, field: string) -> string {
    if gen.struct_defs.contains(struct_name) == false { return "" }
    let info = gen.struct_defs.get(struct_name)
    let mut i = 0
    while i < info.field_names.len() {
        if info.field_names[i] == field and i < info.field_src_types.len() {
            return info.field_src_types[i]
        }
        i = i + 1
    }
    return ""
}

-- Source type for a builtin's IR return type name
fn builtin_src_type(ir_type: string) -> string {
    -- string_split is the only builtin that returns a list
    if ir_type == "list" { return "List[string]" }
    if ir_type == "i64" { return "int" }
    if ir_type == "f64" { return "float" }
    if ir_type == "void" { return "" }
    return ir_type
}

-- ============================================================
-- MAPS
-- Map[K, V] is the generic struct in runtime/map.dm; a map type
-- is one of its instances, such as Map_string_i64.
-- ============================================================

fn is_map_type(gen: IRGenerator, t: string) -> bool {
    if gen.generic_instances.contains(t) == false { return false }
    return gen.generic_instances.get(t) == "Map"
}

-- Source type argument `which` (0 = K, 1 = V) of a map instance
fn map_instance_arg(gen: IRGenerator, t: string, which: int) -> string {
    let args = string_split(gen.generic_instance_args.get(t), "|")
    if which < args.len() { return args[which] }
    return ""
}

-- Which of the basic kinds a source type is: "string", "bool" or
-- "number" (an integer or a float type). "" for every other type.
fn basic_type_kind(t: string) -> string {
    if t == "string" or t == "bool" { return t }
    if t == "int" or t == "float" or t == "f32" or t == "f64" { return "number" }
    if t == "i8" or t == "i16" or t == "i32" or t == "i64" { return "number" }
    if t == "u8" or t == "u16" or t == "u32" or t == "u64" { return "number" }
    return ""
}

-- Report a string, a bool or a number given where another of the
-- three is expected. `what` names the place, such as "argument 1 of
-- 'f'". Values of other types, and values whose type is not known
-- here, are left to the checks of code generation.
fn check_basic_type(gen: IRGenerator, expected: string, value: Expr, what: string) -> IRGenerator {
    let want = basic_type_kind(expected)
    if want == "" { return gen }
    let found = static_type(gen, value)
    let got = basic_type_kind(found)
    if got == "" or got == want { return gen }
    return ir_type_error(gen, "type mismatch in " + what + ": expected " + expected + ", found " + found, value.line)
}

-- Record the source type of a variable that a pattern binds, as a
-- parameter's is recorded, so that its fields, elements and methods
-- resolve. What an earlier variable of the name left is replaced.
fn track_bound_variable(gen: IRGenerator, name: string, src_type: string) -> IRGenerator {
    let mut g = gen
    let t = canon_type(g, src_type)
    g.variable_types.insert(name, map_type_name(t))
    g.var_src_types.insert(name, t)
    if g.struct_defs.contains(t) {
        g.var_struct_types.insert(name, t)
    } else if g.var_struct_types.contains(name) {
        g.var_struct_types.remove(name)
    }
    if g.enum_defs.contains(t) {
        g.var_enum_types.insert(name, t)
    } else if g.var_enum_types.contains(name) {
        g.var_enum_types.remove(name)
    }
    if starts_with(t, "List[") {
        let inner = extract_inner_type(t, "List[")
        let elem_kind = classify_list_elem(inner)
        g.list_elem_kinds.insert(name, elem_kind)
        if elem_kind == LIST_ELEM_OTHER() {
            g.list_elem_types.insert(name, inner)
        }
    } else if g.list_elem_kinds.contains(name) {
        g.list_elem_kinds.remove(name)
    }
    if starts_with(t, "Box[") {
        g.box_inner_types.insert(name, extract_inner_type(t, "Box["))
    } else if g.box_inner_types.contains(name) {
        g.box_inner_types.remove(name)
    }
    return g
}

-- The function that a call written Type.name(args) calls, or "" when
-- the call is a method call on a value. Box.new and Box.null are the
-- builtins Box_new and Box_null; a function of an impl block that
-- takes no self is called on its struct or enum. A variable in scope
-- with the type's name is a value, so a call on it is a method call.
fn static_call_target(gen: IRGenerator, expr: Expr) -> string {
    let obj = *expr.object
    if obj.kind != EXPR_IDENTIFIER() { return "" }
    if gen.variable_map.contains(obj.name) { return "" }
    if obj.name == "Box" and (expr.method == "new" or expr.method == "null") {
        return "Box_" + expr.method
    }
    let target = obj.name + "_" + expr.method
    if gen.static_fns.contains(target) { return target }
    return ""
}

-- The call Type.name(args) as the call of the function `target`
fn static_call_expr(expr: Expr, target: string) -> Expr {
    return expr_call(expr_ident(target, expr.line, expr.col), expr.args, expr.line, expr.col)
}

-- Map_new() or Map.new()
fn is_map_ctor(e: Expr) -> bool {
    if e.kind == EXPR_FUNCTION_CALL() and e.args.len() == 0 {
        let c = *e.callee
        return c.kind == EXPR_IDENTIFIER() and c.name == "Map_new"
    }
    if e.kind == EXPR_METHOD_CALL() and e.method == "new" and e.args.len() == 0 {
        let o = *e.object
        return o.kind == EXPR_IDENTIFIER() and o.name == "Map"
    }
    return false
}

-- Map_new() becomes an empty map of the type its destination
-- needs, written as a struct literal; anything else is unchanged
fn map_ctor_as(gen: IRGenerator, e: Expr, dest: string) -> Expr {
    if is_map_ctor(e) == false or is_map_type(gen, dest) == false { return e }
    let info = gen.struct_defs.get(dest)
    let mut lit = expr_new(EXPR_STRUCT_LITERAL(), e.line, e.col)
    lit.type_name = dest
    let mut names: List[string] = []
    let mut vals: List[Expr] = []
    let mut i = 0
    while i < info.field_names.len() {
        names.push(info.field_names[i])
        if starts_with(info.field_src_types[i], "List[") {
            vals.push(expr_new(EXPR_ARRAY_LITERAL(), e.line, e.col))
        } else {
            vals.push(expr_int(0, e.line, e.col))
        }
        i = i + 1
    }
    lit.field_names = names
    lit.field_values = vals
    return lit
}

-- byte_at(s, i): the byte at index i of s as an int, 0 to 255
fn generate_byte_at(gen: IRGenerator, block: IRBasicBlock, s_expr: Expr, i_expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block
    let s_res = generate_expr(g, b, s_expr)
    g = s_res.gen
    b = s_res.block
    let i_res = generate_expr(g, b, i_expr)
    g = i_res.gen
    b = i_res.block
    -- A string is { data, len, capacity }, like a list of u8
    let slot = g.builder.next_id
    let mut slot_inst = ir_inst_new(slot, OP_ALLOCA())
    slot_inst.alloc_type = "string"
    slot_inst.result_type = "ptr(string)"
    slot_inst.has_result = true
    b.instructions.push(slot_inst)
    g.builder.next_id = slot + 1
    let mut st = ir_inst_new(g.builder.next_id, OP_STORE())
    st.store_ptr = ir_val_inst(slot)
    st.store_val = ir_val_inst(s_res.val_id)
    b.instructions.push(st)
    g.builder.next_id = g.builder.next_id + 1
    let len_id = g.builder.next_id
    let mut len_inst = ir_inst_new(len_id, OP_CALL())
    len_inst.callee = "dm_string_len"
    let mut len_args: List[IRValue] = []
    len_args.push(ir_val_inst(s_res.val_id))
    len_inst.call_args = len_args
    len_inst.result_type = "i64"
    len_inst.has_result = true
    b.instructions.push(len_inst)
    g.builder.next_id = len_id + 1
    let chk = check_index_bounds(g, b, i_res.val_id, ir_val_inst(len_id), "(string)")
    g = chk.gen
    b = chk.block
    let addr = g.builder.next_id
    let mut gep = ir_inst_new(addr, OP_GEP())
    gep.gep_base = ir_val_inst(slot)
    let mut idx: List[IRValue] = []
    idx.push(ir_val_inst(i_res.val_id))
    gep.gep_indices = idx
    gep.alloc_type = "u8"
    gep.field_type = "u8"
    gep.result_type = "ptr(u8)"
    gep.has_result = true
    b.instructions.push(gep)
    g.builder.next_id = addr + 1
    let ld = g.builder.next_id
    let mut ld_inst = ir_inst_new(ld, OP_LOAD())
    ld_inst.load_ptr = ir_val_inst(addr)
    ld_inst.load_type = "u8"
    ld_inst.result_type = "u8"
    ld_inst.has_result = true
    b.instructions.push(ld_inst)
    g.builder.next_id = ld + 1
    let cast = g.builder.next_id
    let mut cast_inst = ir_inst_new(cast, OP_CAST())
    cast_inst.cast_val = ir_val_inst(ld)
    cast_inst.cast_from = "u8"
    cast_inst.cast_to = "i64"
    cast_inst.result_type = "i64"
    cast_inst.has_result = true
    b.instructions.push(cast_inst)
    g.builder.next_id = cast + 1
    return expr_result(g, b, cast)
}

-- Emit a cast of `val` from type `from` to type `to`
fn emit_ir_cast(gen: IRGenerator, block: IRBasicBlock, val: IRValue, from: string, to: string) -> ExprResult {
    let mut g = gen
    let mut b = block
    let id = g.builder.next_id
    let mut inst = ir_inst_new(id, OP_CAST())
    inst.cast_val = val
    inst.cast_from = from
    inst.cast_to = to
    inst.result_type = to
    inst.has_result = true
    b.instructions.push(inst)
    g.builder.next_id = id + 1
    return expr_result(g, b, id)
}

-- Emit a store of `val` through `ptr`
fn emit_ir_store(gen: IRGenerator, block: IRBasicBlock, ptr: IRValue, val: IRValue) -> GenResult {
    let mut g = gen
    let mut b = block
    let mut st = ir_inst_new(g.builder.next_id, OP_STORE())
    st.store_ptr = ptr
    st.store_val = val
    st.has_result = false
    b.instructions.push(st)
    g.builder.next_id = g.builder.next_id + 1
    return gen_result(g, b)
}

-- Emit the address of field `index` (of IR type `field_t`) of the
-- struct of IR type `struct_t` at `base`
fn emit_ir_field_addr(gen: IRGenerator, block: IRBasicBlock, base: IRValue, struct_t: string, index: int, field_t: string) -> ExprResult {
    let mut g = gen
    let mut b = block
    let id = g.builder.next_id
    let mut gep = ir_inst_new(id, OP_GEP())
    gep.gep_base = base
    gep.alloc_type = struct_t
    gep.field_index = index
    gep.field_type = field_t
    gep.result_type = "ptr(" + field_t + ")"
    gep.has_result = true
    b.instructions.push(gep)
    g.builder.next_id = id + 1
    return expr_result(g, b, id)
}

-- Generate an integer argument of a raw memory primitive
fn generate_raw_int_arg(gen: IRGenerator, block: IRBasicBlock, fn_name: string, what: string, arg: Expr) -> ExprResult {
    let mut g = gen
    let arg_t = infer_expr_type(g, arg)
    if is_integer_type(arg_t) == false {
        g = ir_type_error(g, fn_name + "() takes an integer " + what + ", not '" + builtin_src_type(arg_t) + "'", arg.line)
    }
    let r = generate_expr(g, block, arg)
    if arg_t == "i64" or is_integer_type(arg_t) == false {
        return r
    }
    return emit_ir_cast(r.gen, r.block, ir_val_inst(r.val_id), arg_t, "i64")
}

-- An address argument as a pointer
fn generate_raw_ptr_arg(gen: IRGenerator, block: IRBasicBlock, fn_name: string, arg: Expr) -> ExprResult {
    let r = generate_raw_int_arg(gen, block, fn_name, "address", arg)
    return emit_ir_cast(r.gen, r.block, ir_val_inst(r.val_id), "i64", "ptr")
}

-- Whether a source type names a type whose size is known
fn sized_type_known(gen: IRGenerator, t: string) -> bool {
    let ir_t = map_type_name(t)
    if is_integer_type(ir_t) or is_float_type(ir_t) or t == "string" or t == "bool" { return true }
    if starts_with(t, "List[") or starts_with(t, "Box[") { return true }
    return gen.struct_defs.contains(t) or gen.enum_defs.contains(t)
}

fn generate_raw_builtin(gen: IRGenerator, block: IRBasicBlock, fn_name: string, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block
    let args = expr.args
    if g.unsafe_depth == 0 {
        g = ir_type_error(g, fn_name + "() works on raw memory and requires an unsafe block", expr.line)
        return expr_result(g, b, 0)
    }
    let want = if fn_name == "string_from_raw" { 3 } else if starts_with(fn_name, "store_") or fn_name == "static_addr" { 2 } else if fn_name == "size_of" { 0 } else { 1 }
    if args.len() != want {
        g = ir_type_error(g, fn_name + "() takes " + arguments_text(want) + ", not " + int_to_string(args.len()), expr.line)
        return expr_result(g, b, 0)
    }
    let mem_t = raw_mem_type(fn_name)

    -- size_of[T]()
    if fn_name == "size_of" {
        if expr.generic_args.len() != 1 {
            g = ir_type_error(g, "size_of takes one type: size_of[T]()", expr.line)
            return expr_result(g, b, 0)
        }
        let mut t = expr.generic_args[0]
        g = ensure_type_instances(g, t, expr.line)
        t = canon_type(g, t)
        if sized_type_known(g, t) == false {
            g = ir_type_error(g, "size_of: unknown type '" + t + "'", expr.line)
            return expr_result(g, b, 0)
        }
        return emit_ir_cast(g, b, ir_val_sizeof(map_type_name(t)), "i64", "i64")
    }

    -- symbol_addr("name"): lowered where the call is, see generate_call
    if fn_name == "symbol_addr" {
        if args[0].kind != EXPR_LITERAL_STRING() or args[0].str_val == "" {
            g = ir_type_error(g, "symbol_addr() takes the name of a symbol as a string literal", expr.line)
            return expr_result(g, b, 0)
        }
        let sym = g.builder.next_id
        let mut sym_inst = ir_inst_new(sym, OP_CALL())
        sym_inst.callee = "dm_symbol_addr"
        let mut sym_args: List[IRValue] = []
        sym_args.push(ir_val_string(args[0].str_val))
        sym_inst.call_args = sym_args
        sym_inst.result_type = "i64"
        sym_inst.has_result = true
        b.instructions.push(sym_inst)
        g.builder.next_id = sym + 1
        return expr_result(g, b, sym)
    }

    -- static_addr("name", size): lowered where the call is, see generate_call
    if fn_name == "static_addr" {
        if args[0].kind != EXPR_LITERAL_STRING() or args[0].str_val == "" {
            g = ir_type_error(g, "static_addr() takes the name of the storage as a string literal", expr.line)
            return expr_result(g, b, 0)
        }
        if args[1].kind != EXPR_LITERAL_INT() or args[1].int_val <= 0 {
            g = ir_type_error(g, "static_addr() takes the size in bytes as an integer literal above 0", expr.line)
            return expr_result(g, b, 0)
        }
        let st = g.builder.next_id
        let mut st_inst = ir_inst_new(st, OP_CALL())
        st_inst.callee = "dm_static_addr"
        let mut st_args: List[IRValue] = []
        st_args.push(ir_val_string(args[0].str_val))
        st_args.push(ir_val_int(args[1].int_val))
        st_inst.call_args = st_args
        st_inst.result_type = "i64"
        st_inst.has_result = true
        b.instructions.push(st_inst)
        g.builder.next_id = st + 1
        return expr_result(g, b, st)
    }

    -- load_T(addr)
    if starts_with(fn_name, "load_") {
        let p = generate_raw_ptr_arg(g, b, fn_name, args[0])
        g = p.gen
        b = p.block
        let ld = g.builder.next_id
        let mut ld_inst = ir_inst_new(ld, OP_LOAD())
        ld_inst.load_ptr = ir_val_inst(p.val_id)
        ld_inst.load_type = mem_t
        ld_inst.result_type = mem_t
        ld_inst.has_result = true
        b.instructions.push(ld_inst)
        g.builder.next_id = ld + 1
        let wide_t = if is_float_type(mem_t) { "f64" } else { "i64" }
        return emit_ir_cast(g, b, ir_val_inst(ld), mem_t, wide_t)
    }

    -- store_T(addr, v)
    if starts_with(fn_name, "store_") {
        let p = generate_raw_ptr_arg(g, b, fn_name, args[0])
        g = p.gen
        b = p.block
        let val_t = infer_expr_type(g, args[1])
        let fits = if is_float_type(mem_t) { is_float_type(val_t) or is_integer_type(val_t) } else { is_integer_type(val_t) }
        if fits == false {
            g = ir_type_error(g, fn_name + "() cannot store a value of type '" + builtin_src_type(val_t) + "'", expr.line)
            return expr_result(g, b, 0)
        }
        let v = generate_expr(g, b, args[1])
        let narrow = emit_ir_cast(v.gen, v.block, ir_val_inst(v.val_id), val_t, mem_t)
        let st = emit_ir_store(narrow.gen, narrow.block, ir_val_inst(p.val_id), ir_val_inst(narrow.val_id))
        return expr_result(st.gen, st.block, 0)
    }

    -- addr_of(place)
    if fn_name == "addr_of" {
        let a = generate_addr(g, b, args[0])
        g = a.gen
        b = a.block
        if a.ok == false {
            g = ir_type_error(g, "addr_of() takes a variable, a field or a list element", expr.line)
            return expr_result(g, b, 0)
        }
        return emit_ir_cast(g, b, a.ptr, "ptr", "i64")
    }

    -- string_data(s)
    if fn_name == "string_data" {
        let s_t = infer_expr_type(g, args[0])
        if s_t != "string" {
            g = ir_type_error(g, "string_data() takes a string, not '" + builtin_src_type(s_t) + "'", expr.line)
            return expr_result(g, b, 0)
        }
        let s = generate_expr(g, b, args[0])
        g = s.gen
        b = s.block
        let slot = g.builder.next_id
        let mut slot_inst = ir_inst_new(slot, OP_ALLOCA())
        slot_inst.alloc_type = "string"
        slot_inst.result_type = "ptr(string)"
        slot_inst.has_result = true
        b.instructions.push(slot_inst)
        g.builder.next_id = slot + 1
        let st = emit_ir_store(g, b, ir_val_inst(slot), ir_val_inst(s.val_id))
        let data_addr = emit_ir_field_addr(st.gen, st.block, ir_val_inst(slot), "string", 0, "ptr")
        g = data_addr.gen
        b = data_addr.block
        let ld = g.builder.next_id
        let mut ld_inst = ir_inst_new(ld, OP_LOAD())
        ld_inst.load_ptr = ir_val_inst(data_addr.val_id)
        ld_inst.load_type = "ptr"
        ld_inst.result_type = "ptr"
        ld_inst.has_result = true
        b.instructions.push(ld_inst)
        g.builder.next_id = ld + 1
        return emit_ir_cast(g, b, ir_val_inst(ld), "ptr", "i64")
    }

    -- string_from_raw(ptr, len, cap)
    let p = generate_raw_ptr_arg(g, b, fn_name, args[0])
    let n = generate_raw_int_arg(p.gen, p.block, fn_name, "length", args[1])
    let c = generate_raw_int_arg(n.gen, n.block, fn_name, "capacity", args[2])
    g = c.gen
    b = c.block
    let slot = g.builder.next_id
    let mut slot_inst = ir_inst_new(slot, OP_ALLOCA())
    slot_inst.alloc_type = "string"
    slot_inst.result_type = "ptr(string)"
    slot_inst.has_result = true
    b.instructions.push(slot_inst)
    g.builder.next_id = slot + 1
    let mut fi = 0
    while fi < 3 {
        let field_t = if fi == 0 { "ptr" } else { "i64" }
        let field_val = if fi == 0 { p.val_id } else if fi == 1 { n.val_id } else { c.val_id }
        let fa = emit_ir_field_addr(g, b, ir_val_inst(slot), "string", fi, field_t)
        let st = emit_ir_store(fa.gen, fa.block, ir_val_inst(fa.val_id), ir_val_inst(field_val))
        g = st.gen
        b = st.block
        fi = fi + 1
    }
    let ld = g.builder.next_id
    let mut ld_inst = ir_inst_new(ld, OP_LOAD())
    ld_inst.load_ptr = ir_val_inst(slot)
    ld_inst.load_type = "string"
    ld_inst.result_type = "string"
    ld_inst.has_result = true
    b.instructions.push(ld_inst)
    g.builder.next_id = ld + 1
    return expr_result(g, b, ld)
}

fn static_type(gen: IRGenerator, expr: Expr) -> string {
    let found = static_type_from_parts(gen, expr)
    if found != "" { return found }
    -- What cannot be told from the expression's parts, the checker
    -- found from the whole program (see CHECKED TYPES in ir_gen.dm)
    return checked_type(gen, expr)
}

fn static_type_from_parts(gen: IRGenerator, expr: Expr) -> string {
    let k = expr.kind
    if k == EXPR_LITERAL_INT() { return "int" }
    if k == EXPR_LITERAL_FLOAT() { return "float" }
    if k == EXPR_LITERAL_STRING() or k == EXPR_STRING_INTERP() { return "string" }
    if k == EXPR_LITERAL_BOOL() { return "bool" }
    if k == EXPR_STRUCT_LITERAL() { return canon_type(gen, expr.type_name) }
    if k == EXPR_LAMBDA() { return lambda_value_type(gen, expr) }
    if k == EXPR_ENUM_LITERAL() {
        if is_generic_enum(gen, expr.enum_name) {
            return canon_type(gen, generic_enum_type(gen, expr, expr.enum_name, expr.variant_name, expr.payload))
        }
        return expr.enum_name
    }
    if k == EXPR_ARRAY_LITERAL() {
        -- A list of its first element's type
        if expr.elements.len() == 0 { return "" }
        let elem_t = static_type(gen, expr.elements[0])
        if elem_t == "" { return "" }
        return "List[" + elem_t + "]"
    }
    if k == EXPR_GROUPED() { return static_type(gen, *expr.operand) }
    if k == EXPR_ERROR_PROPAGATE() { return propagated_type(static_type(gen, *expr.operand)) }
    if k == EXPR_BINARY() {
        -- Two strings joined are a string; other operators may be
        -- overloaded, so their type is not known here
        if expr.op == BINOP_ADD() and static_type(gen, *expr.left) == "string" and static_type(gen, *expr.right) == "string" {
            return "string"
        }
        return ""
    }
    if k == EXPR_IDENTIFIER() {
        if gen.var_src_types.contains(expr.name) { return gen.var_src_types.get(expr.name) }
        if gen.var_struct_types.contains(expr.name) { return gen.var_struct_types.get(expr.name) }
        return ""
    }
    if k == EXPR_FIELD_ACCESS() {
        let obj_t = strip_box_type(static_type(gen, *expr.object))
        return struct_field_src_type(gen, obj_t, expr.field)
    }
    if k == EXPR_INDEX_ACCESS() {
        -- What is in a box is indexed as itself (unboxed_container)
        let mut obj_t = static_type(gen, *expr.object)
        if starts_with(obj_t, "Box[") { obj_t = extract_inner_type(obj_t, "Box[") }
        if is_map_type(gen, obj_t) { return map_instance_arg(gen, obj_t, 1) }
        if starts_with(obj_t, "List[") { return extract_inner_type(obj_t, "List[") }
        if obj_t == "string" { return "string" }
        return ""
    }
    if k == EXPR_UNARY() {
        if expr.op == UNOP_DEREF() {
            let inner_t = static_type(gen, *expr.operand)
            if starts_with(inner_t, "Box[") { return extract_inner_type(inner_t, "Box[") }
            return ""
        }
        if expr.op == UNOP_NOT() { return "bool" }
        return static_type(gen, *expr.operand)
    }
    if k == EXPR_FUNCTION_CALL() {
        let callee = *expr.callee
        if callee.kind != EXPR_IDENTIFIER() { return "" }
        let fname = callee.name
        if fname == "Box_new" and expr.args.len() == 1 {
            let inner_t = static_type(gen, expr.args[0])
            if inner_t == "" { return "" }
            return "Box[" + inner_t + "]"
        }
        if gen.generic_fn_decls.contains(fname) { return "" }
        if gen.fn_src_return_types.contains(fname) { return gen.fn_src_return_types.get(fname) }
        if is_builtin_fn(fname) { return builtin_src_type(builtin_return_type(fname)) }
        return ""
    }
    if k == EXPR_METHOD_CALL() {
        if starts_with(checked_target(gen, expr), "call:") {
            return static_type(gen, method_as_call(gen, expr))
        }
        let static_target = static_call_target(gen, expr)
        if static_target != "" {
            return static_type(gen, static_call_expr(expr, static_target))
        }
        -- Enum.Variant(values) is a value of the enum
        let call_object = *expr.object
        if call_object.kind == EXPR_IDENTIFIER() and gen.enum_defs.contains(call_object.name) and gen.variable_map.contains(call_object.name) == false {
            if enum_variant_index(gen.enum_defs.get(call_object.name), expr.method) >= 0 {
                return call_object.name
            }
        }
        if call_object.kind == EXPR_IDENTIFIER() and gen.variable_map.contains(call_object.name) == false and is_generic_enum(gen, call_object.name) {
            if generic_enum_has_variant(gen, call_object.name, expr.method) {
                return canon_type(gen, generic_enum_type(gen, expr, call_object.name, expr.method, expr.args))
            }
        }
        let recv_t = strip_box_type(static_type(gen, *expr.object))
        let m = expr.method
        if gen.generic_instances.contains(recv_t) {
            let base_key = gen.generic_instances.get(recv_t) + "_" + m
            if gen.fn_src_return_types.contains(base_key) {
                return instance_type(gen, recv_t, gen.fn_src_return_types.get(base_key))
            }
            return ""
        }
        if gen.struct_defs.contains(recv_t) {
            let key = recv_t + "_" + m
            if gen.fn_src_return_types.contains(key) { return gen.fn_src_return_types.get(key) }
            return ""
        }
        if recv_t == "string" and m == "len" { return "int" }
        if starts_with(recv_t, "List[") {
            if m == "len" { return "int" }
            if m == "pop" or m == "get" { return extract_inner_type(recv_t, "List[") }
            if m == "contains" { return "bool" }
            return ""
        }
        if recv_t == "string" and m == "len" { return "int" }
        return ""
    }
    return ""
}

-- ============================================================
-- ADDRESSES
-- Storage an expression names, so that assignments and list
-- operations change the value in place rather than a copy.
-- ============================================================

struct AddrResult {
    gen: IRGenerator,
    block: IRBasicBlock,
    -- Pointer to the storage
    ptr: IRValue,
    -- Source type of the value stored there
    src_type: string,
    -- false when the expression names no storage
    ok: bool
}

fn addr_result(g: IRGenerator, b: IRBasicBlock, ptr: IRValue, src_type: string) -> AddrResult {
    return AddrResult { gen: g, block: b, ptr: ptr, src_type: src_type, ok: true }
}

fn addr_fail(g: IRGenerator, b: IRBasicBlock) -> AddrResult {
    return AddrResult { gen: g, block: b, ptr: ir_val_undef(), src_type: "", ok: false }
}

fn struct_field_index(gen: IRGenerator, struct_name: string, field: string) -> int {
    if gen.struct_defs.contains(struct_name) == false { return -1 }
    let info = gen.struct_defs.get(struct_name)
    let mut i = 0
    while i < info.field_names.len() {
        if info.field_names[i] == field { return i }
        i = i + 1
    }
    return -1
}

-- Address of a variable, a field of an addressable or boxed struct, or `*box`.
fn generate_addr(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> AddrResult {
    let mut g = gen
    let mut b = block
    if expr.kind == EXPR_GROUPED() {
        return generate_addr(g, b, *expr.operand)
    }
    if expr.kind == EXPR_IDENTIFIER() {
        let var_t = static_type(g, expr)
        -- mut parameters are pointers to the caller's storage
        if g.param_ptr_map.contains(expr.name) {
            return addr_result(g, b, ir_val_param(g.param_ptr_map.get(expr.name)), var_t)
        }
        if g.variable_map.contains(expr.name) {
            let slot = g.variable_map.get(expr.name)
            if slot >= 0 {
                return addr_result(g, b, ir_val_inst(slot), var_t)
            }
        }
        return addr_fail(g, b)
    }
    if expr.kind == EXPR_UNARY() and expr.op == UNOP_DEREF() {
        let box_t = static_type(g, *expr.operand)
        if starts_with(box_t, "Box[") == false {
            return addr_fail(g, b)
        }
        let box_result = generate_expr(g, b, *expr.operand)
        g = box_result.gen
        b = box_result.block
        let chk = check_box_not_null(g, b, box_result.val_id)
        g = chk.gen
        b = chk.block
        return addr_result(g, b, ir_val_inst(box_result.val_id), extract_inner_type(box_t, "Box["))
    }
    if expr.kind == EXPR_INDEX_ACCESS() {
        let indexed = unboxed_container(g, *expr.object)
        let list_t = static_type(g, indexed)
        if starts_with(list_t, "List[") == false {
            return addr_fail(g, b)
        }
        let h = generate_list_handle(g, b, indexed)
        g = h.gen
        b = h.block
        if h.ok == false {
            return addr_fail(g, b)
        }
        let elem_src = extract_inner_type(list_t, "List[")
        let elem_ir = list_elem_ir_type(elem_src)
        let ek = classify_list_elem(elem_src)
        let idx_result = generate_expr(g, b, *expr.index)
        g = idx_result.gen
        b = idx_result.block
        let len_fn = if ek == LIST_ELEM_INT() { "dm_list_int64_len" }
        else if ek == LIST_ELEM_FLOAT() { "dm_list_double_len" }
        else if ek == LIST_ELEM_STRING() { "dm_list_string_len" }
        else { "dm_list_generic_len" }
        let len_id = g.builder.next_id
        let mut len_inst = ir_inst_new(len_id, OP_CALL())
        len_inst.callee = len_fn
        let mut len_args: List[IRValue] = []
        len_args.push(h.ptr)
        len_inst.call_args = len_args
        len_inst.result_type = "i64"
        len_inst.has_result = true
        b.instructions.push(len_inst)
        g.builder.next_id = len_id + 1
        let chk = check_index_bounds(g, b, idx_result.val_id, ir_val_inst(len_id), "(list)")
        g = chk.gen
        b = chk.block
        let elem_addr = emit_list_elem_addr(g, b, h.ptr, idx_result.val_id, elem_ir)
        return addr_result(elem_addr.gen, elem_addr.block, ir_val_inst(elem_addr.val_id), elem_src)
    }
    if expr.kind == EXPR_FIELD_ACCESS() {
        let obj = *expr.object
        let obj_t = static_type(g, obj)
        let mut struct_name = obj_t
        let mut base = ir_val_undef()
        if starts_with(obj_t, "Box[") {
            -- A boxed struct lives on the heap: the box value is its address
            struct_name = extract_inner_type(obj_t, "Box[")
            let box_result = generate_expr(g, b, obj)
            g = box_result.gen
            b = box_result.block
            let chk = check_box_not_null(g, b, box_result.val_id)
            g = chk.gen
            b = chk.block
            base = ir_val_inst(box_result.val_id)
        } else {
            let obj_addr = generate_addr(g, b, obj)
            g = obj_addr.gen
            b = obj_addr.block
            if obj_addr.ok == false {
                return addr_fail(g, b)
            }
            base = obj_addr.ptr
        }
        let fidx = struct_field_index(g, struct_name, expr.field)
        if fidx < 0 {
            return addr_fail(g, b)
        }
        let field_src = struct_field_src_type(g, struct_name, expr.field)
        let field_ir = map_type_name(field_src)
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_GEP())
        inst.gep_base = base
        inst.alloc_type = struct_name
        inst.field_index = fidx
        inst.field_type = field_ir
        inst.result_type = "ptr(" + field_ir + ")"
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return addr_result(g, b, ir_val_inst(id), field_src)
    }
    return addr_fail(g, b)
}

-- Pointer to a list for the runtime's list functions. A list variable
-- or field is used in place. Any other list value (a call result, a
-- list element) is copied to a temporary and `ok` is false, because
-- changes to that copy would be lost.
fn generate_list_handle(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> AddrResult {
    let mut g = gen
    let mut b = block
    let list_t = static_type(g, expr)
    if expr.kind == EXPR_IDENTIFIER() {
        -- A list variable's value is already a pointer to its storage
        let var_result = generate_expr(g, b, expr)
        return addr_result(var_result.gen, var_result.block, ir_val_inst(var_result.val_id), list_t)
    }
    if expr.kind == EXPR_FIELD_ACCESS() or expr.kind == EXPR_INDEX_ACCESS() or expr.kind == EXPR_UNARY() or expr.kind == EXPR_GROUPED() {
        let a = generate_addr(g, b, expr)
        g = a.gen
        b = a.block
        if a.ok {
            return a
        }
    }
    let val_result = generate_expr(g, b, expr)
    g = val_result.gen
    b = val_result.block
    let tmp_id = g.builder.next_id
    let mut tmp_inst = ir_inst_new(tmp_id, OP_ALLOCA())
    tmp_inst.alloc_type = list_t
    tmp_inst.result_type = "ptr(" + list_t + ")"
    tmp_inst.has_result = true
    b.instructions.push(tmp_inst)
    g.builder.next_id = tmp_id + 1
    let mut st_inst = ir_inst_new(g.builder.next_id, OP_STORE())
    st_inst.store_ptr = ir_val_inst(tmp_id)
    st_inst.store_val = ir_val_inst(val_result.val_id)
    b.instructions.push(st_inst)
    g.builder.next_id = g.builder.next_id + 1
    let mut copy = addr_result(g, b, ir_val_inst(tmp_id), list_t)
    copy.ok = false
    return copy
}

-- The address of element idx_id of the list whose header is at
-- list_ptr and whose elements have IR type elem_ir. The caller has
-- checked the index, and nothing may run between that check and the
-- use of the address.
fn emit_list_elem_addr(gen: IRGenerator, block: IRBasicBlock, list_ptr: IRValue, idx_id: int, elem_ir: string) -> ExprResult {
    let mut g = gen
    let mut b = block
    let id = g.builder.next_id
    let mut inst = ir_inst_new(id, OP_GEP())
    inst.gep_base = list_ptr
    let mut gep_idx: List[IRValue] = []
    gep_idx.push(ir_val_inst(idx_id))
    inst.gep_indices = gep_idx
    inst.alloc_type = elem_ir
    inst.field_type = elem_ir
    inst.result_type = "ptr(" + elem_ir + ")"
    inst.has_result = true
    b.instructions.push(inst)
    g.builder.next_id = id + 1
    return expr_result(g, b, id)
}

-- IR type of the elements a list of this kind stores
fn list_slot_ir_type(elem_kind: int, elem_type: string) -> string {
    if elem_kind == LIST_ELEM_INT() { return "i64" }
    if elem_kind == LIST_ELEM_FLOAT() { return "f64" }
    if elem_kind == LIST_ELEM_STRING() { return "string" }
    -- A function value is the address of its closure
    if starts_with(elem_type, "fn(") { return "ptr" }
    return elem_type
}

-- Whether loading a value of IR type t gives the address it was
-- loaded from instead of a copy (strings and lists)
fn ir_load_gives_address(t: string) -> bool {
    return t == "string" or t == "list" or starts_with(t, "List[") or starts_with(t, "dm_list_")
}

-- IR element type of a list whose elements have source type elem_src
fn list_elem_ir_type(elem_src: string) -> string {
    let kind = classify_list_elem(elem_src)
    if kind == LIST_ELEM_INT() { return "i64" }
    if kind == LIST_ELEM_FLOAT() { return "f64" }
    if kind == LIST_ELEM_STRING() { return "string" }
    -- A function value is the address of its closure
    if starts_with(elem_src, "fn(") { return "ptr" }
    return elem_src
}

-- ============================================================
-- EXPRESSION TYPE INFERENCE
-- Determines the IR type name for an expression without
-- generating instructions. Used to select the correct opcode
-- family (integer, float, string) for binary operations.
-- ============================================================

-- Whether the checker's type for the expression is used before any
-- found here (see CHECKED TYPES in ir_gen.dm): for an `if`, a `match`
-- or a block, whose type here is that of their first branch; for
-- None, Some(x), Ok(x) and Err(x), whose type depends on where the
-- value goes; and for a call of a generic function
fn checked_type_first(gen: IRGenerator, expr: Expr) -> bool {
    let k = expr.kind
    if k == EXPR_IF() or k == EXPR_MATCH() or k == EXPR_BLOCK() { return true }
    if k == EXPR_IDENTIFIER() { return expr.name == "None" and gen.variable_map.contains("None") == false }
    if k == EXPR_FUNCTION_CALL() {
        let callee = *expr.callee
        if callee.kind != EXPR_IDENTIFIER() { return false }
        let name = callee.name
        return name == "Some" or name == "Ok" or name == "Err" or gen.generic_fn_decls.contains(name)
    }
    return false
}

-- The function that `recv.method(...)` calls when the receiver is a
-- struct or an enum value, or a box of one, whose type has a method of
-- the name: "Counter_get". "" for any other receiver, and for a method
-- of a generic struct, which is found through its instance.
fn own_method_of(gen: IRGenerator, recv: Expr, method: string) -> string {
    let recv_type = strip_box_type(static_type(gen, recv))
    if recv_type == "" { return "" }
    if gen.struct_defs.contains(recv_type) == false and gen.enum_defs.contains(recv_type) == false { return "" }
    if gen.generic_instances.contains(recv_type) { return "" }
    let mangled = recv_type + "_" + method
    if gen.generic_fn_decls.contains(mangled) { return "" }
    if gen.fn_return_types.contains(mangled) { return mangled }
    return ""
}

fn infer_expr_type(gen: IRGenerator, expr: Expr) -> string {
    if checked_type_first(gen, expr) {
        let checked = checked_ir_type(gen, expr)
        if checked != "" { return checked }
        let k = expr.kind
        if k == EXPR_IF() or k == EXPR_MATCH() or k == EXPR_BLOCK() {
            return checked_slot_type(gen, expr, infer_expr_type_from_parts(gen, expr))
        }
    }
    return infer_expr_type_from_parts(gen, expr)
}

-- The type of the expression as its parts and the variables declared
-- so far give it
fn infer_expr_type_from_parts(gen: IRGenerator, expr: Expr) -> string {
    if expr.kind == EXPR_LITERAL_INT() {
        return "i64"
    }
    if expr.kind == EXPR_LITERAL_FLOAT() {
        return "f64"
    }
    if expr.kind == EXPR_LITERAL_STRING() {
        return "string"
    }
    if expr.kind == EXPR_LITERAL_BOOL() {
        return "bool"
    }
    if expr.kind == EXPR_IDENTIFIER() {
        let name = expr.name
        if name == "true" or name == "false" {
            return "bool"
        }
        if gen.variable_types.contains(name) {
            return gen.variable_types.get(name)
        }
        -- Check global constants for their type
        let mut gi_ty = 0
        while gi_ty < gen.ir_mod.globals.len() {
            let gl_ty = gen.ir_mod.globals[gi_ty]
            if gl_ty.name == name and gl_ty.has_init {
                if gl_ty.init_value.kind == VAL_CONST_STRING() {
                    return "string"
                }
                if gl_ty.init_value.kind == VAL_CONST_FLOAT() {
                    return "f64"
                }
                if gl_ty.init_value.kind == VAL_CONST_BOOL() {
                    return "bool"
                }
                return "i64"
            }
            gi_ty = gi_ty + 1
        }
        -- A function's name is the address of its closure
        if gen.fn_src_param_types.contains(name) and gen.generic_fn_decls.contains(name) == false {
            return "ptr"
        }
        return "i64"
    }
    -- A lambda is the address of its closure
    if expr.kind == EXPR_LAMBDA() {
        return "ptr"
    }
    if expr.kind == EXPR_BINARY() {
        -- Comparison and logical operators always produce bool
        if is_bool_binop(expr.op) {
            return "bool"
        }
        -- Arithmetic. A chain a + b + c + ... nests to the left, one
        -- level for each operator, so its type is worked out in a loop
        -- from the innermost operator outwards; by recursion, a chain
        -- of a few hundred overflowed the stack. Each operand's type is
        -- inferred once: inferring the left one twice doubles the work
        -- at every level.
        let mut levels: List[Expr] = []
        let mut node = expr
        while node.kind == EXPR_BINARY() and is_bool_binop(node.op) == false {
            levels.push(node)
            node = *node.left
        }
        let mut chain_type = infer_expr_type(gen, node)
        let mut level = levels.len() - 1
        while level >= 0 {
            -- Integers of different types meet at one type; otherwise
            -- the operator has its left operand's type
            let common_t = common_int_type(levels[level], chain_type, infer_expr_type(gen, *levels[level].right))
            if common_t != "" {
                chain_type = common_t
            }
            level = level - 1
        }
        return chain_type
    }
    if expr.kind == EXPR_UNARY() {
        if expr.op == UNOP_NOT() {
            return "bool"
        }
        if expr.op == UNOP_DEREF() {
            let deref_src = static_type(gen, expr)
            if deref_src != "" { return map_type_name(deref_src) }
        }
        -- Negation preserves the operand type
        return infer_expr_type(gen, *expr.operand)
    }
    if expr.kind == EXPR_CAST() {
        return map_type_name(expr.cast_type)
    }
    if expr.kind == EXPR_FUNCTION_CALL() {
        -- Check if callee is an identifier with a known builtin return type
        let callee = *expr.callee
        -- A call of a function value gives what the value's type says
        let called_type = called_value_type(gen, callee)
        if called_type != "" {
            return value_call_result_type(gen, called_type)
        }
        if callee.kind == EXPR_IDENTIFIER() {
            let fn_name = callee.name
            if is_builtin_fn(fn_name) {
                return builtin_return_type(fn_name)
            }
            -- SIMD builtins: infer return type from function name or argument types
            if is_simd_builtin(fn_name) {
                if starts_with(fn_name, "simd_splat_") or starts_with(fn_name, "simd_set_") {
                    return parse_simd_type_from_name(fn_name)
                }
                if fn_name == "simd_add" or fn_name == "simd_sub" or fn_name == "simd_mul" or fn_name == "simd_div" {
                    -- Return type is the same as the first argument's vector type
                    if expr.args.len() > 0 {
                        return infer_expr_type(gen, expr.args[0])
                    }
                    return "f32x4"
                }
                if fn_name == "simd_extract" {
                    -- Return dAImond-native type (f64 for float vectors, i64 for int vectors)
                    if expr.args.len() > 0 {
                        let vec_ty = infer_expr_type(gen, expr.args[0])
                        if is_simd_float_type(vec_ty) {
                            return "f64"
                        }
                        return "i64"
                    }
                    return "f64"
                }
            }
            -- Look up user-defined function return types
            let mut fi = 0
            while fi < gen.ir_mod.functions.len() {
                let func = gen.ir_mod.functions[fi]
                if func.name == fn_name {
                    return func.return_type
                }
                fi = fi + 1
            }
            -- Check for generic function declarations
            if gen.generic_fn_decls.contains(fn_name) {
                let decl_idx: int = gen.generic_fn_decls.get(fn_name)
                if decl_idx >= 0 and decl_idx < gen.declarations.len() {
                    let decl = gen.declarations[decl_idx]
                    if decl.kind == DECL_FUNCTION() {
                        let fd = *decl.func_decl
                        let ret_type = fd.return_type
                        -- The return type with the type arguments the
                        -- checker found for this call
                        let call_type_args = checked_type_args(gen, expr)
                        if expr.generic_args.len() == 0 and call_type_args.len() == fd.generic_params.len() and call_type_args.len() > 0 {
                            let mut with_args = gen
                            with_args.type_substitutions = Map_new()
                            let mut ta = 0
                            while ta < call_type_args.len() {
                                with_args.type_substitutions.insert(fd.generic_params[ta], call_type_args[ta])
                                ta = ta + 1
                            }
                            return map_type_name(canon_type(with_args, ret_type))
                        }
                        -- If return type is a generic param, resolve from args
                        if fd.generic_params.len() > 0 {
                            let mut pi = 0
                            while pi < fd.generic_params.len() {
                                if fd.generic_params[pi] == ret_type {
                                    -- Infer from corresponding argument
                                    if pi < expr.args.len() {
                                        return infer_expr_type(gen, expr.args[pi])
                                    }
                                }
                                pi = pi + 1
                            }
                            -- Also check explicit type args
                            if expr.generic_args.len() > 0 {
                                let mut gi = 0
                                while gi < fd.generic_params.len() {
                                    if fd.generic_params[gi] == ret_type and gi < expr.generic_args.len() {
                                        return map_type_name(expr.generic_args[gi])
                                    }
                                    gi = gi + 1
                                }
                            }
                        }
                        return map_type_name(ret_type)
                    }
                }
            }
            -- Declared later in the source: use the signature registered up front
            if gen.fn_return_types.contains(fn_name) {
                return gen.fn_return_types.get(fn_name)
            }
        }
        return "i64"
    }
    if expr.kind == EXPR_STRING_INTERP() {
        return "string"
    }
    if expr.kind == EXPR_GROUPED() {
        return infer_expr_type(gen, *expr.operand)
    }
    if expr.kind == EXPR_ERROR_PROPAGATE() {
        let value_type = propagated_type(infer_expr_type(gen, *expr.operand))
        if value_type != "" { return map_type_name(value_type) }
    }
    if expr.kind == EXPR_STRUCT_LITERAL() {
        return canon_type(gen, expr.type_name)
    }
    if expr.kind == EXPR_ENUM_LITERAL() {
        if is_generic_enum(gen, expr.enum_name) {
            return canon_type(gen, generic_enum_type(gen, expr, expr.enum_name, expr.variant_name, expr.payload))
        }
        return expr.enum_name
    }
    if expr.kind == EXPR_IF() {
        -- Type of the then branch's trailing expression, else the else branch's
        -- (a branch may end in `return` instead)
        let then_t = infer_expr_type(gen, *expr.then_branch)
        if expr.has_else == false { return then_t }
        let else_t = infer_expr_type(gen, *expr.else_branch)
        if then_t == "void" { return else_t }
        -- Integers of different widths meet at one type
        if is_integer_type(then_t) and is_integer_type(else_t) {
            return int_meet_type(then_t, is_int_literal_expr(branch_value_expr(*expr.then_branch)), else_t, is_int_literal_expr(branch_value_expr(*expr.else_branch)))
        }
        return then_t
    }
    if expr.kind == EXPR_BLOCK() {
        -- The type of the expression that ends the block, which an
        -- `if` with an `else` and a `match` are too
        if expr.stmts.len() > 0 {
            let last = expr.stmts[expr.stmts.len() - 1]
            if stmt_gives_value(last) {
                return infer_expr_type(gen, stmt_value_expr(last))
            }
        }
        return "void"
    }
    if expr.kind == EXPR_MATCH() {
        -- The type of the first arm, and for integers the type the
        -- arms meet at
        if expr.match_arms.len() > 0 {
            let arm = expr.match_arms[0]
            if arm.is_expr_body {
                return arms_meet_type(gen, expr.match_arms, infer_expr_type(gen, *arm.body_expr))
            }
        }
        return "void"
    }
    if expr.kind == EXPR_FIELD_ACCESS() {
        -- Look up struct field type
        let obj = *expr.object
        let obj_type = infer_expr_type(gen, obj)
        if gen.struct_defs.contains(obj_type) {
            let si = gen.struct_defs.get(obj_type)
            let mut fi = 0
            while fi < si.field_names.len() {
                if si.field_names[fi] == expr.field {
                    return si.field_types[fi]
                }
                fi = fi + 1
            }
        }
        -- Check variable's struct type
        if obj.kind == EXPR_IDENTIFIER() and gen.var_struct_types.contains(obj.name) {
            let sname = gen.var_struct_types.get(obj.name)
            if gen.struct_defs.contains(sname) {
                let si = gen.struct_defs.get(sname)
                let mut fi = 0
                while fi < si.field_names.len() {
                    if si.field_names[fi] == expr.field {
                        return si.field_types[fi]
                    }
                    fi = fi + 1
                }
            }
        }
        -- Check Option[T] / Result[T, E] types for field access
        if obj.kind == EXPR_IDENTIFIER() and gen.variable_types.contains(obj.name) {
            let fa_vtype = gen.variable_types.get(obj.name)
            if starts_with(fa_vtype, "Option[") {
                let fa_inner = substr(fa_vtype, 7, len(fa_vtype) - 8)
                if expr.field == "value" {
                    return map_type_name(fa_inner)
                }
                if expr.field == "has_value" {
                    return "i32"
                }
            }
            if starts_with(fa_vtype, "Result[") {
                let fa_inner_str = substr(fa_vtype, 7, len(fa_vtype) - 8)
                let mut fa_comma = 0
                let mut fa_ci = 0
                while fa_ci < len(fa_inner_str) {
                    if char_at(fa_inner_str, fa_ci) == "," {
                        fa_comma = fa_ci
                    }
                    fa_ci = fa_ci + 1
                }
                let fa_ok_type = string_trim(substr(fa_inner_str, 0, fa_comma))
                let fa_err_type = string_trim(substr(fa_inner_str, fa_comma + 1, len(fa_inner_str) - fa_comma - 1))
                if expr.field == "ok" or expr.field == "value" {
                    return map_type_name(fa_ok_type)
                }
                if expr.field == "err" or expr.field == "error" {
                    return map_type_name(fa_err_type)
                }
                if expr.field == "is_ok" {
                    return "bool"
                }
            }
        }
        let field_src = static_type(gen, expr)
        if field_src != "" { return map_type_name(field_src) }
        return "i64"
    }
    if expr.kind == EXPR_INDEX_ACCESS() {
        let obj = *expr.object
        if obj.kind == EXPR_IDENTIFIER() {
            let name = obj.name
            -- String indexing returns a string (char_at)
            if gen.variable_types.contains(name) {
                let idx_vtype = gen.variable_types.get(name)
                if idx_vtype == "string" {
                    return "string"
                }
            }
            if gen.list_elem_kinds.contains(name) {
                let ek = gen.list_elem_kinds.get(name)
                if ek == LIST_ELEM_INT() { return "i64" }
                if ek == LIST_ELEM_FLOAT() { return "f64" }
                if ek == LIST_ELEM_STRING() { return "string" }
                if ek == LIST_ELEM_OTHER() and gen.list_elem_types.contains(name) {
                    return gen.list_elem_types.get(name)
                }
            }
        }
        let idx_src = static_type(gen, expr)
        if idx_src != "" {
            return list_elem_ir_type(idx_src)
        }
        return "i64"
    }
    if expr.kind == EXPR_METHOD_CALL() {
        if starts_with(checked_target(gen, expr), "call:") {
            return infer_expr_type(gen, method_as_call(gen, expr))
        }
        let static_target = static_call_target(gen, expr)
        if static_target != "" {
            return infer_expr_type(gen, static_call_expr(expr, static_target))
        }
        let method = expr.method
        -- Methods of generic struct instances have exact signatures
        if gen.generic_instances.contains(strip_box_type(static_type(gen, *expr.object))) {
            let mc_src = static_type(gen, expr)
            if mc_src == "" { return "void" }
            return map_type_name(mc_src)
        }
        -- A struct's or an enum's own method, whatever its name: the
        -- type it declares, not that of the list or map method of the
        -- name, nor of another struct's method of the name
        let own_method = own_method_of(gen, *expr.object, method)
        if own_method != "" { return infer_call_return_type(gen, own_method) }
        if method == "len" { return "i64" }
        if method == "pop" {
            let pop_src = static_type(gen, expr)
            if pop_src != "" { return list_elem_ir_type(pop_src) }
            return "i64"
        }
        if method == "get" {
            return "i64"
        }
        if method == "contains" { return "bool" }
        -- Check for struct method calls (regular and generic impl)
        if gen.method_struct_map.contains(method) {
            let struct_type = gen.method_struct_map.get(method)
            let mangled = struct_type + "_" + method
            -- Check generic impl method
            if gen.generic_fn_decls.contains(mangled) {
                let decl_idx: int = gen.generic_fn_decls.get(mangled)
                if decl_idx >= 0 and decl_idx < gen.declarations.len() {
                    let decl = gen.declarations[decl_idx]
                    if decl.kind == DECL_FUNCTION() {
                        let fd = *decl.func_decl
                        -- Check if method takes self
                        let mut has_self = false
                        if fd.params.len() > 0 {
                            has_self = fd.params[0].name == "self"
                        }
                        -- Build effective args
                        let mut effective_args: List[Expr] = []
                        if has_self {
                            effective_args.push(*expr.object)
                        }
                        let mut ai = 0
                        while ai < expr.args.len() {
                            effective_args.push(expr.args[ai])
                            ai = ai + 1
                        }
                        -- Infer type args
                        let mut temp_subs: Map[string, string] = Map_new()
                        let mut pi = 0
                        while pi < fd.generic_params.len() {
                            let gp = fd.generic_params[pi]
                            let mut inferred = "i64"
                            let mut mi = 0
                            while mi < fd.params.len() and mi < effective_args.len() {
                                if fd.params[mi].type_name == gp {
                                    inferred = infer_arg_type(gen, effective_args[mi])
                                }
                                mi = mi + 1
                            }
                            temp_subs.insert(gp, inferred)
                            pi = pi + 1
                        }
                        -- Resolve return type
                        let ret = fd.return_type
                        if temp_subs.contains(ret) {
                            return map_type_name(temp_subs.get(ret))
                        }
                        -- Handle complex return types like Pair[A, B]
                        let bracket_idx = string_find(ret, "[")
                        if bracket_idx > 0 {
                            let base = substr(ret, 0, bracket_idx)
                            let inner = substr(ret, bracket_idx + 1, len(ret) - bracket_idx - 2)
                            let comma_idx = string_find(inner, ", ")
                            if comma_idx >= 0 {
                                let first_t = substr(inner, 0, comma_idx)
                                let second_t = substr(inner, comma_idx + 2, len(inner) - comma_idx - 2)
                                let r1 = if temp_subs.contains(first_t) { map_type_name(temp_subs.get(first_t)) } else { map_type_name(first_t) }
                                let r2 = if temp_subs.contains(second_t) { map_type_name(temp_subs.get(second_t)) } else { map_type_name(second_t) }
                                return base + "_" + r1 + "_" + r2
                            } else {
                                let r1 = if temp_subs.contains(inner) { map_type_name(temp_subs.get(inner)) } else { map_type_name(inner) }
                                return base + "_" + r1
                            }
                        }
                        return map_type_name(ret)
                    }
                }
            }
            -- Non-generic struct method: look up return type from IR functions
            let ret_type = infer_call_return_type(gen, mangled)
            return ret_type
        }
        return "i64"
    }
    if expr.kind == EXPR_COMPTIME() {
        return infer_expr_type(gen, *expr.operand)
    }
    if expr.kind == EXPR_ARRAY_LITERAL() {
        return "list"
    }
    if expr.kind == EXPR_AWAIT() {
        -- Await returns the type of the inner expression
        return infer_expr_type(gen, *expr.operand)
    }
    -- Default fallback
    return "i64"
}

-- ============================================================
-- BINARY EXPRESSION IR GENERATION
-- Handles arithmetic, comparison, logical, and string operators
-- ============================================================

-- ============================================================
-- EQUALITY
-- `==` and `!=` compare numbers, bools and strings directly, a Box and
-- a function by its address, and an enum whose variants carry no
-- values by its tag. Two structs are equal when their fields are, two
-- enum values when they are the same variant with equal values, two
-- Options or Results likewise, and two lists when they have the same
-- length and equal elements: each such type gets a function that
-- compares two of its values, written here as source and generated
-- when the type is first compared (made_function). A struct or enum
-- with a method `eq` is compared by that method. A Map, a `dyn` value
-- and a SIMD vector are not compared.
-- ============================================================

-- A function the compiler writes: `source` is a file with the one
-- function, which is generated under the name `mangled` the first time
-- it is asked for. No source can name it (the name has a `$`).
fn made_function(gen: IRGenerator, mangled: string, source: string) -> IRGenerator {
    if gen.mono_generated.contains(mangled) { return gen }
    -- Its lines are the runtime's, so it has no debug info of its own
    let mut file = 0
    let mut fi = 0
    while fi < gen.ir_mod.files.len() {
        if gen.ir_mod.files[fi] == PRELUDE_NAME() { file = fi }
        fi = fi + 1
    }
    let sf = parse_source_file(parser_new(tokenize_file(source, PRELUDE_NAME(), file)))
    if sf.declarations.len() == 0 { return gen }
    let decl = sf.declarations[0]
    if decl.kind != DECL_FUNCTION() { return gen }
    let fd = *decl.func_decl

    let caller = gen
    let mut g = gen
    g.mono_generated.insert(mangled, true)
    g.type_substitutions = Map_new()
    g.current_impl_type = ""
    g.has_impl_type = false
    g.unsafe_depth = 0
    g.region_depth = 0
    g.fn_src_return_types.insert(mangled, fd.return_type)
    g.fn_src_param_types.insert(mangled, param_src_types(fd))
    g.fn_return_types.insert(mangled, parse_type_to_ir(fd.return_type))
    g.known_functions.insert(mangled, true)
    g.var_src_types = Map_new()
    g.var_struct_types = Map_new()
    g.list_elem_kinds = Map_new()
    g.list_elem_types = Map_new()
    g.var_enum_types = Map_new()
    g.box_inner_types = Map_new()
    g.array_var_names = Map_new()
    g = declare_function(g, fd, mangled)
    g = generate_function_body(g, fd, mangled)
    return back_to_caller(caller, g)
}

-- The name of the function the compiler writes for `what` ("eq",
-- "contains") and the type
fn made_function_name(what: string, t: string) -> string {
    let a = string_replace(string_replace(t, ", ", "$$"), ",", "$$")
    let b = string_replace(string_replace(a, "[", "$"), "]", "")
    return what + "$" + string_replace(string_replace(b, "; ", "$x"), " ", "")
}

-- The type of a `[T; N]` array as the list it is, and any other type
-- as it is
fn eq_type(t: string) -> string {
    if starts_with(t, "[") and ends_with(t, "]") {
        let semi = string_find(t, ";")
        if semi > 0 { return "List[" + string_trim(substr(t, 1, semi - 1)) + "]" }
    }
    return t
}

-- Whether the enum has a variant that carries values
fn enum_carries_values(info: EnumInfo) -> bool {
    let mut i = 0
    while i < info.variant_payloads.len() {
        if info.variant_payloads[i] != "" { return true }
        i = i + 1
    }
    return false
}

fn is_simd_type_name(t: string) -> bool {
    return t == "f32x4" or t == "f32x8" or t == "f64x2" or t == "f64x4" or t == "i32x4" or t == "i32x8" or t == "i64x2" or t == "i64x4"
}

-- Whether two values of the type are compared by a function the
-- compiler writes (eq_function_source)
fn eq_by_function(g: IRGenerator, t: string) -> bool {
    if starts_with(t, "List[") or starts_with(t, "Option[") or starts_with(t, "Result[") { return true }
    if g.struct_defs.contains(t) and g.enum_defs.contains(t) == false {
        return struct_has_method(g, t, "eq") == false
    }
    if g.enum_defs.contains(t) {
        if struct_has_method(g, t, "eq") { return false }
        return enum_carries_values(g.enum_defs.get(t))
    }
    return false
}

-- The first type among the type and its parts that `==` does not
-- compare, or "". `seen` holds the types that are being looked at,
-- for a type that contains itself.
fn eq_unsupported(g: IRGenerator, t0: string, seen: List[string]) -> string {
    let t = eq_type(t0)
    if starts_with(t, "Map[") or is_map_type(g, t) or starts_with(t, DYN_PREFIX()) or is_simd_type_name(t) { return t }
    if starts_with(t, "Box[") or starts_with(t, "fn(") { return "" }
    if eq_by_function(g, t) == false { return "" }
    let mut si = 0
    while si < seen.len() {
        if seen[si] == t { return "" }
        si = si + 1
    }
    let mut inner = seen
    inner.push(t)
    let mut parts: List[string] = []
    if g.enum_defs.contains(t) {
        let info = g.enum_defs.get(t)
        let mut vi = 0
        while vi < info.variant_payloads.len() {
            if info.variant_payloads[vi] != "" {
                let values = string_split(info.variant_payloads[vi], "|")
                let mut k = 0
                while k < values.len() {
                    parts.push(values[k])
                    k = k + 1
                }
            }
            vi = vi + 1
        }
    } else if g.struct_defs.contains(t) {
        let info = g.struct_defs.get(t)
        parts = info.field_src_types
    } else {
        let bracket = string_find(t, "[")
        parts = split_type_args(substr(t, bracket + 1, len(t) - bracket - 2))
    }
    let mut pi = 0
    while pi < parts.len() {
        let found = eq_unsupported(g, canon_type(g, parts[pi]), inner)
        if found != "" { return found }
        pi = pi + 1
    }
    return ""
}

-- A type as a program writes it, for a message: Pair[int, string] for
-- the instance Pair_i64_string
fn shown_type(g: IRGenerator, t: string) -> string {
    let mut base = t
    let mut args: List[string] = []
    if g.generic_instances.contains(t) {
        base = g.generic_instances.get(t)
        args = string_split(g.generic_instance_args.get(t), "|")
    } else {
        let bracket = string_find(t, "[")
        if bracket <= 0 or ends_with(t, "]") == false { return t }
        base = substr(t, 0, bracket)
        args = split_type_args(substr(t, bracket + 1, len(t) - bracket - 2))
    }
    let mut out = base + "["
    let mut i = 0
    while i < args.len() {
        if i > 0 { out = out + ", " }
        out = out + shown_type(g, args[i])
        i = i + 1
    }
    return out + "]"
}

-- "a0 == b0 and a1 == b1" for n values, or "true" for none
fn eq_values_source(n: int) -> string {
    if n == 0 { return "true" }
    let mut out = ""
    let mut k = 0
    while k < n {
        if k > 0 { out = out + " and " }
        out = out + "a" + int_to_string(k) + " == b" + int_to_string(k)
        k = k + 1
    }
    return out
}

-- "(a0, a1)" for n values of a variant's pattern, or "" for none
fn eq_bindings_source(prefix: string, n: int) -> string {
    if n == 0 { return "" }
    let mut out = "("
    let mut k = 0
    while k < n {
        if k > 0 { out = out + ", " }
        out = out + prefix + int_to_string(k)
        k = k + 1
    }
    return out + ")"
}

-- The function that compares two values of the type, as source
fn eq_function_source(g: IRGenerator, t: string) -> string {
    let head = "module eq\nfn eq(a: " + t + ", b: " + t + ") -> bool {\n"
    if starts_with(t, "List[") {
        return head + "    if a.len() != b.len() { return false }\n    let mut i = 0\n    while i < a.len() {\n        if a[i] != b[i] { return false }\n        i = i + 1\n    }\n    return true\n}\n"
    }
    if starts_with(t, "Option[") {
        return head + "    let mut same = false\n    match a {\n        Some(x) => { match b { Some(y) => { same = x == y } None => { same = false } } }\n        None => { match b { Some(y) => { same = false } None => { same = true } } }\n    }\n    return same\n}\n"
    }
    if starts_with(t, "Result[") {
        return head + "    let mut same = false\n    match a {\n        Ok(x) => { match b { Ok(y) => { same = x == y } Err(y) => { same = false } } }\n        Err(x) => { match b { Ok(y) => { same = false } Err(y) => { same = x == y } } }\n    }\n    return same\n}\n"
    }
    if g.enum_defs.contains(t) {
        let info = g.enum_defs.get(t)
        let mut body = "    let mut same = false\n    match a {\n"
        let mut vi = 0
        while vi < info.variant_names.len() {
            let n = enum_payload_count(info, vi)
            let v = "E." + info.variant_names[vi]
            body = body + "        " + v + eq_bindings_source("a", n) + " => { match b { " + v + eq_bindings_source("b", n) + " => { same = " + eq_values_source(n) + " } _ => { same = false } } }\n"
            vi = vi + 1
        }
        return head + body + "    }\n    return same\n}\n"
    }
    let info = g.struct_defs.get(t)
    let mut all = ""
    let mut fi = 0
    while fi < info.field_names.len() {
        if fi > 0 { all = all + " and " }
        all = all + "a." + info.field_names[fi] + " == b." + info.field_names[fi]
        fi = fi + 1
    }
    if all == "" { all = "true" }
    return head + "    return " + all + "\n}\n"
}

-- The type two operands of `==` are compared as: the left operand's,
-- or the right one's where the left does not say (None == o)
fn eq_operand_type(g: IRGenerator, expr: Expr) -> string {
    let mut t = static_type(g, *expr.left)
    if t == "" or string_contains(t, "?") { t = static_type(g, *expr.right) }
    if t == "" { return "" }
    return eq_type(canon_type(g, t))
}

-- `xs.contains(v)` for a list whose elements `==` compares by a
-- function: a function for the list's type that looks for an equal
-- element
fn contains_function_source(t: string) -> string {
    let elem = substr(t, 5, len(t) - 6)
    return "module contains\nfn contains(xs: " + t + ", v: " + elem + ") -> bool {\n    let mut i = 0\n    while i < xs.len() {\n        if xs[i] == v { return true }\n        i = i + 1\n    }\n    return false\n}\n"
}

fn generate_binary(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    -- A chain such as a + b + c + ... nests to the left, one level
    -- for each operator. Its levels are generated in a loop, from the
    -- innermost outwards: generated by recursion, each level takes
    -- more than a megabyte of stack, and a chain of 40 overflowed it.
    let mut spine: List[Expr] = []
    let mut node = expr
    while node.op != BINOP_AND() and node.op != BINOP_OR() and binary_left_is_binary(node) {
        spine.push(node)
        node = *node.left
    }
    let mut result = generate_binary_level(gen, block, node, -1)
    let mut i = spine.len() - 1
    while i >= 0 {
        result = generate_binary_level(result.gen, result.block, spine[i], result.val_id)
        i = i - 1
    }
    return result
}

fn binary_left_is_binary(expr: Expr) -> bool {
    let left = *expr.left
    return left.kind == EXPR_BINARY()
}

-- Whether the struct has a method of this name, declared or generic
fn struct_has_method(g: IRGenerator, struct_name: string, method: string) -> bool {
    let mangled = struct_name + "_" + method
    let mut fci = 0
    while fci < g.ir_mod.functions.len() {
        if g.ir_mod.functions[fci].name == mangled { return true }
        fci = fci + 1
    }
    if g.generic_fn_decls.contains(mangled) { return true }
    -- A method that is declared further down the file
    let mut dci = 0
    while dci < g.declarations.len() {
        let decl = g.declarations[dci]
        if decl.kind == DECL_FUNCTION() {
            let fd = *decl.func_decl
            if fd.name == mangled { return true }
        }
        dci = dci + 1
    }
    return false
}

-- The method a struct defines an arithmetic operator with
fn arith_overload_method(op: int) -> string {
    if op == BINOP_ADD() { return "add" }
    if op == BINOP_SUB() { return "sub" }
    if op == BINOP_MUL() { return "mul" }
    if op == BINOP_DIV() { return "div" }
    return ""
}

-- A variable no source can name (its name begins with %), which holds
-- a value that is generated already, so that the value can be given
-- where an expression is expected. ty is its IR type and src its
-- source type. unbind_hidden_value forgets it.
fn bind_hidden_value(gen: IRGenerator, block: IRBasicBlock, name: string, val_id: int, ty: string, src: string) -> GenResult {
    let mut g = gen
    let mut b = block
    let slot_id = g.builder.next_id
    let mut slot = ir_inst_new(slot_id, OP_ALLOCA())
    slot.alloc_type = ty
    slot.result_type = "ptr(" + ty + ")"
    slot.has_result = true
    b.instructions.push(slot)
    g.builder.next_id = slot_id + 1
    let stored = emit_ir_store(g, b, ir_val_inst(slot_id), ir_val_inst(val_id))
    g = stored.gen
    g.variable_map.insert(name, slot_id)
    g.variable_types.insert(name, ty)
    if src != "" { g.var_src_types.insert(name, src) }
    if g.struct_defs.contains(ty) { g.var_struct_types.insert(name, ty) }
    return gen_result(g, stored.block)
}

fn unbind_hidden_value(gen: IRGenerator, name: string) -> IRGenerator {
    let mut g = gen
    if g.variable_map.contains(name) { g.variable_map.remove(name) }
    if g.variable_types.contains(name) { g.variable_types.remove(name) }
    if g.var_src_types.contains(name) { g.var_src_types.remove(name) }
    if g.var_struct_types.contains(name) { g.var_struct_types.remove(name) }
    return g
}

-- One binary operator. lhs_done is the value of its left operand when
-- that is generated already, and -1 when it is not. It is only given
-- for an operator that is not `and` or `or` and whose left operand is
-- itself a binary operator.
fn generate_binary_level(gen: IRGenerator, block: IRBasicBlock, expr: Expr, lhs_done: int) -> ExprResult {
    let mut g = gen
    let mut b = block
    let op = expr.op

    -- --------------------------------------------------------
    -- SHORT-CIRCUIT LOGICAL AND
    -- lhs && rhs: if lhs is false, result is false; else result is rhs
    -- --------------------------------------------------------
    if op == BINOP_AND() {
        -- Allocate a result slot for the bool
        let result_alloca_id = g.builder.next_id
        let mut result_alloca = ir_inst_new(result_alloca_id, OP_ALLOCA())
        result_alloca.alloc_type = "bool"
        result_alloca.result_type = "ptr(bool)"
        result_alloca.has_result = true
        b.instructions.push(result_alloca)
        g.builder.next_id = g.builder.next_id + 1

        -- Evaluate left operand
        let lhs_result = generate_expr(g, b, *expr.left)
        g = lhs_result.gen
        b = lhs_result.block
        let lhs_id = lhs_result.val_id

        -- Labels for the branches
        let rhs_label = gen_next_label(g, "and_rhs")
        g = gen_advance_label(g)
        let short_label = gen_next_label(g, "and_short")
        g = gen_advance_label(g)
        let join_label = gen_next_label(g, "and_join")
        g = gen_advance_label(g)

        -- Branch: if lhs is true, evaluate rhs; else short-circuit to false
        b.terminator = Box_new(term_br_cond(ir_val_inst(lhs_id), rhs_label, short_label))
        b.has_terminator = true
        g.completed_blocks.push(b)

        -- RHS block: evaluate rhs, store result, branch to join
        let mut rhs_block = ir_block_new(rhs_label)
        let rhs_result = generate_expr(g, rhs_block, *expr.right)
        g = rhs_result.gen
        rhs_block = rhs_result.block
        let rhs_id = rhs_result.val_id

        let mut store_rhs = ir_inst_new(g.builder.next_id, OP_STORE())
        store_rhs.store_ptr = ir_val_inst(result_alloca_id)
        store_rhs.store_val = ir_val_inst(rhs_id)
        store_rhs.has_result = false
        rhs_block.instructions.push(store_rhs)
        g.builder.next_id = g.builder.next_id + 1

        rhs_block.terminator = Box_new(term_br(join_label))
        rhs_block.has_terminator = true
        g.completed_blocks.push(rhs_block)

        -- Short-circuit block: store false, branch to join
        let mut short_block = ir_block_new(short_label)
        let mut store_false = ir_inst_new(g.builder.next_id, OP_STORE())
        store_false.store_ptr = ir_val_inst(result_alloca_id)
        store_false.store_val = ir_val_bool(false)
        store_false.has_result = false
        short_block.instructions.push(store_false)
        g.builder.next_id = g.builder.next_id + 1

        short_block.terminator = Box_new(term_br(join_label))
        short_block.has_terminator = true
        g.completed_blocks.push(short_block)

        -- Join block: load the result
        let mut join_block = ir_block_new(join_label)
        let load_id = g.builder.next_id
        let mut load_inst = ir_inst_new(load_id, OP_LOAD())
        load_inst.load_ptr = ir_val_inst(result_alloca_id)
        load_inst.load_type = "bool"
        load_inst.result_type = "bool"
        load_inst.has_result = true
        join_block.instructions.push(load_inst)
        g.builder.next_id = g.builder.next_id + 1

        return expr_result(g, join_block, load_id)
    }

    -- --------------------------------------------------------
    -- SHORT-CIRCUIT LOGICAL OR
    -- lhs || rhs: if lhs is true, result is true; else result is rhs
    -- --------------------------------------------------------
    if op == BINOP_OR() {
        -- Allocate a result slot for the bool
        let result_alloca_id = g.builder.next_id
        let mut result_alloca = ir_inst_new(result_alloca_id, OP_ALLOCA())
        result_alloca.alloc_type = "bool"
        result_alloca.result_type = "ptr(bool)"
        result_alloca.has_result = true
        b.instructions.push(result_alloca)
        g.builder.next_id = g.builder.next_id + 1

        -- Evaluate left operand
        let lhs_result = generate_expr(g, b, *expr.left)
        g = lhs_result.gen
        b = lhs_result.block
        let lhs_id = lhs_result.val_id

        -- Labels for the branches
        let short_label = gen_next_label(g, "or_short")
        g = gen_advance_label(g)
        let rhs_label = gen_next_label(g, "or_rhs")
        g = gen_advance_label(g)
        let join_label = gen_next_label(g, "or_join")
        g = gen_advance_label(g)

        -- Branch: if lhs is true, short-circuit to true; else evaluate rhs
        b.terminator = Box_new(term_br_cond(ir_val_inst(lhs_id), short_label, rhs_label))
        b.has_terminator = true
        g.completed_blocks.push(b)

        -- Short-circuit block: store true, branch to join
        let mut short_block = ir_block_new(short_label)
        let mut store_true = ir_inst_new(g.builder.next_id, OP_STORE())
        store_true.store_ptr = ir_val_inst(result_alloca_id)
        store_true.store_val = ir_val_bool(true)
        store_true.has_result = false
        short_block.instructions.push(store_true)
        g.builder.next_id = g.builder.next_id + 1

        short_block.terminator = Box_new(term_br(join_label))
        short_block.has_terminator = true
        g.completed_blocks.push(short_block)

        -- RHS block: evaluate rhs, store result, branch to join
        let mut rhs_block = ir_block_new(rhs_label)
        let rhs_result = generate_expr(g, rhs_block, *expr.right)
        g = rhs_result.gen
        rhs_block = rhs_result.block
        let rhs_id = rhs_result.val_id

        let mut store_rhs = ir_inst_new(g.builder.next_id, OP_STORE())
        store_rhs.store_ptr = ir_val_inst(result_alloca_id)
        store_rhs.store_val = ir_val_inst(rhs_id)
        store_rhs.has_result = false
        rhs_block.instructions.push(store_rhs)
        g.builder.next_id = g.builder.next_id + 1

        rhs_block.terminator = Box_new(term_br(join_label))
        rhs_block.has_terminator = true
        g.completed_blocks.push(rhs_block)

        -- Join block: load the result
        let mut join_block = ir_block_new(join_label)
        let load_id = g.builder.next_id
        let mut load_inst = ir_inst_new(load_id, OP_LOAD())
        load_inst.load_ptr = ir_val_inst(result_alloca_id)
        load_inst.load_type = "bool"
        load_inst.result_type = "bool"
        load_inst.has_result = true
        join_block.instructions.push(load_inst)
        g.builder.next_id = g.builder.next_id + 1

        return expr_result(g, join_block, load_id)
    }

    -- --------------------------------------------------------
    -- EQUALITY of structs, enums, Options, Results and lists (see
    -- EQUALITY above)
    -- --------------------------------------------------------
    if op == BINOP_EQ() or op == BINOP_NE() {
        let eq_t = eq_operand_type(g, expr)
        if eq_t != "" {
            let seen: List[string] = []
            let unsupported = eq_unsupported(g, eq_t, seen)
            if unsupported != "" {
                let mut what = "cannot compare " + shown_type(g, eq_t) + " with '" + ty_op_text(op) + "'"
                if unsupported != eq_t { what = what + ": it holds a " + shown_type(g, unsupported) }
                g = ir_type_error(g, what, expr.line)
                return expr_result(g, b, 0)
            }
            -- A type with a method `eq` is compared by it, and `!=`
            -- is `not eq` where the type has no `ne`. (A struct's
            -- own `eq` and `ne` are called below, with the other
            -- operators' methods.)
            let own_eq = (g.struct_defs.contains(eq_t) or g.enum_defs.contains(eq_t)) and struct_has_method(g, eq_t, "eq")
            let mut method = ""
            let mut negate = false
            if own_eq {
                if op == BINOP_NE() and struct_has_method(g, eq_t, "ne") == false {
                    method = "eq"
                    negate = true
                } else if g.enum_defs.contains(eq_t) {
                    method = "eq"
                    if op == BINOP_NE() { method = "ne" }
                }
            }
            if eq_by_function(g, eq_t) or method != "" {
                let mut left_arg = *expr.left
                if lhs_done >= 0 {
                    let held = bind_hidden_value(g, b, "%operand.left", lhs_done, map_type_name(eq_t), eq_t)
                    g = held.gen
                    b = held.block
                    left_arg = expr_ident("%operand.left", expr.line, expr.col)
                }
                let mut compared = expr_bool(true, expr.line, expr.col)
                if method != "" {
                    let mut eq_args: List[Expr] = []
                    eq_args.push(*expr.right)
                    compared = expr_method_call(left_arg, method, eq_args, expr.line, expr.col)
                } else {
                    let eq_name = made_function_name("eq", eq_t)
                    g = made_function(g, eq_name, eq_function_source(g, eq_t))
                    let mut eq_args: List[Expr] = []
                    eq_args.push(left_arg)
                    eq_args.push(*expr.right)
                    compared = expr_call(expr_ident(eq_name, expr.line, expr.col), eq_args, expr.line, expr.col)
                    negate = op == BINOP_NE()
                }
                if negate {
                    compared = expr_unary(UNOP_NOT(), compared, expr.line, expr.col)
                }
                let result = generate_expr(g, b, compared)
                if lhs_done >= 0 {
                    return expr_result(unbind_hidden_value(result.gen, "%operand.left"), result.block, result.val_id)
                }
                return result
            }
        }
    }

    -- --------------------------------------------------------
    -- OPERATOR OVERLOADING: check if left operand is a struct
    -- with an impl method for this operator
    -- --------------------------------------------------------
    let mut overload_method = ""
    if op == BINOP_ADD() { overload_method = "add" }
    if op == BINOP_SUB() { overload_method = "sub" }
    if op == BINOP_MUL() { overload_method = "mul" }
    if op == BINOP_DIV() { overload_method = "div" }
    if op == BINOP_EQ() { overload_method = "eq" }
    if op == BINOP_NE() { overload_method = "ne" }
    if op == BINOP_LT() { overload_method = "lt" }
    if op == BINOP_GT() { overload_method = "gt" }
    if op == BINOP_LE() { overload_method = "le" }
    if op == BINOP_GE() { overload_method = "ge" }

    if len(overload_method) > 0 {
        let left_expr = *expr.left
        let mut left_struct_name = ""
        if left_expr.kind == EXPR_IDENTIFIER() {
            if g.var_struct_types.contains(left_expr.name) {
                left_struct_name = g.var_struct_types.get(left_expr.name)
            }
        }
        if left_struct_name == "" {
            -- Any other left operand that is a struct: a field, a call,
            -- another operator's result
            let ltype = infer_expr_type(g, left_expr)
            if g.struct_defs.contains(ltype) {
                left_struct_name = ltype
            }
        }

        if len(left_struct_name) > 0 {
            if struct_has_method(g, left_struct_name, overload_method) {
                -- Call the overloaded operator method: struct_method(left, right)
                let mut op_args: List[Expr] = []
                op_args.push(*expr.right)
                if lhs_done >= 0 {
                    -- The left operand is generated already (a + b + c):
                    -- the method takes that value
                    let held = bind_hidden_value(g, b, "%operand.left", lhs_done, left_struct_name, static_type(g, left_expr))
                    let called = generate_struct_method_call(held.gen, held.block, left_struct_name, expr_ident("%operand.left", expr.line, expr.col), overload_method, op_args)
                    return expr_result(unbind_hidden_value(called.gen, "%operand.left"), called.block, called.val_id)
                }
                return generate_struct_method_call(g, b, left_struct_name, left_expr, overload_method, op_args)
            }
        }
    }

    -- --------------------------------------------------------
    -- EAGER BINARY OPERATORS (arithmetic, comparison, string)
    -- Evaluate both operands first, then emit the operation
    -- --------------------------------------------------------

    -- Evaluate left operand
    let mut lhs_id = lhs_done
    if lhs_done < 0 {
        let lhs_result = generate_expr(g, b, *expr.left)
        g = lhs_result.gen
        b = lhs_result.block
        lhs_id = lhs_result.val_id
    }

    -- Evaluate right operand
    let rhs_result = generate_expr(g, b, *expr.right)
    g = rhs_result.gen
    b = rhs_result.block
    let mut rhs_id = rhs_result.val_id

    -- The operands' types select the operation
    return emit_binary_op(g, b, expr, lhs_id, infer_expr_type(g, *expr.left), rhs_id, infer_expr_type(g, *expr.right))
}

-- The operation of the binary operator `expr` on two values that are
-- generated already, with their types. Not `and` and `or`, which do
-- not evaluate both operands, and not an overloaded operator. A
-- compound assignment (generate_compound_value) gives the value its
-- place holds as the left operand.
fn emit_binary_op(gen: IRGenerator, block: IRBasicBlock, expr: Expr, lhs_val_id: int, lhs_in_type: string, rhs_val_id: int, rhs_in_type: string) -> ExprResult {
    let mut g = gen
    let mut b = block
    let op = expr.op
    let mut lhs_id = lhs_val_id
    let mut rhs_id = rhs_val_id
    let mut lhs_type = lhs_in_type
    let mut rhs_type = rhs_in_type

    -- Integers of different types meet at one type (see binary_int_type)
    let common_t = common_int_type(expr, lhs_type, rhs_type)
    if common_t != "" {
        if lhs_type != common_t {
            g = check_int_literal_fits(g, *expr.left, common_t)
            let lc = emit_ir_cast(g, b, ir_val_inst(lhs_id), lhs_type, common_t)
            g = lc.gen
            b = lc.block
            lhs_id = lc.val_id
            lhs_type = common_t
        }
        if rhs_type != common_t {
            g = check_int_literal_fits(g, *expr.right, common_t)
            let rc = emit_ir_cast(g, b, ir_val_inst(rhs_id), rhs_type, common_t)
            g = rc.gen
            b = rc.block
            rhs_id = rc.val_id
            rhs_type = common_t
        }
    }
    let int_operand_t = if is_integer_type(lhs_type) and lhs_type == rhs_type { lhs_type } else { "" }

    -- Determine if either operand is float or string
    let is_string = lhs_type == "string" or rhs_type == "string"
    let is_float = is_float_type(lhs_type) or is_float_type(rhs_type)

    -- Determine the arithmetic result type
    let arith_type = if is_float { "f64" } else { "i64" }

    -- --------------------------------------------------------
    -- STRING OPERATIONS
    -- --------------------------------------------------------
    if is_string {
        -- String concatenation with +
        if op == BINOP_ADD() {
            let id = g.builder.next_id
            let mut inst = ir_inst_new(id, OP_STRING_CONCAT())
            inst.lhs = ir_val_inst(lhs_id)
            inst.rhs = ir_val_inst(rhs_id)
            inst.result_type = "string"
            inst.has_result = true
            b.instructions.push(inst)
            g.builder.next_id = id + 1
            return expr_result(g, b, id)
        }

        -- String equality ==
        if op == BINOP_EQ() {
            let id = g.builder.next_id
            let mut inst = ir_inst_new(id, OP_STRING_EQ())
            inst.lhs = ir_val_inst(lhs_id)
            inst.rhs = ir_val_inst(rhs_id)
            inst.result_type = "bool"
            inst.has_result = true
            b.instructions.push(inst)
            g.builder.next_id = id + 1
            return expr_result(g, b, id)
        }

        -- String inequality !=
        if op == BINOP_NE() {
            -- First compute string equality
            let eq_id = g.builder.next_id
            let mut eq_inst = ir_inst_new(eq_id, OP_STRING_EQ())
            eq_inst.lhs = ir_val_inst(lhs_id)
            eq_inst.rhs = ir_val_inst(rhs_id)
            eq_inst.result_type = "bool"
            eq_inst.has_result = true
            b.instructions.push(eq_inst)
            g.builder.next_id = eq_id + 1

            -- Then negate it
            let not_id = g.builder.next_id
            let mut not_inst = ir_inst_new(not_id, OP_LOGICAL_NOT())
            not_inst.operand = ir_val_inst(eq_id)
            not_inst.result_type = "bool"
            not_inst.has_result = true
            b.instructions.push(not_inst)
            g.builder.next_id = not_id + 1
            return expr_result(g, b, not_id)
        }

        -- String ordering comparisons (<, <=, >, >=) via dm_string_cmp
        if op == BINOP_LT() or op == BINOP_LE() or op == BINOP_GT() or op == BINOP_GE() {
            -- Call dm_string_cmp(lhs, rhs) -> i64
            let cmp_call_id = g.builder.next_id
            let mut cmp_call = ir_inst_new(cmp_call_id, OP_CALL())
            cmp_call.callee = "dm_string_cmp"
            let mut cmp_args: List[IRValue] = []
            cmp_args.push(ir_val_inst(lhs_id))
            cmp_args.push(ir_val_inst(rhs_id))
            cmp_call.call_args = cmp_args
            cmp_call.result_type = "i64"
            cmp_call.has_result = true
            b.instructions.push(cmp_call)
            g.builder.next_id = cmp_call_id + 1

            -- Compare the cmp result to 0
            let cmp_op = if op == BINOP_LT() { OP_LT() }
            else if op == BINOP_LE() { OP_LE() }
            else if op == BINOP_GT() { OP_GT() }
            else { OP_GE() }

            let result_id = g.builder.next_id
            let mut cmp_inst = ir_inst_new(result_id, cmp_op)
            cmp_inst.lhs = ir_val_inst(cmp_call_id)
            cmp_inst.rhs = ir_val_int(0)
            cmp_inst.result_type = "bool"
            cmp_inst.has_result = true
            b.instructions.push(cmp_inst)
            g.builder.next_id = result_id + 1
            return expr_result(g, b, result_id)
        }
    }

    -- --------------------------------------------------------
    -- ARITHMETIC OPERATORS (+, -, *, /, %)
    -- --------------------------------------------------------
    if op == BINOP_ADD() {
        if is_signed_int_type(lhs_type) and is_signed_int_type(rhs_type) {
            let mut fit_type = ""
            if lhs_type == rhs_type and type_bit_width(lhs_type) < 64 { fit_type = lhs_type }
            return emit_checked_int_arith(g, b, "dm_checked_add_i64", ir_val_inst(lhs_id), lhs_type, ir_val_inst(rhs_id), rhs_type, fit_type)
        }
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_ADD())
        inst.lhs = ir_val_inst(lhs_id)
        inst.rhs = ir_val_inst(rhs_id)
        inst.result_type = arith_type
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return expr_result(g, b, id)
    }

    if op == BINOP_SUB() {
        if is_signed_int_type(lhs_type) and is_signed_int_type(rhs_type) {
            let mut fit_type = ""
            if lhs_type == rhs_type and type_bit_width(lhs_type) < 64 { fit_type = lhs_type }
            return emit_checked_int_arith(g, b, "dm_checked_sub_i64", ir_val_inst(lhs_id), lhs_type, ir_val_inst(rhs_id), rhs_type, fit_type)
        }
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_SUB())
        inst.lhs = ir_val_inst(lhs_id)
        inst.rhs = ir_val_inst(rhs_id)
        inst.result_type = arith_type
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return expr_result(g, b, id)
    }

    if op == BINOP_MUL() {
        if is_signed_int_type(lhs_type) and is_signed_int_type(rhs_type) {
            let mut fit_type = ""
            if lhs_type == rhs_type and type_bit_width(lhs_type) < 64 { fit_type = lhs_type }
            return emit_checked_int_arith(g, b, "dm_checked_mul_i64", ir_val_inst(lhs_id), lhs_type, ir_val_inst(rhs_id), rhs_type, fit_type)
        }
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_MUL())
        inst.lhs = ir_val_inst(lhs_id)
        inst.rhs = ir_val_inst(rhs_id)
        inst.result_type = arith_type
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return expr_result(g, b, id)
    }

    if op == BINOP_DIV() {
        -- Safe division: check for zero divisor before dividing
        -- Compare rhs == 0
        let zero_val = if is_float { ir_val_float(0.0) } else { ir_val_int(0) }
        let zero_check_id = g.builder.next_id
        let mut zero_check = ir_inst_new(zero_check_id, OP_EQ())
        zero_check.lhs = ir_val_inst(rhs_id)
        zero_check.rhs = zero_val
        zero_check.result_type = "bool"
        zero_check.has_result = true
        b.instructions.push(zero_check)
        g.builder.next_id = zero_check_id + 1

        let panic_label = gen_next_label(g, "div_panic")
        g = gen_advance_label(g)
        let ok_label = gen_next_label(g, "div_ok")
        g = gen_advance_label(g)

        -- Branch: if zero, panic; else continue
        b.terminator = Box_new(term_br_cond(ir_val_inst(zero_check_id), panic_label, ok_label))
        b.has_terminator = true
        g.completed_blocks.push(b)

        -- Panic block: call dm_panic, then unreachable
        let mut panic_block = ir_block_new(panic_label)
        let mut panic_inst = ir_inst_new(g.builder.next_id, OP_CALL())
        panic_inst.callee = "dm_panic"
        let mut panic_args: List[IRValue] = []
        panic_args.push(ir_val_string("division by zero"))
        panic_inst.call_args = panic_args
        panic_inst.result_type = "void"
        panic_inst.has_result = false
        panic_block.instructions.push(panic_inst)
        g.builder.next_id = g.builder.next_id + 1

        panic_block.terminator = Box_new(term_unreachable())
        panic_block.has_terminator = true
        g.completed_blocks.push(panic_block)

        -- OK block: perform the division
        let mut ok_block = ir_block_new(ok_label)
        let div_chk = check_div_overflow(g, ok_block, lhs_id, rhs_id, lhs_type)
        g = div_chk.gen
        ok_block = div_chk.block
        let div_id = g.builder.next_id
        let mut div_inst = ir_inst_new(div_id, OP_DIV())
        div_inst.lhs = ir_val_inst(lhs_id)
        div_inst.rhs = ir_val_inst(rhs_id)
        div_inst.result_type = arith_type
        div_inst.operand_type = int_operand_t
        div_inst.has_result = true
        ok_block.instructions.push(div_inst)
        g.builder.next_id = div_id + 1

        return expr_result(g, ok_block, div_id)
    }

    if op == BINOP_MOD() {
        -- Safe modulo: check for zero divisor before computing
        let zero_val = if is_float { ir_val_float(0.0) } else { ir_val_int(0) }
        let zero_check_id = g.builder.next_id
        let mut zero_check = ir_inst_new(zero_check_id, OP_EQ())
        zero_check.lhs = ir_val_inst(rhs_id)
        zero_check.rhs = zero_val
        zero_check.result_type = "bool"
        zero_check.has_result = true
        b.instructions.push(zero_check)
        g.builder.next_id = zero_check_id + 1

        let panic_label = gen_next_label(g, "mod_panic")
        g = gen_advance_label(g)
        let ok_label = gen_next_label(g, "mod_ok")
        g = gen_advance_label(g)

        b.terminator = Box_new(term_br_cond(ir_val_inst(zero_check_id), panic_label, ok_label))
        b.has_terminator = true
        g.completed_blocks.push(b)

        -- Panic block
        let mut panic_block = ir_block_new(panic_label)
        let mut panic_inst = ir_inst_new(g.builder.next_id, OP_CALL())
        panic_inst.callee = "dm_panic"
        let mut panic_args: List[IRValue] = []
        panic_args.push(ir_val_string("modulo by zero"))
        panic_inst.call_args = panic_args
        panic_inst.result_type = "void"
        panic_inst.has_result = false
        panic_block.instructions.push(panic_inst)
        g.builder.next_id = g.builder.next_id + 1

        panic_block.terminator = Box_new(term_unreachable())
        panic_block.has_terminator = true
        g.completed_blocks.push(panic_block)

        -- OK block
        let mut ok_block = ir_block_new(ok_label)
        let mod_chk = check_div_overflow(g, ok_block, lhs_id, rhs_id, lhs_type)
        g = mod_chk.gen
        ok_block = mod_chk.block
        let mod_id = g.builder.next_id
        let mut mod_inst = ir_inst_new(mod_id, OP_MOD())
        mod_inst.lhs = ir_val_inst(lhs_id)
        mod_inst.rhs = ir_val_inst(rhs_id)
        mod_inst.result_type = arith_type
        mod_inst.operand_type = int_operand_t
        mod_inst.has_result = true
        ok_block.instructions.push(mod_inst)
        g.builder.next_id = mod_id + 1

        return expr_result(g, ok_block, mod_id)
    }

    -- --------------------------------------------------------
    -- COMPARISON OPERATORS (==, !=, <, <=, >, >=)
    -- --------------------------------------------------------

    -- Check if this is an enum comparison (need to extract tags first)
    let mut is_enum_cmp = false
    let left_expr = *expr.left
    if left_expr.kind == EXPR_IDENTIFIER() {
        if g.var_enum_types.contains(left_expr.name) {
            is_enum_cmp = true
        }
    }
    if left_expr.kind == EXPR_ENUM_LITERAL() {
        is_enum_cmp = true
    }
    -- Also check right side for enum literal like Color.Red
    let right_expr = *expr.right
    if right_expr.kind == EXPR_ENUM_LITERAL() {
        is_enum_cmp = true
    }
    if right_expr.kind == EXPR_IDENTIFIER() {
        if g.var_enum_types.contains(right_expr.name) {
            is_enum_cmp = true
        }
    }
    -- Any other expressions whose type is an enum
    if is_enum_cmp == false and (op == BINOP_EQ() or op == BINOP_NE()) {
        if g.enum_defs.contains(eq_operand_type(g, expr)) { is_enum_cmp = true }
    }

    if is_enum_cmp and (op == BINOP_EQ() or op == BINOP_NE()) {
        -- Extract tag (field 0) from both enum values
        let lhs_tag_id = g.builder.next_id
        let mut lhs_tag = ir_inst_new(lhs_tag_id, OP_EXTRACT_FIELD())
        lhs_tag.field_base = ir_val_inst(lhs_id)
        lhs_tag.field_index = 0
        lhs_tag.field_type = "i32"
        lhs_tag.result_type = "i32"
        lhs_tag.has_result = true
        b.instructions.push(lhs_tag)
        g.builder.next_id = g.builder.next_id + 1

        let rhs_tag_id = g.builder.next_id
        let mut rhs_tag = ir_inst_new(rhs_tag_id, OP_EXTRACT_FIELD())
        rhs_tag.field_base = ir_val_inst(rhs_id)
        rhs_tag.field_index = 0
        rhs_tag.field_type = "i32"
        rhs_tag.result_type = "i32"
        rhs_tag.has_result = true
        b.instructions.push(rhs_tag)
        g.builder.next_id = g.builder.next_id + 1

        let cmp_op = if op == BINOP_EQ() { OP_EQ() } else { OP_NE() }
        let cmp_id = g.builder.next_id
        let mut cmp_inst = ir_inst_new(cmp_id, cmp_op)
        cmp_inst.lhs = ir_val_inst(lhs_tag_id)
        cmp_inst.rhs = ir_val_inst(rhs_tag_id)
        cmp_inst.result_type = "bool"
        cmp_inst.has_result = true
        b.instructions.push(cmp_inst)
        g.builder.next_id = cmp_id + 1
        return expr_result(g, b, cmp_id)
    }

    if op == BINOP_EQ() {
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_EQ())
        inst.lhs = ir_val_inst(lhs_id)
        inst.rhs = ir_val_inst(rhs_id)
        inst.result_type = "bool"
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return expr_result(g, b, id)
    }

    if op == BINOP_NE() {
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_NE())
        inst.lhs = ir_val_inst(lhs_id)
        inst.rhs = ir_val_inst(rhs_id)
        inst.result_type = "bool"
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return expr_result(g, b, id)
    }

    if op == BINOP_LT() {
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_LT())
        inst.lhs = ir_val_inst(lhs_id)
        inst.rhs = ir_val_inst(rhs_id)
        inst.result_type = "bool"
        inst.operand_type = int_operand_t
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return expr_result(g, b, id)
    }

    if op == BINOP_LE() {
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_LE())
        inst.lhs = ir_val_inst(lhs_id)
        inst.rhs = ir_val_inst(rhs_id)
        inst.result_type = "bool"
        inst.operand_type = int_operand_t
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return expr_result(g, b, id)
    }

    if op == BINOP_GT() {
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_GT())
        inst.lhs = ir_val_inst(lhs_id)
        inst.rhs = ir_val_inst(rhs_id)
        inst.result_type = "bool"
        inst.operand_type = int_operand_t
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return expr_result(g, b, id)
    }

    if op == BINOP_GE() {
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_GE())
        inst.lhs = ir_val_inst(lhs_id)
        inst.rhs = ir_val_inst(rhs_id)
        inst.result_type = "bool"
        inst.operand_type = int_operand_t
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return expr_result(g, b, id)
    }

    -- --------------------------------------------------------
    -- BITWISE OPERATORS (&, |, ^, <<, >>)
    -- --------------------------------------------------------
    if op == BINOP_BIT_AND() {
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_BIT_AND())
        inst.lhs = ir_val_inst(lhs_id)
        inst.rhs = ir_val_inst(rhs_id)
        inst.result_type = arith_type
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return expr_result(g, b, id)
    }

    if op == BINOP_BIT_OR() {
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_BIT_OR())
        inst.lhs = ir_val_inst(lhs_id)
        inst.rhs = ir_val_inst(rhs_id)
        inst.result_type = arith_type
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return expr_result(g, b, id)
    }

    if op == BINOP_BIT_XOR() {
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_BIT_XOR())
        inst.lhs = ir_val_inst(lhs_id)
        inst.rhs = ir_val_inst(rhs_id)
        inst.result_type = arith_type
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return expr_result(g, b, id)
    }

    if op == BINOP_SHL() {
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_SHL())
        inst.lhs = ir_val_inst(lhs_id)
        inst.rhs = ir_val_inst(rhs_id)
        inst.result_type = arith_type
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return expr_result(g, b, id)
    }

    if op == BINOP_SHR() {
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_SHR())
        inst.lhs = ir_val_inst(lhs_id)
        inst.rhs = ir_val_inst(rhs_id)
        inst.result_type = arith_type
        -- An unsigned integer shifts in zeros, a signed one its sign
        inst.operand_type = int_operand_t
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return expr_result(g, b, id)
    }

    g = ir_type_error(g, "unsupported binary operator", expr.line)
    return expr_result(g, b, lhs_id)
}

-- ============================================================
-- UNARY EXPRESSION IR GENERATION
-- Handles negation (-) and logical not (!)
-- ============================================================

fn generate_unary(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block

    -- Evaluate the operand expression
    let operand_result = generate_expr(g, b, *expr.operand)
    g = operand_result.gen
    b = operand_result.block
    let operand_id = operand_result.val_id

    if expr.op == UNOP_NEG() {
        -- Negate: emit OP_NEG with operand's type
        let operand_type = infer_expr_type(g, *expr.operand)
        -- Checked negation for signed ints: -INT_MIN overflows
        if is_signed_int_type(operand_type) {
            let mut fit_type = ""
            if type_bit_width(operand_type) < 64 { fit_type = operand_type }
            return emit_checked_int_arith(g, b, "dm_checked_sub_i64", ir_val_int(0), "i64", ir_val_inst(operand_id), operand_type, fit_type)
        }
        let result_type = if is_float_type(operand_type) { "f64" } else { "i64" }

        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_NEG())
        inst.operand = ir_val_inst(operand_id)
        inst.result_type = result_type
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return expr_result(g, b, id)
    }

    if expr.op == UNOP_NOT() {
        -- Logical NOT: emit OP_LOGICAL_NOT, result is always bool
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_LOGICAL_NOT())
        inst.operand = ir_val_inst(operand_id)
        inst.result_type = "bool"
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return expr_result(g, b, id)
    }

    if expr.op == UNOP_BIT_NOT() {
        -- Bitwise NOT: emit OP_BIT_XOR with all-ones mask (XOR with -1)
        -- ~x is equivalent to x ^ (-1) for two's complement integers
        let operand_type = infer_expr_type(g, *expr.operand)
        let result_type = if is_float_type(operand_type) { "f64" } else { "i64" }

        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_BIT_XOR())
        inst.lhs = ir_val_inst(operand_id)
        inst.rhs = ir_val_int(-1)
        inst.result_type = result_type
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return expr_result(g, b, id)
    }

    if expr.op == UNOP_DEREF() {
        -- Unsafe fence: references of extern/cast provenance (including
        -- &T parameters) need an unsafe block to dereference. Box derefs
        -- stay safe (runtime null check below).
        if g.unsafe_depth == 0 and expr_is_tainted_ref(g, *expr.operand) {
            eprintln(error_at(gen.ir_mod.files, "dereference of a reference from an extern call or cast requires unsafe block", expr.line))
            exit(1)
        }
        -- Dereference Box[T]: load the struct value from the pointer
        -- Try to determine the Box inner type from tracked info
        let mut inner_type = "i64"

        -- Check if operand is a variable with known Box inner type
        let operand_expr = *expr.operand
        if operand_expr.kind == EXPR_IDENTIFIER() {
            if g.box_inner_types.contains(operand_expr.name) {
                inner_type = g.box_inner_types.get(operand_expr.name)
            }
        }

        -- Check if operand was a field access that produced a Box value
        let inst_key = "_inst_" + int_to_string(operand_id)
        if g.box_inner_types.contains(inst_key) {
            inner_type = g.box_inner_types.get(inst_key)
        }

        -- Otherwise use the operand's source type (a field, a call, ...)
        if inner_type == "i64" {
            let operand_src = static_type(g, operand_expr)
            if starts_with(operand_src, "Box[") {
                inner_type = extract_inner_type(operand_src, "Box[")
            } else {
                g = ir_type_error(g, "cannot determine the type of the box being dereferenced", expr.line)
            }
        }

        -- Map the inner type to IR type
        let load_type = map_type_name(inner_type)

        -- Null check before dereferencing the pointer
        let chk = check_box_not_null(g, b, operand_id)
        g = chk.gen
        b = chk.block

        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_LOAD())
        inst.load_ptr = ir_val_inst(operand_id)
        inst.load_type = load_type
        inst.result_type = load_type
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1

        -- If inner type is a struct, track the result for subsequent field access
        if g.struct_defs.contains(inner_type) {
            let result_var = "_deref_" + int_to_string(id)
            g.var_struct_types.insert(result_var, inner_type)
        }

        return expr_result(g, b, id)
    }

    -- Unknown unary operator, return operand unchanged
    return expr_result(g, b, operand_id)
}

-- ============================================================
-- CAST EXPRESSION IR GENERATION
-- Handles explicit type casts via `expr as Type`
-- ============================================================

fn generate_cast_expr(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block

    -- Evaluate the operand expression
    let operand_result = generate_expr(g, b, *expr.operand)
    g = operand_result.gen
    b = operand_result.block
    let operand_id = operand_result.val_id

    -- x as dyn Trait: the operand is in the dyn's variant already
    -- (see generate_expr)
    if starts_with(expr.cast_type, DYN_PREFIX()) { return operand_result }

    -- Determine source type by inference
    let from_type = infer_expr_type(g, *expr.operand)

    -- Determine target type from the cast annotation, mapped to IR names
    let to_type = map_type_name(expr.cast_type)

    -- Compile-time cast legality (Stage 0 Phase 2 cast matrix)
    check_cast_legal(g, *expr.operand, from_type, expr.cast_type, expr.cast_is_ref, expr.line)

    -- If the types are the same, no cast needed
    if from_type == to_type {
        return expr_result(g, b, operand_id)
    }

    -- Narrowing integer casts get a runtime range check (Stage 0 matrix);
    -- float<->int and widening casts keep plain conversion semantics.
    if is_integer_type(from_type) and is_integer_type(to_type) and int_cast_fits(from_type, to_type) == false {
        return emit_checked_cast(g, b, operand_id, from_type, to_type)
    }

    -- Emit OP_CAST instruction
    let id = g.builder.next_id
    let mut inst = ir_inst_new(id, OP_CAST())
    inst.cast_val = ir_val_inst(operand_id)
    inst.cast_from = from_type
    inst.cast_to = to_type
    inst.result_type = to_type
    inst.has_result = true
    b.instructions.push(inst)
    g.builder.next_id = id + 1

    return expr_result(g, b, id)
}

-- ============================================================
-- FUNCTION CALL IR GENERATION
-- Dispatches function calls to builtins, special constructors,
-- generic monomorphization, indirect (lambda) calls, and
-- regular user-defined function calls.
-- ============================================================

fn generate_function_call(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block

    -- A call of a value: a variable that holds a function, or any
    -- expression that is not a name
    let callee_expr = *expr.callee
    let called_type = called_value_type(g, callee_expr)
    if called_type != "" {
        return generate_value_call(g, b, callee_expr, called_type, expr.args, expr.line)
    }
    if callee_expr.kind != EXPR_IDENTIFIER() {
        g = ir_type_error(g, "this expression is not a function, so it cannot be called", expr.line)
        return expr_result(g, b, 0)
    }
    let fn_name = callee_expr.name

    -- Unsafe fence: calling an `extern fn` requires an unsafe block
    check_extern_fence(g, fn_name, expr.line)

    -- Raw memory primitives (load_T, store_T, addr_of, size_of, ...)
    if is_raw_builtin(fn_name) {
        return generate_raw_builtin(g, b, fn_name, expr)
    }

    -- --------------------------------------------------------
    -- Special case dispatch (in priority order)
    -- --------------------------------------------------------

    -- SIMD builtins (simd_splat_*, simd_set_*, simd_add, etc.)
    if is_simd_builtin(fn_name) {
        return generate_simd_builtin(g, b, fn_name, expr.args)
    }

    -- assert(cond)
    if fn_name == "assert" {
        return generate_assert_call(g, b, expr.args)
    }

    -- assert_eq(a, b)
    if fn_name == "assert_eq" {
        return generate_assert_eq_call(g, b, expr.args)
    }

    -- panic(msg)
    if fn_name == "panic" {
        return generate_panic_call(g, b, expr.args)
    }

    -- Box_new(value)
    if fn_name == "Box_new" {
        return generate_box_new_call(g, b, expr)
    }

    -- Box_null()
    if fn_name == "Box_null" {
        return generate_box_null_call(g, b)
    }

    -- string_split(s, delim) -> List[string]
    if fn_name == "string_split" {
        return generate_string_split_call(g, b, expr.args)
    }

    -- Some(value) -> Option with has_value=1
    if fn_name == "Some" {
        return generate_some_call(g, b, expr)
    }

    -- Ok(value) -> Result with tag=0
    if fn_name == "Ok" {
        return generate_ok_call(g, b, expr)
    }

    -- Err(value) -> Result with tag=1
    if fn_name == "Err" {
        return generate_err_call(g, b, expr)
    }

    -- Map_new() takes its type from where the map goes (a typed let,
    -- an assignment, a struct field, a return); see map_ctor_as
    if fn_name == "Map_new" {
        g = ir_type_error(g, "cannot tell which Map type Map_new() creates here; give it one, e.g. let m: Map[string, int] = Map_new()", expr.line)
        return expr_result(g, b, 0)
    }

    -- byte_at(s, i): the byte at index i of s, 0 to 255
    if fn_name == "byte_at" and expr.args.len() == 2 {
        return generate_byte_at(g, b, expr.args[0], expr.args[1])
    }

    -- hash_key(k): the hash Map[K, V] uses for a string or integer key
    if fn_name == "hash_key" and expr.args.len() == 1 {
        let key_type = infer_expr_type(g, expr.args[0])
        let hash_fn = if key_type == "string" { "rt_map_hash_string" } else { "rt_map_hash_int" }
        if key_type != "string" and is_integer_type(key_type) == false {
            g = ir_type_error(g, "hash_key() takes a string or integer key, not '" + key_type + "'", expr.line)
        }
        let mut hash_args: List[Expr] = []
        hash_args.push(expr.args[0])
        return generate_expr(g, b, expr_call(expr_ident(hash_fn, expr.line, expr.col), hash_args, expr.line, expr.col))
    }

    -- len() of a number or a bool is an error
    if fn_name == "len" and expr.args.len() == 1 {
        let len_arg_type = static_type(g, expr.args[0])
        let len_arg_kind = basic_type_kind(len_arg_type)
        if len_arg_kind == "number" or len_arg_kind == "bool" {
            g = ir_type_error(g, "len() takes a string, a list, a map or an array, not " + len_arg_type, expr.line)
            return expr_result(g, b, 0)
        }
    }

    -- len(m) on a map is m.len()
    if fn_name == "len" and expr.args.len() == 1 {
        if is_map_type(g, static_type(g, expr.args[0])) {
            let no_args: List[Expr] = []
            return generate_expr(g, b, expr_method_call(expr.args[0], "len", no_args, expr.line, expr.col))
        }
    }

    -- Explicit generic type arguments: fn_name[T](args)
    if expr.generic_args.len() > 0 {
        return generate_generic_call(g, b, expr)
    }

    -- Implicit generic: check if callee is registered as a generic function
    if g.generic_fn_decls.contains(fn_name) {
        return generate_generic_call(g, b, expr)
    }


    -- len() on a list variable: dispatch to typed list_len runtime function
    if fn_name == "len" and expr.args.len() > 0 {
        let first_arg = expr.args[0]
        if first_arg.kind == EXPR_IDENTIFIER() {
            let arg_name = first_arg.name
            if g.list_elem_kinds.contains(arg_name) {
                let ek = g.list_elem_kinds.get(arg_name)
                let list_ptr = g.variable_map.get(arg_name)

                let len_fn = if ek == LIST_ELEM_INT() { "dm_list_int64_len" }
                else if ek == LIST_ELEM_FLOAT() { "dm_list_double_len" }
                else if ek == LIST_ELEM_STRING() { "dm_list_string_len" }
                else { "dm_list_generic_len" }

                let id = g.builder.next_id
                let mut inst = ir_inst_new(id, OP_CALL())
                inst.callee = len_fn
                let mut call_args: List[IRValue] = []
                call_args.push(ir_val_inst(list_ptr))
                inst.call_args = call_args
                inst.result_type = "i64"
                inst.has_result = true
                b.instructions.push(inst)
                g.builder.next_id = g.builder.next_id + 1
                return expr_result(g, b, id)
            }
        }
    }

    -- Builtin function (println, len, int_to_string, etc.)
    if is_builtin_fn(fn_name) {
        -- A thread runs a function value that takes nothing: the
        -- runtime calls it with its closure (rt_thread_spawn)
        if fn_name == "thread_spawn" {
            if expr.args.len() != 1 {
                g = ir_type_error(g, "thread_spawn() takes 1 argument, not " + int_to_string(expr.args.len()), expr.line)
                return expr_result(g, b, 0)
            }
            if starts_with(static_type(g, expr.args[0]), "fn()") == false {
                g = ir_type_error(g, "thread_spawn() takes a function that takes no arguments", expr.line)
                return expr_result(g, b, 0)
            }
        }
        if fn_name == "run_command" or fn_name == "run_command_io" {
            return generate_run_command_call(g, b, expr)
        }
        return generate_builtin_call(g, b, fn_name, expr.args)
    }

    -- Check if function is defined
    if g.known_functions.contains(fn_name) == false and is_builtin_fn(fn_name) == false and g.generic_fn_decls.contains(fn_name) == false and g.user_extern_fns.contains(fn_name) == false and g.method_struct_map.contains(fn_name) == false and g.static_fns.contains(fn_name) == false {
        eprintln(error_at(gen.ir_mod.files, "undefined function '" + fn_name + "'", expr.line))
        exit(1)
    }

    -- --------------------------------------------------------
    -- Default: regular user-defined function call or extern call
    -- --------------------------------------------------------
    return generate_normal_call(g, b, fn_name, expr.args)
}

-- ============================================================
-- NORMAL (USER-DEFINED / EXTERN) FUNCTION CALL
-- Evaluates all argument expressions, then emits OP_CALL.
-- Handles mut param pass-by-reference and extern functions.
-- ============================================================

fn generate_normal_call(gen: IRGenerator, block: IRBasicBlock, fn_name: string, args: List[Expr]) -> ExprResult {
    let mut g = gen
    let mut b = block

    -- Check if this function has mut params (pass-by-reference)
    let has_mut_params = g.mut_param_fns.contains(fn_name)
    let mut_flags_str = if has_mut_params {
        g.mut_param_fns.get(fn_name)
    } else {
        ""
    }

    -- Split mut flags into a list for per-argument checking
    let mut mut_flags_list: List[string] = []
    if has_mut_params {
        mut_flags_list = string_split(mut_flags_str, "|")
    }

    -- The parameters' source types, for the type-mismatch check
    let mut param_types: List[string] = []
    if g.fn_src_param_types.contains(fn_name) {
        param_types = string_split(g.fn_src_param_types.get(fn_name), "|")
    }

    -- Generate all argument expressions
    let mut call_args: List[IRValue] = []
    let mut i = 0
    while i < args.len() {
        if i < param_types.len() {
            g = check_basic_type(g, param_types[i], args[i], "argument " + int_to_string(i + 1) + " of '" + fn_name + "'")
        }
        -- Check if this arg position is a mut parameter
        let is_mut_arg = if i < mut_flags_list.len() {
            mut_flags_list[i] == "1"
        } else {
            false
        }

        let mut arg_addr = addr_fail(g, b)
        if is_mut_arg {
            -- A mut parameter takes the argument's address: a variable,
            -- a mut parameter, a field, a list element or a boxed value
            arg_addr = generate_addr(g, b, args[i])
            g = arg_addr.gen
            b = arg_addr.block
        }
        if arg_addr.ok {
            call_args.push(arg_addr.ptr)
        } else if is_mut_arg {
            -- A mut parameter takes a pointer: spill a non-variable argument
            -- (e.g. a struct literal) to a temporary and pass its address
            let arg_type = infer_expr_type(g, args[i])
            let arg_result = generate_expr(g, b, args[i])
            g = arg_result.gen
            b = arg_result.block
            let tmp_id = g.builder.next_id
            let mut tmp_inst = ir_inst_new(tmp_id, OP_ALLOCA())
            tmp_inst.alloc_type = arg_type
            tmp_inst.result_type = "ptr(" + arg_type + ")"
            tmp_inst.has_result = true
            b.instructions.push(tmp_inst)
            g.builder.next_id = tmp_id + 1
            let mut st_inst = ir_inst_new(g.builder.next_id, OP_STORE())
            st_inst.store_ptr = ir_val_inst(tmp_id)
            st_inst.store_val = ir_val_inst(arg_result.val_id)
            b.instructions.push(st_inst)
            g.builder.next_id = g.builder.next_id + 1
            call_args.push(ir_val_inst(tmp_id))
        } else if i < param_types.len() and starts_with(param_types[i], "fn(") and g.all_extern_fns.contains(fn_name) {
            -- A C function takes a function as its address
            let c_function = generate_c_function_arg(g, b, args[i], fn_name)
            g = c_function.gen
            b = c_function.block
            call_args.push(ir_val_inst(c_function.val_id))
        } else {
            let mut arg_result = generate_expr(g, b, args[i])
            if i < param_types.len() {
                -- An integer becomes the parameter's integer type
                arg_result = convert_int_to_place(arg_result.gen, arg_result.block, arg_result.val_id, args[i], param_types[i], "argument " + int_to_string(i + 1) + " of '" + fn_name + "'")
            }
            g = arg_result.gen
            b = arg_result.block
            call_args.push(ir_val_inst(arg_result.val_id))
        }
        i = i + 1
    }

    -- Determine the callee name for the call instruction
    -- For extern functions, use the function name directly
    -- For user functions, also use the function name directly
    let callee_name = fn_name

    -- Determine return type by looking up registered functions in the module
    let ret_type = infer_call_return_type(g, callee_name)
    let has_result = ret_type != "void"

    -- Emit the OP_CALL instruction
    let id = g.builder.next_id
    let mut inst = ir_inst_new(id, OP_CALL())
    inst.callee = callee_name
    inst.call_args = call_args
    inst.result_type = ret_type
    inst.has_result = has_result
    b.instructions.push(inst)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, b, id)
}

-- ============================================================
-- INFER CALL RETURN TYPE
-- Looks up the return type of a function by name in the module.
-- Falls back to "i64" for unknown functions.
-- ============================================================

fn infer_call_return_type(gen: IRGenerator, fn_name: string) -> string {
    -- Check builtins first
    if is_builtin_fn(fn_name) {
        return builtin_return_type(fn_name)
    }

    -- Search module functions for the declared return type
    let mut i = 0
    while i < gen.ir_mod.functions.len() {
        let f = gen.ir_mod.functions[i]
        if f.name == fn_name {
            return f.return_type
        }
        i = i + 1
    }

    -- Declared later in the source: use the signature registered up front
    if gen.fn_return_types.contains(fn_name) {
        return gen.fn_return_types.get(fn_name)
    }

    -- Unknown function: assume i64 return
    return "i64"
}

fn generate_some_call(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block
    let args = expr.args

    if args.len() < 1 {
        return expr_result(g, b, 0)
    }

    -- Generate the payload value
    let val_result = generate_expr(g, b, args[0])
    g = val_result.gen
    b = val_result.block

    -- The Option[T] the checker found for the place the value goes to;
    -- without it, the function's return type, or Option of the argument's type
    let mut opt_type = checked_ir_type(g, expr)
    if starts_with(opt_type, "Option[") == false {
        opt_type = g.current_return_type
    }
    if starts_with(opt_type, "Option[") == false {
        -- current_return_type isn't an Option (e.g., we're in main/void function).
        -- Infer Option type from the argument expression type.
        let arg_type = infer_expr_type(g, args[0])
        opt_type = "Option[" + arg_type + "]"
    }
    -- An integer becomes the Option's integer type
    let some_val = convert_int_to_place(g, b, val_result.val_id, args[0], extract_inner_type(opt_type, "Option["), "the value of 'Some'")
    g = some_val.gen
    b = some_val.block

    -- Build the Option struct: { has_value: 1, value: payload }
    -- Use undef as the base (not alloca), since insertvalue works on values not pointers

    -- Store has_value = 1 (field index 0)
    let insert1_id = g.builder.next_id
    let mut insert1 = ir_inst_new(insert1_id, OP_INSERT_FIELD())
    insert1.field_base = ir_val_undef()
    insert1.field_value = ir_val_int(1)
    insert1.field_index = 0
    insert1.result_type = opt_type
    insert1.has_result = true
    b.instructions.push(insert1)
    g.builder.next_id = g.builder.next_id + 1

    -- Store value = payload (field index 1)
    let insert2_id = g.builder.next_id
    let mut insert2 = ir_inst_new(insert2_id, OP_INSERT_FIELD())
    insert2.field_base = ir_val_inst(insert1_id)
    insert2.field_value = ir_val_inst(some_val.val_id)
    insert2.field_index = 1
    insert2.result_type = opt_type
    insert2.has_result = true
    b.instructions.push(insert2)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, b, insert2_id)
}

-- ============================================================
-- OK CALL: Result constructor (success)
-- Ok(value) -> Result { tag: 0, ok_val: payload, err_val: undef }
-- ============================================================

fn generate_ok_call(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block
    let args = expr.args

    if args.len() < 1 {
        return expr_result(g, b, 0)
    }

    -- Generate the payload value
    let val_result = generate_expr(g, b, args[0])
    g = val_result.gen
    b = val_result.block

    -- The Result[T, E] the checker found for the place the value goes
    -- to; without it, the function's return type
    let mut res_type = checked_ir_type(g, expr)
    if starts_with(res_type, "Result[") == false {
        res_type = g.current_return_type
    }
    -- An integer becomes the Result's integer type
    let mut ok_val = val_result
    if starts_with(res_type, "Result[") {
        let res_args = split_type_args(extract_inner_type(res_type, "Result["))
        if res_args.len() > 0 {
            ok_val = convert_int_to_place(g, b, val_result.val_id, args[0], res_args[0], "the value of 'Ok'")
            g = ok_val.gen
            b = ok_val.block
        }
    }

    -- Build the Result struct: { tag: 0, ok_val: payload, err_val: undef }
    -- Use undef as the base (not alloca), since insertvalue works on values not pointers

    -- tag = 0 (Ok) at field index 0
    let insert_tag_id = g.builder.next_id
    let mut insert_tag = ir_inst_new(insert_tag_id, OP_INSERT_FIELD())
    insert_tag.field_base = ir_val_undef()
    insert_tag.field_value = ir_val_int(0)
    insert_tag.field_index = 0
    insert_tag.result_type = res_type
    insert_tag.has_result = true
    b.instructions.push(insert_tag)
    g.builder.next_id = g.builder.next_id + 1

    -- ok_val = payload at field index 1
    let insert_ok_id = g.builder.next_id
    let mut insert_ok = ir_inst_new(insert_ok_id, OP_INSERT_FIELD())
    insert_ok.field_base = ir_val_inst(insert_tag_id)
    insert_ok.field_value = ir_val_inst(ok_val.val_id)
    insert_ok.field_index = 1
    insert_ok.result_type = res_type
    insert_ok.has_result = true
    b.instructions.push(insert_ok)
    g.builder.next_id = g.builder.next_id + 1

    -- err_val = undef at field index 2
    let insert_err_id = g.builder.next_id
    let mut insert_err = ir_inst_new(insert_err_id, OP_INSERT_FIELD())
    insert_err.field_base = ir_val_inst(insert_ok_id)
    insert_err.field_value = ir_val_undef()
    insert_err.field_index = 2
    insert_err.result_type = res_type
    insert_err.has_result = true
    b.instructions.push(insert_err)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, b, insert_err_id)
}

-- ============================================================
-- ERR CALL: Result constructor (error)
-- Err(value) -> Result { tag: 1, ok_val: undef, err_val: payload }
-- ============================================================

fn generate_err_call(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block
    let args = expr.args

    if args.len() < 1 {
        return expr_result(g, b, 0)
    }

    -- Generate the error payload value
    let val_result = generate_expr(g, b, args[0])
    g = val_result.gen
    b = val_result.block

    -- The Result[T, E] the checker found for the place the value goes
    -- to; without it, the function's return type
    let mut res_type = checked_ir_type(g, expr)
    if starts_with(res_type, "Result[") == false {
        res_type = g.current_return_type
    }

    -- An integer becomes the Result's integer type
    let mut err_val = val_result
    if starts_with(res_type, "Result[") {
        let res_args = split_type_args(extract_inner_type(res_type, "Result["))
        if res_args.len() > 1 {
            err_val = convert_int_to_place(g, b, val_result.val_id, args[0], res_args[1], "the value of 'Err'")
            g = err_val.gen
            b = err_val.block
        }
    }

    -- Build the Result struct: { tag: 1, ok_val: undef, err_val: payload }
    -- Use undef as the base (not alloca), since insertvalue works on values not pointers

    -- tag = 1 (Err) at field index 0
    let insert_tag_id = g.builder.next_id
    let mut insert_tag = ir_inst_new(insert_tag_id, OP_INSERT_FIELD())
    insert_tag.field_base = ir_val_undef()
    insert_tag.field_value = ir_val_int(1)
    insert_tag.field_index = 0
    insert_tag.result_type = res_type
    insert_tag.has_result = true
    b.instructions.push(insert_tag)
    g.builder.next_id = g.builder.next_id + 1

    -- ok_val = undef at field index 1
    let insert_ok_id = g.builder.next_id
    let mut insert_ok = ir_inst_new(insert_ok_id, OP_INSERT_FIELD())
    insert_ok.field_base = ir_val_inst(insert_tag_id)
    insert_ok.field_value = ir_val_undef()
    insert_ok.field_index = 1
    insert_ok.result_type = res_type
    insert_ok.has_result = true
    b.instructions.push(insert_ok)
    g.builder.next_id = g.builder.next_id + 1

    -- err_val = payload at field index 2
    let insert_err_id = g.builder.next_id
    let mut insert_err = ir_inst_new(insert_err_id, OP_INSERT_FIELD())
    insert_err.field_base = ir_val_inst(insert_ok_id)
    insert_err.field_value = ir_val_inst(err_val.val_id)
    insert_err.field_index = 2
    insert_err.result_type = res_type
    insert_err.has_result = true
    b.instructions.push(insert_err)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, b, insert_err_id)
}

-- ============================================================
-- GENERIC FUNCTION CALL
-- Builds a monomorphized name, generates the specialized copy
-- if not already done, then calls it normally.
-- ============================================================

fn generate_generic_call(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block

    let callee_expr = *expr.callee
    let fn_name = callee_expr.name

    -- Build monomorphized name: fn_name + "_" + type_args joined by "_"
    let mut mangled_name = fn_name
    let mut type_args = expr.generic_args

    -- Type arguments that are not written out are those the checker
    -- found from the arguments
    if type_args.len() == 0 {
        type_args = checked_type_args(g, expr)
    }

    if type_args.len() == 0 {
        -- The checker found none (the call is in the body of a generic
        -- function, or made during code generation): type parameter i
        -- takes the type of argument i
        if g.generic_fn_decls.contains(fn_name) {
            let decl_idx: int = g.generic_fn_decls.get(fn_name)
            if decl_idx >= 0 and decl_idx < g.declarations.len() {
                let decl = g.declarations[decl_idx]
                if decl.kind == DECL_FUNCTION() {
                    let fd = *decl.func_decl
                    let mut inferred: List[string] = []
                    let mut pi = 0
                    while pi < fd.generic_params.len() {
                        -- Try to infer from corresponding argument type
                        let inferred_type = if pi < expr.args.len() {
                            infer_arg_type(g, expr.args[pi])
                        } else {
                            "i64"
                        }
                        inferred.push(inferred_type)
                        pi = pi + 1
                    }
                    type_args = inferred
                }
            }
        }
    }

    -- Build the mangled name from type arguments
    let mut ti = 0
    while ti < type_args.len() {
        mangled_name = mangled_name + "_" + mangle_type_arg(canon_type(g, type_args[ti]))
        ti = ti + 1
    }

    -- Generate the monomorphized function if not already done
    if g.mono_generated.contains(mangled_name) == false {
        g.mono_generated.insert(mangled_name, true)

        if g.generic_fn_decls.contains(fn_name) {
            let decl_idx: int = g.generic_fn_decls.get(fn_name)
            if decl_idx >= 0 and decl_idx < g.declarations.len() {
                let decl = g.declarations[decl_idx]
                if decl.kind == DECL_FUNCTION() {
                    let fd = *decl.func_decl

                    -- Save current generator state
                    let saved_variable_map = g.variable_map
                    let saved_variable_types = g.variable_types
                    let saved_list_elem_kinds = g.list_elem_kinds
                    let saved_list_elem_types = g.list_elem_types
                    let saved_return_type = g.current_return_type
                    let saved_type_subs = g.type_substitutions
                    let saved_completed_blocks = g.completed_blocks
                    let saved_next_id = g.builder.next_id
                    let saved_unsafe_depth = g.unsafe_depth
                    let saved_region_depth = g.region_depth
                    let saved_tainted_vars = g.tainted_vars
                    let saved_ref_vars = g.ref_vars
                    let saved_region_born_vars = g.region_born_vars
                    let saved_declared_vars = g.declared_vars
                    let saved_region_marks = g.region_marks

                    -- Set up fresh maps for the monomorphized function
                    g.variable_map = Map_new()
                    g.variable_types = Map_new()

                    -- Set up type substitutions: map generic param names to concrete types
                    g.type_substitutions = Map_new()
                    let mut si = 0
                    while si < fd.generic_params.len() and si < type_args.len() {
                        g.type_substitutions.insert(fd.generic_params[si], type_args[si])
                        si = si + 1
                    }

                    -- Declare and generate the monomorphized function body
                    -- Create a modified FunctionDecl with the mangled name and no generic params
                    let mut mono_fd = fd
                    let empty_gp: List[string] = []
                    mono_fd.generic_params = empty_gp

                    -- Replace type parameter references in param types and return type
                    let mut mono_params: List[FuncParam] = []
                    let mut pi = 0
                    while pi < fd.params.len() {
                        let p = fd.params[pi]
                        let resolved_type = resolve_type_substitution(g, p.type_name)
                        let mut mp = func_param_new(p.name, resolved_type)
                        mp.is_mut = p.is_mut
                        mp.is_ref = p.is_ref
                        mono_params.push(mp)
                        pi = pi + 1
                    }
                    mono_fd.params = mono_params

                    let resolved_ret = resolve_type_substitution(g, fd.return_type)
                    mono_fd.return_type = resolved_ret

                    g = declare_function(g, mono_fd, mangled_name)
                    let no_outer: List[string] = []
                    let instance_types = instance_types_begin(g, fd, "", no_outer, type_args, instance_text(g, fn_name, type_args))
                    g = generate_function_body(instance_types.gen, mono_fd, mangled_name)
                    g = instance_types_end(g, instance_types)

                    -- Restore previous generator state
                    g.variable_map = saved_variable_map
                    g.variable_types = saved_variable_types
                    g.list_elem_kinds = saved_list_elem_kinds
                    g.list_elem_types = saved_list_elem_types
                    g.current_return_type = saved_return_type
                    g.type_substitutions = saved_type_subs
                    g.completed_blocks = saved_completed_blocks
                    g.builder.next_id = saved_next_id
                    g.unsafe_depth = saved_unsafe_depth
                    g.region_depth = saved_region_depth
                    g.tainted_vars = saved_tainted_vars
                    g.ref_vars = saved_ref_vars
                    g.region_born_vars = saved_region_born_vars
                    g.declared_vars = saved_declared_vars
                    g.region_marks = saved_region_marks
                }
            }
        }
    }

    -- Generate the call to the monomorphized function
    let mut call_args: List[IRValue] = []
    let mut ai = 0
    while ai < expr.args.len() {
        let arg_result = generate_expr(g, b, expr.args[ai])
        g = arg_result.gen
        b = arg_result.block
        call_args.push(ir_val_inst(arg_result.val_id))
        ai = ai + 1
    }

    let ret_type = infer_call_return_type(g, mangled_name)
    let has_result = ret_type != "void"

    let id = g.builder.next_id
    let mut inst = ir_inst_new(id, OP_CALL())
    inst.callee = mangled_name
    inst.call_args = call_args
    inst.result_type = ret_type
    inst.has_result = has_result
    b.instructions.push(inst)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, b, id)
}

-- ============================================================
-- RESOLVE TYPE SUBSTITUTION
-- Replaces type parameter names with concrete types from
-- the current type_substitutions map.
-- ============================================================

-- Helper: join type names with "_" for mangled names

fn resolve_type_substitution(gen: IRGenerator, type_name: string) -> string {
    -- Direct substitution
    if gen.type_substitutions.contains(type_name) {
        return gen.type_substitutions.get(type_name)
    }

    -- Handle generic container types: List[T], Option[T], Box[T], etc.
    if starts_with(type_name, "List[") {
        let inner = extract_inner_type(type_name, "List[")
        let resolved_inner = resolve_type_substitution(gen, inner)
        return "List[" + resolved_inner + "]"
    }
    if starts_with(type_name, "Option[") {
        let inner = extract_inner_type(type_name, "Option[")
        let resolved_inner = resolve_type_substitution(gen, inner)
        return "Option[" + resolved_inner + "]"
    }
    if starts_with(type_name, "Box[") {
        let inner = extract_inner_type(type_name, "Box[")
        let resolved_inner = resolve_type_substitution(gen, inner)
        return "Box[" + resolved_inner + "]"
    }
    if starts_with(type_name, "Result[") {
        let inner = extract_inner_type(type_name, "Result[")
        -- Result inner is "T, E" — split on ", " and resolve each
        let comma_idx = string_find(inner, ", ")
        if comma_idx >= 0 {
            let ok_type = substr(inner, 0, comma_idx)
            let err_type = substr(inner, comma_idx + 2, len(inner) - comma_idx - 2)
            let resolved_ok = resolve_type_substitution(gen, ok_type)
            let resolved_err = resolve_type_substitution(gen, err_type)
            return "Result[" + resolved_ok + ", " + resolved_err + "]"
        }
    }

    -- Handle arbitrary user-defined generic types: Pair[A, B] etc.
    -- Look for Name[...] pattern where Name is not a known builtin container
    let bracket_idx = string_find(type_name, "[")
    if bracket_idx > 0 {
        let base = substr(type_name, 0, bracket_idx)
        let inner = substr(type_name, bracket_idx + 1, len(type_name) - bracket_idx - 2)
        -- Resolve each comma-separated type arg
        let comma_idx = string_find(inner, ", ")
        if comma_idx >= 0 {
            let first_type = substr(inner, 0, comma_idx)
            let second_type = substr(inner, comma_idx + 2, len(inner) - comma_idx - 2)
            let resolved_first = resolve_type_substitution(gen, first_type)
            let resolved_second = resolve_type_substitution(gen, second_type)
            return base + "_" + map_type_name(resolved_first) + "_" + map_type_name(resolved_second)
        } else {
            let resolved_inner = resolve_type_substitution(gen, inner)
            return base + "_" + map_type_name(resolved_inner)
        }
    }

    return type_name
}

-- ============================================================
-- INFER ARGUMENT TYPE
-- Attempts to infer the IR type of an expression for implicit
-- generic type argument deduction.
-- ============================================================

fn infer_arg_type(gen: IRGenerator, arg: Expr) -> string {
    if arg.kind == EXPR_LITERAL_INT() {
        return "int"
    }
    if arg.kind == EXPR_LITERAL_FLOAT() {
        return "float"
    }
    if arg.kind == EXPR_LITERAL_STRING() {
        return "string"
    }
    if arg.kind == EXPR_LITERAL_BOOL() {
        return "bool"
    }
    if arg.kind == EXPR_IDENTIFIER() {
        if gen.variable_types.contains(arg.name) {
            let ty = gen.variable_types.get(arg.name)
            -- Map IR type names back to dAImond names
            if ty == "i64" { return "int" }
            if ty == "f64" { return "float" }
            return ty
        }
    }
    return "int"
}

-- ============================================================
-- METHOD CALL IR GENERATION
-- Dispatches method calls on objects to the appropriate handler:
-- enum constructors, dynamic dispatch, map methods, list methods,
-- string methods, struct methods.
-- ============================================================

-- x.f(a) as the call f(x, a), which it is where the checker found that
-- the type of x has no method f (checked_target). The call keeps the
-- id, at which the checker recorded its type and its type arguments.
fn method_as_call(gen: IRGenerator, expr: Expr) -> Expr {
    let target = checked_target(gen, expr)
    let mut call_args: List[Expr] = []
    call_args.push(*expr.object)
    let mut i = 0
    while i < expr.args.len() {
        call_args.push(expr.args[i])
        i = i + 1
    }
    let mut as_call = expr_call(expr_ident(substr(target, 5, len(target) - 5), expr.line, expr.col), call_args, expr.line, expr.col)
    as_call.id = expr.id
    return as_call
}

fn generate_method_call(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block

    let obj_expr = *expr.object
    let method_name = expr.method
    let args = expr.args

    if is_map_ctor(expr) {
        g = ir_type_error(g, "cannot tell which Map type Map.new() creates here; give it one, e.g. let m: Map[string, int] = Map.new()", expr.line)
        return expr_result(g, b, 0)
    }

    -- x.f(a) where the type of x has no method f is the call f(x, a),
    -- as the checker found. The call keeps the id, at which the checker
    -- recorded its type and its type arguments.
    if starts_with(checked_target(g, expr), "call:") {
        return generate_function_call(g, b, method_as_call(g, expr))
    }

    -- x.f(a) where f is a field of x that holds a function, and no
    -- method, is a call of that value
    let holder = strip_box_type(static_type(g, obj_expr))
    if holder != "" and g.struct_defs.contains(holder) and g.enum_defs.contains(holder) == false {
        let held = struct_field_src_type(g, holder, method_name)
        if starts_with(held, "fn(") and struct_has_method(g, holder, method_name) == false {
            return generate_value_call(g, b, expr_field_access(obj_expr, method_name, expr.line, expr.col), held, args, expr.line)
        }
    }

    -- xs.contains(v) for a list of what `==` compares in parts looks
    -- for an equal element (see EQUALITY)
    if method_name == "contains" and args.len() == 1 {
        let list_src = static_type(g, obj_expr)
        if list_src != "" {
            let list_t = eq_type(canon_type(g, list_src))
            if starts_with(list_t, "List[") and classify_list_elem(substr(list_t, 5, len(list_t) - 6)) == LIST_ELEM_OTHER() and string_contains(list_t, "?") == false {
                let seen: List[string] = []
                let unsupported = eq_unsupported(g, list_t, seen)
                if unsupported != "" {
                    g = ir_type_error(g, "contains() cannot look for a value in a " + shown_type(g, list_t) + ": '==' does not compare " + shown_type(g, unsupported), expr.line)
                    return expr_result(g, b, 0)
                }
                let contains_name = made_function_name("contains", list_t)
                g = made_function(g, contains_name, contains_function_source(list_t))
                let mut contains_args: List[Expr] = []
                contains_args.push(obj_expr)
                contains_args.push(args[0])
                return generate_expr(g, b, expr_call(expr_ident(contains_name, expr.line, expr.col), contains_args, expr.line, expr.col))
            }
        }
    }

    -- Region escape: push/insert/set store their argument into the
    -- container, so a region-born argument must not land in a
    -- container declared outside the region
    if g.region_depth > 0 and (method_name == "push" or method_name == "insert" or method_name == "set") {
        let mut any_born = false
        let mut bai = 0
        while bai < args.len() {
            if expr_is_region_born(g, args[bai]) { any_born = true }
            bai = bai + 1
        }
        if any_born {
            let born_root = root_identifier_name(obj_expr)
            if born_root != "" and var_declared_outside_innermost_region(g, born_root) {
                eprintln(error_at(gen.ir_mod.files, "store of region-born value into container declared outside the region (region escape)", expr.line))
                exit(1)
            }
        }
    }

    -- --------------------------------------------------------
    -- Check if this is an enum variant constructor: EnumName.Variant(args)
    -- --------------------------------------------------------
    if obj_expr.kind == EXPR_IDENTIFIER() {
        let obj_name = obj_expr.name
        if g.enum_defs.contains(obj_name) and g.variable_map.contains(obj_name) == false {
            return generate_enum_method_construct(g, b, obj_name, method_name, args, expr.line)
        }
        if g.variable_map.contains(obj_name) == false and is_generic_enum(g, obj_name) {
            if generic_enum_has_variant(g, obj_name, method_name) {
                let instance = generic_enum_instance(g, expr, obj_name, method_name, args)
                if instance.gen.enum_defs.contains(instance.name) == false {
                    return expr_result(instance.gen, b, 0)
                }
                return generate_enum_method_construct(instance.gen, b, instance.name, method_name, args, expr.line)
            }
        }
    }


    -- --------------------------------------------------------
    -- Get object variable name for type dispatch
    -- --------------------------------------------------------
    let obj_var_name = if obj_expr.kind == EXPR_IDENTIFIER() {
        obj_expr.name
    } else {
        ""
    }

    -- --------------------------------------------------------
    -- List method calls (on direct variable)
    -- --------------------------------------------------------
    if len(obj_var_name) > 0 and g.list_elem_kinds.contains(obj_var_name) {
        let ek = g.list_elem_kinds.get(obj_var_name)
        let raw_list_ptr = g.variable_map.get(obj_var_name)
        -- For mut params (negative sentinel), generate expr to get the actual pointer
        if raw_list_ptr < 0 and g.param_ptr_map.contains(obj_var_name) {
            let obj_result = generate_expr(g, b, obj_expr)
            g = obj_result.gen
            b = obj_result.block
            return generate_list_method_call(g, b, ek, obj_result.val_id, obj_var_name, method_name, args)
        }
        return generate_list_method_call(g, b, ek, raw_list_ptr, obj_var_name, method_name, args)
    }

    -- --------------------------------------------------------
    -- List methods on any other list-typed receiver: a field
    -- (p.tokens.push(x)), a boxed value, a call result, ...
    -- --------------------------------------------------------
    let mut list_recv = obj_expr
    let mut recv_list_type = if g.list_elem_kinds.contains(obj_var_name) { "" } else { static_type(g, obj_expr) }
    if starts_with(recv_list_type, "Box[List[") {
        -- A list in a box: the method is the list's, as b.len() is
        -- (*b).len(), and it changes the list in the box
        list_recv = unboxed_container(g, obj_expr)
        recv_list_type = extract_inner_type(recv_list_type, "Box[")
    }
    if starts_with(recv_list_type, "List[") {
        let recv_elem = extract_inner_type(recv_list_type, "List[")
        let h = generate_list_handle(g, b, list_recv)
        g = h.gen
        b = h.block
        if h.ok == false and (method_name == "push" or method_name == "pop") {
            g = ir_type_error(g, "'." + method_name + "()' would change a temporary copy of this list; store the list in a variable or field first", expr.line)
        }
        -- Generic list methods look up the element type by name
        let recv_key = "_listrecv_" + int_to_string(h.ptr.ref_id)
        g.list_elem_types.insert(recv_key, recv_elem)
        return generate_list_method_call(g, b, classify_list_elem(recv_elem), h.ptr.ref_id, recv_key, method_name, args)
    }

    -- --------------------------------------------------------
    -- String .len() method
    -- --------------------------------------------------------
    -- s.len() on any string-typed expression is len(s), and on a boxed
    -- string it is the length of the string in the box
    let len_recv_type = if method_name == "len" and args.len() == 0 { static_type(g, obj_expr) } else { "" }
    if len_recv_type == "string" or len_recv_type == "Box[string]" {
        let mut len_args: List[Expr] = []
        if len_recv_type == "string" {
            len_args.push(obj_expr)
        } else {
            len_args.push(expr_unary(UNOP_DEREF(), obj_expr, expr.line, expr.col))
        }
        return generate_function_call(g, b, expr_call(expr_ident("len", expr.line, expr.col), len_args, expr.line, expr.col))
    }
    if method_name == "len" and args.len() == 0 {
        if len(obj_var_name) > 0 and g.variable_types.contains(obj_var_name) {
            let vtype = g.variable_types.get(obj_var_name)
            if vtype == "string" {
                let obj_result = generate_expr(g, b, obj_expr)
                g = obj_result.gen
                b = obj_result.block

                let id = g.builder.next_id
                let mut inst = ir_inst_new(id, OP_CALL())
                inst.callee = "dm_string_len"
                let mut call_args: List[IRValue] = []
                call_args.push(ir_val_inst(obj_result.val_id))
                inst.call_args = call_args
                inst.result_type = "i64"
                inst.has_result = true
                b.instructions.push(inst)
                g.builder.next_id = g.builder.next_id + 1
                return expr_result(g, b, id)
            }
        }
    }

    -- --------------------------------------------------------
    -- Methods of a generic struct instance
    -- --------------------------------------------------------
    -- A method called on a box is called on what is in the box:
    -- b.inc() is (*b).inc(), and a `mut self` method changes the value
    -- in the box
    let recv_src = static_type(g, obj_expr)
    let unboxed_recv = if starts_with(recv_src, "Box[") { expr_unary(UNOP_DEREF(), obj_expr, expr.line, expr.col) } else { obj_expr }
    let instance_recv = strip_box_type(recv_src)
    if g.generic_instances.contains(instance_recv) {
        return generate_struct_method_call(g, b, instance_recv, unboxed_recv, method_name, args)
    }
    -- A method of the receiver's own type, before the search by the
    -- method's name alone, which finds the last struct that has one
    if own_method_of(g, obj_expr, method_name) != "" {
        return generate_struct_method_call(g, b, instance_recv, unboxed_recv, method_name, args)
    }
    if starts_with(recv_src, "Box[") and g.struct_defs.contains(instance_recv) and g.generic_fn_decls.contains(instance_recv + "_" + method_name) {
        return generate_struct_method_call(g, b, instance_recv, unboxed_recv, method_name, args)
    }

    -- --------------------------------------------------------
    -- Struct method calls (mangled name dispatch)
    -- --------------------------------------------------------
    let struct_type = if len(obj_var_name) > 0 and g.var_struct_types.contains(obj_var_name) {
        g.var_struct_types.get(obj_var_name)
    } else if g.method_struct_map.contains(method_name) {
        g.method_struct_map.get(method_name)
    } else {
        ""
    }

    if len(struct_type) > 0 {
        return generate_struct_method_call(g, b, struct_type, obj_expr, method_name, args)
    }

    -- --------------------------------------------------------
    -- Any other receiver: dispatch on its static source type
    -- --------------------------------------------------------
    let recv_type = static_type(g, obj_expr)
    if g.struct_defs.contains(recv_type) {
        return generate_struct_method_call(g, b, recv_type, obj_expr, method_name, args)
    }

    -- --------------------------------------------------------
    -- Fallback: a free function called with method syntax, self first.
    -- Any other method means the receiver's type is unknown.
    -- --------------------------------------------------------
    if g.known_functions.contains(method_name) == false {
        g = ir_type_error(g, "cannot determine the type of the value '." + method_name + "()' is called on", expr.line)
    }
    let obj_result = generate_expr(g, b, obj_expr)
    g = obj_result.gen
    b = obj_result.block

    let mut call_args: List[IRValue] = []
    call_args.push(ir_val_inst(obj_result.val_id))

    let mut i = 0
    while i < args.len() {
        let arg_result = generate_expr(g, b, args[i])
        g = arg_result.gen
        b = arg_result.block
        call_args.push(ir_val_inst(arg_result.val_id))
        i = i + 1
    }

    let ret_type = infer_call_return_type(g, method_name)
    let has_result = ret_type != "void"

    let id = g.builder.next_id
    let mut inst = ir_inst_new(id, OP_CALL())
    inst.callee = method_name
    inst.call_args = call_args
    inst.result_type = ret_type
    inst.has_result = has_result
    b.instructions.push(inst)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, b, id)
}

-- ============================================================
-- ENUM VARIANT CONSTRUCTOR VIA METHOD SYNTAX
-- Handles EnumName.Variant(payload...) as a method call.
-- ============================================================

fn generate_enum_method_construct(gen: IRGenerator, block: IRBasicBlock, enum_name: string, variant_name: string, args: List[Expr], line: int) -> ExprResult {
    let mut g = gen
    let mut b = block

    let info = g.enum_defs.get(enum_name)

    -- Find the variant
    let variant_index = enum_variant_index(info, variant_name)
    if variant_index < 0 {
        g = ir_type_error(g, "enum '" + enum_name + "' has no variant or function '" + variant_name + "'", line)
        return expr_result(g, b, 0)
    }
    let tag = info.variant_tags[variant_index]
    let payload_count = enum_payload_count(info, variant_index)
    if args.len() != payload_count {
        g = ir_type_error(g, "variant '" + enum_name + "." + variant_name + "' carries " + values_text(payload_count) + ", not " + int_to_string(args.len()), line)
        return expr_result(g, b, 0)
    }

    -- The enum value: its tag at field index 0, then the values
    let tag_insert_id = g.builder.next_id
    let mut tag_insert = ir_inst_new(tag_insert_id, OP_INSERT_FIELD())
    tag_insert.field_base = ir_val_undef()
    tag_insert.field_value = ir_val_int(tag)
    tag_insert.field_index = 0
    tag_insert.result_type = enum_name
    tag_insert.has_result = true
    b.instructions.push(tag_insert)
    g.builder.next_id = g.builder.next_id + 1

    let mut last_id = tag_insert_id

    -- The values the variant carries go in its fields
    if payload_count > 0 {
        let field_idx = enum_payload_field(info, variant_index)

        -- Insert each payload argument
        let mut ai = 0
        while ai < args.len() {
            g = check_basic_type(g, enum_payload_type(info, variant_index, ai), args[ai], "value " + int_to_string(ai + 1) + " of '" + enum_name + "." + variant_name + "'")
            let mut arg_result = generate_expr(g, b, args[ai])
            arg_result = convert_int_to_place(arg_result.gen, arg_result.block, arg_result.val_id, args[ai], enum_payload_type(info, variant_index, ai), "value " + int_to_string(ai + 1) + " of '" + enum_name + "." + variant_name + "'")
            g = arg_result.gen
            b = arg_result.block

            let payload_insert_id = g.builder.next_id
            let mut payload_insert = ir_inst_new(payload_insert_id, OP_INSERT_FIELD())
            payload_insert.field_base = ir_val_inst(last_id)
            payload_insert.field_value = ir_val_inst(arg_result.val_id)
            payload_insert.field_index = field_idx + ai
            payload_insert.result_type = enum_name
            payload_insert.has_result = true
            b.instructions.push(payload_insert)
            g.builder.next_id = g.builder.next_id + 1

            last_id = payload_insert_id
            ai = ai + 1
        }
    }

    return expr_result(g, b, last_id)
}


-- ============================================================
-- LIST METHOD CALL
-- Dispatches .push, .pop, .len, .contains on List[T] variables.
-- Runtime function names are selected based on elem_kind.
-- ============================================================

fn generate_list_method_call(gen: IRGenerator, block: IRBasicBlock, ek: int, list_ptr: int, obj_var_name: string, method_name: string, args: List[Expr]) -> ExprResult {
    let mut g = gen
    let mut b = block

    -- ---- push ----
    if method_name == "push" {
        if args.len() < 1 {
            return expr_result(g, b, 0)
        }

        let mut val_result = generate_expr(g, b, args[0])
        -- An integer becomes the elements' integer type
        let pushed_elem_type = if len(obj_var_name) > 0 and g.list_elem_types.contains(obj_var_name) { g.list_elem_types.get(obj_var_name) } else { "i64" }
        val_result = convert_list_elem(val_result.gen, val_result.block, val_result.val_id, args[0], ek, pushed_elem_type, "the pushed value")
        g = val_result.gen
        b = val_result.block

        if ek == LIST_ELEM_OTHER() {
            -- Generic push: alloca temp, store struct value, pass pointer + elem_size
            let elem_type_name = pushed_elem_type
            -- Alloca temp for the value
            let temp_alloca_id = g.builder.next_id
            let mut temp_inst = ir_inst_new(temp_alloca_id, OP_ALLOCA())
            temp_inst.alloc_type = elem_type_name
            temp_inst.result_type = "ptr(" + elem_type_name + ")"
            temp_inst.has_result = true
            b.instructions.push(temp_inst)
            g.builder.next_id = g.builder.next_id + 1

            -- Store value into temp
            let mut store_inst = ir_inst_new(g.builder.next_id, OP_STORE())
            store_inst.store_ptr = ir_val_inst(temp_alloca_id)
            store_inst.store_val = ir_val_inst(val_result.val_id)
            store_inst.has_result = false
            b.instructions.push(store_inst)
            g.builder.next_id = g.builder.next_id + 1

            -- Call dm_list_generic_push(list_ptr, temp_ptr, elem_size)
            let id = g.builder.next_id
            let mut inst = ir_inst_new(id, OP_CALL())
            inst.callee = "dm_list_generic_push"
            let mut call_args: List[IRValue] = []
            call_args.push(ir_val_inst(list_ptr))
            call_args.push(ir_val_inst(temp_alloca_id))
            call_args.push(ir_val_sizeof(elem_type_name))
            inst.call_args = call_args
            inst.result_type = "void"
            inst.has_result = false
            b.instructions.push(inst)
            g.builder.next_id = g.builder.next_id + 1
            return expr_result(g, b, id)
        }

        let push_fn = if ek == LIST_ELEM_INT() { "dm_list_int64_push" }
        else if ek == LIST_ELEM_FLOAT() { "dm_list_double_push" }
        else { "dm_list_string_push" }

        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_CALL())
        inst.callee = push_fn
        let mut call_args: List[IRValue] = []
        call_args.push(ir_val_inst(list_ptr))
        call_args.push(ir_val_inst(val_result.val_id))
        inst.call_args = call_args
        inst.result_type = "void"
        inst.has_result = false
        b.instructions.push(inst)
        g.builder.next_id = g.builder.next_id + 1
        return expr_result(g, b, id)
    }

    -- ---- pop ----
    if method_name == "pop" {
        if ek == LIST_ELEM_OTHER() {
            -- Generic pop: dm_list_generic_pop(out_ptr, list_ptr, elem_size)
            -- copies the element to a temporary, which is then loaded
            let elem_type_name = if len(obj_var_name) > 0 and g.list_elem_types.contains(obj_var_name) {
                g.list_elem_types.get(obj_var_name)
            } else {
                "i64"
            }
            let temp_alloca_id = g.builder.next_id
            let mut temp_inst = ir_inst_new(temp_alloca_id, OP_ALLOCA())
            temp_inst.alloc_type = elem_type_name
            temp_inst.result_type = "ptr(" + elem_type_name + ")"
            temp_inst.has_result = true
            b.instructions.push(temp_inst)
            g.builder.next_id = g.builder.next_id + 1

            let pop_id = g.builder.next_id
            let mut pop_inst = ir_inst_new(pop_id, OP_CALL())
            pop_inst.callee = "dm_list_generic_pop"
            let mut pop_args: List[IRValue] = []
            pop_args.push(ir_val_inst(temp_alloca_id))
            pop_args.push(ir_val_inst(list_ptr))
            pop_args.push(ir_val_sizeof(elem_type_name))
            pop_inst.call_args = pop_args
            pop_inst.result_type = "void"
            pop_inst.has_result = false
            b.instructions.push(pop_inst)
            g.builder.next_id = pop_id + 1

            let load_id = g.builder.next_id
            let mut load_inst = ir_inst_new(load_id, OP_LOAD())
            load_inst.load_ptr = ir_val_inst(temp_alloca_id)
            load_inst.load_type = elem_type_name
            load_inst.result_type = elem_type_name
            load_inst.has_result = true
            b.instructions.push(load_inst)
            g.builder.next_id = load_id + 1
            if g.struct_defs.contains(elem_type_name) {
                g.var_struct_types.insert("_listget_" + int_to_string(load_id), elem_type_name)
            }
            return expr_result(g, b, load_id)
        }

        let pop_fn = if ek == LIST_ELEM_INT() { "dm_list_int64_pop" }
        else if ek == LIST_ELEM_FLOAT() { "dm_list_double_pop" }
        else { "dm_list_string_pop" }

        let ret_type = if ek == LIST_ELEM_FLOAT() { "f64" }
        else if ek == LIST_ELEM_STRING() { "string" }
        else { "i64" }

        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_CALL())
        inst.callee = pop_fn
        let mut call_args: List[IRValue] = []
        call_args.push(ir_val_inst(list_ptr))
        inst.call_args = call_args
        inst.result_type = ret_type
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = g.builder.next_id + 1
        return expr_result(g, b, id)
    }

    -- ---- len ----
    if method_name == "len" {
        let len_fn = if ek == LIST_ELEM_INT() { "dm_list_int64_len" }
        else if ek == LIST_ELEM_FLOAT() { "dm_list_double_len" }
        else if ek == LIST_ELEM_STRING() { "dm_list_string_len" }
        else { "dm_list_generic_len" }

        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_CALL())
        inst.callee = len_fn
        let mut call_args: List[IRValue] = []
        call_args.push(ir_val_inst(list_ptr))
        inst.call_args = call_args
        inst.result_type = "i64"
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = g.builder.next_id + 1
        return expr_result(g, b, id)
    }

    -- ---- contains ----
    if method_name == "contains" {
        if args.len() >= 1 {
            let search_result = generate_expr(g, b, args[0])
            g = search_result.gen
            b = search_result.block

            let contains_fn = if ek == LIST_ELEM_INT() { "dm_list_int64_contains" }
            else if ek == LIST_ELEM_STRING() { "dm_list_string_contains" }
            else if ek == LIST_ELEM_FLOAT() { "dm_list_double_contains" }
            else { "dm_list_int64_contains" }

            let id = g.builder.next_id
            let mut inst = ir_inst_new(id, OP_CALL())
            inst.callee = contains_fn
            let mut call_args: List[IRValue] = []
            call_args.push(ir_val_inst(list_ptr))
            call_args.push(ir_val_inst(search_result.val_id))
            inst.call_args = call_args
            inst.result_type = "bool"
            inst.has_result = true
            b.instructions.push(inst)
            g.builder.next_id = g.builder.next_id + 1
            return expr_result(g, b, id)
        }
        return expr_result(g, b, 0)
    }

    -- Unknown list method; return undef
    return expr_result(g, b, 0)
}

-- ============================================================
-- STRUCT METHOD CALL
-- Builds mangled name (StructType_method), passes object as
-- self (first arg), and emits OP_CALL.
-- Handles both self-by-value and mut self (pass-by-pointer).
-- ============================================================

-- "first[Point]" for the instance of a generic function, for a message
fn instance_text(gen: IRGenerator, name: string, type_args: List[string]) -> string {
    let mut out = name + "["
    let mut i = 0
    while i < type_args.len() {
        if i > 0 { out = out + ", " }
        out = out + checker_type(gen, type_args[i])
        i = i + 1
    }
    return out + "]"
}

-- The caller's generator after another function was generated in the
-- middle of its own: its function's state, and what the new function
-- added to the program
fn back_to_caller(caller: IRGenerator, g: IRGenerator) -> IRGenerator {
    let mut out = caller
    out.checked_types = g.checked_types
    out.checked_type_args = g.checked_type_args
    out.checked_targets = g.checked_targets
    out.ir_mod = g.ir_mod
    out.struct_defs = g.struct_defs
    out.mono_generated = g.mono_generated
    out.mut_param_fns = g.mut_param_fns
    out.user_extern_fns = g.user_extern_fns
    out.fn_return_types = g.fn_return_types
    out.fn_src_return_types = g.fn_src_return_types
    out.fn_src_param_types = g.fn_src_param_types
    out.field_list_elem_kinds = g.field_list_elem_kinds
    out.field_list_elem_types = g.field_list_elem_types
    out.label_counter = g.label_counter
    out.lambda_counter = g.lambda_counter
    out.known_functions = g.known_functions
    out.type_errors = g.type_errors
    out.generic_instances = g.generic_instances
    out.generic_instance_args = g.generic_instance_args
    return out
}

-- Generate Instance_method for a generic struct instance from its
-- generic impl, with the instance's type arguments substituted.
-- Only signature-wide state survives; the caller's function state
-- is restored.
fn ensure_instance_method(gen: IRGenerator, instance: string, method_name: string) -> IRGenerator {
    let mangled = instance + "_" + method_name
    if gen.mono_generated.contains(mangled) { return gen }
    let base_mangled = gen.generic_instances.get(instance) + "_" + method_name
    if gen.generic_fn_decls.contains(base_mangled) == false { return gen }
    let decl_idx: int = gen.generic_fn_decls.get(base_mangled)
    let decl = gen.declarations[decl_idx]
    if decl.kind != DECL_FUNCTION() { return gen }
    let fd = *decl.func_decl

    let caller = gen
    let mut g = gen
    g.mono_generated.insert(mangled, true)
    g.type_substitutions = instance_subs(g, instance)
    g.current_impl_type = instance
    g.has_impl_type = true

    let mut mono_fd = fd
    let empty_gp: List[string] = []
    mono_fd.generic_params = empty_gp
    let mut mono_params: List[FuncParam] = []
    let mut pi = 0
    while pi < fd.params.len() {
        let p = fd.params[pi]
        g = ensure_type_instances(g, p.type_name, fd.line)
        let mut mp = func_param_new(p.name, canon_type(g, p.type_name))
        mp.is_mut = p.is_mut
        mp.is_ref = p.is_ref
        mono_params.push(mp)
        pi = pi + 1
    }
    mono_fd.params = mono_params
    g = ensure_type_instances(g, fd.return_type, fd.line)
    let ret_src = canon_type(g, fd.return_type)
    mono_fd.return_type = ret_src
    g.fn_src_return_types.insert(mangled, ret_src)
    g.fn_src_param_types.insert(mangled, param_src_types(mono_fd))
    if len(ret_src) > 0 {
        g.fn_return_types.insert(mangled, parse_type_to_ir(ret_src))
    } else {
        g.fn_return_types.insert(mangled, "void")
    }
    g.known_functions.insert(mangled, true)

    g.var_src_types = Map_new()
    g.var_struct_types = Map_new()
    g.list_elem_kinds = Map_new()
    g.list_elem_types = Map_new()
    g.var_enum_types = Map_new()
    g.box_inner_types = Map_new()
    g.array_var_names = Map_new()
    g = declare_function(g, mono_fd, mangled)
    let base = g.generic_instances.get(instance)
    let outer = string_split(g.generic_struct_params.get(base), "|")
    let outer_args = string_split(g.generic_instance_args.get(instance), "|")
    let instance_types = instance_types_begin(g, fd, instance, outer, outer_args, checker_type(g, instance) + "." + method_name)
    g = generate_function_body(instance_types.gen, mono_fd, mangled)
    g = instance_types_end(g, instance_types)

    return back_to_caller(caller, g)
}

fn generate_struct_method_call(gen: IRGenerator, block: IRBasicBlock, struct_type: string, obj_expr: Expr, method_name: string, args: List[Expr]) -> ExprResult {
    let mut g = gen
    let mut b = block

    let mangled = struct_type + "_" + method_name

    -- --------------------------------------------------------
    -- GENERIC IMPL METHOD: monomorphize on demand
    -- --------------------------------------------------------
    if g.generic_fn_decls.contains(mangled) {
        let decl_idx: int = g.generic_fn_decls.get(mangled)
        if decl_idx >= 0 and decl_idx < g.declarations.len() {
            let decl = g.declarations[decl_idx]
            if decl.kind == DECL_FUNCTION() {
                let fd = *decl.func_decl

                -- Check if this method takes self (first param named "self")
                let mut has_self = false
                if fd.params.len() > 0 {
                    has_self = fd.params[0].name == "self"
                }

                -- Build the effective argument list for type inference
                -- If method takes self, include obj_expr; otherwise, just args
                let mut effective_args: List[Expr] = []
                if has_self {
                    effective_args.push(obj_expr)
                }
                let mut ai = 0
                while ai < args.len() {
                    effective_args.push(args[ai])
                    ai = ai + 1
                }

                -- Infer type arguments from effective args
                let mut type_args: List[string] = []
                let mut pi = 0
                while pi < fd.generic_params.len() {
                    let gp = fd.generic_params[pi]
                    -- Try to infer this generic param from matching param types
                    let mut inferred = "i64"
                    let mut mi = 0
                    while mi < fd.params.len() and mi < effective_args.len() {
                        if fd.params[mi].type_name == gp {
                            inferred = infer_arg_type(g, effective_args[mi])
                        }
                        mi = mi + 1
                    }
                    type_args.push(inferred)
                    pi = pi + 1
                }

                -- Build monomorphized name
                let mut mono_name = mangled
                let mut ti = 0
                while ti < type_args.len() {
                    mono_name = mono_name + "_" + map_type_name(type_args[ti])
                    ti = ti + 1
                }

                -- Monomorphize if not already done
                if g.mono_generated.contains(mono_name) == false {
                    g.mono_generated.insert(mono_name, true)

                    -- Save current state
                    let saved_variable_map = g.variable_map
                    let saved_variable_types = g.variable_types
                    let saved_list_elem_kinds = g.list_elem_kinds
                    let saved_list_elem_types = g.list_elem_types
                    let saved_return_type = g.current_return_type
                    let saved_type_subs = g.type_substitutions
                    let saved_completed_blocks = g.completed_blocks
                    let saved_next_id = g.builder.next_id
                    let saved_impl_type = g.current_impl_type
                    let saved_has_impl = g.has_impl_type
                    let saved_unsafe_depth = g.unsafe_depth
                    let saved_region_depth = g.region_depth
                    let saved_tainted_vars = g.tainted_vars
                    let saved_ref_vars = g.ref_vars
                    let saved_region_born_vars = g.region_born_vars
                    let saved_declared_vars = g.declared_vars
                    let saved_region_marks = g.region_marks

                    g.variable_map = Map_new()
                    g.variable_types = Map_new()

                    -- Set up type substitutions
                    g.type_substitutions = Map_new()
                    let mut si = 0
                    while si < fd.generic_params.len() and si < type_args.len() {
                        g.type_substitutions.insert(fd.generic_params[si], type_args[si])
                        si = si + 1
                    }

                    -- Set impl type context for Self resolution
                    g.current_impl_type = struct_type
                    g.has_impl_type = true

                    -- Create monomorphized FunctionDecl
                    let mut mono_fd = fd
                    let empty_gp: List[string] = []
                    mono_fd.generic_params = empty_gp

                    -- Resolve param types
                    let mut mono_params: List[FuncParam] = []
                    let mut mpi = 0
                    while mpi < fd.params.len() {
                        let p = fd.params[mpi]
                        let resolved = resolve_type_substitution(g, p.type_name)
                        let mut mp = func_param_new(p.name, resolved)
                        mp.is_mut = p.is_mut
                        mp.is_ref = p.is_ref
                        mono_params.push(mp)
                        mpi = mpi + 1
                    }
                    mono_fd.params = mono_params

                    -- Resolve return type
                    let resolved_ret = resolve_type_substitution(g, fd.return_type)
                    mono_fd.return_type = resolved_ret

                    -- Also register the monomorphized struct type if needed
                    -- e.g., Pair[A,B] with A=int, B=string → register Pair_i64_string struct
                    let mono_struct = struct_type + "_" + join_types(type_args)
                    if g.struct_defs.contains(struct_type) and g.struct_defs.contains(mono_struct) == false {
                        let base_info = g.struct_defs.get(struct_type)
                        let mut mono_info = struct_info_new(mono_struct)
                        let mut mono_fields: List[IRField] = []
                        let mut fi = 0
                        while fi < base_info.field_names.len() {
                            let fname = base_info.field_names[fi]
                            let ftype = resolve_type_substitution(g, base_info.field_types[fi])
                            mono_info.field_names.push(fname)
                            mono_info.field_types.push(map_type_name(ftype))
                            mono_info.field_src_types.push(ftype)
                            mono_fields.push(ir_field_new(fname, map_type_name(ftype)))
                            fi = fi + 1
                        }
                        g.struct_defs.insert(mono_struct, mono_info)
                        let mut ir_ty = ir_type_named(IR_TYPE_STRUCT(), mono_struct)
                        ir_ty.fields = mono_fields
                        g.ir_mod.struct_defs.insert(mono_struct, ir_ty)
                    }

                    -- Map the base struct name to monomorphized name for struct literals
                    g.type_substitutions.insert(struct_type, mono_struct)

                    g = declare_function(g, mono_fd, mono_name)
                    let no_outer: List[string] = []
                    let instance_types = instance_types_begin(g, fd, struct_type, no_outer, type_args, instance_text(g, struct_type + "." + method_name, type_args))
                    g = generate_function_body(instance_types.gen, mono_fd, mono_name)
                    g = instance_types_end(g, instance_types)

                    -- Restore state
                    g.variable_map = saved_variable_map
                    g.variable_types = saved_variable_types
                    g.list_elem_kinds = saved_list_elem_kinds
                    g.list_elem_types = saved_list_elem_types
                    g.current_return_type = saved_return_type
                    g.type_substitutions = saved_type_subs
                    g.completed_blocks = saved_completed_blocks
                    g.builder.next_id = saved_next_id
                    g.current_impl_type = saved_impl_type
                    g.has_impl_type = saved_has_impl
                    g.unsafe_depth = saved_unsafe_depth
                    g.region_depth = saved_region_depth
                    g.tainted_vars = saved_tainted_vars
                    g.ref_vars = saved_ref_vars
                    g.region_born_vars = saved_region_born_vars
                    g.declared_vars = saved_declared_vars
                    g.region_marks = saved_region_marks
                }

                -- Generate the call to monomorphized function
                let mut call_args: List[IRValue] = []
                let mut ci = 0
                while ci < effective_args.len() {
                    let arg_result = generate_expr(g, b, effective_args[ci])
                    g = arg_result.gen
                    b = arg_result.block
                    call_args.push(ir_val_inst(arg_result.val_id))
                    ci = ci + 1
                }

                let ret_type = infer_call_return_type(g, mono_name)
                let has_result = ret_type != "void"

                let id = g.builder.next_id
                let mut call_inst = ir_inst_new(id, OP_CALL())
                call_inst.callee = mono_name
                call_inst.call_args = call_args
                call_inst.result_type = ret_type
                call_inst.has_result = has_result
                b.instructions.push(call_inst)
                g.builder.next_id = g.builder.next_id + 1

                return expr_result(g, b, id)
            }
        }
    }

    -- --------------------------------------------------------
    -- NON-GENERIC IMPL METHOD: direct call
    -- --------------------------------------------------------

    -- A method of a generic struct instance is generated on first use
    if g.generic_instances.contains(struct_type) {
        g = ensure_instance_method(g, struct_type, method_name)
    }

    -- Check if this method takes a mut self parameter (pass-by-pointer)
    let mut takes_mut_self = false
    if g.mut_param_fns.contains(mangled) {
        let flags = g.mut_param_fns.get(mangled)
        takes_mut_self = starts_with(flags, "1")
    }

    let mut call_args: List[IRValue] = []

    if takes_mut_self {
        -- mut self takes the receiver's address: a variable, a mut
        -- parameter, a field, a list element or a boxed value
        let recv_addr = generate_addr(g, b, obj_expr)
        g = recv_addr.gen
        b = recv_addr.block
        if recv_addr.ok {
            call_args.push(recv_addr.ptr)
        } else {
            -- A temporary receiver: its changes are lost, as with a copy
            let recv_type = infer_expr_type(g, obj_expr)
            let obj_result = generate_expr(g, b, obj_expr)
            g = obj_result.gen
            b = obj_result.block
            let tmp_id = g.builder.next_id
            let mut tmp_inst = ir_inst_new(tmp_id, OP_ALLOCA())
            tmp_inst.alloc_type = recv_type
            tmp_inst.result_type = "ptr(" + recv_type + ")"
            tmp_inst.has_result = true
            b.instructions.push(tmp_inst)
            g.builder.next_id = tmp_id + 1
            let mut st_inst = ir_inst_new(g.builder.next_id, OP_STORE())
            st_inst.store_ptr = ir_val_inst(tmp_id)
            st_inst.store_val = ir_val_inst(obj_result.val_id)
            b.instructions.push(st_inst)
            g.builder.next_id = g.builder.next_id + 1
            call_args.push(ir_val_inst(tmp_id))
        }
    } else {
        -- Pass the object value (self by value)
        let obj_result = generate_expr(g, b, obj_expr)
        g = obj_result.gen
        b = obj_result.block
        call_args.push(ir_val_inst(obj_result.val_id))
    }

    -- The parameters' source types, self first
    let mut method_param_types: List[string] = []
    if g.fn_src_param_types.contains(mangled) {
        method_param_types = string_split(g.fn_src_param_types.get(mangled), "|")
    }

    -- Generate remaining arguments
    let mut i = 0
    while i < args.len() {
        let mut arg_result = generate_expr(g, b, args[i])
        if i + 1 < method_param_types.len() {
            -- An integer becomes the parameter's integer type
            arg_result = convert_int_to_place(arg_result.gen, arg_result.block, arg_result.val_id, args[i], method_param_types[i + 1], "argument " + int_to_string(i + 1) + " of '" + method_name + "'")
        }
        g = arg_result.gen
        b = arg_result.block
        call_args.push(ir_val_inst(arg_result.val_id))
        i = i + 1
    }

    let ret_type = infer_call_return_type(g, mangled)
    let has_result = ret_type != "void"

    let id = g.builder.next_id
    let mut inst = ir_inst_new(id, OP_CALL())
    inst.callee = mangled
    inst.call_args = call_args
    inst.result_type = ret_type
    inst.has_result = has_result
    b.instructions.push(inst)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, b, id)
}

-- ============================================================
-- IR Generation: Field Access, Index Access, Struct Literals,
--                Enum Literals, Array Literals
-- ============================================================
-- Part 4 of expression IR generation for the Stage 4 compiler.
-- Each function follows the signature:
--   fn xxx(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult
-- and returns expr_result(g, b, result_id).

-- ============================================================
-- RUNTIME SAFETY CHECKS (Phase 4 M2a)
-- Conditional-panic block split following the div-by-zero pattern in
-- generate_binary: terminate the current block with a conditional branch
-- to a panic block (dm_panic + unreachable) and an OK block, push both
-- finished blocks to completed_blocks, and continue in the OK block.
-- Panic messages mirror Stage 0 codegen shapes. dm_panic prints
-- "PANIC: " before the message.
-- ============================================================

-- Panic if a Box pointer value is null. Branches directly on the pointer
-- value; llvm_gen coerces a pointer condition to (ptr != null), so the
-- true edge is the non-null (OK) edge.
fn check_box_not_null(gen: IRGenerator, block: IRBasicBlock, ptr_id: int) -> ExprResult {
    let mut g = gen
    let mut b = block

    let panic_label = gen_next_label(g, "box_null_panic")
    g = gen_advance_label(g)
    let ok_label = gen_next_label(g, "box_ok")
    g = gen_advance_label(g)

    b.terminator = Box_new(term_br_cond(ir_val_inst(ptr_id), ok_label, panic_label))
    b.has_terminator = true
    g.completed_blocks.push(b)

    let mut panic_block = ir_block_new(panic_label)
    let mut panic_inst = ir_inst_new(g.builder.next_id, OP_CALL())
    panic_inst.callee = "dm_panic"
    let mut panic_args: List[IRValue] = []
    panic_args.push(ir_val_string("null Box dereference"))
    panic_inst.call_args = panic_args
    panic_inst.result_type = "void"
    panic_inst.has_result = false
    panic_block.instructions.push(panic_inst)
    g.builder.next_id = g.builder.next_id + 1
    panic_block.terminator = Box_new(term_unreachable())
    panic_block.has_terminator = true
    g.completed_blocks.push(panic_block)

    let ok_block = ir_block_new(ok_label)
    return expr_result(g, ok_block, ptr_id)
}

-- Panic unless 0 <= idx < len. ctx is "(array)", "(string)", or "(list)".
-- The panic message is built in the panic block (idx and len dominate it):
--   PANIC: index out of bounds: index <idx>, length <len> <ctx>
fn check_index_bounds(gen: IRGenerator, block: IRBasicBlock, idx_id: int, len_val: IRValue, ctx: string) -> ExprResult {
    let mut g = gen
    let mut b = block

    -- bad_neg = idx < 0
    let neg_id = g.builder.next_id
    let mut neg_inst = ir_inst_new(neg_id, OP_LT())
    neg_inst.lhs = ir_val_inst(idx_id)
    neg_inst.rhs = ir_val_int(0)
    neg_inst.result_type = "bool"
    neg_inst.has_result = true
    b.instructions.push(neg_inst)
    g.builder.next_id = neg_id + 1

    let panic_label = gen_next_label(g, "oob_panic")
    g = gen_advance_label(g)
    let mid_label = gen_next_label(g, "oob_check")
    g = gen_advance_label(g)
    let ok_label = gen_next_label(g, "oob_ok")
    g = gen_advance_label(g)

    b.terminator = Box_new(term_br_cond(ir_val_inst(neg_id), panic_label, mid_label))
    b.has_terminator = true
    g.completed_blocks.push(b)

    -- Mid block: bad_ge = idx >= len
    let mut mid_block = ir_block_new(mid_label)
    let ge_id = g.builder.next_id
    let mut ge_inst = ir_inst_new(ge_id, OP_GE())
    ge_inst.lhs = ir_val_inst(idx_id)
    ge_inst.rhs = len_val
    ge_inst.result_type = "bool"
    ge_inst.has_result = true
    mid_block.instructions.push(ge_inst)
    g.builder.next_id = ge_id + 1
    mid_block.terminator = Box_new(term_br_cond(ir_val_inst(ge_id), panic_label, ok_label))
    mid_block.has_terminator = true
    g.completed_blocks.push(mid_block)

    -- Panic block: build the message, then OP_PANIC + unreachable
    let mut panic_block = ir_block_new(panic_label)

    let idx_str_id = g.builder.next_id
    let mut idx_str_inst = ir_inst_new(idx_str_id, OP_CALL())
    idx_str_inst.callee = "dm_int_to_string"
    let mut idx_args: List[IRValue] = []
    idx_args.push(ir_val_inst(idx_id))
    idx_str_inst.call_args = idx_args
    idx_str_inst.result_type = "string"
    idx_str_inst.has_result = true
    panic_block.instructions.push(idx_str_inst)
    g.builder.next_id = idx_str_id + 1

    let len_str_id = g.builder.next_id
    let mut len_str_inst = ir_inst_new(len_str_id, OP_CALL())
    len_str_inst.callee = "dm_int_to_string"
    let mut len_args: List[IRValue] = []
    len_args.push(len_val)
    len_str_inst.call_args = len_args
    len_str_inst.result_type = "string"
    len_str_inst.has_result = true
    panic_block.instructions.push(len_str_inst)
    g.builder.next_id = len_str_id + 1

    let c1_id = g.builder.next_id
    let mut c1 = ir_inst_new(c1_id, OP_STRING_CONCAT())
    c1.lhs = ir_val_string("index out of bounds: index ")
    c1.rhs = ir_val_inst(idx_str_id)
    c1.result_type = "string"
    c1.has_result = true
    panic_block.instructions.push(c1)
    g.builder.next_id = c1_id + 1

    let c2_id = g.builder.next_id
    let mut c2 = ir_inst_new(c2_id, OP_STRING_CONCAT())
    c2.lhs = ir_val_inst(c1_id)
    c2.rhs = ir_val_string(", length ")
    c2.result_type = "string"
    c2.has_result = true
    panic_block.instructions.push(c2)
    g.builder.next_id = c2_id + 1

    let c3_id = g.builder.next_id
    let mut c3 = ir_inst_new(c3_id, OP_STRING_CONCAT())
    c3.lhs = ir_val_inst(c2_id)
    c3.rhs = ir_val_inst(len_str_id)
    c3.result_type = "string"
    c3.has_result = true
    panic_block.instructions.push(c3)
    g.builder.next_id = c3_id + 1

    let c4_id = g.builder.next_id
    let mut c4 = ir_inst_new(c4_id, OP_STRING_CONCAT())
    c4.lhs = ir_val_inst(c3_id)
    c4.rhs = ir_val_string(" " + ctx)
    c4.result_type = "string"
    c4.has_result = true
    panic_block.instructions.push(c4)
    g.builder.next_id = c4_id + 1

    -- OP_CALL (not OP_PANIC): OP_PANIC lowering emits its own unreachable,
    -- which would duplicate this block's terminator.
    let mut panic_inst = ir_inst_new(g.builder.next_id, OP_CALL())
    panic_inst.callee = "dm_panic"
    let mut oob_panic_args: List[IRValue] = []
    oob_panic_args.push(ir_val_inst(c4_id))
    panic_inst.call_args = oob_panic_args
    panic_inst.result_type = "void"
    panic_inst.has_result = false
    panic_block.instructions.push(panic_inst)
    g.builder.next_id = g.builder.next_id + 1
    panic_block.terminator = Box_new(term_unreachable())
    panic_block.has_terminator = true
    g.completed_blocks.push(panic_block)

    let ok_block = ir_block_new(ok_label)
    return expr_result(g, ok_block, idx_id)
}

-- Panic on INT_MIN / -1 (signed division overflow) before dividing.
-- No-op for non-signed-int operands. Returns the block to divide in.
fn check_div_overflow(gen: IRGenerator, block: IRBasicBlock, lhs_id: int, rhs_id: int, lhs_type: string) -> ExprResult {
    let mut g = gen
    let mut b = block

    if is_signed_int_type(lhs_type) == false {
        return expr_result(g, b, lhs_id)
    }

    let min_id = g.builder.next_id
    let mut min_inst = ir_inst_new(min_id, OP_EQ())
    min_inst.lhs = ir_val_inst(lhs_id)
    min_inst.rhs = ir_val_int(int_fit_min(lhs_type))
    min_inst.result_type = "bool"
    min_inst.has_result = true
    b.instructions.push(min_inst)
    g.builder.next_id = min_id + 1

    let neg1_id = g.builder.next_id
    let mut neg1_inst = ir_inst_new(neg1_id, OP_EQ())
    neg1_inst.lhs = ir_val_inst(rhs_id)
    neg1_inst.rhs = ir_val_int(-1)
    neg1_inst.result_type = "bool"
    neg1_inst.has_result = true
    b.instructions.push(neg1_inst)
    g.builder.next_id = neg1_id + 1

    let both_id = g.builder.next_id
    let mut both_inst = ir_inst_new(both_id, OP_LOGICAL_AND())
    both_inst.lhs = ir_val_inst(min_id)
    both_inst.rhs = ir_val_inst(neg1_id)
    both_inst.result_type = "bool"
    both_inst.has_result = true
    b.instructions.push(both_inst)
    g.builder.next_id = both_id + 1

    let panic_label = gen_next_label(g, "div_ovf_panic")
    g = gen_advance_label(g)
    let do_label = gen_next_label(g, "div_do")
    g = gen_advance_label(g)

    b.terminator = Box_new(term_br_cond(ir_val_inst(both_id), panic_label, do_label))
    b.has_terminator = true
    g.completed_blocks.push(b)

    let mut panic_block = ir_block_new(panic_label)
    let mut panic_inst = ir_inst_new(g.builder.next_id, OP_CALL())
    panic_inst.callee = "dm_panic"
    let mut panic_args: List[IRValue] = []
    panic_args.push(ir_val_string("integer overflow"))
    panic_inst.call_args = panic_args
    panic_inst.result_type = "void"
    panic_inst.has_result = false
    panic_block.instructions.push(panic_inst)
    g.builder.next_id = g.builder.next_id + 1
    panic_block.terminator = Box_new(term_unreachable())
    panic_block.has_terminator = true
    g.completed_blocks.push(panic_block)

    let do_block = ir_block_new(do_label)
    return expr_result(g, do_block, lhs_id)
}

-- True for signed integer IR types (i8/i16/i32/i64)
fn is_signed_int_type(name: string) -> bool {
    return is_integer_type(name) and is_unsigned_type(name) == false
}

-- Range bounds for the narrow signed widths (fit targets)
fn int_fit_min(name: string) -> int {
    if name == "i8" { return -128 }
    if name == "i16" { return -32768 }
    if name == "i32" { return -2147483648 }
    return 0 - 9223372036854775807 - 1
}

-- An integer constant: a literal, or literals combined with unary minus,
-- parentheses, +, - and *
fn is_int_literal_expr(e: Expr) -> bool {
    if e.kind == EXPR_LITERAL_INT() { return true }
    if e.kind == EXPR_GROUPED() { return is_int_literal_expr(*e.operand) }
    if e.kind == EXPR_UNARY() and e.op == UNOP_NEG() { return is_int_literal_expr(*e.operand) }
    if e.kind == EXPR_BINARY() and (e.op == BINOP_ADD() or e.op == BINOP_SUB() or e.op == BINOP_MUL()) {
        return is_int_literal_expr(*e.left) and is_int_literal_expr(*e.right)
    }
    return false
}

-- Whether the statements of a branch give an integer constant as
-- their value
fn stmts_value_is_int_literal(stmts: List[Stmt]) -> bool {
    if stmts.len() == 0 { return false }
    let last = stmts[stmts.len() - 1]
    if last.kind != STMT_EXPRESSION() { return false }
    return is_int_literal_expr(branch_value_expr(*last.expr))
}

fn arm_value_is_int_literal(arm: MatchArm) -> bool {
    if arm.is_expr_body { return is_int_literal_expr(branch_value_expr(*arm.body_expr)) }
    return stmts_value_is_int_literal(arm.body)
}

-- The type the arms of a match give together, as far as it can be
-- told before the arms' own variables are declared, where the first
-- arm gives `first`: integers of different widths meet at one type
-- (int_meet_type); for any other type it is the first arm's
fn arms_meet_type(gen: IRGenerator, arms: List[MatchArm], first: string) -> string {
    if is_integer_type(first) == false or arms.len() == 0 { return first }
    let mut t = first
    let mut t_literal = arm_value_is_int_literal(arms[0])
    let mut i = 1
    while i < arms.len() {
        let arm = arms[i]
        let mut arm_type = ""
        if arm.is_expr_body {
            arm_type = infer_expr_type(gen, *arm.body_expr)
        } else if arm.body.len() > 0 {
            let last = arm.body[arm.body.len() - 1]
            if last.kind == STMT_EXPRESSION() { arm_type = infer_expr_type(gen, *last.expr) }
        }
        if is_integer_type(arm_type) {
            let arm_literal = arm_value_is_int_literal(arm)
            t = int_meet_type(t, t_literal, arm_type, arm_literal)
            t_literal = t_literal and arm_literal
        }
        i = i + 1
    }
    return t
}

-- What a branch of an `if` or an arm of a `match` gives: 1 for an
-- integer constant, itself or through an `if` or a `match` whose
-- branches all give one; 0 for no value, as it returns or panics; -1
-- for any other value
fn branch_int_literal_state(e: Expr) -> int {
    let v = branch_value_expr(e)
    if is_int_literal_expr(v) { return 1 }
    -- A block that ends in a statement
    if v.kind == EXPR_BLOCK() { return 0 }
    if v.kind == EXPR_FUNCTION_CALL() {
        let callee = *v.callee
        if callee.kind == EXPR_IDENTIFIER() and (callee.name == "panic" or callee.name == "exit") { return 0 }
    }
    if branches_give_int_literals(v) { return 1 }
    return -1
}

-- Whether the expression is an `if` or a `match` whose every branch
-- that gives a value gives an integer constant: its type is that of
-- the place it goes to, as a literal's is
fn branches_give_int_literals(e: Expr) -> bool {
    let v = branch_value_expr(e)
    let mut states: List[int] = []
    if v.kind == EXPR_IF() {
        if v.has_else == false { return false }
        states.push(branch_int_literal_state(*v.then_branch))
        states.push(branch_int_literal_state(*v.else_branch))
    } else if v.kind == EXPR_MATCH() {
        let mut ai = 0
        while ai < v.match_arms.len() {
            let arm = v.match_arms[ai]
            if arm.is_expr_body {
                states.push(branch_int_literal_state(*arm.body_expr))
            } else if arm.body.len() == 0 {
                states.push(0)
            } else {
                let last = arm.body[arm.body.len() - 1]
                if last.kind == STMT_EXPRESSION() {
                    states.push(branch_int_literal_state(*last.expr))
                } else {
                    states.push(0)
                }
            }
            ai = ai + 1
        }
    } else {
        return false
    }
    let mut any = false
    let mut si = 0
    while si < states.len() {
        if states[si] < 0 { return false }
        if states[si] == 1 { any = true }
        si = si + 1
    }
    return any
}

fn int_literal_value(e: Expr) -> int {
    if e.kind == EXPR_GROUPED() { return int_literal_value(*e.operand) }
    if e.kind == EXPR_UNARY() { return 0 - int_literal_value(*e.operand) }
    if e.kind == EXPR_BINARY() {
        let l = int_literal_value(*e.left)
        let r = int_literal_value(*e.right)
        if e.op == BINOP_ADD() { return l + r }
        if e.op == BINOP_SUB() { return l - r }
        return l * r
    }
    return e.int_val
}

-- Convert an integer value of type `from` to type `to` where it is
-- stored, passed or returned as `to`: constants that fit and widening
-- convert; narrowing anything else is an error that asks for `as`.
-- `from` is the value's type as it is found here, which is "i64" where
-- nothing is known, as for the value of a `?`. So a narrowing is an
-- error only where the checker, when it has a type for the value, also
-- finds one that does not fit. An `if` or a `match` whose branches all
-- give constants is no narrowing: each constant is checked where its
-- branch stores it.
fn convert_int_value(gen: IRGenerator, block: IRBasicBlock, val_id: int, e: Expr, from: string, to: string, what: string) -> ExprResult {
    let mut g = gen
    if is_integer_type(from) == false or is_integer_type(to) == false or from == to {
        return expr_result(g, block, val_id)
    }
    let mut value = branch_value_expr(e)
    -- `comptime 3` is the constant 3
    if value.kind == EXPR_COMPTIME() { value = branch_value_expr(*value.operand) }
    if is_int_literal_expr(value) {
        g = check_int_literal_fits(g, value, to)
    } else if type_bit_width(from) > type_bit_width(to) and branches_give_int_literals(value) == false {
        let checked = map_type_name(checked_type(g, e))
        if is_integer_type(checked) == false or type_bit_width(checked) > type_bit_width(to) {
            g = ir_type_error(g, what + " has type " + builtin_src_type(from) + ", which does not fit in " + to + "; convert it with `as " + to + "`", e.line)
        }
    }
    return emit_ir_cast(g, block, ir_val_inst(val_id), from, to)
}

-- convert_int_value for a value that goes to a place of the source
-- type `to`: a parameter, a field, a variant's value. Any place that
-- is not an integer's leaves the value as it is.
fn convert_int_to_place(gen: IRGenerator, block: IRBasicBlock, val_id: int, e: Expr, to: string, what: string) -> ExprResult {
    let to_ir = map_type_name(canon_type(gen, to))
    if is_integer_type(to_ir) == false { return expr_result(gen, block, val_id) }
    return convert_int_value(gen, block, val_id, e, infer_expr_type(gen, e), to_ir, what)
}

-- convert_int_value for an element that a list of integers stores:
-- a List[int] holds 64-bit elements, and a list of another integer
-- type holds elements of that type
fn convert_list_elem(gen: IRGenerator, block: IRBasicBlock, val_id: int, e: Expr, elem_kind: int, elem_type: string, what: string) -> ExprResult {
    if elem_kind == LIST_ELEM_INT() { return convert_int_to_place(gen, block, val_id, e, "i64", what) }
    if elem_kind == LIST_ELEM_OTHER() { return convert_int_to_place(gen, block, val_id, e, elem_type, what) }
    return expr_result(gen, block, val_id)
}

-- The integer type both operands of a binary operator take when they
-- are integers of different types: an integer literal takes the other
-- operand's type, as in `fd < 0` with fd: i32; otherwise the narrower
-- operand widens. "" when the operands need no conversion.
fn binary_int_type(gen: IRGenerator, expr: Expr) -> string {
    return common_int_type(expr, infer_expr_type(gen, *expr.left), infer_expr_type(gen, *expr.right))
}

-- Whether a binary operator gives a bool whatever its operands are
fn is_bool_binop(op: int) -> bool {
    if op == BINOP_EQ() or op == BINOP_NE() { return true }
    if op == BINOP_LT() or op == BINOP_LE() or op == BINOP_GT() or op == BINOP_GE() { return true }
    return op == BINOP_AND() or op == BINOP_OR()
}

-- binary_int_type for operands whose types, lt and rt, are known
fn common_int_type(expr: Expr, lt: string, rt: string) -> string {
    if is_integer_type(lt) == false or is_integer_type(rt) == false or lt == rt { return "" }
    return int_meet_type(lt, is_int_literal_expr(*expr.left), rt, is_int_literal_expr(*expr.right))
}

-- Report an integer literal that does not fit the type it converts to
fn check_int_literal_fits(gen: IRGenerator, e: Expr, t: string) -> IRGenerator {
    if is_int_literal_expr(e) == false or type_bit_width(t) >= 64 { return gen }
    let v = int_literal_value(e)
    let mut lo = 0
    let mut hi = 0
    if is_unsigned_type(t) {
        hi = if t == "u8" { 255 } else if t == "u16" { 65535 } else { 4294967295 }
    } else {
        lo = int_fit_min(t)
        hi = int_fit_max(t)
    }
    if v < lo or v > hi {
        return ir_type_error(gen, "integer literal " + int_to_string(v) + " does not fit in " + t, e.line)
    }
    return gen
}

fn int_fit_max(name: string) -> int {
    if name == "i8" { return 127 }
    if name == "i16" { return 32767 }
    if name == "i32" { return 2147483647 }
    return 9223372036854775807
}

-- Checked signed arithmetic, mirroring Stage 0: widen both operands to
-- i64, call the dm_checked_*_i64 runtime helper (panics on overflow),
-- and range-fit the result when fit_type names a narrower signed width.
fn emit_checked_int_arith(gen: IRGenerator, block: IRBasicBlock, callee: string, lhs_val: IRValue, lhs_type: string, rhs_val: IRValue, rhs_type: string, fit_type: string) -> ExprResult {
    let mut g = gen
    let mut b = block

    let mut lhs64 = lhs_val
    if is_integer_type(lhs_type) and type_bit_width(lhs_type) < 64 {
        let widen_id = g.builder.next_id
        let mut widen_inst = ir_inst_new(widen_id, OP_CAST())
        widen_inst.cast_val = lhs_val
        widen_inst.cast_from = lhs_type
        widen_inst.cast_to = "i64"
        widen_inst.result_type = "i64"
        widen_inst.has_result = true
        b.instructions.push(widen_inst)
        g.builder.next_id = widen_id + 1
        lhs64 = ir_val_inst(widen_id)
    }

    let mut rhs64 = rhs_val
    if is_integer_type(rhs_type) and type_bit_width(rhs_type) < 64 {
        let widen_id = g.builder.next_id
        let mut widen_inst = ir_inst_new(widen_id, OP_CAST())
        widen_inst.cast_val = rhs_val
        widen_inst.cast_from = rhs_type
        widen_inst.cast_to = "i64"
        widen_inst.result_type = "i64"
        widen_inst.has_result = true
        b.instructions.push(widen_inst)
        g.builder.next_id = widen_id + 1
        rhs64 = ir_val_inst(widen_id)
    }

    let call_id = g.builder.next_id
    let mut call_inst = ir_inst_new(call_id, OP_CALL())
    call_inst.callee = callee
    let mut call_args: List[IRValue] = []
    call_args.push(lhs64)
    call_args.push(rhs64)
    call_inst.call_args = call_args
    call_inst.result_type = "i64"
    call_inst.has_result = true
    b.instructions.push(call_inst)
    g.builder.next_id = call_id + 1

    if len(fit_type) == 0 {
        return expr_result(g, b, call_id)
    }

    -- Range-fit to the narrower signed width, then truncate back
    let range_id = g.builder.next_id
    let mut range_inst = ir_inst_new(range_id, OP_CALL())
    range_inst.callee = "dm_checked_range_i64"
    let mut range_args: List[IRValue] = []
    range_args.push(ir_val_inst(call_id))
    range_args.push(ir_val_int(int_fit_min(fit_type)))
    range_args.push(ir_val_int(int_fit_max(fit_type)))
    range_inst.call_args = range_args
    range_inst.result_type = "i64"
    range_inst.has_result = true
    b.instructions.push(range_inst)
    g.builder.next_id = range_id + 1

    let trunc_id = g.builder.next_id
    let mut trunc_inst = ir_inst_new(trunc_id, OP_CAST())
    trunc_inst.cast_val = ir_val_inst(range_id)
    trunc_inst.cast_from = "i64"
    trunc_inst.cast_to = fit_type
    trunc_inst.result_type = fit_type
    trunc_inst.has_result = true
    b.instructions.push(trunc_inst)
    g.builder.next_id = trunc_id + 1
    return expr_result(g, b, trunc_id)
}

-- Stage 0 cast-fit rule: same signedness needs dst width >= src width;
-- unsigned -> signed needs dst width > src width; signed -> unsigned
-- never fits (negative values).
fn int_cast_fits(from_type: string, to_type: string) -> bool {
    let from_signed = is_unsigned_type(from_type) == false
    let to_signed = is_unsigned_type(to_type) == false
    if from_signed == to_signed { return type_bit_width(to_type) >= type_bit_width(from_type) }
    if from_signed == false and to_signed { return type_bit_width(to_type) > type_bit_width(from_type) }
    return false
}

-- Max value of the unsigned widths (u64-as-target uses INT64_MAX, as in
-- Stage 0's signed -> unsigned rule)
fn uint_fit_max(name: string) -> int {
    if name == "u8" { return 255 }
    if name == "u16" { return 65535 }
    if name == "u32" { return 4294967295 }
    return 9223372036854775807
}

-- Narrowing integer cast with a runtime range check, mirroring Stage 0:
-- widen to 64 bits, dm_cast_check_* (panics out of range), then convert.
fn emit_checked_cast(gen: IRGenerator, block: IRBasicBlock, operand_id: int, from_type: string, to_type: string) -> ExprResult {
    let mut g = gen
    let mut b = block
    let from_signed = is_unsigned_type(from_type) == false
    let to_signed = is_unsigned_type(to_type) == false

    let mut wide_id = operand_id
    if type_bit_width(from_type) < 64 {
        let wide_to = if from_signed { "i64" } else { "u64" }
        let wid = g.builder.next_id
        let mut winst = ir_inst_new(wid, OP_CAST())
        winst.cast_val = ir_val_inst(operand_id)
        winst.cast_from = from_type
        winst.cast_to = wide_to
        winst.result_type = wide_to
        winst.has_result = true
        b.instructions.push(winst)
        g.builder.next_id = wid + 1
        wide_id = wid
    }

    let chk_id = g.builder.next_id
    let mut chk_inst = ir_inst_new(chk_id, OP_CALL())
    let mut chk_args: List[IRValue] = []
    chk_args.push(ir_val_inst(wide_id))
    if from_signed and to_signed {
        chk_inst.callee = "dm_cast_check_i64"
        chk_args.push(ir_val_int(int_fit_min(to_type)))
        chk_args.push(ir_val_int(int_fit_max(to_type)))
        chk_inst.result_type = "i64"
    } else if from_signed {
        chk_inst.callee = "dm_cast_check_i64"
        chk_args.push(ir_val_int(0))
        chk_args.push(ir_val_int(uint_fit_max(to_type)))
        chk_inst.result_type = "i64"
    } else if to_signed {
        chk_inst.callee = "dm_cast_check_u64"
        chk_args.push(ir_val_int(int_fit_max(to_type)))
        chk_inst.result_type = "u64"
    } else {
        chk_inst.callee = "dm_cast_check_u64"
        chk_args.push(ir_val_int(uint_fit_max(to_type)))
        chk_inst.result_type = "u64"
    }
    chk_inst.call_args = chk_args
    chk_inst.has_result = true
    b.instructions.push(chk_inst)
    g.builder.next_id = chk_id + 1
    let chk_ret_type = chk_inst.result_type

    let cast_id = g.builder.next_id
    let mut cast_inst = ir_inst_new(cast_id, OP_CAST())
    cast_inst.cast_val = ir_val_inst(chk_id)
    cast_inst.cast_from = chk_ret_type
    cast_inst.cast_to = to_type
    cast_inst.result_type = to_type
    cast_inst.has_result = true
    b.instructions.push(cast_inst)
    g.builder.next_id = cast_id + 1
    return expr_result(g, b, cast_id)
}

-- ============================================================
-- Field Access: expr.object.expr.field
-- ============================================================

fn generate_field_access(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block

    let object = *expr.object
    let field_name = expr.field

    -- Generate the base object expression
    let obj_result = generate_expr(g, b, object)
    g = obj_result.gen
    b = obj_result.block
    let obj_id = obj_result.val_id

    -- Determine the struct type name by examining the object expression
    let mut struct_name = ""
    if object.kind == EXPR_IDENTIFIER() {
        let var_name = object.name
        if g.var_struct_types.contains(var_name) {
            struct_name = g.var_struct_types.get(var_name)
        }
    }

    -- Check for list index result struct type (e.g., points[0].x)
    if struct_name == "" {
        let listget_key = "_listget_" + int_to_string(obj_id)
        if g.var_struct_types.contains(listget_key) {
            struct_name = g.var_struct_types.get(listget_key)
        }
    }

    -- Check for chained field access struct type (e.g., a.b.x)
    if struct_name == "" {
        let field_key = "_field_" + int_to_string(obj_id)
        if g.var_struct_types.contains(field_key) {
            struct_name = g.var_struct_types.get(field_key)
        }
    }

    -- Check for Box[T] field access: dereference pointer then access struct field
    if struct_name == "" and object.kind == EXPR_IDENTIFIER() {
        let var_name = object.name
        if g.box_inner_types.contains(var_name) {
            let inner_type = g.box_inner_types.get(var_name)
            if g.struct_defs.contains(inner_type) {
                let info = g.struct_defs.get(inner_type)
                -- Null check before dereferencing the box pointer
                let chk = check_box_not_null(g, b, obj_id)
                g = chk.gen
                b = chk.block
                -- Load the struct from the box pointer
                let load_id = g.builder.next_id
                let mut load_inst = ir_inst_new(load_id, OP_LOAD())
                load_inst.load_ptr = ir_val_inst(obj_id)
                load_inst.load_type = inner_type
                load_inst.result_type = inner_type
                load_inst.has_result = true
                b.instructions.push(load_inst)
                g.builder.next_id = g.builder.next_id + 1

                -- Find the field index by name
                let mut fidx = 0
                let mut field_type_s = "i64"
                let mut ffi = 0
                while ffi < info.field_names.len() {
                    if info.field_names[ffi] == field_name {
                        fidx = ffi
                        field_type_s = info.field_types[ffi]
                    }
                    ffi = ffi + 1
                }
                let ir_type = map_type_name(field_type_s)

                -- Extract field from loaded struct
                let extract_id = g.builder.next_id
                let mut extract_inst = ir_inst_new(extract_id, OP_EXTRACT_FIELD())
                extract_inst.field_base = ir_val_inst(load_id)
                extract_inst.field_index = fidx
                extract_inst.field_type = ir_type
                extract_inst.result_type = ir_type
                extract_inst.has_result = true
                b.instructions.push(extract_inst)
                g.builder.next_id = g.builder.next_id + 1

                -- Track struct result for chained access
                if g.struct_defs.contains(field_type_s) {
                    let result_var = "_field_" + int_to_string(extract_id)
                    g.var_struct_types.insert(result_var, field_type_s)
                }
                -- Track Box[T] result for chained box access
                if starts_with(field_type_s, "Box[") {
                    let box_inner = extract_inner_type(field_type_s, "Box[")
                    let result_var = "_field_" + int_to_string(extract_id)
                    g.box_inner_types.insert(result_var, box_inner)
                }

                return expr_result(g, b, extract_id)
            }
        }
    }

    -- Check for Box field access from chained field access (non-identifier objects)
    -- e.g., o.inner.value where inner: Box[Inner] — obj_id is the result of extracting inner
    if struct_name == "" {
        let box_key = "_field_" + int_to_string(obj_id)
        if g.box_inner_types.contains(box_key) {
            let inner_type = g.box_inner_types.get(box_key)
            if g.struct_defs.contains(inner_type) {
                let info = g.struct_defs.get(inner_type)
                -- Null check before dereferencing the box pointer
                let chk = check_box_not_null(g, b, obj_id)
                g = chk.gen
                b = chk.block
                -- Load the struct from the box pointer
                let load_id = g.builder.next_id
                let mut load_inst = ir_inst_new(load_id, OP_LOAD())
                load_inst.load_ptr = ir_val_inst(obj_id)
                load_inst.load_type = inner_type
                load_inst.result_type = inner_type
                load_inst.has_result = true
                b.instructions.push(load_inst)
                g.builder.next_id = g.builder.next_id + 1

                let mut fidx = 0
                let mut field_type_s = "i64"
                let mut ffi = 0
                while ffi < info.field_names.len() {
                    if info.field_names[ffi] == field_name {
                        fidx = ffi
                        field_type_s = info.field_types[ffi]
                    }
                    ffi = ffi + 1
                }
                let ir_type = map_type_name(field_type_s)

                let extract_id = g.builder.next_id
                let mut extract_inst = ir_inst_new(extract_id, OP_EXTRACT_FIELD())
                extract_inst.field_base = ir_val_inst(load_id)
                extract_inst.field_index = fidx
                extract_inst.field_type = ir_type
                extract_inst.result_type = ir_type
                extract_inst.has_result = true
                b.instructions.push(extract_inst)
                g.builder.next_id = g.builder.next_id + 1

                if g.struct_defs.contains(field_type_s) {
                    let result_var = "_field_" + int_to_string(extract_id)
                    g.var_struct_types.insert(result_var, field_type_s)
                }
                if starts_with(field_type_s, "Box[") {
                    let box_inner = extract_inner_type(field_type_s, "Box[")
                    let result_var = "_field_" + int_to_string(extract_id)
                    g.box_inner_types.insert(result_var, box_inner)
                }

                return expr_result(g, b, extract_id)
            }
        }
    }

    -- If we could not resolve from a direct identifier, try from the
    -- variable_types map (e.g., for chained field access results)
    if struct_name == "" {
        if object.kind == EXPR_IDENTIFIER() {
            let var_name = object.name
            if g.variable_types.contains(var_name) {
                let vtype = g.variable_types.get(var_name)
                -- If the type string names a known struct, use it
                if g.struct_defs.contains(vtype) {
                    struct_name = vtype
                }
            }
        }
    }

    -- Check for Option/Result types before falling back
    if struct_name == "" and object.kind == EXPR_IDENTIFIER() {
        let var_name = object.name
        if g.variable_types.contains(var_name) {
            let vtype = g.variable_types.get(var_name)
            if starts_with(vtype, "Option[") {
                -- Option[T] = { i32 has_value, T value }
                let inner = substr(vtype, 7, len(vtype) - 8)
                let inner_ir = map_type_name(inner)
                let mut fidx = 0
                let mut ftype = "i32"
                if field_name == "value" {
                    fidx = 1
                    ftype = inner_ir
                }
                let id = g.builder.next_id
                let mut inst = ir_inst_new(id, OP_EXTRACT_FIELD())
                inst.field_base = ir_val_inst(obj_id)
                inst.field_index = fidx
                inst.field_type = ftype
                inst.result_type = ftype
                inst.has_result = true
                b.instructions.push(inst)
                g.builder.next_id = id + 1
                return expr_result(g, b, id)
            }
            if starts_with(vtype, "Result[") {
                -- Result[T, E] = { i32 tag, T ok_val, E err_val }
                let inner_str = substr(vtype, 7, len(vtype) - 8)
                -- Parse "T, E" from inner_str
                let mut comma_pos = 0
                let mut ci = 0
                while ci < len(inner_str) {
                    if char_at(inner_str, ci) == "," {
                        comma_pos = ci
                    }
                    ci = ci + 1
                }
                let ok_type = string_trim(substr(inner_str, 0, comma_pos))
                let err_type = string_trim(substr(inner_str, comma_pos + 1, len(inner_str) - comma_pos - 1))
                let ok_ir = map_type_name(ok_type)
                let err_ir = map_type_name(err_type)
                if field_name == "is_ok" {
                    -- Extract tag (field 0) and compare with 0 to get boolean
                    -- is_ok should be true when tag == 0 (Ok), false when tag == 1 (Err)
                    let tag_id = g.builder.next_id
                    let mut tag_inst = ir_inst_new(tag_id, OP_EXTRACT_FIELD())
                    tag_inst.field_base = ir_val_inst(obj_id)
                    tag_inst.field_index = 0
                    tag_inst.field_type = "i32"
                    tag_inst.result_type = "i32"
                    tag_inst.has_result = true
                    b.instructions.push(tag_inst)
                    g.builder.next_id = g.builder.next_id + 1

                    let cmp_id = g.builder.next_id
                    let mut cmp_inst = ir_inst_new(cmp_id, OP_EQ())
                    cmp_inst.lhs = ir_val_inst(tag_id)
                    cmp_inst.rhs = ir_val_int(0)
                    cmp_inst.result_type = "bool"
                    cmp_inst.has_result = true
                    b.instructions.push(cmp_inst)
                    g.builder.next_id = g.builder.next_id + 1

                    return expr_result(g, b, cmp_id)
                }
                let mut fidx = 0
                let mut ftype = "i32"
                if field_name == "ok" or field_name == "value" {
                    fidx = 1
                    ftype = ok_ir
                }
                if field_name == "err" or field_name == "error" {
                    fidx = 2
                    ftype = err_ir
                }
                let id = g.builder.next_id
                let mut inst = ir_inst_new(id, OP_EXTRACT_FIELD())
                inst.field_base = ir_val_inst(obj_id)
                inst.field_index = fidx
                inst.field_type = ftype
                inst.result_type = ftype
                inst.has_result = true
                b.instructions.push(inst)
                g.builder.next_id = id + 1
                return expr_result(g, b, id)
            }
        }
    }

    if struct_name == "" {
        let obj_static = static_type(g, object)
        if g.struct_defs.contains(obj_static) {
            struct_name = obj_static
        }
    }

    -- Look up struct definition to find the field index and type
    if struct_name == "" {
        -- Cannot resolve struct type: report it, then extract index 0 to continue
        g = ir_type_error(g, "cannot determine the struct type for field access '." + expr.field + "'", expr.line)
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_EXTRACT_FIELD())
        inst.field_base = ir_val_inst(obj_id)
        inst.field_index = 0
        inst.field_type = "i64"
        inst.result_type = "i64"
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return expr_result(g, b, id)
    }

    let info = g.struct_defs.get(struct_name)

    -- Find the field index by name
    let mut field_idx = 0
    let mut found = false
    let mut field_type_str = "i64"
    let num_fields = info.field_names.len()
    let mut fi = 0
    while fi < num_fields {
        if info.field_names[fi] == field_name {
            field_idx = fi
            field_type_str = info.field_types[fi]
            found = true
        }
        fi = fi + 1
    }

    -- Map the dAImond type name to an IR type string
    let ir_type = map_type_name(field_type_str)

    -- Emit OP_EXTRACT_FIELD instruction
    let id = g.builder.next_id
    let mut inst = ir_inst_new(id, OP_EXTRACT_FIELD())
    inst.field_base = ir_val_inst(obj_id)
    inst.field_index = field_idx
    inst.field_type = ir_type
    inst.result_type = ir_type
    inst.has_result = true
    b.instructions.push(inst)
    g.builder.next_id = id + 1

    -- Track list-typed fields for later index access resolution
    if starts_with(field_type_str, "List[") {
        let inner = substr(field_type_str, 5, len(field_type_str) - 6)
        let key = struct_name + "." + field_name
        if inner == "int" {
            g.field_list_elem_kinds.insert(key, LIST_ELEM_INT())
        } else if inner == "float" {
            g.field_list_elem_kinds.insert(key, LIST_ELEM_FLOAT())
        } else if inner == "string" {
            g.field_list_elem_kinds.insert(key, LIST_ELEM_STRING())
        } else {
            g.field_list_elem_kinds.insert(key, LIST_ELEM_OTHER())
            g.field_list_elem_types.insert(key, inner)
        }
    }

    -- If the field type is itself a struct, track the result variable mapping
    if g.struct_defs.contains(field_type_str) {
        -- Use a synthetic name based on instruction id for chained access tracking
        let result_var = "_field_" + int_to_string(id)
        g.var_struct_types.insert(result_var, field_type_str)
    }

    -- If the field type is Box[T], track for chained box access
    if starts_with(field_type_str, "Box[") {
        let box_inner = extract_inner_type(field_type_str, "Box[")
        let result_var = "_field_" + int_to_string(id)
        g.box_inner_types.insert(result_var, box_inner)
    }

    return expr_result(g, b, id)
}

-- ============================================================
-- Index Access: expr.object[expr.index]
-- ============================================================

-- Read element idx_id of the list at list_id (a pointer to the list),
-- with a bounds check that panics with bounds_ctx in its message.
fn generate_list_index_get(gen: IRGenerator, block: IRBasicBlock, elem_kind: int, elem_type: string, obj_id: int, idx_id: int, bounds_ctx: string) -> ExprResult {
    let mut g = gen
    let mut b = block
    -- Bounds check: panic unless 0 <= idx < len
    let bounds_len_fn = if elem_kind == LIST_ELEM_INT() { "dm_list_int64_len" }
    else if elem_kind == LIST_ELEM_FLOAT() { "dm_list_double_len" }
    else if elem_kind == LIST_ELEM_STRING() { "dm_list_string_len" }
    else { "dm_list_generic_len" }
    let bounds_len_id = g.builder.next_id
    let mut bounds_len_inst = ir_inst_new(bounds_len_id, OP_CALL())
    bounds_len_inst.callee = bounds_len_fn
    let mut bounds_len_args: List[IRValue] = []
    bounds_len_args.push(ir_val_inst(obj_id))
    bounds_len_inst.call_args = bounds_len_args
    bounds_len_inst.result_type = "i64"
    bounds_len_inst.has_result = true
    b.instructions.push(bounds_len_inst)
    g.builder.next_id = bounds_len_id + 1
    let bounds_chk = check_index_bounds(g, b, idx_id, ir_val_inst(bounds_len_id), bounds_ctx)
    g = bounds_chk.gen
    b = bounds_chk.block

    -- The index is in range: read the element where it lies
    let slot_type = list_slot_ir_type(elem_kind, elem_type)
    let elem_addr = emit_list_elem_addr(g, b, ir_val_inst(obj_id), idx_id, slot_type)
    g = elem_addr.gen
    b = elem_addr.block
    let mut load_id = g.builder.next_id
    let mut load_inst = ir_inst_new(load_id, OP_LOAD())
    load_inst.load_ptr = ir_val_inst(elem_addr.val_id)
    load_inst.load_type = slot_type
    load_inst.result_type = slot_type
    load_inst.has_result = true
    b.instructions.push(load_inst)
    g.builder.next_id = load_id + 1

    if ir_load_gives_address(slot_type) {
        -- A string or list element: copy it out, so the value read
        -- does not change when the element is assigned later
        let copy_id = g.builder.next_id
        let mut copy_inst = ir_inst_new(copy_id, OP_ALLOCA())
        copy_inst.alloc_type = slot_type
        copy_inst.result_type = "ptr(" + slot_type + ")"
        copy_inst.has_result = true
        b.instructions.push(copy_inst)
        g.builder.next_id = copy_id + 1
        let copied = emit_ir_store(g, b, ir_val_inst(copy_id), ir_val_inst(load_id))
        g = copied.gen
        b = copied.block
        load_id = g.builder.next_id
        let mut reload_inst = ir_inst_new(load_id, OP_LOAD())
        reload_inst.load_ptr = ir_val_inst(copy_id)
        reload_inst.load_type = slot_type
        reload_inst.result_type = slot_type
        reload_inst.has_result = true
        b.instructions.push(reload_inst)
        g.builder.next_id = load_id + 1
    }

    -- Track struct type for subsequent field access
    if elem_kind == LIST_ELEM_OTHER() and g.struct_defs.contains(elem_type) {
        g.var_struct_types.insert("_listget_" + int_to_string(load_id), elem_type)
    }
    return expr_result(g, b, load_id)
}

fn generate_index_access(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block

    -- A list, a map or a string in a box is indexed as itself
    let object = unboxed_container(g, *expr.object)
    let index = *expr.index

    -- m[k] is m.get(k)
    if is_map_type(g, static_type(g, object)) {
        let mut get_args: List[Expr] = []
        get_args.push(index)
        return generate_expr(g, b, expr_method_call(object, "get", get_args, expr.line, expr.col))
    }

    -- A list reached through a field, a box, a call, ...: index its storage
    let obj_static = if object.kind == EXPR_IDENTIFIER() { "" } else { static_type(g, object) }
    if starts_with(obj_static, "List[") {
        let h = generate_list_handle(g, b, object)
        g = h.gen
        b = h.block
        let list_idx = generate_expr(g, b, index)
        g = list_idx.gen
        b = list_idx.block
        let list_elem_src = extract_inner_type(obj_static, "List[")
        let list_get = generate_list_index_get(g, b, classify_list_elem(list_elem_src), list_elem_ir_type(list_elem_src), h.ptr.ref_id, list_idx.val_id, "(list)")
        -- Track struct elements for subsequent field access
        if g.struct_defs.contains(list_elem_src) {
            let mut lg = list_get.gen
            lg.var_struct_types.insert("_listget_" + int_to_string(list_get.val_id), list_elem_src)
            return expr_result(lg, list_get.block, list_get.val_id)
        }
        return list_get
    }

    -- Generate the object expression
    let obj_result = generate_expr(g, b, object)
    g = obj_result.gen
    b = obj_result.block
    let obj_id = obj_result.val_id

    -- Generate the index expression
    let idx_result = generate_expr(g, b, index)
    g = idx_result.gen
    b = idx_result.block
    let idx_id = idx_result.val_id

    -- Check if the object is a string (s[i] -> char_at)
    let mut obj_is_string = obj_static == "string"
    if object.kind == EXPR_IDENTIFIER() and g.variable_types.contains(object.name) {
        obj_is_string = g.variable_types.get(object.name) == "string"
    }
    if obj_is_string {
        -- Bounds check: panic unless 0 <= idx < strlen
        let str_len_id = g.builder.next_id
        let mut str_len_inst = ir_inst_new(str_len_id, OP_CALL())
        str_len_inst.callee = "dm_string_len"
        let mut str_len_args: List[IRValue] = []
        str_len_args.push(ir_val_inst(obj_id))
        str_len_inst.call_args = str_len_args
        str_len_inst.result_type = "i64"
        str_len_inst.has_result = true
        b.instructions.push(str_len_inst)
        g.builder.next_id = str_len_id + 1
        let str_chk = check_index_bounds(g, b, idx_id, ir_val_inst(str_len_id), "(string)")
        g = str_chk.gen
        b = str_chk.block

        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_CALL())
        inst.callee = "dm_char_at"
        let mut call_args: List[IRValue] = []
        call_args.push(ir_val_inst(obj_id))
        call_args.push(ir_val_inst(idx_id))
        inst.call_args = call_args
        inst.result_type = "string"
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return expr_result(g, b, id)
    }

    -- Check if the object is a known list variable
    if object.kind == EXPR_IDENTIFIER() {
        let var_name = object.name

        -- List variable index access
        if g.list_elem_kinds.contains(var_name) {
            let elem_kind = g.list_elem_kinds.get(var_name)

            -- Determine element type from kind
            let mut elem_type = "i64"
            if elem_kind == LIST_ELEM_INT() {
                elem_type = "i64"
            } else if elem_kind == LIST_ELEM_FLOAT() {
                elem_type = "f64"
            } else if elem_kind == LIST_ELEM_STRING() {
                elem_type = "string"
            } else if elem_kind == LIST_ELEM_OTHER() {
                if g.list_elem_types.contains(var_name) {
                    elem_type = g.list_elem_types.get(var_name)
                }
            }

            let bounds_ctx = if g.array_var_names.contains(var_name) { "(array)" } else { "(list)" }
            return generate_list_index_get(g, b, elem_kind, elem_type, obj_id, idx_id, bounds_ctx)
        }
    }

    -- Unknown object type: report it, then emit an i64 list read to continue
    g = ir_type_error(g, "cannot determine the type of the indexed value", expr.line)
    let id = g.builder.next_id
    let mut inst = ir_inst_new(id, OP_LIST_GET())
    inst.lhs = ir_val_inst(obj_id)
    inst.rhs = ir_val_inst(idx_id)
    inst.result_type = "i64"
    inst.has_result = true
    b.instructions.push(inst)
    g.builder.next_id = id + 1
    return expr_result(g, b, id)
}

-- ============================================================
-- Struct Literal: TypeName { field1: val1, field2: val2, ... }
-- ============================================================

fn generate_struct_literal(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block

    -- Resolve type parameters and generic struct instances
    g = ensure_type_instances(g, expr.type_name, expr.line)
    let type_name = canon_type(g, expr.type_name)
    if g.generic_struct_params.contains(type_name) {
        g = ir_type_error(g, "generic struct '" + type_name + "' needs type arguments, e.g. " + type_name + "[int] { ... }", expr.line)
    }

    -- Look up the struct definition
    if g.struct_defs.contains(type_name) == false {
        -- Unknown struct type; return undef
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_INSERT_FIELD())
        inst.field_base = ir_val_undef()
        inst.field_value = ir_val_int(0)
        inst.field_index = 0
        inst.result_type = type_name
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return expr_result(g, b, id)
    }

    let info = g.struct_defs.get(type_name)
    let num_fields = expr.field_names.len()

    -- Build the struct value by chaining INSERT_FIELD instructions.
    -- The first insert uses undef as the base; each subsequent insert
    -- takes the result of the previous one as its base.
    let mut current_id = -1
    let mut i = 0
    while i < num_fields {
        let fname = expr.field_names[i]
        let fval_expr = map_ctor_as(g, expr.field_values[i], struct_field_src_type(g, type_name, fname))

        -- Generate the field value expression; an integer becomes the
        -- field's integer type
        let mut val_result = generate_expr(g, b, fval_expr)
        val_result = convert_int_to_place(val_result.gen, val_result.block, val_result.val_id, fval_expr, struct_field_src_type(g, type_name, fname), "field '" + fname + "' of '" + type_name + "'")
        g = val_result.gen
        b = val_result.block
        let val_id = val_result.val_id

        -- Find the field index in the struct definition
        let mut field_idx = 0
        let def_count = info.field_names.len()
        let mut fi = 0
        while fi < def_count {
            if info.field_names[fi] == fname {
                field_idx = fi
            }
            fi = fi + 1
        }

        -- Emit OP_INSERT_FIELD
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_INSERT_FIELD())

        -- Base is undef for the first field, or the previous insert result
        if current_id == -1 {
            inst.field_base = ir_val_undef()
        } else {
            inst.field_base = ir_val_inst(current_id)
        }

        inst.field_value = ir_val_inst(val_id)
        inst.field_index = field_idx
        inst.result_type = type_name
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1

        current_id = id
        i = i + 1
    }

    -- Handle empty struct (no fields specified in literal)
    if current_id == -1 {
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_INSERT_FIELD())
        inst.field_base = ir_val_undef()
        inst.field_value = ir_val_int(0)
        inst.field_index = 0
        inst.result_type = type_name
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        current_id = id
    }

    return expr_result(g, b, current_id)
}

-- ============================================================
-- Enum Literal: EnumName.VariantName or EnumName.VariantName(payload...)
-- ============================================================

-- ============================================================
-- GENERIC ENUMS
-- `enum Opt[T] { Has(T), Empty }` is one enum for each set of type
-- arguments it is used with, as a generic struct is: Opt[int] is the
-- enum Opt_i64 (ensure_type_instances). A constructor names no type
-- arguments, `Opt.Has(3)`, `Opt.Empty`: they are what the checker
-- found, from the values or from the place the value goes to.
-- ============================================================

-- Whether the generic enum has the variant
fn generic_enum_has_variant(gen: IRGenerator, enum_name: string, variant: string) -> bool {
    let decl = gen.declarations[gen.generic_struct_decls.get(enum_name)]
    let ed = *decl.enum_decl
    let mut i = 0
    while i < ed.variants.len() {
        if ed.variants[i].name == variant { return true }
        i = i + 1
    }
    return false
}

-- The type of the value that `expr`, a constructor of a variant of the
-- generic enum, makes: "Opt[int]". "" when nothing says.
fn generic_enum_type(gen: IRGenerator, expr: Expr, enum_name: string, variant: string, args: List[Expr]) -> string {
    if expr.id >= 0 and expr.id < gen.checked_types.len() {
        let checked = gen.checked_types[expr.id]
        if starts_with(checked, enum_name + "[") and string_contains(checked, "?") == false { return checked }
    }
    -- In the body of a generic function the checker records nothing:
    -- the types of the values, then the type the function returns
    let decl = gen.declarations[gen.generic_struct_decls.get(enum_name)]
    let ed = *decl.enum_decl
    let mut binds = ty_unbound(ed.generic_params.len())
    let mut vi = 0
    while vi < ed.variants.len() {
        let v = ed.variants[vi]
        if v.name == variant {
            let mut ai = 0
            while ai < args.len() and ai < v.payload_types.len() {
                binds = ty_bind(v.payload_types[ai], static_type(gen, args[ai]), ed.generic_params, binds)
                ai = ai + 1
            }
        }
        vi = vi + 1
    }
    let mut t = enum_name + "["
    let mut whole = true
    let mut bi = 0
    while bi < binds.len() {
        if binds[bi] == "" { whole = false }
        if bi > 0 { t = t + ", " }
        t = t + binds[bi]
        bi = bi + 1
    }
    if whole { return t + "]" }
    if starts_with(gen.current_return_type, enum_name + "[") { return gen.current_return_type }
    -- An instance of the function has the instance it returns by name
    let returned = canon_type(gen, gen.current_return_type)
    if gen.generic_instances.contains(returned) {
        if gen.generic_instances.get(returned) == enum_name { return returned }
    }
    return ""
}

struct EnumInstance {
    gen: IRGenerator,
    -- The instance's name; the generic enum's own when nothing says
    -- which instance it is, which is then reported
    name: string
}

-- The instance of the generic enum that `expr` makes a value of (see
-- generic_enum_type), registered
fn generic_enum_instance(gen: IRGenerator, expr: Expr, enum_name: string, variant: string, args: List[Expr]) -> EnumInstance {
    let mut g = gen
    let t = generic_enum_type(g, expr, enum_name, variant, args)
    if t == "" {
        g = ir_type_error(g, "cannot tell the type arguments of '" + enum_name + "' from '" + enum_name + "." + variant + "': give the place the value goes to a type, such as `let v: " + enum_name + "[int] = ...`", expr.line)
        return EnumInstance { gen: g, name: enum_name }
    }
    g = ensure_type_instances(g, t, expr.line)
    return EnumInstance { gen: g, name: canon_type(g, t) }
}

fn generate_enum_literal(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block

    let mut enum_name = expr.enum_name
    let variant_name = expr.variant_name
    if is_generic_enum(g, enum_name) {
        let instance = generic_enum_instance(g, expr, enum_name, variant_name, expr.payload)
        g = instance.gen
        enum_name = instance.name
    }

    -- Look up the enum definition
    if g.enum_defs.contains(enum_name) == false {
        -- Unknown enum; return a zero-tagged undef
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_INSERT_FIELD())
        inst.field_base = ir_val_undef()
        inst.field_value = ir_val_int(0)
        inst.field_index = 0
        inst.result_type = enum_name
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return expr_result(g, b, id)
    }

    let info = g.enum_defs.get(enum_name)

    -- Find the variant index and its tag value
    let mut variant_tag = 0
    let mut variant_idx = -1
    let mut has_payload = false
    let num_variants = info.variant_names.len()
    let mut vi = 0
    while vi < num_variants {
        if info.variant_names[vi] == variant_name {
            variant_tag = info.variant_tags[vi]
            variant_idx = vi
            has_payload = info.variant_has_payload[vi]
        }
        vi = vi + 1
    }

    -- Step 1: Insert tag field at index 0
    let tag_id = g.builder.next_id
    let mut tag_inst = ir_inst_new(tag_id, OP_INSERT_FIELD())
    tag_inst.field_base = ir_val_undef()
    tag_inst.field_value = ir_val_int(variant_tag)
    tag_inst.field_index = 0
    tag_inst.result_type = enum_name
    tag_inst.has_result = true
    b.instructions.push(tag_inst)
    g.builder.next_id = tag_id + 1

    let mut current_id = tag_id

    -- Step 2: If the variant has payload, generate payload expressions
    -- and insert them starting at field index 1.
    -- The field offset must skip past prior variant payload fields in the
    -- tagged union layout.
    if has_payload and variant_idx >= 0 {
        let payload = expr.payload
        let mut num_payload = payload.len()
        let payload_count = enum_payload_count(info, variant_idx)
        if num_payload != payload_count {
            g = ir_type_error(g, "variant '" + enum_name + "." + variant_name + "' carries " + values_text(payload_count) + ", not " + int_to_string(num_payload), expr.line)
            num_payload = 0
        }

        -- The variant's values go in its fields
        let field_offset = enum_payload_field(info, variant_idx)

        let mut pi = 0
        while pi < num_payload {
            let payload_expr = payload[pi]
            g = check_basic_type(g, enum_payload_type(info, variant_idx, pi), payload_expr, "value " + int_to_string(pi + 1) + " of '" + enum_name + "." + variant_name + "'")

            -- Generate the payload value
            let mut pval_result = generate_expr(g, b, payload_expr)
            pval_result = convert_int_to_place(pval_result.gen, pval_result.block, pval_result.val_id, payload_expr, enum_payload_type(info, variant_idx, pi), "value " + int_to_string(pi + 1) + " of '" + enum_name + "." + variant_name + "'")
            g = pval_result.gen
            b = pval_result.block
            let pval_id = pval_result.val_id

            -- Insert payload at the computed field index
            let id = g.builder.next_id
            let mut inst = ir_inst_new(id, OP_INSERT_FIELD())
            inst.field_base = ir_val_inst(current_id)
            inst.field_value = ir_val_inst(pval_id)
            inst.field_index = field_offset + pi
            inst.result_type = enum_name
            inst.has_result = true
            b.instructions.push(inst)
            g.builder.next_id = id + 1

            current_id = id
            pi = pi + 1
        }
    }

    return expr_result(g, b, current_id)
}

-- ============================================================
-- Array Literal: [elem1, elem2, ...]
-- ============================================================

-- Push a value that a list stores whole, such as a struct or an enum
-- value, onto the list at `list_ptr`: the runtime copies the bytes of
-- `elem_type` from a temporary that holds the value
fn push_whole_value(gen: IRGenerator, block: IRBasicBlock, list_ptr: int, val_id: int, elem_type: string) -> GenResult {
    let mut g = gen
    let mut b = block
    let temp_id = g.builder.next_id
    let mut temp_inst = ir_inst_new(temp_id, OP_ALLOCA())
    temp_inst.alloc_type = elem_type
    temp_inst.result_type = "ptr(" + elem_type + ")"
    temp_inst.has_result = true
    b.instructions.push(temp_inst)
    g.builder.next_id = g.builder.next_id + 1

    let mut store_inst = ir_inst_new(g.builder.next_id, OP_STORE())
    store_inst.store_ptr = ir_val_inst(temp_id)
    store_inst.store_val = ir_val_inst(val_id)
    store_inst.has_result = false
    b.instructions.push(store_inst)
    g.builder.next_id = g.builder.next_id + 1

    let mut push_inst = ir_inst_new(g.builder.next_id, OP_CALL())
    push_inst.callee = "dm_list_generic_push"
    let mut push_args: List[IRValue] = []
    push_args.push(ir_val_inst(list_ptr))
    push_args.push(ir_val_inst(temp_id))
    push_args.push(ir_val_sizeof(elem_type))
    push_inst.call_args = push_args
    push_inst.result_type = "void"
    push_inst.has_result = false
    b.instructions.push(push_inst)
    g.builder.next_id = g.builder.next_id + 1
    return gen_result(g, b)
}

-- The type of the elements of a list literal whose elements are
-- lists, as [[1, 2], [3]] and [xs, ys] are: "List[int]". "" for any
-- other literal. Such a list stores each element's header whole.
fn nested_list_elem_type(gen: IRGenerator, lit: Expr) -> string {
    let t = static_type(gen, lit)
    if starts_with(t, "List[") == false { return "" }
    let inner = extract_inner_type(t, "List[")
    if starts_with(inner, "List[") { return inner }
    return ""
}

-- Whether the expression is a box of a list, a map or a string
fn is_boxed_container(gen: IRGenerator, e: Expr) -> bool {
    let t = static_type(gen, e)
    if starts_with(t, "Box[") == false { return false }
    let inner = extract_inner_type(t, "Box[")
    return starts_with(inner, "List[") or inner == "string" or is_map_type(gen, inner)
}

-- What is indexed or has a list's method called on it: a list, a map
-- or a string in a box stands for what is in the box, so b[i] is
-- (*b)[i] and b.len() is (*b).len(). Any other expression is itself.
fn unboxed_container(gen: IRGenerator, e: Expr) -> Expr {
    if is_boxed_container(gen, e) { return expr_unary(UNOP_DEREF(), e, e.line, e.col) }
    return e
}

-- List_new() and List.new(): the empty list
fn is_list_ctor(e: Expr) -> bool {
    if e.args.len() != 0 { return false }
    if e.kind == EXPR_FUNCTION_CALL() {
        let c = *e.callee
        return c.kind == EXPR_IDENTIFIER() and c.name == "List_new"
    }
    if e.kind == EXPR_METHOD_CALL() and e.method == "new" {
        let o = *e.object
        return o.kind == EXPR_IDENTIFIER() and o.name == "List"
    }
    return false
}

fn generate_array_literal(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block

    let elements = expr.elements
    let num_elements = elements.len()

    -- Empty array: create a new empty list
    if num_elements == 0 {
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_LIST_NEW())
        inst.result_type = "list"
        inst.has_result = true
        b.instructions.push(inst)
        g.builder.next_id = id + 1
        return expr_result(g, b, id)
    }

    -- Generate all element expressions first to determine types
    let mut elem_ids: List[int] = []
    let mut i = 0
    while i < num_elements {
        let elem_result = generate_expr(g, b, elements[i])
        g = elem_result.gen
        b = elem_result.block
        elem_ids.push(elem_result.val_id)
        i = i + 1
    }

    -- Infer element type from the first element
    let mut elem_ir_type = infer_expr_type(g, elements[0])
    let nested = nested_list_elem_type(g, expr)
    if nested != "" { elem_ir_type = nested }
    -- An Option or a Result is stored whole; the first element may be
    -- a None, so its type is the one the checker found for the list
    let mut whole_elem = false
    let lit_src = checked_type(g, expr)
    if starts_with(lit_src, "List[Option[") or starts_with(lit_src, "List[Result[") {
        elem_ir_type = map_type_name(substr(lit_src, 5, len(lit_src) - 6))
        whole_elem = true
    }

    -- Determine which list new/push functions to use
    let mut new_fn = "dm_list_int64_new"
    let mut push_fn = "dm_list_int64_push"
    if elem_ir_type == "f64" or elem_ir_type == "float" {
        new_fn = "dm_list_double_new"
        push_fn = "dm_list_double_push"
    } else if elem_ir_type == "string" {
        new_fn = "dm_list_string_new"
        push_fn = "dm_list_string_push"
    } else if g.struct_defs.contains(elem_ir_type) or g.enum_defs.contains(elem_ir_type) or nested != "" or whole_elem {
        -- Structs, enum values and lists are stored whole
        new_fn = "dm_list_generic_new"
        push_fn = "dm_list_generic_push"
    }

    -- Create list alloca and call new function (sret pattern)
    let alloca_id = g.builder.next_id
    let mut alloca_inst = ir_inst_new(alloca_id, OP_ALLOCA())
    alloca_inst.alloc_type = "list"
    alloca_inst.result_type = "ptr(list)"
    alloca_inst.has_result = true
    b.instructions.push(alloca_inst)
    g.builder.next_id = g.builder.next_id + 1

    let mut call_new = ir_inst_new(g.builder.next_id, OP_CALL())
    call_new.callee = new_fn
    let mut new_args: List[IRValue] = []
    new_args.push(ir_val_inst(alloca_id))
    call_new.call_args = new_args
    call_new.result_type = "void"
    call_new.has_result = false
    b.instructions.push(call_new)
    g.builder.next_id = g.builder.next_id + 1

    -- Push each element into the list
    let mut pi = 0
    if push_fn == "dm_list_generic_push" {
        while pi < num_elements {
            let pushed = push_whole_value(g, b, alloca_id, elem_ids[pi], elem_ir_type)
            g = pushed.gen
            b = pushed.block
            pi = pi + 1
        }
    }
    while pi < num_elements {
        let mut push_call = ir_inst_new(g.builder.next_id, OP_CALL())
        push_call.callee = push_fn
        let mut push_args: List[IRValue] = []
        push_args.push(ir_val_inst(alloca_id))
        push_args.push(ir_val_inst(elem_ids[pi]))
        push_call.call_args = push_args
        push_call.result_type = "void"
        push_call.has_result = false
        b.instructions.push(push_call)
        g.builder.next_id = g.builder.next_id + 1
        pi = pi + 1
    }

    return expr_result(g, b, alloca_id)
}

-- ============================================================
-- EXPRESSION IR GENERATION PART 5
-- If expressions, match expressions, block expressions,
-- lambda expressions, pipeline operator, error propagation,
-- string interpolation, and comptime expressions.
-- ============================================================

-- ============================================================
-- IF EXPRESSION (returns a value)
-- ============================================================

fn generate_if_expr(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block

    -- Generate condition expression
    let cond_result = generate_expr(g, b, *expr.condition)
    g = cond_result.gen
    b = cond_result.block
    let cond_id = cond_result.val_id

    -- Create labels for then, else, and join blocks
    let then_label = gen_next_label(g, "if_then")
    g = gen_advance_label(g)
    let else_label = gen_next_label(g, "if_else")
    g = gen_advance_label(g)
    let join_label = gen_next_label(g, "if_join")
    g = gen_advance_label(g)

    -- Infer result type from the branches' trailing expressions
    let mut if_result_type = infer_expr_type(g, expr)
    if if_result_type == "void" {
        if_result_type = "i64"
    }

    -- Allocate a result slot before branching so both branches can store into it
    let result_alloca_id = g.builder.next_id
    let mut result_alloca = ir_inst_new(result_alloca_id, OP_ALLOCA())
    result_alloca.alloc_type = if_result_type
    result_alloca.result_type = "ptr(" + if_result_type + ")"
    result_alloca.has_result = true
    b.instructions.push(result_alloca)
    g.builder.next_id = g.builder.next_id + 1

    -- Terminate current block with conditional branch
    if expr.has_else {
        b.terminator = Box_new(term_br_cond(ir_val_inst(cond_id), then_label, else_label))
        b.has_terminator = true
        g.completed_blocks.push(b)
    } else {
        b.terminator = Box_new(term_br_cond(ir_val_inst(cond_id), then_label, join_label))
        b.has_terminator = true
        g.completed_blocks.push(b)
    }

    -- Generate then block
    let mut then_block = ir_block_new(then_label)
    let then_result = generate_expr(g, then_block, *expr.then_branch)
    g = then_result.gen
    then_block = then_result.block

    -- Store then result into the result slot
    let stored_then = store_branch_value(g, then_block, result_alloca_id, if_result_type, then_result.val_id, *expr.then_branch)
    g = stored_then.gen
    then_block = stored_then.block

    -- Terminate then block with branch to join
    if then_block.has_terminator == false {
        then_block.terminator = Box_new(term_br(join_label))
        then_block.has_terminator = true
    }
    g.completed_blocks.push(then_block)
    -- Generate else block
    let mut else_block = ir_block_new(else_label)
    if expr.has_else {
        let else_result = generate_expr(g, else_block, *expr.else_branch)
        g = else_result.gen
        else_block = else_result.block

        -- Store else result into the result slot
        let stored_else = store_branch_value(g, else_block, result_alloca_id, if_result_type, else_result.val_id, *expr.else_branch)
        g = stored_else.gen
        else_block = stored_else.block

        if else_block.has_terminator == false {
            else_block.terminator = Box_new(term_br(join_label))
            else_block.has_terminator = true
        }
        g.completed_blocks.push(else_block)
    } else {
        -- No else branch: store a default value
        let mut default_store = ir_inst_new(g.builder.next_id, OP_STORE())
        default_store.store_ptr = ir_val_inst(result_alloca_id)
        default_store.store_val = ir_val_int(0)
        default_store.has_result = false
        else_block.instructions.push(default_store)
        g.builder.next_id = g.builder.next_id + 1

        else_block.terminator = Box_new(term_br(join_label))
        else_block.has_terminator = true
        g.completed_blocks.push(else_block)
    }

    -- Create join block and load the result
    let mut join_block = ir_block_new(join_label)
    let load_id = g.builder.next_id
    let mut load_inst = ir_inst_new(load_id, OP_LOAD())
    load_inst.load_ptr = ir_val_inst(result_alloca_id)
    load_inst.load_type = if_result_type
    load_inst.result_type = if_result_type
    load_inst.has_result = true
    join_block.instructions.push(load_inst)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, join_block, load_id)
}

-- ============================================================
-- MATCH EXPRESSION (returns a value)
-- ============================================================

fn generate_match_expr(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block

    -- Generate scrutinee
    let scrut_result = generate_expr(g, b, *expr.scrutinee)
    g = scrut_result.gen
    b = scrut_result.block
    let scrut_id = scrut_result.val_id

    -- Determine the scrutinee type to route to specialized match
    let scrut_expr = *expr.scrutinee

    -- Check if scrutinee is a known enum variable
    if scrut_expr.kind == EXPR_IDENTIFIER() {
        let scrut_name = scrut_expr.name
        if g.var_enum_types.contains(scrut_name) {
            let enum_type = g.var_enum_types.get(scrut_name)
            return generate_enum_match(g, b, expr, scrut_id, enum_type)
        }
    }

    -- Check match arms for enum variant patterns to detect enum matching:
    -- the first arm that names a variant says which kind of value it is
    let mut variant_arm = 0
    while variant_arm < expr.match_arms.len() and expr.match_arms[variant_arm].pattern.kind != PAT_ENUM_VARIANT() {
        variant_arm = variant_arm + 1
    }
    if variant_arm < expr.match_arms.len() {
        let first_arm = expr.match_arms[variant_arm]
        let first_pat = first_arm.pattern

        -- Check for bare Ok/Err patterns (Result type)
        if first_pat.kind == PAT_ENUM_VARIANT() {
            let variant = first_pat.variant
            if variant == "Ok" or variant == "Err" {
                -- Determine the Result type for correct field types
                let mut result_type_name = ""
                if scrut_expr.kind == EXPR_IDENTIFIER() {
                    if g.variable_types.contains(scrut_expr.name) {
                        result_type_name = g.variable_types.get(scrut_expr.name)
                    }
                }
                if starts_with(result_type_name, "Result[") == false {
                    -- A call, a field or a variable with no annotation
                    let scrut_src = canon_type(g, static_type(g, scrut_expr))
                    if starts_with(scrut_src, "Result[") {
                        result_type_name = scrut_src
                    }
                }
                return generate_result_match(g, b, expr, scrut_id, result_type_name)
            }
            if variant == "Some" or variant == "None" {
                let mut option_type_name = ""
                if scrut_expr.kind == EXPR_IDENTIFIER() {
                    if g.variable_types.contains(scrut_expr.name) {
                        option_type_name = g.variable_types.get(scrut_expr.name)
                    }
                }
                if starts_with(option_type_name, "Option[") == false {
                    let scrut_src = canon_type(g, static_type(g, scrut_expr))
                    if starts_with(scrut_src, "Option[") {
                        option_type_name = scrut_src
                    }
                }
                return generate_option_match(g, b, expr, scrut_id, option_type_name)
            }
            -- General enum variant pattern with known type
            if len(first_pat.enum_type) > 0 {
                let mut matched_enum = first_pat.enum_type
                if is_generic_enum(g, matched_enum) {
                    -- Which instance it is, the matched value's type says
                    matched_enum = canon_type(g, static_type(g, scrut_expr))
                    if g.enum_defs.contains(matched_enum) == false {
                        g = ir_type_error(g, "cannot tell which '" + first_pat.enum_type + "' this match is on: give the matched value a type", expr.line)
                        return expr_result(g, b, scrut_id)
                    }
                }
                return generate_enum_match(g, b, expr, scrut_id, matched_enum)
            }
        }
    }

    -- Default: literal/identifier matching with cascading if-else
    return generate_literal_match(g, b, expr, scrut_id)
}

-- ============================================================
-- MATCH RESULT TYPE INFERENCE
-- ============================================================

fn generate_literal_match(gen: IRGenerator, block: IRBasicBlock, expr: Expr, scrut_id: int) -> ExprResult {
    let mut g = gen
    let mut b = block

    -- The type of the matched value, for an arm that binds it to a name
    let scrut_bind_type = static_type(g, *expr.scrutinee)

    -- Infer the match result type from arm bodies
    let match_type = match_slot_type(g, expr, infer_match_result_type(g, expr.match_arms))

    -- Allocate result slot
    let result_alloca_id = g.builder.next_id
    let mut result_alloca = ir_inst_new(result_alloca_id, OP_ALLOCA())
    result_alloca.alloc_type = slot_alloc_type(match_type)
    result_alloca.result_type = "ptr(" + slot_alloc_type(match_type) + ")"
    result_alloca.has_result = true
    b.instructions.push(result_alloca)
    g.builder.next_id = g.builder.next_id + 1

    let join_label = gen_next_label(g, "match_end")
    g = gen_advance_label(g)

    -- Process each arm as cascading if-else
    let mut final_block_pushed = false
    let mut arm_idx = 0
    while arm_idx < expr.match_arms.len() {
        let arm = expr.match_arms[arm_idx]
        let pat = arm.pattern

        let arm_label = gen_next_label(g, "match_arm")
        g = gen_advance_label(g)
        let next_label = gen_next_label(g, "match_next")
        g = gen_advance_label(g)

        if pat.kind == PAT_WILDCARD() or pat.kind == PAT_IDENTIFIER() {
            -- Bind identifier if needed
            if pat.kind == PAT_IDENTIFIER() {
                -- Bind the scrutinee value to the pattern name
                -- The name is a variable of the matched value's type
                let mut bind_type = "i64"
                if scrut_bind_type != "" {
                    bind_type = map_type_name(canon_type(g, scrut_bind_type))
                }
                let bind_alloca_id = g.builder.next_id
                let mut bind_alloca = ir_inst_new(bind_alloca_id, OP_ALLOCA())
                bind_alloca.alloc_type = bind_type
                bind_alloca.result_type = "ptr(" + bind_type + ")"
                bind_alloca.has_result = true
                b.instructions.push(bind_alloca)
                g.builder.next_id = g.builder.next_id + 1

                let mut bind_store = ir_inst_new(g.builder.next_id, OP_STORE())
                bind_store.store_ptr = ir_val_inst(bind_alloca_id)
                bind_store.store_val = ir_val_inst(scrut_id)
                bind_store.has_result = false
                b.instructions.push(bind_store)
                g.builder.next_id = g.builder.next_id + 1

                g.variable_map.insert(pat.name, bind_alloca_id)
                g.variable_types.insert(pat.name, bind_type)
                if scrut_bind_type != "" {
                    g = track_bound_variable(g, pat.name, scrut_bind_type)
                }
            }

            -- If there is a guard condition, evaluate it and branch
            if arm.has_guard {
                let guard_result = generate_expr(g, b, *arm.guard)
                g = guard_result.gen
                b = guard_result.block

                -- Branch: if guard is true, execute arm body; else go to next arm
                b.terminator = Box_new(term_br_cond(ir_val_inst(guard_result.val_id), arm_label, next_label))
                b.has_terminator = true
                g.completed_blocks.push(b)

                -- Generate arm body in arm_block
                let mut arm_block = ir_block_new(arm_label)
                if arm.is_expr_body {
                    let body_result = generate_expr(g, arm_block, *arm.body_expr)
                    g = body_result.gen
                    arm_block = body_result.block

                    let stored_body = store_branch_value(g, arm_block, result_alloca_id, match_type, body_result.val_id, *arm.body_expr)
                    g = stored_body.gen
                    arm_block = stored_body.block
                } else {
                    let body_gen = generate_arm_block(g, arm_block, arm.body, result_alloca_id, match_type)
                    g = body_gen.gen
                    arm_block = body_gen.block
                }

                if arm_block.has_terminator == false {
                    arm_block.terminator = Box_new(term_br(join_label))
                    arm_block.has_terminator = true
                }
                g.completed_blocks.push(arm_block)

                -- Continue to next arm (set up next block)
                b = ir_block_new(next_label)
                arm_idx = arm_idx + 1
            } else {
                -- No guard: always matches (catch-all)
                -- Generate arm body directly in current block
                if arm.is_expr_body {
                    let body_result = generate_expr(g, b, *arm.body_expr)
                    g = body_result.gen
                    b = body_result.block

                    let stored_body = store_branch_value(g, b, result_alloca_id, match_type, body_result.val_id, *arm.body_expr)
                    g = stored_body.gen
                    b = stored_body.block
                } else {
                    let body_gen = generate_arm_block(g, b, arm.body, result_alloca_id, match_type)
                    g = body_gen.gen
                    b = body_gen.block
                }

                if b.has_terminator == false {
                    b.terminator = Box_new(term_br(join_label))
                    b.has_terminator = true
                }
                g.completed_blocks.push(b)
                final_block_pushed = true

                -- Wildcard/identifier without guard is the catch-all, break out of loop
                arm_idx = expr.match_arms.len()
            }
        } else if pat.kind == PAT_LITERAL() {
            -- Generate comparison of scrutinee with literal
            let lit_expr = *pat.literal_expr
            let lit_result = generate_expr(g, b, lit_expr)
            g = lit_result.gen
            b = lit_result.block

            -- Compare scrutinee with literal value: strings by their text
            let cmp_id = g.builder.next_id
            let mut cmp_op = OP_EQ()
            if lit_expr.kind == EXPR_LITERAL_STRING() {
                cmp_op = OP_STRING_EQ()
            }
            let mut cmp_inst = ir_inst_new(cmp_id, cmp_op)
            cmp_inst.lhs = ir_val_inst(scrut_id)
            cmp_inst.rhs = ir_val_inst(lit_result.val_id)
            cmp_inst.result_type = "bool"
            cmp_inst.has_result = true
            b.instructions.push(cmp_inst)
            g.builder.next_id = g.builder.next_id + 1

            -- Check guard if present
            if arm.has_guard {
                let guard_result = generate_expr(g, b, *arm.guard)
                g = guard_result.gen
                b = guard_result.block

                -- AND the pattern match with the guard condition
                let and_id = g.builder.next_id
                let mut and_inst = ir_inst_new(and_id, OP_LOGICAL_AND())
                and_inst.lhs = ir_val_inst(cmp_id)
                and_inst.rhs = ir_val_inst(guard_result.val_id)
                and_inst.result_type = "bool"
                and_inst.has_result = true
                b.instructions.push(and_inst)
                g.builder.next_id = g.builder.next_id + 1

                b.terminator = Box_new(term_br_cond(ir_val_inst(and_id), arm_label, next_label))
                b.has_terminator = true
            } else {
                b.terminator = Box_new(term_br_cond(ir_val_inst(cmp_id), arm_label, next_label))
                b.has_terminator = true
            }
            g.completed_blocks.push(b)

            -- Generate arm body in arm_block
            let mut arm_block = ir_block_new(arm_label)
            if arm.is_expr_body {
                let body_result = generate_expr(g, arm_block, *arm.body_expr)
                g = body_result.gen
                arm_block = body_result.block

                let stored_body = store_branch_value(g, arm_block, result_alloca_id, match_type, body_result.val_id, *arm.body_expr)
                g = stored_body.gen
                arm_block = stored_body.block
            } else {
                let body_gen = generate_arm_block(g, arm_block, arm.body, result_alloca_id, match_type)
                g = body_gen.gen
                arm_block = body_gen.block
            }

            if arm_block.has_terminator == false {
                arm_block.terminator = Box_new(term_br(join_label))
                arm_block.has_terminator = true
            }
            g.completed_blocks.push(arm_block)

            -- Continue with next_label as the new current block
            b = ir_block_new(next_label)
            arm_idx = arm_idx + 1
        } else {
            -- Unsupported pattern kind in literal match, skip
            arm_idx = arm_idx + 1
        }
    }

    -- If we fell through all arms without a wildcard, branch to join
    if b.has_terminator == false {
        b.terminator = Box_new(term_br(join_label))
        b.has_terminator = true
    }
    if final_block_pushed == false { g.completed_blocks.push(b) }

    -- Create join block and load result
    let mut join_block = ir_block_new(join_label)
    let load_id = g.builder.next_id
    let mut load_inst = ir_inst_new(load_id, OP_LOAD())
    load_inst.load_ptr = ir_val_inst(result_alloca_id)
    load_inst.load_type = slot_alloc_type(match_type)
    load_inst.result_type = slot_alloc_type(match_type)
    load_inst.has_result = true
    join_block.instructions.push(load_inst)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, join_block, load_id)
}

-- ============================================================
-- ENUM MATCH
-- ============================================================

fn generate_enum_match(gen: IRGenerator, block: IRBasicBlock, expr: Expr, scrut_id: int, enum_type: string) -> ExprResult {
    if gen.enum_defs.contains(enum_type) == false {
        return generate_literal_match(gen, block, expr, scrut_id)
    }
    return generate_variant_match(gen, block, expr, scrut_id, gen.enum_defs.get(enum_type), enum_type)
}

-- A Result is matched as the enum it is laid out as: the tag, 0 for
-- Ok, then Ok's value and Err's value
fn generate_result_match(gen: IRGenerator, block: IRBasicBlock, expr: Expr, scrut_id: int, result_type_name: string) -> ExprResult {
    let mut ok_type = "int"
    let mut err_type = "int"
    if starts_with(result_type_name, "Result[") {
        let res_args = split_type_args(extract_inner_type(result_type_name, "Result["))
        if res_args.len() == 2 {
            ok_type = res_args[0]
            err_type = res_args[1]
        }
    }
    let mut info = enum_info_new("Result")
    info.variant_names.push("Ok")
    info.variant_tags.push(0)
    info.variant_payload_types.push(ok_type)
    info.variant_has_payload.push(true)
    info.variant_payloads.push(ok_type)
    info.variant_names.push("Err")
    info.variant_tags.push(1)
    info.variant_payload_types.push(err_type)
    info.variant_has_payload.push(true)
    info.variant_payloads.push(err_type)
    return generate_variant_match(gen, block, expr, scrut_id, info, result_type_name)
}

-- An Option is matched as the enum it is laid out as: the tag, 1 for
-- Some, then Some's value
fn generate_option_match(gen: IRGenerator, block: IRBasicBlock, expr: Expr, scrut_id: int, option_type_name: string) -> ExprResult {
    let mut some_type = "int"
    if starts_with(option_type_name, "Option[") {
        some_type = extract_inner_type(option_type_name, "Option[")
    }
    let mut info = enum_info_new("Option")
    info.variant_names.push("Some")
    info.variant_tags.push(1)
    info.variant_payload_types.push(some_type)
    info.variant_has_payload.push(true)
    info.variant_payloads.push(some_type)
    info.variant_names.push("None")
    info.variant_tags.push(0)
    info.variant_payload_types.push("")
    info.variant_has_payload.push(false)
    info.variant_payloads.push("")
    return generate_variant_match(gen, block, expr, scrut_id, info, option_type_name)
}

-- A match on the variants of an enum, an Option or a Result. The arms
-- are tried in the order they are written: an arm of a variant is
-- taken when the value is that variant and the arm's guard, if it has
-- one, holds; a name or `_` takes any value. `scrut_type` is the type
-- of the matched value, "" when it is not known.
fn generate_variant_match(gen: IRGenerator, block: IRBasicBlock, expr: Expr, scrut_id: int, enum_info: EnumInfo, scrut_type: string) -> ExprResult {
    let mut g = gen
    let mut b = block
    let enum_type = enum_info.name
    -- The type of the matched value, for an arm that binds it to a name
    let scrut_bind_type = scrut_type

    -- Infer match result type from arm bodies
    let ematch_type = match_slot_type(g, expr, infer_match_result_type(g, expr.match_arms))

    -- Allocate result slot
    let result_alloca_id = g.builder.next_id
    let mut result_alloca = ir_inst_new(result_alloca_id, OP_ALLOCA())
    result_alloca.alloc_type = slot_alloc_type(ematch_type)
    result_alloca.result_type = "ptr(" + slot_alloc_type(ematch_type) + ")"
    result_alloca.has_result = true
    b.instructions.push(result_alloca)
    g.builder.next_id = g.builder.next_id + 1

    -- Extract tag from scrutinee (field 0)
    let tag_id = g.builder.next_id
    let mut tag_inst = ir_inst_new(tag_id, OP_EXTRACT_FIELD())
    tag_inst.field_base = ir_val_inst(scrut_id)
    tag_inst.field_index = 0
    tag_inst.field_type = "i32"
    tag_inst.result_type = "i32"
    tag_inst.has_result = true
    b.instructions.push(tag_inst)
    g.builder.next_id = g.builder.next_id + 1

    let join_label = gen_next_label(g, "ematch_end")
    g = gen_advance_label(g)

    -- Process each arm
    let mut final_block_pushed = false
    let mut arm_idx = 0
    while arm_idx < expr.match_arms.len() {
        let arm = expr.match_arms[arm_idx]
        let pat = arm.pattern

        let arm_label = gen_next_label(g, "ematch_arm")
        g = gen_advance_label(g)
        let next_label = gen_next_label(g, "ematch_next")
        g = gen_advance_label(g)

        if pat.kind == PAT_WILDCARD() or pat.kind == PAT_IDENTIFIER() {
            -- Catch-all: bind if identifier
            if pat.kind == PAT_IDENTIFIER() {
                -- The name is a variable of the matched value's type
                let mut bind_type = "i64"
                if scrut_bind_type != "" {
                    bind_type = map_type_name(canon_type(g, scrut_bind_type))
                }
                let bind_alloca_id = g.builder.next_id
                let mut bind_alloca = ir_inst_new(bind_alloca_id, OP_ALLOCA())
                bind_alloca.alloc_type = bind_type
                bind_alloca.result_type = "ptr(" + bind_type + ")"
                bind_alloca.has_result = true
                b.instructions.push(bind_alloca)
                g.builder.next_id = g.builder.next_id + 1

                let mut bind_store = ir_inst_new(g.builder.next_id, OP_STORE())
                bind_store.store_ptr = ir_val_inst(bind_alloca_id)
                bind_store.store_val = ir_val_inst(scrut_id)
                bind_store.has_result = false
                b.instructions.push(bind_store)
                g.builder.next_id = g.builder.next_id + 1

                g.variable_map.insert(pat.name, bind_alloca_id)
                g.variable_types.insert(pat.name, bind_type)
                if scrut_bind_type != "" {
                    g = track_bound_variable(g, pat.name, scrut_bind_type)
                }
            }

            -- With a guard, the arm is taken when the guard holds
            if arm.has_guard {
                let guard = generate_expr(g, b, *arm.guard)
                g = guard.gen
                b = guard.block
                b.terminator = Box_new(term_br_cond(ir_val_inst(guard.val_id), arm_label, next_label))
                b.has_terminator = true
                g.completed_blocks.push(b)
                b = ir_block_new(arm_label)
            }

            -- Generate arm body in current block
            if arm.is_expr_body {
                let body_result = generate_expr(g, b, *arm.body_expr)
                g = body_result.gen
                b = body_result.block

                let stored_body = store_branch_value(g, b, result_alloca_id, ematch_type, body_result.val_id, *arm.body_expr)
                g = stored_body.gen
                b = stored_body.block
            } else {
                let body_gen = generate_arm_block(g, b, arm.body, result_alloca_id, ematch_type)
                g = body_gen.gen
                b = body_gen.block
            }

            if b.has_terminator == false {
                b.terminator = Box_new(term_br(join_label))
                b.has_terminator = true
            }
            g.completed_blocks.push(b)
            if arm.has_guard {
                b = ir_block_new(next_label)
                arm_idx = arm_idx + 1
            } else {
                -- No arm after this one is reached
                final_block_pushed = true
                arm_idx = expr.match_arms.len()
            }
        } else if pat.kind == PAT_ENUM_VARIANT() {
            -- Find variant tag value from enum definition
            let variant_name = pat.variant
            let variant_index = enum_variant_index(enum_info, variant_name)
            let mut variant_tag = -1
            let mut payload_count = 0
            if variant_index >= 0 {
                variant_tag = enum_info.variant_tags[variant_index]
                payload_count = enum_payload_count(enum_info, variant_index)
            } else {
                g = ir_type_error(g, "enum '" + enum_type + "' has no variant '" + variant_name + "'", expr.line)
            }
            if pat.bindings.len() > payload_count and variant_index >= 0 {
                g = ir_type_error(g, "variant '" + enum_type + "." + variant_name + "' carries " + values_text(payload_count) + ", but the pattern binds " + int_to_string(pat.bindings.len()), expr.line)
            }

            -- Compare tag with variant tag
            let cmp_id = g.builder.next_id
            let mut cmp_inst = ir_inst_new(cmp_id, OP_EQ())
            cmp_inst.lhs = ir_val_inst(tag_id)
            cmp_inst.rhs = ir_val_int(variant_tag)
            cmp_inst.result_type = "bool"
            cmp_inst.has_result = true
            b.instructions.push(cmp_inst)
            g.builder.next_id = g.builder.next_id + 1

            b.terminator = Box_new(term_br_cond(ir_val_inst(cmp_id), arm_label, next_label))
            b.has_terminator = true
            g.completed_blocks.push(b)

            -- Generate arm body in arm_block
            let mut arm_block = ir_block_new(arm_label)

            -- Bind the variant's values: each is a variable of its type
            let mut bi = 0
            while bi < pat.bindings.len() and bi < payload_count {
                let bind_name = pat.bindings[bi]
                let payload_src = enum_payload_type(enum_info, variant_index, bi)
                let payload_type = map_type_name(payload_src)

                let payload_id = g.builder.next_id
                let mut payload_inst = ir_inst_new(payload_id, OP_EXTRACT_FIELD())
                payload_inst.field_base = ir_val_inst(scrut_id)
                payload_inst.field_index = enum_payload_field(enum_info, variant_index) + bi
                payload_inst.field_type = payload_type
                payload_inst.result_type = payload_type
                payload_inst.has_result = true
                arm_block.instructions.push(payload_inst)
                g.builder.next_id = g.builder.next_id + 1

                let bind_alloca_id = g.builder.next_id
                let mut bind_alloca = ir_inst_new(bind_alloca_id, OP_ALLOCA())
                bind_alloca.alloc_type = payload_type
                bind_alloca.result_type = "ptr(" + payload_type + ")"
                bind_alloca.has_result = true
                arm_block.instructions.push(bind_alloca)
                g.builder.next_id = g.builder.next_id + 1

                let mut bind_store = ir_inst_new(g.builder.next_id, OP_STORE())
                bind_store.store_ptr = ir_val_inst(bind_alloca_id)
                bind_store.store_val = ir_val_inst(payload_id)
                bind_store.has_result = false
                arm_block.instructions.push(bind_store)
                g.builder.next_id = g.builder.next_id + 1

                g.variable_map.insert(bind_name, bind_alloca_id)
                g = track_bound_variable(g, bind_name, payload_src)
                bi = bi + 1
            }

            -- With a guard, which may read the values just bound, the
            -- arm is taken when the guard holds; the arms after it are
            -- tried when it does not
            if arm.has_guard {
                let guard = generate_expr(g, arm_block, *arm.guard)
                g = guard.gen
                arm_block = guard.block
                let body_label = gen_next_label(g, "ematch_body")
                g = gen_advance_label(g)
                arm_block.terminator = Box_new(term_br_cond(ir_val_inst(guard.val_id), body_label, next_label))
                arm_block.has_terminator = true
                g.completed_blocks.push(arm_block)
                arm_block = ir_block_new(body_label)
            }

            if arm.is_expr_body {
                let body_result = generate_expr(g, arm_block, *arm.body_expr)
                g = body_result.gen
                arm_block = body_result.block

                let stored_body = store_branch_value(g, arm_block, result_alloca_id, ematch_type, body_result.val_id, *arm.body_expr)
                g = stored_body.gen
                arm_block = stored_body.block
            } else {
                let body_gen = generate_arm_block(g, arm_block, arm.body, result_alloca_id, ematch_type)
                g = body_gen.gen
                arm_block = body_gen.block
            }

            if arm_block.has_terminator == false {
                arm_block.terminator = Box_new(term_br(join_label))
                arm_block.has_terminator = true
            }
            g.completed_blocks.push(arm_block)

            -- Move to next arm's block
            b = ir_block_new(next_label)
            arm_idx = arm_idx + 1
        } else {
            arm_idx = arm_idx + 1
        }
    }

    -- If we fell through all arms, branch to join
    if b.has_terminator == false {
        b.terminator = Box_new(term_br(join_label))
        b.has_terminator = true
    }
    if final_block_pushed == false { g.completed_blocks.push(b) }

    -- Create join block and load result
    let mut join_block = ir_block_new(join_label)
    let load_id = g.builder.next_id
    let mut load_inst = ir_inst_new(load_id, OP_LOAD())
    load_inst.load_ptr = ir_val_inst(result_alloca_id)
    load_inst.load_type = slot_alloc_type(ematch_type)
    load_inst.result_type = slot_alloc_type(ematch_type)
    load_inst.has_result = true
    join_block.instructions.push(load_inst)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, join_block, load_id)
}

-- ============================================================
-- BLOCK EXPRESSION
-- ============================================================

-- Whether the block, which ends in an `if` or a `match` statement, has
-- that statement's value: as the checker found, and where it recorded
-- nothing (the body of a generic function), as the statement's
-- branches say
fn block_ends_in_value(gen: IRGenerator, expr: Expr) -> bool {
    if expr.id >= 0 and expr.id < gen.checked_types.len() {
        let checked = gen.checked_types[expr.id]
        if checked == "void" { return false }
        if checked != "" { return true }
    }
    let last = expr.stmts[expr.stmts.len() - 1]
    return infer_expr_type(gen, stmt_value_expr(last)) != "void"
}

fn generate_block_expr(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block

    -- A block whose last statement is a non-void expression, such as an
    -- `if` branch `{ a }`, has that expression's value
    let n = expr.stmts.len()
    if expr.has_result == false and n > 0 {
        let last = expr.stmts[n - 1]
        if last.kind == STMT_EXPRESSION() and infer_expr_type(g, *last.expr) != "void" {
            let mut lead: List[Stmt] = []
            let mut li = 0
            while li < n - 1 {
                lead.push(expr.stmts[li])
                li = li + 1
            }
            let lead_result = generate_block_stmts(g, b, lead)
            g = lead_result.gen
            b = lead_result.block
            if b.has_terminator {
                return expr_result(g, b, g.builder.next_id - 1)
            }
            return generate_expr(g, b, *last.expr)
        }
        -- A block that ends in an `if` with an `else` or in a `match`
        -- has that statement's value, unless the checker found that
        -- it gives none
        if last.kind != STMT_EXPRESSION() and stmt_gives_value(last) and block_ends_in_value(g, expr) {
            let mut lead: List[Stmt] = []
            let mut li = 0
            while li < n - 1 {
                lead.push(expr.stmts[li])
                li = li + 1
            }
            let lead_result = generate_block_stmts(g, b, lead)
            g = lead_result.gen
            b = lead_result.block
            if b.has_terminator {
                return expr_result(g, b, g.builder.next_id - 1)
            }
            return generate_expr(g, b, stmt_value_expr(last))
        }
    }

    -- Generate all statements in the block
    let stmts_result = generate_block_stmts(g, b, expr.stmts)
    g = stmts_result.gen
    b = stmts_result.block

    -- If the block already has a terminator (e.g., from a return statement), just return
    if b.has_terminator {
        return expr_result(g, b, g.builder.next_id - 1)
    }

    -- If the block has a result expression, generate it and return its value
    if expr.has_result {
        let result = generate_expr(g, b, *expr.result)
        return result
    }

    -- No result expression: return undef-like value (alloca of 0)
    let id = g.builder.next_id
    let mut inst = ir_inst_new(id, OP_ALLOCA())
    inst.alloc_type = "i64"
    inst.result_type = "ptr(i64)"
    inst.has_result = true
    b.instructions.push(inst)
    g.builder.next_id = id + 1

    let mut store = ir_inst_new(g.builder.next_id, OP_STORE())
    store.store_ptr = ir_val_inst(id)
    store.store_val = ir_val_int(0)
    store.has_result = false
    b.instructions.push(store)
    g.builder.next_id = g.builder.next_id + 1

    let load_id = g.builder.next_id
    let mut load = ir_inst_new(load_id, OP_LOAD())
    load.load_ptr = ir_val_inst(id)
    load.load_type = "i64"
    load.result_type = "i64"
    load.has_result = true
    b.instructions.push(load)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, b, load_id)
}

-- ============================================================
-- FUNCTION VALUES
-- A value of a type fn(A, B) -> R is the address of a closure: memory
-- that begins with the address of a function and goes on with what
-- that function needs besides its arguments. The function takes the
-- closure's address and then A and B. So every function value is
-- called the same way, whatever made it (generate_value_call): the
-- function's address is loaded from the closure, and the function is
-- called with the closure and the arguments.
--
-- A lambda's closure holds the values of the variables of the function
-- around it that the lambda's body names, as they are when the lambda
-- is made; the lambda's function begins by copying them into variables
-- of its own (generate_lambda_expr). The closure is allocated and
-- never freed, as a string is. A lambda that names none of those
-- variables needs nothing with it, and neither does a function used by
-- its name: such a closure is one word of the program's own storage
-- (emit_static_closure). A function declared with `fn` takes no
-- closure, so its value is made with a function the compiler writes,
-- which takes one and calls it (value_function).
--
-- A C function cannot call a closure. An `extern fn` whose parameter
-- has a function type takes the address of a function, which the
-- argument must name (generate_c_function_arg).
-- ============================================================

-- The function type of what a call calls, when that is a value: a
-- variable that holds a function, or an expression that is not a
-- name. "" for a call of a function by its name.
fn called_value_type(gen: IRGenerator, callee: Expr) -> string {
    if callee.kind == EXPR_IDENTIFIER() and gen.variable_map.contains(callee.name) == false {
        return ""
    }
    let t = static_type(gen, callee)
    if starts_with(t, "fn(") { return t }
    return ""
}

-- The function type of a lambda: its parameters and its result as
-- they are written, else as the checker found them, else int (which
-- is what generate_lambda_expr makes of them)
fn lambda_value_type(gen: IRGenerator, expr: Expr) -> string {
    let checked = checked_type(gen, expr)
    let mut checked_params: List[string] = []
    let mut ret = expr.lambda_ret_type
    if starts_with(checked, "fn(") {
        checked_params = ty_fn_params(checked)
        if ret == "" and ty_known(ty_fn_ret(checked)) { ret = ty_fn_ret(checked) }
    }
    if ret == "" { ret = "int" }
    let mut text = "fn("
    let mut i = 0
    while i < expr.lambda_params.len() {
        let mut t = expr.lambda_params[i].type_name
        if t == "" and i < checked_params.len() {
            if ty_known(checked_params[i]) { t = checked_params[i] }
        }
        if t == "" { t = "int" }
        if i > 0 { text = text + ", " }
        text = text + t
        i = i + 1
    }
    return text + ") -> " + ret
}

-- The IR type of what a call of a value of the function type gives
fn value_call_result_type(gen: IRGenerator, fn_type: string) -> string {
    let ret = ty_fn_ret(fn_type)
    if ret == "" or ret == "void" { return "void" }
    if ty_known(ret) == false { return "i64" }
    return map_type_name(canon_type(gen, ret))
}

-- The name of the function that stands for the function `name` in a
-- function value
fn value_function_name(name: string) -> string {
    return "fn$" + name
}

-- Write the function that stands for the function `name` in a function
-- value, unless it is written already: it takes a closure, which it
-- has no use for, then what `name` takes, and calls `name`
fn value_function(gen: IRGenerator, name: string) -> IRGenerator {
    let made = value_function_name(name)
    if gen.mono_generated.contains(made) { return gen }
    let mut params: List[string] = []
    if gen.fn_src_param_types.contains(name) {
        let joined = gen.fn_src_param_types.get(name)
        if joined != "" { params = string_split(joined, "|") }
    }
    let mut src = "module made\nfn made(closure__: Box[int]"
    let mut call = name + "("
    let mut i = 0
    while i < params.len() {
        let arg = "a" + int_to_string(i) + "__"
        src = src + ", " + arg + ": " + type_source_text(params[i])
        if i > 0 { call = call + ", " }
        call = call + arg
        i = i + 1
    }
    call = call + ")"
    src = src + ")"
    let mut ret = ""
    if gen.fn_src_return_types.contains(name) { ret = gen.fn_src_return_types.get(name) }
    if ret != "" and ret != "void" {
        src = src + " -> " + type_source_text(ret)
        call = "return " + call
    }
    if gen.all_extern_fns.contains(name) {
        call = "unsafe { " + call + " }"
    }
    return made_function(gen, made, src + " {\n    " + call + "\n}\n")
}

-- The closure of `function`, a function that takes a closure and
-- reads nothing from it: one word of the program's own storage, named
-- after the function, that holds the function's address. The word is
-- written each time the value is made, with the same address.
fn emit_static_closure(gen: IRGenerator, block: IRBasicBlock, function: string) -> ExprResult {
    let mut g = gen
    let mut b = block
    let st = g.builder.next_id
    let mut st_inst = ir_inst_new(st, OP_CALL())
    st_inst.callee = "dm_static_addr"
    let mut st_args: List[IRValue] = []
    st_args.push(ir_val_string("closure$" + function))
    st_args.push(ir_val_int(8))
    st_inst.call_args = st_args
    st_inst.result_type = "i64"
    st_inst.has_result = true
    b.instructions.push(st_inst)
    g.builder.next_id = st + 1
    let addr = emit_ir_cast(g, b, ir_val_inst(st), "i64", "ptr")
    let stored = emit_ir_store(addr.gen, addr.block, ir_val_inst(addr.val_id), ir_val_global(function))
    return expr_result(stored.gen, stored.block, addr.val_id)
}

-- An argument of the C function `c_name` where its parameter has a
-- function type: the address of the function the argument names
fn generate_c_function_arg(gen: IRGenerator, block: IRBasicBlock, arg: Expr, c_name: string) -> ExprResult {
    let mut g = gen
    let mut b = block
    let named = arg.kind == EXPR_IDENTIFIER() and g.variable_map.contains(arg.name) == false and g.fn_src_param_types.contains(arg.name) and g.generic_fn_decls.contains(arg.name) == false
    if named == false {
        g = ir_type_error(g, "the C function '" + c_name + "' takes a function by its name: a lambda or a function held in a variable is a closure, which C cannot call", arg.line)
        return expr_result(g, b, 0)
    }
    let slot = g.builder.next_id
    let mut slot_inst = ir_inst_new(slot, OP_ALLOCA())
    slot_inst.alloc_type = "ptr"
    slot_inst.result_type = "ptr(ptr)"
    slot_inst.has_result = true
    b.instructions.push(slot_inst)
    g.builder.next_id = slot + 1
    let stored = emit_ir_store(g, b, ir_val_inst(slot), ir_val_global(arg.name))
    g = stored.gen
    b = stored.block
    let load_id = g.builder.next_id
    let mut load_inst = ir_inst_new(load_id, OP_LOAD())
    load_inst.load_ptr = ir_val_inst(slot)
    load_inst.load_type = "ptr"
    load_inst.result_type = "ptr"
    load_inst.has_result = true
    b.instructions.push(load_inst)
    g.builder.next_id = load_id + 1
    return expr_result(g, b, load_id)
}

-- A call of the function value `callee`, of the type `fn_type`
fn generate_value_call(gen: IRGenerator, block: IRBasicBlock, callee: Expr, fn_type: string, args: List[Expr], line: int) -> ExprResult {
    let mut g = gen
    let mut b = block
    let params = ty_fn_params(fn_type)
    if params.len() != args.len() {
        g = ir_type_error(g, "this call passes " + int_to_string(args.len()) + " arguments to a function of type " + fn_type, line)
        return expr_result(g, b, 0)
    }
    let held = generate_expr(g, b, callee)
    g = held.gen
    b = held.block
    let mut shown = "this call"
    if callee.kind == EXPR_IDENTIFIER() { shown = "'" + callee.name + "'" }

    -- The closure, then the arguments; an integer becomes the integer
    -- type the function type names for it
    let mut call_args: List[IRValue] = []
    call_args.push(ir_val_inst(held.val_id))
    let mut param_irs = "ptr"
    let mut i = 0
    while i < args.len() {
        let mut arg_result = generate_expr(g, b, args[i])
        let mut param_ir = ""
        if ty_known(params[i]) {
            let want = canon_type(arg_result.gen, params[i])
            arg_result = convert_int_to_place(arg_result.gen, arg_result.block, arg_result.val_id, args[i], want, "argument " + int_to_string(i + 1) + " of " + shown)
            param_ir = map_type_name(want)
        } else {
            param_ir = infer_expr_type(arg_result.gen, args[i])
        }
        g = arg_result.gen
        b = arg_result.block
        call_args.push(ir_val_inst(arg_result.val_id))
        param_irs = param_irs + "|" + param_ir
        i = i + 1
    }

    let ret_type = value_call_result_type(g, fn_type)
    let id = g.builder.next_id
    let mut inst = ir_inst_new(id, OP_CALL_PTR())
    inst.callee_val = ir_val_inst(held.val_id)
    inst.callee = param_irs
    inst.call_args = call_args
    inst.result_type = ret_type
    inst.has_result = ret_type != "void"
    b.instructions.push(inst)
    g.builder.next_id = id + 1
    return expr_result(g, b, id)
}

-- What IR generation knows about the variable `name` of the function
-- `from`, by its name, copied to `to`: a lambda's copy of a captured
-- variable is all that the variable is
fn copy_variable_facts(from: IRGenerator, to: IRGenerator, name: string) -> IRGenerator {
    let mut g = to
    if from.var_src_types.contains(name) { g.var_src_types.insert(name, from.var_src_types.get(name)) }
    if from.var_struct_types.contains(name) { g.var_struct_types.insert(name, from.var_struct_types.get(name)) }
    if from.var_enum_types.contains(name) { g.var_enum_types.insert(name, from.var_enum_types.get(name)) }
    if from.box_inner_types.contains(name) { g.box_inner_types.insert(name, from.box_inner_types.get(name)) }
    if from.list_elem_kinds.contains(name) { g.list_elem_kinds.insert(name, from.list_elem_kinds.get(name)) }
    if from.list_elem_types.contains(name) { g.list_elem_types.insert(name, from.list_elem_types.get(name)) }
    if from.array_var_names.contains(name) { g.array_var_names.insert(name, from.array_var_names.get(name)) }
    if from.var_type_annotations.contains(name) { g.var_type_annotations.insert(name, from.var_type_annotations.get(name)) }
    return g
}

-- ============================================================
-- LAMBDA EXPRESSION
-- A lambda is a function of the module, with a name of its own, and a
-- closure that holds its address (see FUNCTION VALUES). The value of
-- the expression is the closure's address.
-- ============================================================

fn generate_lambda_expr(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block

    let lambda_name = gen_next_lambda_name(g)
    g = gen_advance_lambda(g)

    -- The types of the parameters and of the value: as they are
    -- written, else as the checker found them for the lambda
    let checked = checked_type(g, expr)
    let mut checked_params: List[string] = []
    let mut checked_ret = ""
    if starts_with(checked, "fn(") {
        checked_params = ty_fn_params(checked)
        checked_ret = ty_fn_ret(checked)
    }
    let mut ret_src = expr.lambda_ret_type
    if ret_src == "" and ty_known(checked_ret) { ret_src = checked_ret }
    let ret_type = if ret_src == "" {
        "i64"
    } else if ret_src == "void" {
        "void"
    } else {
        map_type_name(canon_type(g, ret_src))
    }

    let mut lambda_func = ir_function_new(lambda_name, ret_type)
    lambda_func.source_line = expr.line

    -- The closure, then the lambda's own parameters
    lambda_func.params.push(ir_param_new("closure$", "ptr"))
    let mut param_src: List[string] = []
    let mut pi = 0
    while pi < expr.lambda_params.len() {
        let lp = expr.lambda_params[pi]
        let mut src = lp.type_name
        if src == "" and pi < checked_params.len() {
            if ty_known(checked_params[pi]) { src = checked_params[pi] }
        }
        if src == "" { src = "int" }
        src = canon_type(g, src)
        param_src.push(src)
        lambda_func.params.push(ir_param_new(lp.name, map_type_name(src)))
        pi = pi + 1
    }

    -- The captured variables: those of the function around the lambda
    -- that the lambda's body names, and that no parameter hides
    let mut capture_names: List[string] = []
    let mut capture_types: List[string] = []
    let body_names = expr_names(*expr.lambda_body)
    let mut mentioned: Map[string, bool] = Map_new()
    let mut ni = 0
    while ni < body_names.len() {
        mentioned.insert(body_names[ni], true)
        ni = ni + 1
    }
    let keys = g.variable_map.keys()
    let mut ki = 0
    while ki < keys.len() {
        let var_name = keys[ki]
        let mut captured = mentioned.contains(var_name)
        let mut pj = 0
        while pj < expr.lambda_params.len() {
            if expr.lambda_params[pj].name == var_name { captured = false }
            pj = pj + 1
        }
        if captured {
            capture_names.push(var_name)
            if g.variable_types.contains(var_name) {
                capture_types.push(g.variable_types.get(var_name))
            } else {
                capture_types.push("i64")
            }
        }
        ki = ki + 1
    }

    -- The closure's layout: the function's address, then the captured
    -- values
    let closure_type = "closure$" + lambda_name
    if capture_names.len() > 0 {
        let mut fields: List[IRField] = []
        fields.push(ir_field_new("function", "ptr"))
        let mut fi = 0
        while fi < capture_names.len() {
            fields.push(ir_field_new(capture_names[fi], capture_types[fi]))
            fi = fi + 1
        }
        let mut closure_ir = ir_type_named(IR_TYPE_STRUCT(), closure_type)
        closure_ir.fields = fields
        g.ir_mod.struct_defs.insert(closure_type, closure_ir)
    }

    -- The closure is made here, in the function around the lambda,
    -- from the variables as they are now
    let mut closure_id = 0
    if capture_names.len() == 0 {
        let made = emit_static_closure(g, b, lambda_name)
        g = made.gen
        b = made.block
        closure_id = made.val_id
    } else {
        closure_id = g.builder.next_id
        let mut malloc_inst = ir_inst_new(closure_id, OP_CALL())
        malloc_inst.callee = "dm_libc_malloc"
        let mut margs: List[IRValue] = []
        margs.push(ir_val_sizeof(closure_type))
        malloc_inst.call_args = margs
        malloc_inst.result_type = "ptr"
        malloc_inst.has_result = true
        b.instructions.push(malloc_inst)
        g.builder.next_id = closure_id + 1
        let function_at = emit_ir_field_addr(g, b, ir_val_inst(closure_id), closure_type, 0, "ptr")
        let function_set = emit_ir_store(function_at.gen, function_at.block, ir_val_inst(function_at.val_id), ir_val_global(lambda_name))
        g = function_set.gen
        b = function_set.block
        let mut ci = 0
        while ci < capture_names.len() {
            let value = generate_expr(g, b, expr_ident(capture_names[ci], expr.line, expr.col))
            let value_at = emit_ir_field_addr(value.gen, value.block, ir_val_inst(closure_id), closure_type, ci + 1, capture_types[ci])
            let value_set = emit_ir_store(value_at.gen, value_at.block, ir_val_inst(value_at.val_id), ir_val_inst(value.val_id))
            g = value_set.gen
            b = value_set.block
            ci = ci + 1
        }
    }

    -- The lambda's function is generated with the state of a function
    -- of its own; what is lexical (the impl type, type parameters, an
    -- unsafe block) carries in
    let outer = g
    let empty_blocks: List[IRBasicBlock] = []
    let empty_declared: List[string] = []
    let empty_marks: List[int] = []
    g.completed_blocks = empty_blocks
    g.variable_map = Map_new()
    g.variable_types = Map_new()
    g.mut_ptr_vars = Map_new()
    g.param_ptr_map = Map_new()
    g.var_src_types = Map_new()
    g.var_struct_types = Map_new()
    g.var_enum_types = Map_new()
    g.box_inner_types = Map_new()
    g.list_elem_kinds = Map_new()
    g.list_elem_types = Map_new()
    g.array_var_names = Map_new()
    g.var_type_annotations = Map_new()
    g.region_depth = 0
    g.tainted_vars = Map_new()
    g.ref_vars = Map_new()
    g.region_born_vars = Map_new()
    g.declared_vars = empty_declared
    g.region_marks = empty_marks
    g.has_break_target = false
    g.has_continue_target = false
    g.current_return_type = ret_type
    g.builder.next_id = 0

    let mut entry_block = ir_block_new("entry")

    -- The lambda's parameters are variables of its function
    let mut param_idx = 0
    while param_idx < expr.lambda_params.len() {
        let lp = expr.lambda_params[param_idx]
        let ptype = map_type_name(param_src[param_idx])

        let alloca_id = g.builder.next_id
        let mut alloca_inst = ir_inst_new(alloca_id, OP_ALLOCA())
        alloca_inst.alloc_type = ptype
        alloca_inst.result_type = "ptr(" + ptype + ")"
        alloca_inst.has_result = true
        entry_block.instructions.push(alloca_inst)
        g.builder.next_id = alloca_id + 1
        let param_set = emit_ir_store(g, entry_block, ir_val_inst(alloca_id), ir_val_param(param_idx + 1))
        g = param_set.gen
        entry_block = param_set.block

        g.variable_map.insert(lp.name, alloca_id)
        g.variable_types.insert(lp.name, ptype)
        g.declared_vars.push(lp.name)
        -- The type of an untyped parameter is left to the checker
        if lp.type_name != "" { g.var_src_types.insert(lp.name, param_src[param_idx]) }
        let param_debug = debug_var(g, entry_block, lp.name, expr.line, param_idx + 2)
        g = param_debug.gen
        entry_block = param_debug.block
        param_idx = param_idx + 1
    }

    -- And so are the captured variables, each with its value from the
    -- closure
    let mut cap_idx = 0
    while cap_idx < capture_names.len() {
        let cap_name = capture_names[cap_idx]
        let cap_type = capture_types[cap_idx]
        let from_at = emit_ir_field_addr(g, entry_block, ir_val_param(0), closure_type, cap_idx + 1, cap_type)
        g = from_at.gen
        entry_block = from_at.block
        let from_id = g.builder.next_id
        let mut from_inst = ir_inst_new(from_id, OP_LOAD())
        from_inst.load_ptr = ir_val_inst(from_at.val_id)
        from_inst.load_type = cap_type
        from_inst.result_type = cap_type
        from_inst.has_result = true
        entry_block.instructions.push(from_inst)
        g.builder.next_id = from_id + 1

        let alloca_id = g.builder.next_id
        let mut alloca_inst = ir_inst_new(alloca_id, OP_ALLOCA())
        alloca_inst.alloc_type = cap_type
        alloca_inst.result_type = "ptr(" + cap_type + ")"
        alloca_inst.has_result = true
        entry_block.instructions.push(alloca_inst)
        g.builder.next_id = alloca_id + 1
        let cap_set = emit_ir_store(g, entry_block, ir_val_inst(alloca_id), ir_val_inst(from_id))
        g = cap_set.gen
        entry_block = cap_set.block

        g.variable_map.insert(cap_name, alloca_id)
        g.variable_types.insert(cap_name, cap_type)
        g.declared_vars.push(cap_name)
        g = copy_variable_facts(outer, g, cap_name)
        cap_idx = cap_idx + 1
    }

    -- The body's value is the lambda's
    let body_result = generate_expr(g, entry_block, *expr.lambda_body)
    g = body_result.gen
    entry_block = body_result.block
    if entry_block.has_terminator == false {
        if ret_type == "void" {
            entry_block.terminator = Box_new(term_ret_void())
        } else {
            entry_block.terminator = Box_new(term_ret(ir_val_inst(body_result.val_id)))
        }
        entry_block.has_terminator = true
    }

    -- The lambda's blocks in order: the ones the body finished, then
    -- the block it ended in (the entry block itself for a simple body)
    let mut lbi = 0
    while lbi < g.completed_blocks.len() {
        lambda_func.blocks.push(g.completed_blocks[lbi])
        lbi = lbi + 1
    }
    lambda_func.blocks.push(entry_block)
    g.ir_mod.functions.push(lambda_func)

    -- Back to the function around the lambda
    g.completed_blocks = outer.completed_blocks
    g.variable_map = outer.variable_map
    g.variable_types = outer.variable_types
    g.mut_ptr_vars = outer.mut_ptr_vars
    g.param_ptr_map = outer.param_ptr_map
    g.var_src_types = outer.var_src_types
    g.var_struct_types = outer.var_struct_types
    g.var_enum_types = outer.var_enum_types
    g.box_inner_types = outer.box_inner_types
    g.list_elem_kinds = outer.list_elem_kinds
    g.list_elem_types = outer.list_elem_types
    g.array_var_names = outer.array_var_names
    g.var_type_annotations = outer.var_type_annotations
    g.region_depth = outer.region_depth
    g.tainted_vars = outer.tainted_vars
    g.ref_vars = outer.ref_vars
    g.region_born_vars = outer.region_born_vars
    g.declared_vars = outer.declared_vars
    g.region_marks = outer.region_marks
    g.has_break_target = outer.has_break_target
    g.has_continue_target = outer.has_continue_target
    g.current_return_type = outer.current_return_type
    g.builder.next_id = outer.builder.next_id

    return expr_result(g, b, closure_id)
}

-- ============================================================
-- ERROR PROPAGATION (? operator)
-- expr? on Result[T, E] unwraps Ok or early-returns Err
-- expr? on Option[T] unwraps Some or early-returns None
-- ============================================================

-- The type of the value of `operand?`: T for a Result[T, E] or an
-- Option[T], in the form the operand's type is in. "" for any other
-- operand.
fn propagated_type(operand_type: string) -> string {
    if starts_with(operand_type, "Result[") {
        let parts = split_type_args(extract_inner_type(operand_type, "Result["))
        if parts.len() > 0 { return string_trim(parts[0]) }
    }
    if starts_with(operand_type, "Option[") {
        return string_trim(extract_inner_type(operand_type, "Option["))
    }
    return ""
}

fn generate_error_propagate(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block

    -- The operand's type gives the types of the value and of the error
    let operand_type = infer_expr_type(g, *expr.operand)
    let is_option = starts_with(operand_type, "Option[")
    let mut ok_field_type = "i64"
    let mut err_field_type = "i64"
    if starts_with(operand_type, "Result[") {
        let parts = split_type_args(extract_inner_type(operand_type, "Result["))
        if parts.len() > 1 {
            ok_field_type = map_type_name(string_trim(parts[0]))
            err_field_type = map_type_name(string_trim(parts[1]))
        }
    } else if is_option {
        ok_field_type = map_type_name(string_trim(extract_inner_type(operand_type, "Option[")))
    } else {
        g = ir_type_error(g, "'?' needs a Result or an Option", expr.line)
    }

    -- Generate the operand (the Result/Option expression)
    let operand_result = generate_expr(g, b, *expr.operand)
    g = operand_result.gen
    b = operand_result.block
    let operand_id = operand_result.val_id

    -- Extract tag from the result/option (field 0)
    let tag_id = g.builder.next_id
    let mut tag_inst = ir_inst_new(tag_id, OP_EXTRACT_FIELD())
    tag_inst.field_base = ir_val_inst(operand_id)
    tag_inst.field_index = 0
    tag_inst.field_type = "i32"
    tag_inst.result_type = "i32"
    tag_inst.has_result = true
    b.instructions.push(tag_inst)
    g.builder.next_id = g.builder.next_id + 1

    -- The tag of the variant that has the value: 0 for Ok, 1 for Some
    let mut value_tag = 0
    if is_option { value_tag = 1 }
    let is_ok_id = g.builder.next_id
    let mut is_ok_cmp = ir_inst_new(is_ok_id, OP_EQ())
    is_ok_cmp.lhs = ir_val_inst(tag_id)
    is_ok_cmp.rhs = ir_val_int(value_tag)
    is_ok_cmp.result_type = "bool"
    is_ok_cmp.has_result = true
    b.instructions.push(is_ok_cmp)
    g.builder.next_id = g.builder.next_id + 1

    -- Create labels for ok, err, and continue paths
    let ok_label = gen_next_label(g, "prop_ok")
    g = gen_advance_label(g)
    let err_label = gen_next_label(g, "prop_err")
    g = gen_advance_label(g)
    let cont_label = gen_next_label(g, "prop_cont")
    g = gen_advance_label(g)

    -- Pre-allocate storage for the Ok value (must be in current block, before the branch)
    let ok_alloca_id = g.builder.next_id
    let mut ok_alloca = ir_inst_new(ok_alloca_id, OP_ALLOCA())
    ok_alloca.alloc_type = ok_field_type
    ok_alloca.result_type = "ptr(" + ok_field_type + ")"
    ok_alloca.has_result = true
    b.instructions.push(ok_alloca)
    g.builder.next_id = g.builder.next_id + 1

    -- Branch to the block of the variant the operand is
    b.terminator = Box_new(term_br_cond(ir_val_inst(is_ok_id), ok_label, err_label))
    b.has_terminator = true
    g.completed_blocks.push(b)

    -- An Err or a None leaves the function with a value of the type
    -- the function returns: the operand itself where that is its type,
    -- and otherwise a None, or an Err with the operand's error (the
    -- function may return a Result with another type of value)
    let mut err_block = ir_block_new(err_label)
    let ret_type = g.current_return_type
    let mut leaves_with = operand_id
    if ret_type != operand_type and is_option and starts_with(ret_type, "Option[") {
        let none_id = g.builder.next_id
        let mut none_inst = ir_inst_new(none_id, OP_INSERT_FIELD())
        none_inst.field_base = ir_val_undef()
        none_inst.field_value = ir_val_int(0)
        none_inst.field_index = 0
        none_inst.result_type = ret_type
        none_inst.has_result = true
        err_block.instructions.push(none_inst)
        g.builder.next_id = none_id + 1
        leaves_with = none_id
    } else if ret_type != operand_type and is_option == false and starts_with(ret_type, "Result[") {
        let err_val_id = g.builder.next_id
        let mut err_extract = ir_inst_new(err_val_id, OP_EXTRACT_FIELD())
        err_extract.field_base = ir_val_inst(operand_id)
        err_extract.field_index = 2
        err_extract.field_type = err_field_type
        err_extract.result_type = err_field_type
        err_extract.has_result = true
        err_block.instructions.push(err_extract)
        g.builder.next_id = err_val_id + 1

        let tag_set_id = g.builder.next_id
        let mut tag_set = ir_inst_new(tag_set_id, OP_INSERT_FIELD())
        tag_set.field_base = ir_val_undef()
        tag_set.field_value = ir_val_int(1)
        tag_set.field_index = 0
        tag_set.result_type = ret_type
        tag_set.has_result = true
        err_block.instructions.push(tag_set)
        g.builder.next_id = tag_set_id + 1

        let err_set_id = g.builder.next_id
        let mut err_set = ir_inst_new(err_set_id, OP_INSERT_FIELD())
        err_set.field_base = ir_val_inst(tag_set_id)
        err_set.field_value = ir_val_inst(err_val_id)
        err_set.field_index = 2
        err_set.result_type = ret_type
        err_set.has_result = true
        err_block.instructions.push(err_set)
        g.builder.next_id = err_set_id + 1
        leaves_with = err_set_id
    }
    err_block.terminator = Box_new(term_ret(ir_val_inst(leaves_with)))
    err_block.has_terminator = true
    g.completed_blocks.push(err_block)

    -- Ok path: extract the Ok/Some value (field 1)
    let mut ok_block = ir_block_new(ok_label)
    let ok_val_id = g.builder.next_id
    let mut ok_extract = ir_inst_new(ok_val_id, OP_EXTRACT_FIELD())
    ok_extract.field_base = ir_val_inst(operand_id)
    ok_extract.field_index = 1
    ok_extract.field_type = ok_field_type
    ok_extract.result_type = ok_field_type
    ok_extract.has_result = true
    ok_block.instructions.push(ok_extract)
    g.builder.next_id = g.builder.next_id + 1

    -- Store ok value into the pre-allocated alloca
    let mut ok_store = ir_inst_new(g.builder.next_id, OP_STORE())
    ok_store.store_ptr = ir_val_inst(ok_alloca_id)
    ok_store.store_val = ir_val_inst(ok_val_id)
    ok_store.has_result = false
    ok_block.instructions.push(ok_store)
    g.builder.next_id = g.builder.next_id + 1

    ok_block.terminator = Box_new(term_br(cont_label))
    ok_block.has_terminator = true
    g.completed_blocks.push(ok_block)
    -- Continue block: load the ok value
    let mut cont_block = ir_block_new(cont_label)
    let load_id = g.builder.next_id
    let mut load_inst = ir_inst_new(load_id, OP_LOAD())
    load_inst.load_ptr = ir_val_inst(ok_alloca_id)
    load_inst.load_type = ok_field_type
    load_inst.result_type = ok_field_type
    load_inst.has_result = true
    cont_block.instructions.push(load_inst)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, cont_block, load_id)
}

-- ============================================================
-- STRING INTERPOLATION
-- f"Hello {name}, you are {age} years old"
-- Alternating literal and expression parts concatenated.
-- ============================================================

fn generate_string_interp(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block

    -- Start with an empty string
    let empty_id = g.builder.next_id
    let mut empty_inst = ir_inst_new(empty_id, OP_ALLOCA())
    empty_inst.alloc_type = "string"
    empty_inst.result_type = "ptr(string)"
    empty_inst.has_result = true
    b.instructions.push(empty_inst)
    g.builder.next_id = g.builder.next_id + 1

    let mut empty_store = ir_inst_new(g.builder.next_id, OP_STORE())
    empty_store.store_ptr = ir_val_inst(empty_id)
    empty_store.store_val = ir_val_string("")
    empty_store.has_result = false
    b.instructions.push(empty_store)
    g.builder.next_id = g.builder.next_id + 1

    let mut empty_load = ir_inst_new(g.builder.next_id, OP_LOAD())
    empty_load.load_ptr = ir_val_inst(empty_id)
    empty_load.load_type = "string"
    empty_load.result_type = "string"
    empty_load.has_result = true
    b.instructions.push(empty_load)
    let mut running_id = g.builder.next_id
    g.builder.next_id = g.builder.next_id + 1

    -- Process each part
    let mut i = 0
    while i < expr.interp_parts.len() {
        let part = expr.interp_parts[i]
        let is_literal = if i < expr.interp_is_literal.len() {
            expr.interp_is_literal[i]
        } else {
            false
        }

        if is_literal {
            -- Literal string part: generate directly
            let lit_result = generate_expr(g, b, part)
            g = lit_result.gen
            b = lit_result.block

            -- Concatenate with running string
            let concat_id = g.builder.next_id
            let mut concat_inst = ir_inst_new(concat_id, OP_STRING_CONCAT())
            concat_inst.lhs = ir_val_inst(running_id)
            concat_inst.rhs = ir_val_inst(lit_result.val_id)
            concat_inst.result_type = "string"
            concat_inst.has_result = true
            b.instructions.push(concat_inst)
            g.builder.next_id = g.builder.next_id + 1
            running_id = concat_id
        } else {
            -- Expression part: generate the expression
            let expr_result_val = generate_expr(g, b, part)
            g = expr_result_val.gen
            b = expr_result_val.block
            let part_val_id = expr_result_val.val_id

            -- Determine the expression type to decide if conversion is needed
            -- Check if the part is an identifier with a known type
            let part_type = infer_part_type(g, part)

            let mut str_val_id = part_val_id
            if part_type == "string" {
                -- Already a string, use directly
                str_val_id = part_val_id
            } else if is_integer_type(part_type) or part_type == "int" {
                let conv = emit_int_to_string(g, b, part_val_id, part_type)
                g = conv.gen
                b = conv.block
                str_val_id = conv.val_id
            } else if part_type == "f64" or part_type == "f32" or part_type == "float" {
                -- Convert float to string via float_to_string
                let conv_id = g.builder.next_id
                let mut conv_inst = ir_inst_new(conv_id, OP_CALL())
                conv_inst.callee = "dm_float_to_string"
                let mut conv_args: List[IRValue] = []
                conv_args.push(ir_val_inst(part_val_id))
                conv_inst.call_args = conv_args
                conv_inst.result_type = "string"
                conv_inst.has_result = true
                b.instructions.push(conv_inst)
                g.builder.next_id = g.builder.next_id + 1
                str_val_id = conv_id
            } else if part_type == "bool" {
                -- Convert bool to string via bool_to_string
                let conv_id = g.builder.next_id
                let mut conv_inst = ir_inst_new(conv_id, OP_CALL())
                conv_inst.callee = "dm_bool_to_string"
                let mut conv_args: List[IRValue] = []
                conv_args.push(ir_val_inst(part_val_id))
                conv_inst.call_args = conv_args
                conv_inst.result_type = "string"
                conv_inst.has_result = true
                b.instructions.push(conv_inst)
                g.builder.next_id = g.builder.next_id + 1
                str_val_id = conv_id
            } else {
                -- Unknown type: try int_to_string as default
                let conv_id = g.builder.next_id
                let mut conv_inst = ir_inst_new(conv_id, OP_CALL())
                conv_inst.callee = "dm_int_to_string"
                let mut conv_args: List[IRValue] = []
                conv_args.push(ir_val_inst(part_val_id))
                conv_inst.call_args = conv_args
                conv_inst.result_type = "string"
                conv_inst.has_result = true
                b.instructions.push(conv_inst)
                g.builder.next_id = g.builder.next_id + 1
                str_val_id = conv_id
            }

            -- Concatenate with running string
            let concat_id = g.builder.next_id
            let mut concat_inst = ir_inst_new(concat_id, OP_STRING_CONCAT())
            concat_inst.lhs = ir_val_inst(running_id)
            concat_inst.rhs = ir_val_inst(str_val_id)
            concat_inst.result_type = "string"
            concat_inst.has_result = true
            b.instructions.push(concat_inst)
            g.builder.next_id = g.builder.next_id + 1
            running_id = concat_id
        }

        i = i + 1
    }

    return expr_result(g, b, running_id)
}

-- Infer the type of a string interpolation part expression.
-- Checks identifiers against variable_types, and literals by kind.
fn infer_part_type(gen: IRGenerator, part: Expr) -> string {
    return infer_expr_type(gen, part)
}

-- ============================================================
-- COMPTIME EXPRESSION
-- Evaluates the inner expression at compile time and emits
-- the result as a constant value.
-- ============================================================

fn generate_comptime_expr(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block

    -- Evaluate the inner expression at compile time
    let ct_val = eval_comptime_expr(g, *expr.operand)

    -- Determine the type of the compile-time value
    let ct_type = comptime_value_type(ct_val)

    -- Emit an alloca/store/load sequence for the compile-time constant
    let alloca_id = g.builder.next_id
    let mut alloca_inst = ir_inst_new(alloca_id, OP_ALLOCA())
    alloca_inst.alloc_type = ct_type
    alloca_inst.result_type = "ptr(" + ct_type + ")"
    alloca_inst.has_result = true
    b.instructions.push(alloca_inst)
    g.builder.next_id = g.builder.next_id + 1

    let mut store_inst = ir_inst_new(g.builder.next_id, OP_STORE())
    store_inst.store_ptr = ir_val_inst(alloca_id)
    store_inst.store_val = ct_val
    store_inst.has_result = false
    b.instructions.push(store_inst)
    g.builder.next_id = g.builder.next_id + 1

    let load_id = g.builder.next_id
    let mut load_inst = ir_inst_new(load_id, OP_LOAD())
    load_inst.load_ptr = ir_val_inst(alloca_id)
    load_inst.load_type = ct_type
    load_inst.result_type = ct_type
    load_inst.has_result = true
    b.instructions.push(load_inst)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, b, load_id)
}


-- ============================================================
-- SIMD Builtin IR Generation
-- Handles simd_splat_*, simd_set_*, simd_add/sub/mul/div,
-- and simd_extract intrinsic function calls.
-- ============================================================

-- ============================================================
-- SIMD BUILTIN DETECTION
-- ============================================================

-- Returns true if the function name is a SIMD builtin intrinsic

-- ============================================================
-- SOME CALL: Option constructor
-- Some(value) -> Option { has_value: 1, value: payload }
-- ============================================================

-- Store the value that a branch of an `if` or an arm of a `match`
-- gives into the slot of the whole. The branches may give numbers of
-- different widths, which meet at the slot's type (checked_slot_type
-- in ir_gen.dm): a narrower integer widens to it, and a literal takes
-- it. `value` is the branch's expression, generated as `val_id`.
fn store_branch_value(gen: IRGenerator, block: IRBasicBlock, slot_id: int, slot_type: string, val_id: int, value: Expr) -> GenResult {
    let mut g = gen
    let mut b = block
    -- A `match` that is a statement keeps no value
    if slot_type == "void" { return gen_result(g, b) }
    let mut store_id = val_id
    -- The type is asked for here, where the branch's variables are known
    let from = infer_expr_type(g, value)
    if b.has_terminator == false and from != slot_type {
        if is_integer_type(from) and is_integer_type(slot_type) {
            let conv = convert_int_value(g, b, val_id, branch_value_expr(value), from, slot_type, "the value of this branch")
            g = conv.gen
            b = conv.block
            store_id = conv.val_id
        } else if is_float_type(from) and is_float_type(slot_type) {
            let conv = emit_ir_cast(g, b, ir_val_inst(val_id), from, slot_type)
            g = conv.gen
            b = conv.block
            store_id = conv.val_id
        }
    }
    return emit_ir_store(g, b, ir_val_inst(slot_id), ir_val_inst(store_id))
}

-- The type of the slot that holds the value of the `match`: the
-- checker's, else `inferred` (checked_slot_type); and "void" for a
-- `match` that is a statement, whose arms' values are not stored
fn match_slot_type(gen: IRGenerator, expr: Expr, inferred: string) -> string {
    if gen.unused_match == expr.id and expr.id >= 0 { return "void" }
    return checked_slot_type(gen, expr, inferred)
}

-- The type a slot of the type is allocated with: a slot that is not
-- used still has a size
fn slot_alloc_type(slot_type: string) -> string {
    if slot_type == "void" { return "i64" }
    return slot_type
}

-- The block of a match arm. When it ends in an expression of the type
-- of the match's slot, or in a number where the slot holds a number
-- of another width, that value is the arm's and goes into the slot.
-- An `if` with an `else` or a `match` that ends the block is such an
-- expression (stmt_value_expr).
fn generate_arm_block(gen: IRGenerator, block: IRBasicBlock, stmts: List[Stmt], slot_id: int, slot_type: string) -> GenResult {
    let n = stmts.len()
    if n == 0 { return gen_result(gen, block) }
    let last = stmts[n - 1]
    if slot_type == "void" or stmt_gives_value(last) == false { return generate_block_stmts(gen, block, stmts) }
    let mut lead: List[Stmt] = []
    let mut li = 0
    while li < n - 1 {
        lead.push(stmts[li])
        li = li + 1
    }
    let lead_result = generate_block_stmts(gen, block, lead)
    let mut g = lead_result.gen
    let mut b = lead_result.block
    if b.has_terminator { return gen_result(g, b) }
    -- The type is asked for here, where the block's variables are known
    let value = stmt_value_expr(last)
    let value_type = infer_expr_type(g, value)
    let both_integers = is_integer_type(value_type) and is_integer_type(slot_type)
    let both_floats = is_float_type(value_type) and is_float_type(slot_type)
    if value_type != slot_type and both_integers == false and both_floats == false { return generate_statement(g, b, last) }
    let value_result = generate_expr(g, b, value)
    g = value_result.gen
    b = value_result.block
    if b.has_terminator { return gen_result(g, b) }
    return store_branch_value(g, b, slot_id, slot_type, value_result.val_id, value)
}

fn infer_match_result_type(gen: IRGenerator, arms: List[MatchArm]) -> string {
    -- The first arm's type, and for integers the type the arms meet at
    if arms.len() == 0 {
        return "i64"
    }
    let arm = arms[0]
    if arm.is_expr_body {
        -- Arms that give no value, such as calls of println, leave the
        -- result slot unused; it still needs a type that has a size
        let arm_type = infer_expr_type(gen, *arm.body_expr)
        if arm_type == "void" {
            return "i64"
        }
        return arms_meet_type(gen, arms, arm_type)
    }
    return "i64"
}

-- ============================================================
-- LITERAL MATCH (int, string, bool, wildcard)
-- ============================================================

fn join_types(types: List[string]) -> string {
    let mut result = ""
    let mut i = 0
    while i < types.len() {
        if i > 0 {
            result = result + "_"
        }
        result = result + map_type_name(types[i])
        i = i + 1
    }
    return result
}


-- ============================================================
-- SIMD Builtin IR Generation
-- Handles simd_splat_*, simd_set_*, simd_add/sub/mul/div,
-- and simd_extract intrinsic function calls.
-- ============================================================

-- ============================================================
-- SIMD BUILTIN DETECTION
-- ============================================================

-- Returns true if the function name is a SIMD builtin intrinsic
fn is_simd_builtin(name: string) -> bool {
    if starts_with(name, "simd_splat_") { return true }
    if starts_with(name, "simd_set_") { return true }
    if name == "simd_add" { return true }
    if name == "simd_sub" { return true }
    if name == "simd_mul" { return true }
    if name == "simd_div" { return true }
    if name == "simd_extract" { return true }
    return false
}

-- ============================================================
-- SIMD TYPE PARSING
-- ============================================================

-- Extracts the SIMD vector type name from a simd_splat_* or simd_set_* name.
-- "simd_splat_f32x4" -> "f32x4"
-- "simd_set_i32x8"   -> "i32x8"
fn parse_simd_type_from_name(name: string) -> string {
    if starts_with(name, "simd_splat_") {
        let prefix_len = len("simd_splat_")
        return substr(name, prefix_len, len(name) - prefix_len)
    }
    if starts_with(name, "simd_set_") {
        let prefix_len = len("simd_set_")
        return substr(name, prefix_len, len(name) - prefix_len)
    }
    return ""
}

-- Returns the scalar element type for a SIMD vector type.
-- f32x4 -> "f32", f32x8 -> "f32"
-- f64x2 -> "f64", f64x4 -> "f64"
-- i32x4 -> "i32", i32x8 -> "i32"
-- i64x2 -> "i64", i64x4 -> "i64"
fn simd_extract_scalar_type(vec_type: string) -> string {
    if vec_type == "f32x4" or vec_type == "f32x8" { return "f32" }
    if vec_type == "f64x2" or vec_type == "f64x4" { return "f64" }
    if vec_type == "i32x4" or vec_type == "i32x8" { return "i32" }
    if vec_type == "i64x2" or vec_type == "i64x4" { return "i64" }
    return "i32"
}

-- Returns the result type for a SIMD operation given the function name
-- and the type of the first argument.
-- For splat/set: the vector type from the function name
-- For add/sub/mul/div: same as first argument type
-- For extract: the scalar type of the vector
fn simd_result_type(fn_name: string, arg_type: string) -> string {
    -- splat and set derive their type from the function name suffix
    if starts_with(fn_name, "simd_splat_") or starts_with(fn_name, "simd_set_") {
        return parse_simd_type_from_name(fn_name)
    }
    -- Binary SIMD ops produce the same type as their inputs
    if fn_name == "simd_add" or fn_name == "simd_sub" {
        return arg_type
    }
    if fn_name == "simd_mul" or fn_name == "simd_div" {
        return arg_type
    }
    -- Extract produces the scalar element type
    if fn_name == "simd_extract" {
        return simd_extract_scalar_type(arg_type)
    }
    return arg_type
}

-- ============================================================
-- SIMD BUILTIN CODE GENERATION
-- ============================================================

-- Main dispatcher for SIMD builtin function calls.
-- Generates the appropriate SIMD IR instruction based on the function name.
fn generate_simd_builtin(gen: IRGenerator, block: IRBasicBlock, fn_name: string, args: List[Expr]) -> ExprResult {
    -- simd_splat_TYPE(scalar_val)
    if starts_with(fn_name, "simd_splat_") {
        return generate_simd_splat(gen, block, fn_name, args)
    }

    -- simd_set_TYPE(a, b, c, d, ...)
    if starts_with(fn_name, "simd_set_") {
        return generate_simd_set(gen, block, fn_name, args)
    }

    -- simd_add(a, b)
    if fn_name == "simd_add" {
        return generate_simd_binary(gen, block, OP_SIMD_ADD(), args)
    }

    -- simd_sub(a, b)
    if fn_name == "simd_sub" {
        return generate_simd_binary(gen, block, OP_SIMD_SUB(), args)
    }

    -- simd_mul(a, b)
    if fn_name == "simd_mul" {
        return generate_simd_binary(gen, block, OP_SIMD_MUL(), args)
    }

    -- simd_div(a, b)
    if fn_name == "simd_div" {
        return generate_simd_binary(gen, block, OP_SIMD_DIV(), args)
    }

    -- simd_extract(vec, idx)
    if fn_name == "simd_extract" {
        return generate_simd_extract(gen, block, args)
    }

    let line = if args.len() > 0 { args[0].line } else { 0 }
    return expr_result(ir_type_error(gen, "unknown SIMD builtin '" + fn_name + "'", line), block, 0)
}

-- ============================================================
-- SIMD SPLAT
-- simd_splat_TYPE(scalar) -> vector with all lanes set to scalar
-- ============================================================

fn generate_simd_splat(gen: IRGenerator, block: IRBasicBlock, fn_name: string, args: List[Expr]) -> ExprResult {
    let mut g = gen
    let mut b = block
    let vec_type = parse_simd_type_from_name(fn_name)

    -- Generate the scalar argument
    if args.len() < 1 {
        return expr_result(g, b, 0)
    }
    let scalar_result = generate_expr(g, b, args[0])
    g = scalar_result.gen
    b = scalar_result.block

    -- Emit OP_SIMD_SPLAT instruction
    let id = g.builder.next_id
    let mut inst = ir_inst_new(id, OP_SIMD_SPLAT())
    inst.simd_scalar = ir_val_inst(scalar_result.val_id)
    inst.simd_vec_type = vec_type
    inst.result_type = vec_type
    inst.has_result = true
    b.instructions.push(inst)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, b, id)
}

-- ============================================================
-- SIMD SET
-- simd_set_TYPE(a, b, c, d, ...) -> vector from individual elements
-- ============================================================

fn generate_simd_set(gen: IRGenerator, block: IRBasicBlock, fn_name: string, args: List[Expr]) -> ExprResult {
    let mut g = gen
    let mut b = block
    let vec_type = parse_simd_type_from_name(fn_name)

    -- Generate each element argument
    let mut elements: List[IRValue] = []
    let mut i = 0
    while i < args.len() {
        let elem_result = generate_expr(g, b, args[i])
        g = elem_result.gen
        b = elem_result.block
        elements.push(ir_val_inst(elem_result.val_id))
        i = i + 1
    }

    -- Emit OP_SIMD_SET instruction
    let id = g.builder.next_id
    let mut inst = ir_inst_new(id, OP_SIMD_SET())
    inst.simd_elements = elements
    inst.simd_vec_type = vec_type
    inst.result_type = vec_type
    inst.has_result = true
    b.instructions.push(inst)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, b, id)
}

-- ============================================================
-- SIMD BINARY OPERATIONS (add, sub, mul, div)
-- simd_op(lhs_vec, rhs_vec) -> element-wise result vector
-- ============================================================

fn generate_simd_binary(gen: IRGenerator, block: IRBasicBlock, op: int, args: List[Expr]) -> ExprResult {
    let mut g = gen
    let mut b = block

    if args.len() < 2 {
        return expr_result(g, b, 0)
    }

    -- Generate left operand
    let lhs_result = generate_expr(g, b, args[0])
    g = lhs_result.gen
    b = lhs_result.block

    -- Generate right operand
    let rhs_result = generate_expr(g, b, args[1])
    g = rhs_result.gen
    b = rhs_result.block

    -- The vector type is the first argument's
    let mut vec_type = infer_simd_arg_type(g, args[0])
    if vec_type == "" {
        g = ir_type_error(g, "the arguments of a SIMD operation must be SIMD vectors, such as f32x4", args[0].line)
        vec_type = "f32x4"
    }

    -- Emit the SIMD binary instruction
    let id = g.builder.next_id
    let mut inst = ir_inst_new(id, op)
    inst.lhs = ir_val_inst(lhs_result.val_id)
    inst.rhs = ir_val_inst(rhs_result.val_id)
    inst.simd_vec_type = vec_type
    inst.result_type = vec_type
    inst.has_result = true
    b.instructions.push(inst)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, b, id)
}

-- ============================================================
-- SIMD EXTRACT
-- simd_extract(vector, index) -> scalar element at index
-- ============================================================

fn generate_simd_extract(gen: IRGenerator, block: IRBasicBlock, args: List[Expr]) -> ExprResult {
    let mut g = gen
    let mut b = block

    if args.len() < 2 {
        return expr_result(g, b, 0)
    }

    -- Generate the vector argument
    let vec_result = generate_expr(g, b, args[0])
    g = vec_result.gen
    b = vec_result.block

    -- Generate the index argument
    let idx_result = generate_expr(g, b, args[1])
    g = idx_result.gen
    b = idx_result.block

    -- The vector type is the first argument's
    let mut vec_type = infer_simd_arg_type(g, args[0])
    if vec_type == "" {
        g = ir_type_error(g, "the first argument of simd_extract must be a SIMD vector, such as f32x4", args[0].line)
        vec_type = "f32x4"
    }
    -- Use dAImond-native types (f64 for float vectors, i64 for int vectors)
    let scalar_type = if is_simd_float_type(vec_type) { "f64" } else { "i64" }

    -- The lane must be one the vector has: LLVM gives no defined value
    -- for any other
    let in_range = check_index_bounds(g, b, idx_result.val_id, ir_val_int(simd_lane_count(vec_type)), "(" + vec_type + ")")
    g = in_range.gen
    b = in_range.block

    -- Emit OP_SIMD_EXTRACT instruction
    let id = g.builder.next_id
    let mut inst = ir_inst_new(id, OP_SIMD_EXTRACT())
    inst.simd_vector = ir_val_inst(vec_result.val_id)
    inst.simd_index = ir_val_inst(idx_result.val_id)
    inst.simd_vec_type = vec_type
    inst.result_type = scalar_type
    inst.has_result = true
    b.instructions.push(inst)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, b, id)
}

-- ============================================================
-- SIMD TYPE INFERENCE HELPERS
-- ============================================================

-- The SIMD vector type of an argument: "i32x8" for a variable, a call,
-- an element or a field of that type. "" when it is no vector.
fn infer_simd_arg_type(gen: IRGenerator, arg: Expr) -> string {
    let found = infer_expr_type(gen, arg)
    if is_simd_type(found) {
        return found
    }
    return ""
}

-- ============================================================
-- SIMD LANE COUNT HELPERS
-- ============================================================

-- Returns the number of lanes for a given SIMD vector type.
fn simd_lane_count(vec_type: string) -> int {
    if vec_type == "f32x4" or vec_type == "i32x4" { return 4 }
    if vec_type == "f32x8" or vec_type == "i32x8" { return 8 }
    if vec_type == "f64x2" or vec_type == "i64x2" { return 2 }
    if vec_type == "f64x4" or vec_type == "i64x4" { return 4 }
    return 4
}

-- ============================================================
-- BUILTIN CALL GENERATION HELPERS
-- ============================================================

-- Generate a simple builtin function call (non-SIMD).
-- An integer as text. The value widens to 64 bits by the sign of its
-- own type, so a u8 of 200 is "200"; a u64 goes to uint_to_string,
-- which prints the values above the highest int.
fn emit_int_to_string(gen: IRGenerator, block: IRBasicBlock, val_id: int, int_type: string) -> ExprResult {
    let mut g = gen
    let mut b = block
    let mut wide_id = val_id
    let mut callee = "dm_int_to_string"
    if int_type == "u64" {
        callee = "dm_uint_to_string"
    } else if is_integer_type(int_type) and type_bit_width(int_type) < 64 {
        let wide = emit_ir_cast(g, b, ir_val_inst(val_id), int_type, "i64")
        g = wide.gen
        b = wide.block
        wide_id = wide.val_id
    }
    let conv_id = g.builder.next_id
    let mut conv_inst = ir_inst_new(conv_id, OP_CALL())
    conv_inst.callee = callee
    let mut conv_args: List[IRValue] = []
    conv_args.push(ir_val_inst(wide_id))
    conv_inst.call_args = conv_args
    conv_inst.result_type = "string"
    conv_inst.has_result = true
    b.instructions.push(conv_inst)
    g.builder.next_id = conv_id + 1
    return expr_result(g, b, conv_id)
}

-- Maps the dAImond builtin name to the C runtime name and emits
-- an OP_CALL instruction with generated argument values.
fn generate_builtin_call(gen: IRGenerator, block: IRBasicBlock, fn_name: string, args: List[Expr]) -> ExprResult {
    let mut g = gen
    let mut b = block
    let c_name = map_builtin_name(fn_name)
    let ret_type = builtin_return_type(fn_name)

    -- int_to_string takes an integer of any type
    if fn_name == "int_to_string" and args.len() == 1 {
        let n = generate_expr(g, b, args[0])
        return emit_int_to_string(n.gen, n.block, n.val_id, infer_expr_type(n.gen, args[0]))
    }

    -- Auto-convert print/println/eprint/eprintln args to string
    let is_print_fn = fn_name == "println" or fn_name == "print" or fn_name == "eprintln" or fn_name == "eprint"
    -- What the builtin's parameters take (see ck_builtin_params)
    let param_kinds = string_split(ck_builtin_params(fn_name), "|")

    -- Generate all argument expressions
    let mut call_args: List[IRValue] = []
    let mut i = 0
    while i < args.len() {
        let arg_result = generate_expr(g, b, args[i])
        g = arg_result.gen
        b = arg_result.block

        if is_print_fn {
            let arg_type = infer_expr_type(g, args[i])
            if is_integer_type(arg_type) or arg_type == "int" {
                let conv = emit_int_to_string(g, b, arg_result.val_id, arg_type)
                g = conv.gen
                b = conv.block
                call_args.push(ir_val_inst(conv.val_id))
            } else if arg_type == "f64" or arg_type == "f32" or arg_type == "float" {
                -- Wrap with float_to_string
                let conv_id = g.builder.next_id
                let mut conv_inst = ir_inst_new(conv_id, OP_CALL())
                conv_inst.callee = "dm_float_to_string"
                let mut conv_args: List[IRValue] = []
                conv_args.push(ir_val_inst(arg_result.val_id))
                conv_inst.call_args = conv_args
                conv_inst.result_type = "string"
                conv_inst.has_result = true
                b.instructions.push(conv_inst)
                g.builder.next_id = g.builder.next_id + 1
                call_args.push(ir_val_inst(conv_id))
            } else if arg_type == "bool" {
                -- Wrap with bool_to_string
                let conv_id = g.builder.next_id
                let mut conv_inst = ir_inst_new(conv_id, OP_CALL())
                conv_inst.callee = "dm_bool_to_string"
                let mut conv_args: List[IRValue] = []
                conv_args.push(ir_val_inst(arg_result.val_id))
                conv_inst.call_args = conv_args
                conv_inst.result_type = "string"
                conv_inst.has_result = true
                b.instructions.push(conv_inst)
                g.builder.next_id = g.builder.next_id + 1
                call_args.push(ir_val_inst(conv_id))
            } else {
                call_args.push(ir_val_inst(arg_result.val_id))
            }
        } else if i < param_kinds.len() and param_kinds[i] == "int" {
            -- An integer narrower than the int the builtin takes
            -- widens by the sign of its own type
            let arg_type = infer_expr_type(g, args[i])
            if is_integer_type(arg_type) and type_bit_width(arg_type) < 64 {
                let wide = emit_ir_cast(g, b, ir_val_inst(arg_result.val_id), arg_type, "i64")
                g = wide.gen
                b = wide.block
                call_args.push(ir_val_inst(wide.val_id))
            } else {
                call_args.push(ir_val_inst(arg_result.val_id))
            }
        } else {
            call_args.push(ir_val_inst(arg_result.val_id))
        }
        i = i + 1
    }

    -- Emit the call instruction
    let id = g.builder.next_id
    let mut inst = ir_inst_new(id, OP_CALL())
    inst.callee = c_name
    inst.call_args = call_args
    inst.result_type = ret_type
    inst.has_result = ret_type != "void"
    b.instructions.push(inst)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, b, id)
}

-- assert(cond): panic with "assertion failed" unless cond is true
fn generate_assert_call(gen: IRGenerator, block: IRBasicBlock, args: List[Expr]) -> ExprResult {
    let mut g = gen
    let mut b = block

    if args.len() != 1 {
        g = ir_type_error(g, "assert() takes 1 argument, not " + int_to_string(args.len()), 0)
        return expr_result(g, b, 0)
    }

    let cond_result = generate_expr(g, b, args[0])
    g = cond_result.gen
    b = cond_result.block

    -- The runtime's rt_assert panics when the condition is false
    let id = g.builder.next_id
    let mut inst = ir_inst_new(id, OP_CALL())
    inst.callee = "dm_assert"
    let mut call_args: List[IRValue] = []
    call_args.push(ir_val_inst(cond_result.val_id))
    inst.call_args = call_args
    inst.result_type = "void"
    inst.has_result = false
    b.instructions.push(inst)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, b, id)
}

-- assert_eq(a, b): panic unless a == b. The comparison is the ==
-- operator's, so it works for every type == does; the runtime's
-- function panics with "assert_eq failed: strings not equal" or
-- "assert_eq failed: values not equal".
fn generate_assert_eq_call(gen: IRGenerator, block: IRBasicBlock, args: List[Expr]) -> ExprResult {
    let mut g = gen
    let mut b = block

    if args.len() != 2 {
        g = ir_type_error(g, "assert_eq() takes 2 arguments, not " + int_to_string(args.len()), 0)
        return expr_result(g, b, 0)
    }

    let compares_strings = static_type(g, args[0]) == "string" or static_type(g, args[1]) == "string"
    let equal = expr_binary(BINOP_EQ(), args[0], args[1], args[0].line, args[0].col)
    let eq_result = generate_expr(g, b, equal)
    g = eq_result.gen
    b = eq_result.block

    let id = g.builder.next_id
    let mut inst = ir_inst_new(id, OP_CALL())
    inst.callee = "dm_assert_eq_values"
    if compares_strings {
        inst.callee = "dm_assert_eq_strings"
    }
    let mut call_args: List[IRValue] = []
    call_args.push(ir_val_inst(eq_result.val_id))
    inst.call_args = call_args
    inst.result_type = "void"
    inst.has_result = false
    b.instructions.push(inst)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, b, id)
}

-- Generate a panic call.
-- panic(msg) -> dm_panic(msg); unreachable
fn generate_panic_call(gen: IRGenerator, block: IRBasicBlock, args: List[Expr]) -> ExprResult {
    let mut g = gen
    let mut b = block

    if args.len() < 1 {
        -- Panic with no message
        let id = g.builder.next_id
        let mut inst = ir_inst_new(id, OP_PANIC())
        inst.operand = ir_val_string("panic")
        inst.has_result = false
        b.instructions.push(inst)
        g.builder.next_id = g.builder.next_id + 1
        return end_block_after_panic(g, b, id)
    }

    -- Generate the message expression
    let msg_result = generate_expr(g, b, args[0])
    g = msg_result.gen
    b = msg_result.block

    let id = g.builder.next_id
    let mut inst = ir_inst_new(id, OP_PANIC())
    inst.operand = ir_val_inst(msg_result.val_id)
    inst.has_result = false
    b.instructions.push(inst)
    g.builder.next_id = g.builder.next_id + 1

    return end_block_after_panic(g, b, id)
}

-- panic never returns: end the block with `unreachable` and continue in a
-- new block that nothing branches to, so statements after the panic are
-- not emitted after a terminator.
fn end_block_after_panic(gen: IRGenerator, block: IRBasicBlock, id: int) -> ExprResult {
    let mut g = gen
    let mut b = block
    b.terminator = Box_new(term_unreachable())
    b.has_terminator = true
    g.completed_blocks.push(b)
    let cont_label = gen_next_label(g, "after_panic")
    g = gen_advance_label(g)
    return expr_result(g, ir_block_new(cont_label), id)
}

-- Generate a Box_new(value) call.
-- Allocates the value on the heap via malloc and stores it.
fn generate_box_new_call(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block
    let args = expr.args

    if args.len() < 1 {
        return expr_result(g, b, 0)
    }

    -- Generate the value to box. An integer becomes the integer type
    -- of the box the checker found for the place the box goes to.
    let mut val_result = generate_expr(g, b, args[0])
    let box_type = checked_type(g, expr)
    if starts_with(box_type, "Box[") {
        val_result = convert_int_to_place(val_result.gen, val_result.block, val_result.val_id, args[0], extract_inner_type(box_type, "Box["), "the value of 'Box_new'")
    }
    g = val_result.gen
    b = val_result.block

    -- Allocate as many bytes as the boxed value's LLVM type needs
    let malloc_id = g.builder.next_id
    let mut malloc_inst = ir_inst_new(malloc_id, OP_CALL())
    malloc_inst.callee = "dm_libc_malloc"
    let mut margs: List[IRValue] = []
    margs.push(ir_val_sizeof_value(val_result.val_id))
    malloc_inst.call_args = margs
    malloc_inst.result_type = "ptr"
    malloc_inst.has_result = true
    b.instructions.push(malloc_inst)
    g.builder.next_id = g.builder.next_id + 1

    -- Store the value into the allocated memory
    let mut store_inst = ir_inst_new(g.builder.next_id, OP_STORE())
    store_inst.store_ptr = ir_val_inst(malloc_id)
    store_inst.store_val = ir_val_inst(val_result.val_id)
    store_inst.has_result = false
    b.instructions.push(store_inst)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, b, malloc_id)
}

-- Generate a Box_null() call.
-- Returns a null pointer constant via inttoptr(0).
fn generate_box_null_call(gen: IRGenerator, block: IRBasicBlock) -> ExprResult {
    let mut g = gen
    let mut b = block

    -- Emit inttoptr(i64 0) to produce a true null pointer
    let id = g.builder.next_id
    let mut inst = ir_inst_new(id, OP_CAST())
    inst.cast_val = ir_val_int(0)
    inst.cast_from = "i64"
    inst.cast_to = "ptr"
    inst.result_type = "ptr"
    inst.has_result = true
    b.instructions.push(inst)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, b, id)
}

-- ============================================================
-- RUN COMMAND BUILTINS
-- run_command(args) and run_command_io(args, input, output, errors)
-- both call dm_run_command(list, input, output, errors); run_command
-- gives "" for the three files, which leaves the streams as they are.
-- ============================================================

fn generate_run_command_call(gen: IRGenerator, block: IRBasicBlock, expr: Expr) -> ExprResult {
    let mut g = gen
    let mut b = block
    let args = expr.args
    let callee = *expr.callee
    let fn_name = callee.name
    let takes = if fn_name == "run_command" { "1 argument" } else { "4 arguments" }
    let wanted = if fn_name == "run_command" { 1 } else { 4 }
    if args.len() != wanted {
        g = ir_type_error(g, fn_name + "() takes " + takes + ", not " + int_to_string(args.len()), expr.line)
        return expr_result(g, b, 0)
    }
    if static_type(g, args[0]) != "List[string]" {
        g = ir_type_error(g, fn_name + "() takes the program and its arguments as a List[string]", expr.line)
        return expr_result(g, b, 0)
    }
    -- The list goes to the runtime as the address of its header
    let handle = generate_list_handle(g, b, args[0])
    g = handle.gen
    b = handle.block
    let mut call_args: List[IRValue] = []
    call_args.push(handle.ptr)
    let mut i = 1
    while i < 4 {
        if i < args.len() {
            if infer_expr_type(g, args[i]) != "string" {
                g = ir_type_error(g, "argument " + int_to_string(i + 1) + " of '" + fn_name + "' is a file's path, a string", expr.line)
                return expr_result(g, b, 0)
            }
            let file = generate_expr(g, b, args[i])
            g = file.gen
            b = file.block
            call_args.push(ir_val_inst(file.val_id))
        } else {
            call_args.push(ir_val_string(""))
        }
        i = i + 1
    }
    let id = g.builder.next_id
    let mut call_inst = ir_inst_new(id, OP_CALL())
    call_inst.callee = "dm_run_command"
    call_inst.call_args = call_args
    call_inst.result_type = "i64"
    call_inst.has_result = true
    b.instructions.push(call_inst)
    g.builder.next_id = id + 1
    return expr_result(g, b, id)
}

-- ============================================================
-- STRING SPLIT BUILTIN
-- string_split(s, delim) returns List[string]
-- Needs special handling: allocates a list, calls dm_string_split
-- ============================================================

fn generate_string_split_call(gen: IRGenerator, block: IRBasicBlock, args: List[Expr]) -> ExprResult {
    let mut g = gen
    let mut b = block

    if args.len() < 2 {
        return expr_result(g, b, 0)
    }

    -- Generate source string
    let str_result = generate_expr(g, b, args[0])
    g = str_result.gen
    b = str_result.block

    -- Generate delimiter string
    let delim_result = generate_expr(g, b, args[1])
    g = delim_result.gen
    b = delim_result.block

    -- Allocate a list to receive the results
    let list_alloca_id = g.builder.next_id
    let mut list_inst = ir_inst_new(list_alloca_id, OP_ALLOCA())
    list_inst.alloc_type = "dm_list_dm_string"
    list_inst.result_type = "ptr(dm_list_dm_string)"
    list_inst.has_result = true
    b.instructions.push(list_inst)
    g.builder.next_id = g.builder.next_id + 1

    -- Call dm_string_split(list_ptr, str, delim)
    let id = g.builder.next_id
    let mut call_inst = ir_inst_new(id, OP_CALL())
    call_inst.callee = "dm_string_split"
    let mut call_args: List[IRValue] = []
    call_args.push(ir_val_inst(list_alloca_id))
    call_args.push(ir_val_inst(str_result.val_id))
    call_args.push(ir_val_inst(delim_result.val_id))
    call_inst.call_args = call_args
    call_inst.result_type = "void"
    call_inst.has_result = false
    b.instructions.push(call_inst)
    g.builder.next_id = g.builder.next_id + 1

    return expr_result(g, b, list_alloca_id)
}


-- ============================================================
-- COMPILE-TIME EVALUATION
-- The value of a `comptime` expression and of a `const` is found
-- here, by walking the expression: eval_comptime_expr gives it as an
-- IRValue, a constant of the program.
--
-- A value is an integer, a float, a bool, a string or a list of
-- values (CtValue). Variables are kept in CtState, innermost last;
-- a function that is called sees its own variables only (`base`).
-- The evaluator takes numbers, strings, bools and lists; operators;
-- `if`, `match` on literals and names, blocks; `let`, assignment,
-- `while`, `loop`, `for` over a range or a list, `break`, `continue`,
-- `return`; calls of the program's functions and of the builtins in
-- ct_builtin; f-strings; casts between numbers. What it does not
-- take is a compile error that says what it was, as is what would be
-- a panic in the program: an overflow, a division by zero, an index
-- out of range. A computation that takes more than CT_MAX_STEPS() steps
-- or calls nested more than CT_MAX_DEPTH() deep is an error too.
-- Until 2026-11-22 what the evaluator did not take was the value 0, a
-- loop stopped after 10,000 turns without a word, and a function
-- that was called saw its caller's variables.
-- ============================================================

fn CT_MAX_STEPS() -> int { return 1000000 }
fn CT_MAX_DEPTH() -> int { return 200 }

fn CT_NONE() -> int { return 0 }
fn CT_INT() -> int { return 1 }
fn CT_FLOAT() -> int { return 2 }
fn CT_BOOL() -> int { return 3 }
fn CT_STRING() -> int { return 4 }
fn CT_LIST() -> int { return 5 }

-- A value at compile time. CT_NONE is no value: what a statement gives.
struct CtValue {
    kind: int,
    int_val: int,
    float_val: float,
    bool_val: bool,
    str_val: string,
    items: List[CtValue]
}

fn ct_none() -> CtValue {
    return CtValue { kind: CT_NONE(), int_val: 0, float_val: 0.0, bool_val: false, str_val: "", items: [] }
}

fn ct_int(v: int) -> CtValue {
    return CtValue { kind: CT_INT(), int_val: v, float_val: 0.0, bool_val: false, str_val: "", items: [] }
}

fn ct_float(v: float) -> CtValue {
    return CtValue { kind: CT_FLOAT(), int_val: 0, float_val: v, bool_val: false, str_val: "", items: [] }
}

fn ct_bool(v: bool) -> CtValue {
    return CtValue { kind: CT_BOOL(), int_val: 0, float_val: 0.0, bool_val: v, str_val: "", items: [] }
}

fn ct_string(v: string) -> CtValue {
    return CtValue { kind: CT_STRING(), int_val: 0, float_val: 0.0, bool_val: false, str_val: v, items: [] }
}

fn ct_list(items: List[CtValue]) -> CtValue {
    return CtValue { kind: CT_LIST(), int_val: 0, float_val: 0.0, bool_val: false, str_val: "", items: items }
}

-- "an integer", "a list": the kind of a value, for a message
fn ct_kind_text(v: CtValue) -> string {
    if v.kind == CT_INT() { return "an integer" }
    if v.kind == CT_FLOAT() { return "a float" }
    if v.kind == CT_BOOL() { return "a bool" }
    if v.kind == CT_STRING() { return "a string" }
    if v.kind == CT_LIST() { return "a list" }
    return "no value"
}

-- What the evaluator knows and how far it is
struct CtState {
    files: List[string],
    decls: List[Declaration],
    globals: List[IRGlobal],
    -- The variables, innermost last
    names: List[string],
    values: List[CtValue],
    -- Where the variables of the function being evaluated begin
    base: int,
    steps: int,
    depth: int
}

-- How a statement ends: CT_NEXT goes on to the next one
fn CT_NEXT() -> int { return 0 }
fn CT_RETURN() -> int { return 1 }
fn CT_BREAK() -> int { return 2 }
fn CT_CONTINUE() -> int { return 3 }

struct CtOut {
    st: CtState,
    v: CtValue,
    flow: int
}

fn ct_out(st: CtState, v: CtValue) -> CtOut {
    return CtOut { st: st, v: v, flow: CT_NEXT() }
}

-- Report what cannot be evaluated and stop the compilation
fn ct_error(st: CtState, msg: string, line: int) {
    eprintln(error_at(st.files, msg + " in a compile-time expression", line))
    exit(1)
}

-- One more step taken
fn ct_step(st: CtState, line: int) -> CtState {
    let mut s = st
    s.steps = s.steps + 1
    if s.steps > CT_MAX_STEPS() {
        ct_error(s, "more than " + int_to_string(CT_MAX_STEPS()) + " steps (does it end?)", line)
    }
    return s
}

-- ============================================================
-- VARIABLES
-- ============================================================

fn ct_bind(st: CtState, name: string, v: CtValue) -> CtState {
    let mut s = st
    s.names.push(name)
    s.values.push(v)
    return s
}

-- Forget the variables declared since there were `mark` of them
fn ct_leave(st: CtState, mark: int) -> CtState {
    let mut s = st
    while s.names.len() > mark {
        s.names.pop()
        s.values.pop()
    }
    return s
}

-- The place of the variable among the function's own, or -1
fn ct_find(st: CtState, name: string) -> int {
    let mut i = st.names.len() - 1
    while i >= st.base {
        if st.names[i] == name { return i }
        i = i - 1
    }
    return -1
}

fn ct_from_ir(val: IRValue) -> CtValue {
    if val.kind == VAL_CONST_INT() { return ct_int(val.int_val) }
    if val.kind == VAL_CONST_FLOAT() { return ct_float(val.float_val) }
    if val.kind == VAL_CONST_BOOL() { return ct_bool(val.bool_val) }
    if val.kind == VAL_CONST_STRING() { return ct_string(val.str_val) }
    return ct_none()
}

-- The value of a name: a variable, or a constant of the program,
-- also one that is declared further down
fn ct_name(st: CtState, name: string, line: int) -> CtOut {
    let at = ct_find(st, name)
    if at >= 0 {
        let v = st.values[at]
        if v.kind == CT_NONE() { ct_error(st, "'" + source_name(name) + "' has no value", line) }
        return ct_out(st, v)
    }
    let mut gi = st.globals.len() - 1
    while gi >= 0 {
        let gl = st.globals[gi]
        if gl.name == name and gl.has_init and gl.is_const {
            let v = ct_from_ir(gl.init_value)
            if v.kind != CT_NONE() { return ct_out(st, v) }
        }
        gi = gi - 1
    }
    let mut di = 0
    while di < st.decls.len() {
        let decl = st.decls[di]
        if decl.kind == DECL_CONST() {
            let cd = *decl.const_decl
            if cd.name == name {
                -- Its value is evaluated with no variables in sight
                let mut inner = st
                inner.base = inner.names.len()
                inner.depth = inner.depth + 1
                if inner.depth > CT_MAX_DEPTH() {
                    ct_error(st, "the constant '" + name + "' is defined by itself", line)
                }
                let found = ct_expr(inner, *cd.value)
                let mut back = found.st
                back.base = st.base
                back.depth = st.depth
                return ct_out(back, found.v)
            }
        }
        di = di + 1
    }
    ct_error(st, "'" + source_name(name) + "' is not known at compile time: it is not a constant, nor a variable of the expression", line)
    return ct_out(st, ct_none())
}

-- ============================================================
-- OPERATORS
-- ============================================================

fn CT_INT_MAX() -> int { return 9223372036854775807 }
fn CT_INT_MIN() -> int { return 0 - 9223372036854775807 - 1 }

fn ct_add_overflows(a: int, b: int) -> bool {
    if b > 0 { return a > CT_INT_MAX() - b }
    if b < 0 { return a < CT_INT_MIN() - b }
    return false
}

fn ct_sub_overflows(a: int, b: int) -> bool {
    if b > 0 { return a < CT_INT_MIN() + b }
    if b < 0 { return a > CT_INT_MAX() + b }
    return false
}

fn ct_mul_overflows(a: int, b: int) -> bool {
    if a == 0 or b == 0 { return false }
    if a == 0 - 1 { return b == CT_INT_MIN() }
    if b == 0 - 1 { return a == CT_INT_MIN() }
    if a > 0 {
        if b > 0 { return a > CT_INT_MAX() / b }
        return b < CT_INT_MIN() / a
    }
    if b > 0 { return a < CT_INT_MIN() / b }
    return a < CT_INT_MAX() / b
}

fn is_bit_binop(op: int) -> bool {
    return op == BINOP_BIT_AND() or op == BINOP_BIT_OR() or op == BINOP_BIT_XOR() or op == BINOP_SHL() or op == BINOP_SHR()
}

-- The 64 bits of an integer, the lowest first, each 0 or 1. The
-- compiler's own source is compiled by the seed's compiler, which may
-- have no bitwise operators, so the bits are found by arithmetic.
fn comptime_bits(v: int) -> List[int] {
    let mut bits: List[int] = []
    let mut x = v
    let mut i = 0
    while i < 64 {
        -- x halved and rounded down, also where x is negative
        let mut half = x / 2
        if x < 0 and x % 2 != 0 { half = (x - 1) / 2 }
        bits.push(x - half - half)
        x = half
        i = i + 1
    }
    return bits
}

-- The integer with the 64 bits, the lowest first
fn comptime_from_bits(bits: List[int]) -> int {
    let mut v = 0
    let mut weight = 1
    let mut i = 0
    while i < 63 {
        if bits[i] == 1 { v = v + weight }
        if i < 62 { weight = weight * 2 }
        i = i + 1
    }
    -- The highest bit is the sign: it weighs -2^63
    if bits[63] == 1 { v = v + (0 - 9223372036854775807 - 1) }
    return v
}

-- a & b, a | b, a ^ b, a << b or a >> b of two 64-bit integers, as the
-- program computes them. A shift by 64 or more, or by a negative
-- amount, is an error here as it is a panic there.
fn comptime_bit_op(files: List[string], op: int, a: int, b: int, line: int) -> int {
    let x = comptime_bits(a)
    let mut out: List[int] = []
    let mut i = 0
    if op == BINOP_SHL() or op == BINOP_SHR() {
        if b < 0 or b > 63 {
            eprintln(error_at(files, "shift amount " + int_to_string(b) + " is out of range in a compile-time expression", line))
            exit(1)
        }
        while i < 64 {
            let mut bit = 0
            if op == BINOP_SHL() {
                if i >= b { bit = x[i - b] }
            } else if i + b < 64 {
                bit = x[i + b]
            } else {
                -- The sign fills the top
                bit = x[63]
            }
            out.push(bit)
            i = i + 1
        }
        return comptime_from_bits(out)
    }
    let y = comptime_bits(b)
    while i < 64 {
        let mut bit = 0
        if op == BINOP_BIT_AND() {
            if x[i] == 1 and y[i] == 1 { bit = 1 }
        } else if op == BINOP_BIT_OR() {
            if x[i] == 1 or y[i] == 1 { bit = 1 }
        } else if x[i] != y[i] {
            bit = 1
        }
        out.push(bit)
        i = i + 1
    }
    return comptime_from_bits(out)
}


fn ct_int_op(st: CtState, op: int, a: int, b: int, line: int) -> CtValue {
    if op == BINOP_ADD() {
        if ct_add_overflows(a, b) { ct_error(st, "integer overflow", line) }
        return ct_int(a + b)
    }
    if op == BINOP_SUB() {
        if ct_sub_overflows(a, b) { ct_error(st, "integer overflow", line) }
        return ct_int(a - b)
    }
    if op == BINOP_MUL() {
        if ct_mul_overflows(a, b) { ct_error(st, "integer overflow", line) }
        return ct_int(a * b)
    }
    if op == BINOP_DIV() or op == BINOP_MOD() {
        -- An error here as it is a panic in the program
        if b == 0 { ct_error(st, "division by zero", line) }
        if b == 0 - 1 {
            if op == BINOP_MOD() { return ct_int(0) }
            if a == CT_INT_MIN() { ct_error(st, "integer overflow", line) }
            return ct_int(0 - a)
        }
        if op == BINOP_DIV() { return ct_int(a / b) }
        return ct_int(a % b)
    }
    if is_bit_binop(op) { return ct_int(comptime_bit_op(st.files, op, a, b, line)) }
    if op == BINOP_EQ() { return ct_bool(a == b) }
    if op == BINOP_NE() { return ct_bool(a != b) }
    if op == BINOP_LT() { return ct_bool(a < b) }
    if op == BINOP_LE() { return ct_bool(a <= b) }
    if op == BINOP_GT() { return ct_bool(a > b) }
    if op == BINOP_GE() { return ct_bool(a >= b) }
    return ct_none()
}

fn ct_float_op(op: int, a: float, b: float) -> CtValue {
    if op == BINOP_ADD() { return ct_float(a + b) }
    if op == BINOP_SUB() { return ct_float(a - b) }
    if op == BINOP_MUL() { return ct_float(a * b) }
    if op == BINOP_DIV() { return ct_float(a / b) }
    if op == BINOP_EQ() { return ct_bool(a == b) }
    if op == BINOP_NE() { return ct_bool(a != b) }
    if op == BINOP_LT() { return ct_bool(a < b) }
    if op == BINOP_LE() { return ct_bool(a <= b) }
    if op == BINOP_GT() { return ct_bool(a > b) }
    if op == BINOP_GE() { return ct_bool(a >= b) }
    return ct_none()
}

-- Whether two values are equal: of one kind, and lists element by element
fn ct_equal(a: CtValue, b: CtValue) -> bool {
    if a.kind != b.kind { return false }
    if a.kind == CT_INT() { return a.int_val == b.int_val }
    if a.kind == CT_FLOAT() { return a.float_val == b.float_val }
    if a.kind == CT_BOOL() { return a.bool_val == b.bool_val }
    if a.kind == CT_STRING() { return a.str_val == b.str_val }
    if a.kind == CT_LIST() {
        if a.items.len() != b.items.len() { return false }
        let mut i = 0
        while i < a.items.len() {
            if ct_equal(a.items[i], b.items[i]) == false { return false }
            i = i + 1
        }
        return true
    }
    return true
}

-- a op b for two values; not `and` and `or`, which ct_expr evaluates
fn ct_binary(st: CtState, op: int, a: CtValue, b: CtValue, line: int) -> CtValue {
    let mut out = ct_none()
    if a.kind == CT_INT() and b.kind == CT_INT() {
        out = ct_int_op(st, op, a.int_val, b.int_val, line)
    } else if a.kind == CT_FLOAT() and b.kind == CT_FLOAT() {
        out = ct_float_op(op, a.float_val, b.float_val)
    } else if a.kind == CT_BOOL() and b.kind == CT_BOOL() {
        if op == BINOP_BIT_AND() { out = ct_bool(a.bool_val and b.bool_val) }
        if op == BINOP_BIT_OR() { out = ct_bool(a.bool_val or b.bool_val) }
        if op == BINOP_BIT_XOR() { out = ct_bool(a.bool_val != b.bool_val) }
        if op == BINOP_EQ() { out = ct_bool(a.bool_val == b.bool_val) }
        if op == BINOP_NE() { out = ct_bool(a.bool_val != b.bool_val) }
    } else if a.kind == CT_STRING() and b.kind == CT_STRING() {
        if op == BINOP_ADD() { out = ct_string(a.str_val + b.str_val) }
        if op == BINOP_EQ() { out = ct_bool(a.str_val == b.str_val) }
        if op == BINOP_NE() { out = ct_bool(a.str_val != b.str_val) }
        if op == BINOP_LT() { out = ct_bool(a.str_val < b.str_val) }
        if op == BINOP_LE() { out = ct_bool(a.str_val <= b.str_val) }
        if op == BINOP_GT() { out = ct_bool(a.str_val > b.str_val) }
        if op == BINOP_GE() { out = ct_bool(a.str_val >= b.str_val) }
    } else if a.kind == CT_LIST() and b.kind == CT_LIST() {
        if op == BINOP_EQ() { out = ct_bool(ct_equal(a, b)) }
        if op == BINOP_NE() { out = ct_bool(ct_equal(a, b) == false) }
    }
    if out.kind == CT_NONE() {
        ct_error(st, "operator '" + ty_op_text(op) + "' does not take " + ct_kind_text(a) + " and " + ct_kind_text(b), line)
    }
    return out
}

-- ============================================================
-- EXPRESSIONS
-- ============================================================

-- The value as a bool, which a condition must be
fn ct_condition(st: CtState, v: CtValue, line: int) -> bool {
    if v.kind != CT_BOOL() { ct_error(st, "a condition is " + ct_kind_text(v) + ", not a bool", line) }
    return v.bool_val
}

-- The value as text, as an f-string prints it
fn ct_text(st: CtState, v: CtValue, line: int) -> string {
    if v.kind == CT_INT() { return int_to_string(v.int_val) }
    if v.kind == CT_FLOAT() { return float_to_string(v.float_val) }
    if v.kind == CT_BOOL() { return bool_to_string(v.bool_val) }
    if v.kind == CT_STRING() { return v.str_val }
    ct_error(st, ct_kind_text(v) + " cannot be made a string", line)
    return ""
}

-- Whether the integer fits the integer type
fn ct_int_fits(v: int, t: string) -> bool {
    if t == "i8" { return v >= 0 - 128 and v <= 127 }
    if t == "i16" { return v >= 0 - 32768 and v <= 32767 }
    if t == "i32" { return v >= 0 - 2147483648 and v <= 2147483647 }
    if t == "u8" { return v >= 0 and v <= 255 }
    if t == "u16" { return v >= 0 and v <= 65535 }
    if t == "u32" { return v >= 0 and v <= 4294967295 }
    if t == "u64" { return v >= 0 }
    return true
}

fn ct_cast(st: CtState, v: CtValue, t: string, line: int) -> CtValue {
    let to_float = t == "float" or t == "f64" or t == "f32"
    let to_int = t == "int" or t == "i64" or t == "i8" or t == "i16" or t == "i32" or t == "u8" or t == "u16" or t == "u32" or t == "u64"
    if v.kind == CT_INT() {
        if to_float { return ct_float(v.int_val as float) }
        if to_int {
            if ct_int_fits(v.int_val, t) == false {
                ct_error(st, int_to_string(v.int_val) + " does not fit " + t, line)
            }
            return v
        }
    }
    if v.kind == CT_FLOAT() {
        if to_float { return v }
        if to_int {
            if v.float_val >= 9223372036854775808.0 or v.float_val < 0.0 - 9223372036854775808.0 or v.float_val != v.float_val {
                ct_error(st, float_to_string(v.float_val) + " does not fit " + t, line)
            }
            let whole = v.float_val as int
            if ct_int_fits(whole, t) == false {
                ct_error(st, int_to_string(whole) + " does not fit " + t, line)
            }
            return ct_int(whole)
        }
    }
    if v.kind == CT_BOOL() and t == "bool" { return v }
    if v.kind == CT_STRING() and (t == "string" or t == "String") { return v }
    ct_error(st, ct_kind_text(v) + " cannot be cast to " + t, line)
    return v
}

-- What an expression the evaluator does not take is called, for the error
fn ct_expr_text(e: Expr) -> string {
    let k = e.kind
    if k == EXPR_FIELD_ACCESS() { return "a field ('." + e.field + "')" }
    if k == EXPR_METHOD_CALL() { return "the method '" + e.method + "'" }
    if k == EXPR_STRUCT_LITERAL() { return "a struct ('" + e.type_name + "')" }
    if k == EXPR_ENUM_LITERAL() { return "an enum value" }
    if k == EXPR_LAMBDA() { return "a lambda" }
    if k == EXPR_ERROR_PROPAGATE() { return "'?'" }
    if k == EXPR_RANGE() { return "a range outside a 'for'" }
    if k == EXPR_AWAIT() { return "'await'" }
    return "this expression"
}

fn ct_index(st: CtState, object: CtValue, index: CtValue, line: int) -> CtValue {
    if index.kind != CT_INT() { ct_error(st, "an index is " + ct_kind_text(index) + ", not an integer", line) }
    let i = index.int_val
    if object.kind == CT_LIST() {
        if i < 0 or i >= object.items.len() {
            ct_error(st, "index " + int_to_string(i) + " is out of range for a list of " + int_to_string(object.items.len()), line)
        }
        return object.items[i]
    }
    if object.kind == CT_STRING() {
        if i < 0 or i >= len(object.str_val) {
            ct_error(st, "index " + int_to_string(i) + " is out of range for a string of " + int_to_string(len(object.str_val)), line)
        }
        return ct_string(char_at(object.str_val, i))
    }
    ct_error(st, ct_kind_text(object) + " cannot be indexed", line)
    return ct_none()
}

fn ct_expr(st0: CtState, e: Expr) -> CtOut {
    let k = e.kind
    if k == EXPR_LITERAL_INT() { return ct_out(st0, ct_int(e.int_val)) }
    if k == EXPR_LITERAL_FLOAT() { return ct_out(st0, ct_float(e.float_val)) }
    if k == EXPR_LITERAL_BOOL() { return ct_out(st0, ct_bool(e.bool_val)) }
    if k == EXPR_LITERAL_STRING() { return ct_out(st0, ct_string(e.str_val)) }
    if k == EXPR_IDENTIFIER() { return ct_name(st0, e.name, e.line) }
    if k == EXPR_GROUPED() or k == EXPR_COMPTIME() { return ct_expr(st0, *e.operand) }
    let mut st = st0

    if k == EXPR_BINARY() {
        let left = ct_expr(st, *e.left)
        st = left.st
        if e.op == BINOP_AND() or e.op == BINOP_OR() {
            -- The right side is evaluated only where it decides
            let first = ct_condition(st, left.v, e.line)
            if e.op == BINOP_AND() and first == false { return ct_out(st, ct_bool(false)) }
            if e.op == BINOP_OR() and first { return ct_out(st, ct_bool(true)) }
            let right = ct_expr(st, *e.right)
            return ct_out(right.st, ct_bool(ct_condition(right.st, right.v, e.line)))
        }
        let right = ct_expr(st, *e.right)
        st = right.st
        let mut a = left.v
        let mut b = right.v
        -- An integer meets a float as a float
        if a.kind == CT_INT() and b.kind == CT_FLOAT() { a = ct_float(a.int_val as float) }
        if a.kind == CT_FLOAT() and b.kind == CT_INT() { b = ct_float(b.int_val as float) }
        return ct_out(st, ct_binary(st, e.op, a, b, e.line))
    }

    if k == EXPR_UNARY() {
        let operand = ct_expr(st, *e.operand)
        st = operand.st
        let v = operand.v
        if e.op == UNOP_NEG() and v.kind == CT_INT() {
            if v.int_val == CT_INT_MIN() { ct_error(st, "integer overflow", e.line) }
            return ct_out(st, ct_int(0 - v.int_val))
        }
        if e.op == UNOP_NEG() and v.kind == CT_FLOAT() { return ct_out(st, ct_float(0.0 - v.float_val)) }
        -- ~x is -x - 1
        if e.op == UNOP_BIT_NOT() and v.kind == CT_INT() { return ct_out(st, ct_int(0 - 1 - v.int_val)) }
        if e.op == UNOP_NOT() and v.kind == CT_BOOL() { return ct_out(st, ct_bool(v.bool_val == false)) }
        let mut text = "'not'"
        if e.op == UNOP_NEG() { text = "'-'" }
        if e.op == UNOP_BIT_NOT() { text = "'~'" }
        if e.op == UNOP_DEREF() { text = "'*'" }
        ct_error(st, text + " does not take " + ct_kind_text(v), e.line)
    }

    if k == EXPR_IF() {
        let cond = ct_expr(st, *e.condition)
        st = cond.st
        if ct_condition(st, cond.v, e.line) { return ct_expr(st, *e.then_branch) }
        if e.has_else { return ct_expr(st, *e.else_branch) }
        return ct_out(st, ct_none())
    }

    if k == EXPR_BLOCK() {
        let mark = st.names.len()
        let mut done = ct_stmts(st, e.stmts)
        if done.flow == CT_NEXT() and e.has_result {
            done = ct_expr(done.st, *e.result)
        }
        done.st = ct_leave(done.st, mark)
        return done
    }

    if k == EXPR_MATCH() { return ct_match(st, e) }
    if k == EXPR_FUNCTION_CALL() { return ct_call(st, e) }

    if k == EXPR_ARRAY_LITERAL() {
        let mut items: List[CtValue] = []
        let mut i = 0
        while i < e.elements.len() {
            let item = ct_expr(st, e.elements[i])
            st = item.st
            items.push(item.v)
            i = i + 1
        }
        return ct_out(st, ct_list(items))
    }

    if k == EXPR_INDEX_ACCESS() {
        let object = ct_expr(st, *e.object)
        let index = ct_expr(object.st, *e.index)
        return ct_out(index.st, ct_index(index.st, object.v, index.v, e.line))
    }

    if k == EXPR_METHOD_CALL() and e.method == "len" and e.args.len() == 0 {
        let object = ct_expr(st, *e.object)
        if object.v.kind == CT_LIST() { return ct_out(object.st, ct_int(object.v.items.len())) }
        if object.v.kind == CT_STRING() { return ct_out(object.st, ct_int(len(object.v.str_val))) }
        ct_error(st, ct_kind_text(object.v) + " has no length", e.line)
    }

    if k == EXPR_CAST() {
        let operand = ct_expr(st, *e.operand)
        return ct_out(operand.st, ct_cast(operand.st, operand.v, e.cast_type, e.line))
    }

    if k == EXPR_STRING_INTERP() {
        let mut text = ""
        let mut i = 0
        while i < e.interp_parts.len() {
            let part = ct_expr(st, e.interp_parts[i])
            st = part.st
            text = text + ct_text(st, part.v, e.line)
            i = i + 1
        }
        return ct_out(st, ct_string(text))
    }

    ct_error(st, ct_expr_text(e) + " cannot be evaluated", e.line)
    return ct_out(st, ct_none())
}

-- Whether the value matches the pattern of a match arm
fn ct_pattern_matches(st: CtState, v: CtValue, pat: Pattern, line: int) -> bool {
    if pat.kind == PAT_WILDCARD() or pat.kind == PAT_IDENTIFIER() { return true }
    if pat.kind == PAT_LITERAL() {
        let literal = ct_expr(st, *pat.literal_expr)
        return ct_equal(v, literal.v)
    }
    ct_error(st, "the pattern of a variant ('" + pat.variant + "') cannot be matched", line)
    return false
}

fn ct_match(st0: CtState, e: Expr) -> CtOut {
    let scrutinee = ct_expr(st0, *e.scrutinee)
    let mut st = scrutinee.st
    let mut i = 0
    while i < e.match_arms.len() {
        let arm = e.match_arms[i]
        if ct_pattern_matches(st, scrutinee.v, arm.pattern, e.line) {
            let mark = st.names.len()
            if arm.pattern.kind == PAT_IDENTIFIER() {
                st = ct_bind(st, arm.pattern.name, scrutinee.v)
            }
            let mut taken = true
            if arm.has_guard {
                let guard = ct_expr(st, *arm.guard)
                st = guard.st
                taken = ct_condition(st, guard.v, e.line)
            }
            if taken {
                let mut done = ct_out(st, ct_none())
                if arm.is_expr_body {
                    done = ct_expr(st, *arm.body_expr)
                } else {
                    done = ct_stmts(st, arm.body)
                }
                done.st = ct_leave(done.st, mark)
                return done
            }
            st = ct_leave(st, mark)
        }
        i = i + 1
    }
    ct_error(st, "no arm of the match takes the value", e.line)
    return ct_out(st, ct_none())
}

-- ============================================================
-- CALLS
-- ============================================================

fn ct_want(st: CtState, name: string, args: List[CtValue], i: int, kind: int, line: int) -> CtValue {
    if args[i].kind != kind {
        ct_error(st, "argument " + int_to_string(i + 1) + " of " + name + "() is " + ct_kind_text(args[i]), line)
    }
    return args[i]
}

-- The builtin functions that are evaluated at compile time; CT_NONE
-- for any other name
fn ct_builtin(st: CtState, name: string, args: List[CtValue], line: int) -> CtValue {
    let n = args.len()
    if name == "len" and n == 1 {
        if args[0].kind == CT_LIST() { return ct_int(args[0].items.len()) }
        return ct_int(len(ct_want(st, name, args, 0, CT_STRING(), line).str_val))
    }
    if name == "int_to_string" and n == 1 { return ct_string(int_to_string(ct_want(st, name, args, 0, CT_INT(), line).int_val)) }
    if name == "float_to_string" and n == 1 { return ct_string(float_to_string(ct_want(st, name, args, 0, CT_FLOAT(), line).float_val)) }
    if name == "bool_to_string" and n == 1 { return ct_string(bool_to_string(ct_want(st, name, args, 0, CT_BOOL(), line).bool_val)) }
    if name == "char_at" and n == 2 {
        return ct_index(st, ct_want(st, name, args, 0, CT_STRING(), line), ct_want(st, name, args, 1, CT_INT(), line), line)
    }
    if name == "substr" and n == 3 {
        let s = ct_want(st, name, args, 0, CT_STRING(), line).str_val
        return ct_string(substr(s, ct_want(st, name, args, 1, CT_INT(), line).int_val, ct_want(st, name, args, 2, CT_INT(), line).int_val))
    }
    if n == 2 and (name == "string_contains" or name == "string_find" or name == "starts_with" or name == "ends_with") {
        let s = ct_want(st, name, args, 0, CT_STRING(), line).str_val
        let t = ct_want(st, name, args, 1, CT_STRING(), line).str_val
        if name == "string_contains" { return ct_bool(string_contains(s, t)) }
        if name == "string_find" { return ct_int(string_find(s, t)) }
        if name == "starts_with" { return ct_bool(starts_with(s, t)) }
        return ct_bool(ends_with(s, t))
    }
    if n == 1 and (name == "string_trim" or name == "string_to_upper" or name == "string_to_lower") {
        let s = ct_want(st, name, args, 0, CT_STRING(), line).str_val
        if name == "string_trim" { return ct_string(string_trim(s)) }
        if name == "string_to_upper" { return ct_string(string_to_upper(s)) }
        return ct_string(string_to_lower(s))
    }
    if name == "string_replace" and n == 3 {
        let s = ct_want(st, name, args, 0, CT_STRING(), line).str_val
        return ct_string(string_replace(s, ct_want(st, name, args, 1, CT_STRING(), line).str_val, ct_want(st, name, args, 2, CT_STRING(), line).str_val))
    }
    return ct_none()
}

fn ct_call(st0: CtState, e: Expr) -> CtOut {
    let callee = *e.callee
    if callee.kind != EXPR_IDENTIFIER() {
        ct_error(st0, "a call of what is not a function's name cannot be evaluated", e.line)
    }
    let name = callee.name
    let mut st = ct_step(st0, e.line)
    let mut args: List[CtValue] = []
    let mut i = 0
    while i < e.args.len() {
        let arg = ct_expr(st, e.args[i])
        st = arg.st
        args.push(arg.v)
        i = i + 1
    }

    -- A builtin's name is the builtin, as it is in the program
    if is_builtin_fn(name) {
        let built = ct_builtin(st, name, args, e.line)
        if built.kind == CT_NONE() {
            ct_error(st, "'" + name + "' cannot be called", e.line)
        }
        return ct_out(st, built)
    }
    -- The program's function of the name. The methods of generic
    -- types are among the declarations too, under their own names:
    -- they take `self`.
    let mut found = -1
    i = 0
    while i < st.decls.len() and found < 0 {
        let decl = st.decls[i]
        if decl.kind == DECL_FUNCTION() {
            let fd = *decl.func_decl
            let mut is_method = false
            if fd.params.len() > 0 { is_method = fd.params[0].name == "self" }
            if fd.name == name and fd.is_extern == false and is_method == false { found = i }
        }
        i = i + 1
    }
    if found < 0 {
        ct_error(st, "'" + name + "' cannot be called", e.line)
    }
    let decl = st.decls[found]
    let fd = *decl.func_decl
    if fd.params.len() != args.len() {
        ct_error(st, "'" + name + "' takes " + int_to_string(fd.params.len()) + " arguments, not " + int_to_string(args.len()) + ",", e.line)
    }
    if st.depth >= CT_MAX_DEPTH() {
        ct_error(st, "calls nested more than " + int_to_string(CT_MAX_DEPTH()) + " deep ('" + name + "')", e.line)
    }

    -- The function sees its parameters and nothing of its caller
    let mark = st.names.len()
    let caller_base = st.base
    st.base = mark
    st.depth = st.depth + 1
    i = 0
    while i < fd.params.len() {
        st = ct_bind(st, fd.params[i].name, args[i])
        i = i + 1
    }
    let done = ct_stmts(st, fd.body)
    st = ct_leave(done.st, mark)
    st.base = caller_base
    st.depth = st.depth - 1
    if done.flow == CT_BREAK() or done.flow == CT_CONTINUE() {
        ct_error(st, "'break' or 'continue' outside a loop in '" + name + "'", e.line)
    }
    if done.flow != CT_RETURN() and done.v.kind == CT_NONE() and fd.return_type != "" and fd.return_type != "void" {
        ct_error(st, "'" + name + "' ended without returning a value", e.line)
    }
    return ct_out(st, done.v)
}

-- ============================================================
-- STATEMENTS
-- ============================================================

-- Run the body of a loop once. The variables it declares are forgotten.
fn ct_loop_body(st: CtState, body: List[Stmt]) -> CtOut {
    let mark = st.names.len()
    let mut done = ct_stmts(st, body)
    done.st = ct_leave(done.st, mark)
    return done
}

-- name = v, or name op= v
fn ct_assign(st0: CtState, s: Stmt) -> CtState {
    let value = ct_expr(st0, *s.assign_value)
    let mut st = value.st
    let mut v = value.v
    let target = *s.assign_target
    let mut op = 0 - 1
    if s.assign_op == ASSIGN_ADD() { op = BINOP_ADD() }
    if s.assign_op == ASSIGN_SUB() { op = BINOP_SUB() }
    if s.assign_op == ASSIGN_MUL() { op = BINOP_MUL() }
    if s.assign_op == ASSIGN_DIV() { op = BINOP_DIV() }
    if s.assign_op == ASSIGN_MOD() { op = BINOP_MOD() }
    if target.kind == EXPR_IDENTIFIER() {
        let at = ct_find(st, target.name)
        if at < 0 {
            ct_error(st, "'" + source_name(target.name) + "' is not a variable of the expression", s.line)
        }
        if op >= 0 { v = ct_binary(st, op, st.values[at], v, s.line) }
        st.values[at] = v
        return st
    }
    if target.kind == EXPR_INDEX_ACCESS() {
        let object = *target.object
        if object.kind == EXPR_IDENTIFIER() {
            let at = ct_find(st, object.name)
            if at < 0 {
                ct_error(st, "'" + source_name(object.name) + "' is not a variable of the expression", s.line)
            }
            let index = ct_expr(st, *target.index)
            st = index.st
            let old = ct_index(st, st.values[at], index.v, s.line)
            if op >= 0 { v = ct_binary(st, op, old, v, s.line) }
            let mut list = st.values[at]
            if list.kind != CT_LIST() { ct_error(st, "an element of " + ct_kind_text(list) + " cannot be assigned", s.line) }
            -- A list of its own: another variable may hold the old one
            let mut items: List[CtValue] = []
            let mut i = 0
            while i < list.items.len() {
                if i == index.v.int_val {
                    items.push(v)
                } else {
                    items.push(list.items[i])
                }
                i = i + 1
            }
            list.items = items
            st.values[at] = list
            return st
        }
    }
    ct_error(st, "this assignment cannot be evaluated", s.line)
    return st
}

-- xs.push(v) on a variable: the one method call that is a statement
fn ct_push(st0: CtState, e: Expr) -> CtState {
    let object = *e.object
    let at = ct_find(st0, object.name)
    if at < 0 {
        ct_error(st0, "'" + source_name(object.name) + "' is not a variable of the expression", e.line)
    }
    let pushed = ct_expr(st0, e.args[0])
    let mut st = pushed.st
    let mut list = st.values[at]
    if list.kind != CT_LIST() { ct_error(st, "push() on " + ct_kind_text(list), e.line) }
    -- A list of its own: another variable may hold the old one
    let mut items: List[CtValue] = []
    let mut i = 0
    while i < list.items.len() {
        items.push(list.items[i])
        i = i + 1
    }
    items.push(pushed.v)
    list.items = items
    st.values[at] = list
    return st
}

-- Run the statements in turn. The value is that of the last one, if it
-- gives one (the value of a block that ends in an expression, an `if`
-- or a `match`), or what a `return` returns.
fn ct_stmts(st0: CtState, stmts: List[Stmt]) -> CtOut {
    let mut st = st0
    let mut last = ct_none()
    let mut i = 0
    while i < stmts.len() {
        let s = stmts[i]
        let k = s.kind
        last = ct_none()
        if k == STMT_RETURN() {
            let mut out = ct_out(st, ct_none())
            if s.has_ret_value { out = ct_expr(st, *s.ret_value) }
            out.flow = CT_RETURN()
            return out
        } else if k == STMT_BREAK() or k == STMT_CONTINUE() {
            let mut out = ct_out(st, ct_none())
            out.flow = CT_BREAK()
            if k == STMT_CONTINUE() { out.flow = CT_CONTINUE() }
            return out
        } else if k == STMT_LET() {
            let value_expr = *s.let_value
            if value_expr.kind == EXPR_LITERAL_NULL() {
                st = ct_bind(st, s.let_name, ct_none())
            } else {
                let value = ct_expr(st, value_expr)
                st = ct_bind(value.st, s.let_name, value.v)
            }
        } else if k == STMT_ASSIGNMENT() {
            st = ct_assign(st, s)
        } else if k == STMT_EXPRESSION() {
            let e = *s.expr
            let mut is_push = false
            if e.kind == EXPR_METHOD_CALL() and e.method == "push" and e.args.len() == 1 {
                let object = *e.object
                is_push = object.kind == EXPR_IDENTIFIER()
            }
            if is_push {
                st = ct_push(st, e)
            } else {
                let value = ct_expr(st, e)
                st = value.st
                last = value.v
                if value.flow != CT_NEXT() { return value }
            }
        } else if k == STMT_IF() {
            let cond = ct_expr(st, *s.if_cond)
            st = cond.st
            let mark = st.names.len()
            let mut done = ct_out(st, ct_none())
            if ct_condition(st, cond.v, s.line) {
                done = ct_stmts(st, s.if_then)
            } else if s.has_else_branch {
                done = ct_stmts(st, s.if_else)
            }
            done.st = ct_leave(done.st, mark)
            if done.flow != CT_NEXT() { return done }
            st = done.st
            last = done.v
        } else if k == STMT_MATCH() {
            let done = ct_match(st, *s.match_expr)
            if done.flow != CT_NEXT() { return done }
            st = done.st
            last = done.v
        } else if k == STMT_WHILE() or k == STMT_LOOP() {
            let mut looping = true
            while looping {
                st = ct_step(st, s.line)
                if k == STMT_WHILE() {
                    let cond = ct_expr(st, *s.while_cond)
                    st = cond.st
                    looping = ct_condition(st, cond.v, s.line)
                }
                if looping {
                    let mut body = s.while_body
                    if k == STMT_LOOP() { body = s.loop_body }
                    let done = ct_loop_body(st, body)
                    st = done.st
                    if done.flow == CT_RETURN() { return done }
                    if done.flow == CT_BREAK() { looping = false }
                }
            }
        } else if k == STMT_FOR() {
            let iter = *s.for_iter
            let mut items: List[CtValue] = []
            if iter.kind == EXPR_RANGE() {
                let from = ct_expr(st, *iter.left)
                let to = ct_expr(from.st, *iter.right)
                st = to.st
                if from.v.kind != CT_INT() or to.v.kind != CT_INT() {
                    ct_error(st, "a range runs from " + ct_kind_text(from.v) + " to " + ct_kind_text(to.v) + ", not between integers", s.line)
                }
                let mut n = from.v.int_val
                let end = to.v.int_val
                while n < end {
                    st = ct_step(st, s.line)
                    items.push(ct_int(n))
                    n = n + 1
                }
                -- a..=b ends with b
                if iter.op == BINOP_LE() and from.v.int_val <= end { items.push(ct_int(end)) }
            } else {
                let list = ct_expr(st, iter)
                st = list.st
                if list.v.kind != CT_LIST() {
                    ct_error(st, "'for' runs over " + ct_kind_text(list.v) + ", not a list or a range", s.line)
                }
                items = list.v.items
            }
            let mut fi = 0
            let mut looping = true
            while looping and fi < items.len() {
                st = ct_step(st, s.line)
                let mark = st.names.len()
                st = ct_bind(st, s.for_var, items[fi])
                let mut done = ct_stmts(st, s.for_body)
                done.st = ct_leave(done.st, mark)
                st = done.st
                if done.flow == CT_RETURN() { return done }
                if done.flow == CT_BREAK() { looping = false }
                fi = fi + 1
            }
        } else {
            ct_error(st, "this statement cannot be evaluated", s.line)
        }
        i = i + 1
    }
    return ct_out(st, last)
}

-- ============================================================
-- THE VALUE OF AN EXPRESSION
-- ============================================================

-- Evaluate the expression at compile time. The value is a number, a
-- bool or a string; anything else, and anything the evaluator cannot
-- do, is reported and ends the compilation.
fn eval_comptime_expr(gen: IRGenerator, e: Expr) -> IRValue {
    let st = CtState {
        files: gen.ir_mod.files,
        decls: gen.declarations,
        globals: gen.ir_mod.globals,
        names: [],
        values: [],
        base: 0,
        steps: 0,
        depth: 0
    }
    let out = ct_expr(st, e)
    let v = out.v
    if out.flow == CT_BREAK() or out.flow == CT_CONTINUE() {
        ct_error(st, "'break' or 'continue' outside a loop", e.line)
    }
    if v.kind == CT_INT() { return ir_val_int(v.int_val) }
    if v.kind == CT_FLOAT() { return ir_val_float(v.float_val) }
    if v.kind == CT_BOOL() { return ir_val_bool(v.bool_val) }
    if v.kind == CT_STRING() { return ir_val_string(v.str_val) }
    ct_error(st, "the value is " + ct_kind_text(v) + ", not a number, a bool or a string,", e.line)
    return ir_val_int(0)
}

-- The IR type of a value that was found at compile time
fn comptime_value_type(val: IRValue) -> string {
    if val.kind == VAL_CONST_INT() { return "i64" }
    if val.kind == VAL_CONST_FLOAT() { return "f64" }
    if val.kind == VAL_CONST_BOOL() { return "bool" }
    if val.kind == VAL_CONST_STRING() { return "string" }
    return "i64"
}


-- ============================================================
-- THE CHECKER
-- Finds the type of every expression of a program and reports
-- where names and types do not fit, before any code is
-- generated: check_program gives the errors of a source file,
-- and the type of each of its expressions.
--
-- A type is its name in source form: "int", "List[string]",
-- "Map[string, int]", "fn(int) -> bool". "" is a type the
-- checker does not know, and "?" stands for any type, alone or
-- as a part ("Option[?]" is what None is). A mismatch is
-- reported only when both sides are known, so what the checker
-- cannot type is left to the checks of code generation.
--
-- The checker is a value: a function takes it, changes its
-- copy and returns it, alone or in a Typed with the type found.
--
-- The type of each expression is recorded at the expression's
-- id (see EXPRESSION IDS in ast.dm), for code generation. Where
-- a value goes says what type it has when the value alone does
-- not: None is "Option[?]", and an Option[int] in
-- `let o: Option[int] = None` (ck_settle).
-- ============================================================

-- A function's or method's signature
struct FnSig {
    -- The types of the parameters, with `self` first for a method.
    -- Type parameters are still names here; a call substitutes them.
    params: List[string],
    -- "void" when the function returns nothing
    ret: string,
    -- The type parameters of the impl block, then the function's own
    generics: List[string],
    -- The traits each type parameter must implement, joined with "+"
    -- ("" for none): the bounds of fn f[T: Show + Named]
    bounds: List[string],
    has_self: bool,
    is_async: bool,
    -- Whether each parameter is `mut`: the function changes the
    -- variable it is given, which must then be `mut` itself
    changes: List[bool],
    -- An extern fn that takes more arguments than it has parameters
    variadic: bool,
    -- The effects the function declares it has
    effects: List[string]
}

struct StructSig {
    generics: List[string],
    field_names: List[string],
    field_types: List[string]
}

struct EnumSig {
    generics: List[string],
    variant_names: List[string],
    -- The types of each variant's values, joined with "|"
    variant_payloads: List[string]
}

struct Checker {
    -- The files of the program, at their numbers (see LINES IN FILES in token.dm)
    files: List[string],
    errors: List[string],
    -- Functions by name, and methods as "Type_method"; a trait's
    -- methods are "Trait_method"
    fns: Map[string, FnSig],
    structs: Map[string, StructSig],
    enums: Map[string, EnumSig],
    -- A trait's method names, as "|a|b|"
    traits: Map[string, string],
    -- The traits a type implements, as "|A|B|"
    type_traits: Map[string, string],
    -- Constants and their types
    consts: Map[string, string],
    -- The variables in scope, innermost last. A flag is 1 when the
    -- variable may be assigned to.
    var_names: List[string],
    var_types: List[string],
    var_flags: List[int],
    -- Inside a lambda, how many variables there were where it began:
    -- those are the variables of the function around it, of which the
    -- lambda has copies (see FUNCTION VALUES in ir_gen_expr.dm). 0
    -- outside a lambda.
    lambda_floor: int,
    -- While a lambda that does not say what it returns is checked: the
    -- type of the value its first `return` gives ("void" for a return
    -- without one), "" before there was one. "-" otherwise.
    lambda_ret: string,
    -- What the function or lambda being checked returns: "void" for
    -- nothing, "" when it is not known
    ret_type: string,
    -- The id of the call that an `await` is waiting for, while that
    -- call is checked; -3 once the call is found to be of an async
    -- function, and -2 outside an `await`
    awaited: int,
    -- The function being checked and the effects it declares. One
    -- that declares none is not held to any.
    fn_name: string,
    fn_effects: List[string],
    -- Names that stand for other types where the checker is: Self,
    -- and the type parameters in scope, which stand for "?"
    norm_names: List[string],
    norm_repls: List[string],
    -- The type of each expression, at the expression's id
    types: List[string],
    -- For a call of a generic function, at the call's id: what the
    -- function's type parameters stand for, joined with "|"
    type_args: List[string],
    -- For a method call that is a call of a function, at the call's
    -- id: "call:f" for x.f(a), which is f(x, a)
    targets: List[string],
    -- False in the body of a generic function or method, where the
    -- types depend on the type arguments and none is recorded
    record: bool
}

-- What check_program finds
struct Checked {
    errors: List[string],
    -- The type of each expression at its id; "" where it is not known
    types: List[string],
    -- The type arguments of each call of a generic function at the
    -- call's id, joined with "|"; "" where they are not all known
    type_args: List[string],
    -- What a method call calls, at the call's id, where it is not a
    -- method: "call:f" for x.f(a), which is f(x, a)
    targets: List[string],
    -- The checker as it was at the end, with the program's functions
    -- and types: code generation checks each instance of a generic
    -- function with it (check_instance)
    checker: Box[Checker]
}

-- A checker and the type of the expression it has just checked
struct Typed {
    c: Checker,
    t: string
}

struct TypedList {
    c: Checker,
    types: List[string]
}

fn ck_typed(c: Checker, t: string) -> Typed {
    return Typed { c: c, t: t }
}

fn ck_error(c: Checker, msg: string, line: int) -> Checker {
    let mut out = c
    out.errors.push(error_at(out.files, msg, line))
    return out
}

fn ck_index_of(names: List[string], name: string) -> int {
    let mut i = 0
    while i < names.len() {
        if names[i] == name { return i }
        i = i + 1
    }
    return -1
}

-- ============================================================
-- TYPE NAMES
-- ============================================================

fn ty_ident_byte(b: int) -> bool {
    if b >= 97 and b <= 122 { return true }
    if b >= 65 and b <= 90 { return true }
    if b >= 48 and b <= 57 { return true }
    -- 36 is the $ of Dyn$Trait
    return b == 95 or b == 36
}

-- One name for the types that have two
fn ty_alias(name: string) -> string {
    if name == "i64" { return "int" }
    if name == "f64" { return "float" }
    if name == "String" { return "string" }
    return name
}

-- The type with each of `names` in it replaced by the entry of
-- `repls` at the same place, and every other name by its alias
fn ty_rewrite(t: string, names: List[string], repls: List[string]) -> string {
    let n = len(t)
    let mut out = ""
    let mut i = 0
    while i < n {
        let start = i
        if ty_ident_byte(byte_at(t, i)) {
            while i < n and ty_ident_byte(byte_at(t, i)) {
                i = i + 1
            }
            let word = substr(t, start, i - start)
            let at = ck_index_of(names, word)
            if at >= 0 and at < repls.len() {
                out = out + repls[at]
            } else {
                out = out + ty_alias(word)
            }
        } else {
            while i < n and ty_ident_byte(byte_at(t, i)) == false {
                i = i + 1
            }
            out = out + substr(t, start, i - start)
        }
    }
    return out
}

fn ty_known(t: string) -> bool {
    return t != "" and t != "?"
}

-- Whether every part of the type is known: "Option[int]", and not
-- "Option[?]"
fn ty_whole(t: string) -> bool {
    return t != "" and string_contains(t, "?") == false
}

-- One type from two that describe the same value, taking from each
-- the parts the other does not know: "Result[int, string]" from
-- "Result[int, ?]" and "Result[?, string]". The first where they differ.
fn ty_merge(a: string, b: string) -> string {
    if ty_known(a) == false { return b }
    if ty_known(b) == false or a == b { return a }
    if ty_whole(a) { return a }
    let head = ty_head(a)
    if head == "" or head != ty_head(b) { return a }
    let a_args = ty_args(a)
    let b_args = ty_args(b)
    if a_args.len() == 0 or a_args.len() != b_args.len() { return a }
    let mut out = head + "["
    let mut i = 0
    while i < a_args.len() {
        if i > 0 { out = out + ", " }
        out = out + ty_merge(a_args[i], b_args[i])
        i = i + 1
    }
    return out + "]"
}

fn ty_is_int(t: string) -> bool {
    if t == "int" or t == "i8" or t == "i16" or t == "i32" { return true }
    return t == "u8" or t == "u16" or t == "u32" or t == "u64"
}

fn ty_is_float(t: string) -> bool {
    return t == "float" or t == "f32"
}

-- "string", "bool" or "number" for a type that is one, else ""
fn ty_kind(t: string) -> string {
    if t == "string" or t == "bool" { return t }
    if ty_is_int(t) or ty_is_float(t) { return "number" }
    return ""
}

-- The name of a type without its arguments: "Map" for
-- "Map[string, int]". "" for function and array types.
fn ty_head(t: string) -> string {
    if starts_with(t, "fn(") or starts_with(t, "[") { return "" }
    let at = string_find(t, "[")
    if at < 0 { return t }
    return substr(t, 0, at)
}

-- The arguments of a type: "string" and "int" for "Map[string, int]"
fn ty_args(t: string) -> List[string] {
    let none: List[string] = []
    if starts_with(t, "fn(") or starts_with(t, "[") { return none }
    let at = string_find(t, "[")
    if at < 0 or ends_with(t, "]") == false { return none }
    return split_type_args(substr(t, at + 1, len(t) - at - 2))
}

fn ty_arg(t: string, i: int) -> string {
    let found = ty_args(t)
    if i < found.len() { return found[i] }
    return ""
}

-- "T" for "Box[T]", and any other type as it is
fn ty_unbox(t: string) -> string {
    if ty_head(t) == "Box" { return ty_arg(t, 0) }
    return t
}

-- The element type of an array type: "int" for "[int; 4]"
fn ty_array_elem(t: string) -> string {
    let inner = substr(t, 1, len(t) - 2)
    let semi = string_find(inner, ";")
    if semi >= 0 { return string_trim(substr(inner, 0, semi)) }
    return string_trim(inner)
}

-- What a `for` over a value of the type gives each time round
fn ty_iterated(t: string) -> string {
    let head = ty_head(t)
    if head == "List" or head == "Map" { return ty_arg(t, 0) }
    if starts_with(t, "[") { return ty_array_elem(t) }
    return ""
}

-- Where the parameters of a function type end: the place of the
-- ")" in "fn(A, B) -> R", or -1
fn ty_fn_close(t: string) -> int {
    let n = len(t)
    let mut depth = 0
    let mut i = 2
    while i < n {
        let b = byte_at(t, i)
        if b == 40 { depth = depth + 1 }
        if b == 41 {
            depth = depth - 1
            if depth == 0 { return i }
        }
        i = i + 1
    }
    return -1
}

-- The parameter types of a function type: "A" and "B" for "fn(A, B) -> R"
fn ty_fn_params(t: string) -> List[string] {
    let close = ty_fn_close(t)
    if close < 3 {
        let none: List[string] = []
        return none
    }
    return split_type_args(substr(t, 3, close - 3))
}

-- What a function type returns: "R" for "fn(A, B) -> R", "void" for
-- "fn(A)", and "" for a type that is not a function's
fn ty_fn_ret(t: string) -> string {
    if starts_with(t, "fn(") == false { return "" }
    let n = len(t)
    let close = ty_fn_close(t)
    if close < 0 { return "" }
    let rest = substr(t, close + 1, n - close - 1)
    if starts_with(rest, " -> ") { return substr(rest, 4, len(rest) - 4) }
    return "void"
}

-- Whether two types are the same type, as far as both are known:
-- "List[?]" is the same as "List[int]", and "int" is not "i32"
fn ty_same(a: string, b: string) -> bool {
    if a == b { return true }
    if ty_known(a) == false or ty_known(b) == false { return true }
    if starts_with(a, "fn(") and starts_with(b, "fn(") { return ty_fn_agrees(a, b) }
    if starts_with(a, "fn(") or starts_with(b, "fn(") { return false }
    if starts_with(a, "[") or starts_with(b, "[") { return true }
    if ty_head(a) != ty_head(b) { return false }
    let a_args = ty_args(a)
    let b_args = ty_args(b)
    if a_args.len() != b_args.len() { return false }
    let mut i = 0
    while i < a_args.len() {
        if ty_same(a_args[i], b_args[i]) == false { return false }
        i = i + 1
    }
    return true
}

-- Whether two function types take the same parameters and return the
-- same type. A function is called with the types its own type names,
-- so a parameter of another width is another type here.
fn ty_fn_agrees(a: string, b: string) -> bool {
    let a_params = ty_fn_params(a)
    let b_params = ty_fn_params(b)
    if a_params.len() != b_params.len() { return false }
    let mut i = 0
    while i < a_params.len() {
        if ty_same(a_params[i], b_params[i]) == false { return false }
        i = i + 1
    }
    return ty_same(ty_fn_ret(a), ty_fn_ret(b))
}

-- Whether a value of type `got` can go where `want` is expected.
-- Unknown types fit anything. Integers of every width fit each other
-- (code generation checks the narrowing), and so do the float types.
-- Two function types must agree (ty_fn_agrees). Array types are not
-- compared.
fn ty_fits(want: string, got: string) -> bool {
    if want == got { return true }
    if ty_known(want) == false or ty_known(got) == false { return true }
    if ty_is_int(want) and ty_is_int(got) { return true }
    if ty_is_float(want) and ty_is_float(got) { return true }
    if starts_with(want, "fn(") and starts_with(got, "fn(") { return ty_fn_agrees(want, got) }
    if starts_with(want, "fn(") or starts_with(got, "fn(") { return false }
    if starts_with(want, "[") or starts_with(got, "[") { return true }
    if ty_head(want) != ty_head(got) { return false }
    let want_args = ty_args(want)
    let got_args = ty_args(got)
    if want_args.len() == 0 or got_args.len() == 0 { return true }
    if want_args.len() != got_args.len() { return false }
    let mut i = 0
    while i < want_args.len() {
        if ty_fits(want_args[i], got_args[i]) == false { return false }
        i = i + 1
    }
    return true
}

-- The types `generics` stand for, found by laying the parameter type
-- `pattern` over the argument type `actual`: T is int when List[T]
-- meets List[int]. `binds` holds what is known so far, "" for a type
-- parameter that is not.
fn ty_bind(pattern: string, actual: string, generics: List[string], binds: List[string]) -> List[string] {
    let mut out = binds
    if ty_known(actual) == false { return out }
    let at = ck_index_of(generics, pattern)
    if at >= 0 {
        if at < out.len() and out[at] == "" {
            out[at] = actual
        }
        return out
    }
    -- A function type binds through its parameters and its result:
    -- fn(T) -> U against fn(int) -> string
    if starts_with(pattern, "fn(") and starts_with(actual, "fn(") {
        let pattern_params = ty_fn_params(pattern)
        let actual_params = ty_fn_params(actual)
        if pattern_params.len() != actual_params.len() { return out }
        let mut pi = 0
        while pi < pattern_params.len() {
            out = ty_bind(pattern_params[pi], actual_params[pi], generics, out)
            pi = pi + 1
        }
        return ty_bind(ty_fn_ret(pattern), ty_fn_ret(actual), generics, out)
    }
    let head = ty_head(pattern)
    if head == "" or head == pattern or head != ty_head(actual) { return out }
    let pattern_args = ty_args(pattern)
    let actual_args = ty_args(actual)
    if pattern_args.len() != actual_args.len() { return out }
    let mut i = 0
    while i < pattern_args.len() {
        out = ty_bind(pattern_args[i], actual_args[i], generics, out)
        i = i + 1
    }
    return out
}

-- `count` type parameters that stand for nothing yet
fn ty_unbound(count: int) -> List[string] {
    let mut out: List[string] = []
    let mut i = 0
    while i < count {
        out.push("")
        i = i + 1
    }
    return out
}

-- The type with its type parameters replaced by what they stand
-- for, and by "?" where that is not known
fn ty_apply(t: string, generics: List[string], binds: List[string]) -> string {
    if generics.len() == 0 { return t }
    let mut repls: List[string] = []
    let mut i = 0
    while i < generics.len() {
        if i < binds.len() and binds[i] != "" {
            repls.push(binds[i])
        } else {
            repls.push("?")
        }
        i = i + 1
    }
    return ty_rewrite(t, generics, repls)
}

fn ty_op_text(op: int) -> string {
    if op == BINOP_ADD() { return "+" }
    if op == BINOP_SUB() { return "-" }
    if op == BINOP_MUL() { return "*" }
    if op == BINOP_DIV() { return "/" }
    if op == BINOP_MOD() { return "%" }
    if op == BINOP_EQ() { return "==" }
    if op == BINOP_NE() { return "!=" }
    if op == BINOP_LT() { return "<" }
    if op == BINOP_LE() { return "<=" }
    if op == BINOP_GT() { return ">" }
    if op == BINOP_GE() { return ">=" }
    if op == BINOP_AND() { return "and" }
    if op == BINOP_OR() { return "or" }
    if op == BINOP_BIT_AND() { return "&" }
    if op == BINOP_BIT_OR() { return "|" }
    if op == BINOP_BIT_XOR() { return "^" }
    if op == BINOP_SHL() { return "<<" }
    return ">>"
}

-- The method that overloads the operator for a struct, or ""
fn ty_op_method(op: int) -> string {
    if op == BINOP_ADD() { return "add" }
    if op == BINOP_SUB() { return "sub" }
    if op == BINOP_MUL() { return "mul" }
    if op == BINOP_DIV() { return "div" }
    if op == BINOP_EQ() { return "eq" }
    if op == BINOP_NE() { return "ne" }
    if op == BINOP_LT() { return "lt" }
    if op == BINOP_GT() { return "gt" }
    if op == BINOP_LE() { return "le" }
    if op == BINOP_GE() { return "ge" }
    return ""
}

fn ty_is_comparison(op: int) -> bool {
    return op == BINOP_EQ() or op == BINOP_NE() or op == BINOP_LT() or op == BINOP_LE() or op == BINOP_GT() or op == BINOP_GE()
}

-- ============================================================
-- SCOPES
-- ============================================================

fn ck_bind(c: Checker, name: string, t: string, flag: int) -> Checker {
    let mut out = c
    out.var_names.push(name)
    out.var_types.push(t)
    out.var_flags.push(flag)
    return out
}

-- Forget the variables declared since there were `mark` of them
fn ck_unbind(c: Checker, mark: int) -> Checker {
    let mut out = c
    while out.var_names.len() > mark {
        out.var_names.pop()
        out.var_types.pop()
        out.var_flags.pop()
    }
    return out
}

-- The place of the innermost variable of the name, or -1
fn ck_var(c: Checker, name: string) -> int {
    let mut i = c.var_names.len() - 1
    while i >= 0 {
        if c.var_names[i] == name { return i }
        i = i - 1
    }
    return -1
}

-- Whether a value of type `got` can go where `want` is expected:
-- ty_fits, and a value of a type that implements the trait can go
-- where a `dyn Trait` is expected (it is put in the dyn's variant
-- there, see ck_settle)
fn ck_fits(c: Checker, want: string, got: string) -> bool {
    if starts_with(want, DYN_PREFIX()) and ty_known(got) and got != want {
        -- A `dyn` of no trait, or of a trait that no type implements,
        -- is reported where it is written
        if c.enums.contains(want) == false { return true }
        if ty_head(got) != got { return false }
        return ck_implements(c, got, substr(want, len(DYN_PREFIX()), len(want) - len(DYN_PREFIX())))
    }
    return ty_fits(want, got)
}

-- Whether the value of the expression `e`, of type `got`, can go
-- where `want` is expected: ck_fits, and a value that is made there
-- can be made of the type of its place. Some(circle) is an
-- Option[Circle], which is no Option[dyn Shape]; but written where an
-- Option[dyn Shape] is expected it makes one, with the circle put in
-- the dyn (ck_settle goes the same way down the expression).
fn ck_fits_value(c: Checker, want: string, got: string, e0: Expr) -> bool {
    if ck_fits(c, want, got) { return true }
    if string_contains(want, DYN_PREFIX()) == false { return false }
    let mut e = e0
    while e.kind == EXPR_GROUPED() {
        e = *e.operand
    }
    let head = ty_head(want)
    if ty_head(got) != head { return false }
    let k = e.kind
    if k == EXPR_FUNCTION_CALL() and e.args.len() == 1 {
        let callee = *e.callee
        if callee.kind != EXPR_IDENTIFIER() { return false }
        if (callee.name == "Some" and head == "Option") or (callee.name == "Box_new" and head == "Box") {
            return ck_fits_value(c, ty_arg(want, 0), ty_arg(got, 0), e.args[0])
        }
        if callee.name == "Ok" and head == "Result" {
            return ck_fits(c, ty_arg(want, 1), ty_arg(got, 1)) and ck_fits_value(c, ty_arg(want, 0), ty_arg(got, 0), e.args[0])
        }
        if callee.name == "Err" and head == "Result" {
            return ck_fits(c, ty_arg(want, 0), ty_arg(got, 0)) and ck_fits_value(c, ty_arg(want, 1), ty_arg(got, 1), e.args[0])
        }
        return false
    }
    if k == EXPR_ARRAY_LITERAL() and head == "List" {
        let mut i = 0
        while i < e.elements.len() {
            if ck_fits_value(c, ty_arg(want, 0), ty_arg(got, 0), e.elements[i]) == false { return false }
            i = i + 1
        }
        return true
    }
    if k == EXPR_IF() and e.has_else {
        return ck_fits_value(c, want, got, *e.then_branch) and ck_fits_value(c, want, got, *e.else_branch)
    }
    if k == EXPR_BLOCK() {
        if e.has_result { return ck_fits_value(c, want, got, *e.result) }
        return ck_fits_last(c, want, got, e.stmts)
    }
    if k == EXPR_MATCH() {
        let mut i = 0
        while i < e.match_arms.len() {
            let arm = e.match_arms[i]
            if arm.is_expr_body {
                if ck_fits_value(c, want, got, *arm.body_expr) == false { return false }
            } else if ck_fits_last(c, want, got, arm.body) == false {
                return false
            }
            i = i + 1
        }
        return e.match_arms.len() > 0
    }
    return false
}

-- ck_fits_value for the value of a body: that of its last statement
fn ck_fits_last(c: Checker, want: string, got: string, stmts: List[Stmt]) -> bool {
    if stmts.len() == 0 { return false }
    let last = stmts[stmts.len() - 1]
    if stmt_gives_value(last) == false { return false }
    return ck_fits_value(c, want, got, stmt_value_expr(last))
}

-- A type as written in the source, in the checker's form
fn ck_norm(c: Checker, t: string) -> string {
    if t == "" { return "" }
    return ty_rewrite(t, c.norm_names, c.norm_repls)
}

fn ck_builtin_type_name(name: string) -> bool {
    if name == "int" or name == "float" or name == "bool" or name == "string" or name == "void" { return true }
    if name == "i8" or name == "i16" or name == "i32" or name == "i64" { return true }
    if name == "u8" or name == "u16" or name == "u32" or name == "u64" { return true }
    if name == "f32" or name == "f64" or name == "String" { return true }
    if name == "List" or name == "Map" or name == "Box" or name == "Option" or name == "Result" { return true }
    if name == "f32x4" or name == "f32x8" or name == "f64x2" or name == "f64x4" { return true }
    if name == "i32x4" or name == "i32x8" or name == "i64x2" or name == "i64x4" { return true }
    return name == "Self" or name == "fn" or name == "Future"
}

-- Report the first name in the type that is no type
fn ck_type_exists(c: Checker, t: string, line: int) -> Checker {
    let n = len(t)
    let mut i = 0
    let mut in_size = false
    while i < n {
        let b = byte_at(t, i)
        if b == 59 { in_size = true }
        if b == 93 { in_size = false }
        if ty_ident_byte(b) == false {
            i = i + 1
            continue
        }
        let start = i
        while i < n and ty_ident_byte(byte_at(t, i)) {
            i = i + 1
        }
        -- An array's size is a number or a constant
        if in_size or (b >= 48 and b <= 57) { continue }
        let word = substr(t, start, i - start)
        if ck_builtin_type_name(word) { continue }
        if c.structs.contains(word) or c.enums.contains(word) { continue }
        if ck_index_of(c.norm_names, word) >= 0 { continue }
        -- `dyn Trait` is the enum Dyn$Trait, which there is when a type
        -- implements the trait (see TRAITS in main_split.dm)
        if starts_with(word, DYN_PREFIX()) {
            let trait_name = substr(word, len(DYN_PREFIX()), len(word) - len(DYN_PREFIX()))
            if c.traits.contains(trait_name) {
                return ck_error(c, "no type implements the trait '" + trait_name + "', so there is no value a '" + word + "' could hold", line)
            }
            return ck_error(c, "undefined trait '" + trait_name + "'", line)
        }
        if c.traits.contains(word) {
            return ck_error(c, "'" + word + "' is a trait, not a type: a value of any type that implements it is a '" + DYN_PREFIX() + word + "'", line)
        }
        return ck_error(c, "undefined type '" + word + "'", line)
    }
    return ck_type_arity(c, t, t, line)
}

-- Report a generic struct or enum in the type `t`, a part of the type
-- `whole`, that has another number of type arguments than it takes
fn ck_type_arity(c0: Checker, t: string, whole: string, line: int) -> Checker {
    let mut c = c0
    let args = ty_args(t)
    if args.len() == 0 { return c }
    let head = ty_head(t)
    let mut takes = -1
    if c.structs.contains(head) {
        takes = c.structs.get(head).generics.len()
    } else if c.enums.contains(head) {
        takes = c.enums.get(head).generics.len()
    }
    if takes >= 0 and takes != args.len() {
        return ck_error(c, "'" + head + "' takes " + int_to_string(takes) + " type arguments, got " + int_to_string(args.len()) + " in '" + whole + "'", line)
    }
    let mut i = 0
    while i < args.len() {
        c = ck_type_arity(c, args[i], whole, line)
        i = i + 1
    }
    return c
}

-- ============================================================
-- DECLARATIONS
-- ============================================================

fn ck_sig(fd: FunctionDecl, self_type: string, outer_generics: List[string]) -> FnSig {
    let mut names: List[string] = []
    names.push("Self")
    let mut repls: List[string] = []
    repls.push(self_type)
    let mut generics: List[string] = []
    let mut bounds: List[string] = []
    let mut gi = 0
    while gi < outer_generics.len() {
        generics.push(outer_generics[gi])
        bounds.push("")
        gi = gi + 1
    }
    gi = 0
    while gi < fd.generic_params.len() {
        generics.push(fd.generic_params[gi])
        if gi < fd.generic_bounds.len() {
            bounds.push(fd.generic_bounds[gi])
        } else {
            bounds.push("")
        }
        gi = gi + 1
    }
    let mut params: List[string] = []
    let mut changes: List[bool] = []
    let mut i = 0
    while i < fd.params.len() {
        params.push(ty_rewrite(fd.params[i].type_name, names, repls))
        changes.push(fd.params[i].is_mut)
        i = i + 1
    }
    let mut has_self = false
    if fd.params.len() > 0 {
        has_self = fd.params[0].name == "self"
    }
    return FnSig {
        params: params,
        ret: ty_rewrite(fd.return_type, names, repls),
        generics: generics,
        bounds: bounds,
        has_self: has_self,
        is_async: fd.is_async,
        changes: changes,
        variadic: fd.is_variadic,
        effects: fd.effects
    }
}

fn ck_struct_sig(sd: StructDecl) -> StructSig {
    let none: List[string] = []
    let mut names: List[string] = []
    let mut types: List[string] = []
    let mut i = 0
    while i < sd.fields.len() {
        names.push(sd.fields[i].name)
        types.push(ty_rewrite(sd.fields[i].type_name, none, none))
        i = i + 1
    }
    return StructSig { generics: sd.generic_params, field_names: names, field_types: types }
}

fn ck_enum_sig(ed: EnumDecl) -> EnumSig {
    let none: List[string] = []
    let mut names: List[string] = []
    let mut payloads: List[string] = []
    let mut i = 0
    while i < ed.variants.len() {
        let v = ed.variants[i]
        names.push(v.name)
        let mut joined = ""
        let mut j = 0
        while j < v.payload_types.len() {
            if j > 0 { joined = joined + "|" }
            joined = joined + ty_rewrite(v.payload_types[j], none, none)
            j = j + 1
        }
        payloads.push(joined)
        i = i + 1
    }
    return EnumSig { generics: ed.generic_params, variant_names: names, variant_payloads: payloads }
}

-- "Name[A, B]" for a type with type parameters, else "Name"
fn ck_generic_type(name: string, generics: List[string]) -> string {
    if generics.len() == 0 { return name }
    let mut t = name + "["
    let mut i = 0
    while i < generics.len() {
        if i > 0 { t = t + ", " }
        t = t + generics[i]
        i = i + 1
    }
    return t + "]"
}

fn ck_collect_impl(c0: Checker, ib: ImplBlock) -> Checker {
    let mut c = c0
    let self_type = ck_generic_type(ib.target_type, ib.generic_params)
    let mut i = 0
    while i < ib.methods.len() {
        let fd = ib.methods[i]
        c.fns.insert(ib.target_type + "_" + fd.name, ck_sig(fd, self_type, ib.generic_params))
        i = i + 1
    }
    if ib.trait_name != "" {
        let mut known = "|"
        if c.type_traits.contains(ib.target_type) {
            known = c.type_traits.get(ib.target_type)
        }
        c.type_traits.insert(ib.target_type, known + ib.trait_name + "|")
    }
    return c
}

fn ck_collect_trait(c0: Checker, td: TraitDecl) -> Checker {
    let mut c = c0
    let mut names = "|"
    let mut i = 0
    while i < td.methods.len() {
        let fd = td.methods[i]
        names = names + fd.name + "|"
        c.fns.insert(td.name + "_" + fd.name, ck_sig(fd, "?", td.generic_params))
        i = i + 1
    }
    c.traits.insert(td.name, names)
    return c
}

-- Every declaration's signature, before any body is checked
fn ck_collect(c0: Checker, sf: SourceFile) -> Checker {
    let mut c = c0
    let no_generics: List[string] = []
    let mut i = 0
    while i < sf.declarations.len() {
        let decl = sf.declarations[i]
        if decl.kind == DECL_STRUCT() {
            let sd = *decl.struct_decl
            c.structs.insert(sd.name, ck_struct_sig(sd))
        } else if decl.kind == DECL_ENUM() {
            let ed = *decl.enum_decl
            c.enums.insert(ed.name, ck_enum_sig(ed))
        } else if decl.kind == DECL_TRAIT() {
            c = ck_collect_trait(c, *decl.trait_decl)
        } else if decl.kind == DECL_IMPL() {
            c = ck_collect_impl(c, *decl.impl_block)
        } else if decl.kind == DECL_FUNCTION() {
            let fd = *decl.func_decl
            c.fns.insert(fd.name, ck_sig(fd, "", no_generics))
        } else if decl.kind == DECL_CONST() {
            let cd = *decl.const_decl
            let none: List[string] = []
            c.consts.insert(cd.name, ty_rewrite(cd.type_name, none, none))
        }
        i = i + 1
    }
    return c
}

-- ============================================================
-- EXPRESSIONS
-- ============================================================

-- Record the type found for the expression with the id
fn ck_note(c: Checker, id: int, t: string) -> Checker {
    if c.record == false or id < 0 or id >= c.types.len() { return c }
    let mut out = c
    out.types[id] = t
    return out
}

-- Whether the expression makes a new value whose type its place
-- decides: None, Some(x), Ok(x), Err(x), a new Box or Map, a list literal
fn ck_makes_value(e: Expr) -> bool {
    if e.kind == EXPR_ARRAY_LITERAL() { return true }
    if e.kind == EXPR_IDENTIFIER() { return e.name == "None" }
    if e.kind == EXPR_FUNCTION_CALL() {
        let callee = *e.callee
        if callee.kind != EXPR_IDENTIFIER() { return false }
        let name = callee.name
        return name == "Some" or name == "Ok" or name == "Err" or name == "Box_new" or name == "Box_null" or name == "Map_new"
    }
    return false
}

-- A value of the expression goes where a `want` is expected. Where
-- the checker found a type with unknown parts for it, such as
-- "Option[?]" for None, the place says what they are: record `want`
-- for the expression, and for the expressions its value comes from.
fn ck_settle(c0: Checker, e: Expr, want: string) -> Checker {
    if c0.record == false or ty_whole(want) == false or want == "void" { return c0 }
    if e.id < 0 or e.id >= c0.types.len() { return c0 }
    let mut c = c0
    let variant_of = ck_generic_variant(c, e)
    if variant_of != "" and ty_head(want) == variant_of {
        return ck_settle_variant(c, e, variant_of, want)
    }
    let have = c.types[e.id]
    -- A value of a type that implements the trait, where a `dyn Trait`
    -- is expected: code generation puts it in the dyn's variant there
    if starts_with(want, DYN_PREFIX()) {
        if ty_known(have) and have != want and starts_with(have, DYN_PREFIX()) == false and ck_fits(c, want, have) {
            if string_contains(c.targets[e.id], "dyn:") == false {
                let mut marks = c.targets[e.id]
                if marks != "" { marks = marks + ";" }
                c.targets[e.id] = marks + "dyn:" + want + "|" + have
            }
        }
        return c
    }
    -- A type the checker does not know at all stays unknown, and so
    -- does a whole type that differs, such as an i32 that goes where an
    -- int is expected: the value is converted there. What makes a new
    -- value (ck_makes_value) makes it of the type of its place.
    if ty_known(have) and have != want and ty_fits(want, have) and (ty_whole(have) == false or ck_makes_value(e)) {
        c = ck_note(c, e.id, want)
    } else if ty_known(have) and have != want and ty_fits(want, have) == false and ck_fits_value(c, want, have, e) {
        -- A value made here with a `dyn Trait` in it (ck_fits_value)
        c = ck_note(c, e.id, want)
    } else if have != want and ty_is_int(have) and ty_is_int(want) and branches_give_int_literals(e) {
        -- An `if` or a `match` of integer constants is an integer of
        -- the type of its place, as a literal is: 0 or 1 for an i32
        c = ck_note(c, e.id, want)
    }
    let k = e.kind
    if k == EXPR_GROUPED() { return ck_settle(c, *e.operand, want) }
    if k == EXPR_IF() {
        c = ck_settle(c, *e.then_branch, want)
        if e.has_else { c = ck_settle(c, *e.else_branch, want) }
        return c
    }
    if k == EXPR_BLOCK() {
        if e.has_result { return ck_settle(c, *e.result, want) }
        return ck_settle_last(c, e.stmts, want)
    }
    if k == EXPR_MATCH() {
        let mut i = 0
        while i < e.match_arms.len() {
            let arm = e.match_arms[i]
            if arm.is_expr_body {
                c = ck_settle(c, *arm.body_expr, want)
            } else {
                c = ck_settle_last(c, arm.body, want)
            }
            i = i + 1
        }
        return c
    }
    if k == EXPR_ARRAY_LITERAL() {
        if ty_head(want) == "List" {
            let elem = ty_arg(want, 0)
            let mut i = 0
            while i < e.elements.len() {
                c = ck_settle(c, e.elements[i], elem)
                i = i + 1
            }
        }
        return c
    }
    -- The value inside a Some, an Ok, an Err or a Box
    if k == EXPR_FUNCTION_CALL() and e.args.len() == 1 {
        let callee = *e.callee
        if callee.kind == EXPR_IDENTIFIER() {
            let head = ty_head(want)
            if (callee.name == "Some" and head == "Option") or (callee.name == "Ok" and head == "Result") or (callee.name == "Box_new" and head == "Box") {
                return ck_settle(c, e.args[0], ty_arg(want, 0))
            }
            if callee.name == "Err" and head == "Result" {
                return ck_settle(c, e.args[0], ty_arg(want, 1))
            }
        }
    }
    return c
}

-- ck_settle for the expression that gives a block its value
fn ck_settle_last(c: Checker, stmts: List[Stmt], want: string) -> Checker {
    if stmts.len() == 0 { return c }
    let last = stmts[stmts.len() - 1]
    if stmt_gives_value(last) == false { return c }
    return ck_settle(c, stmt_value_expr(last), want)
}

-- The type of the expression, which is recorded at its id
fn ck_expr(c: Checker, e: Expr) -> Typed {
    let found = ck_expr_of_kind(c, e)
    return ck_typed(ck_note(found.c, e.id, found.t), found.t)
}

fn ck_expr_of_kind(c: Checker, e: Expr) -> Typed {
    let k = e.kind
    if k == EXPR_LITERAL_INT() { return ck_typed(c, "int") }
    if k == EXPR_LITERAL_FLOAT() { return ck_typed(c, "float") }
    if k == EXPR_LITERAL_STRING() { return ck_typed(c, "string") }
    if k == EXPR_LITERAL_BOOL() { return ck_typed(c, "bool") }
    if k == EXPR_IDENTIFIER() { return ck_identifier(c, e) }
    if k == EXPR_BINARY() { return ck_binary(c, e) }
    if k == EXPR_UNARY() { return ck_unary(c, e) }
    if k == EXPR_FIELD_ACCESS() { return ck_field(c, e) }
    if k == EXPR_INDEX_ACCESS() { return ck_index(c, e) }
    if k == EXPR_METHOD_CALL() { return ck_method_call(c, e) }
    if k == EXPR_FUNCTION_CALL() { return ck_call(c, e) }
    if k == EXPR_STRUCT_LITERAL() { return ck_struct_literal(c, e) }
    if k == EXPR_ENUM_LITERAL() { return ck_enum_literal(c, e) }
    if k == EXPR_ARRAY_LITERAL() { return ck_array_literal(c, e) }
    if k == EXPR_IF() { return ck_if_expr(c, e) }
    if k == EXPR_MATCH() { return ck_match(c, e, true) }
    if k == EXPR_BLOCK() { return ck_block(c, e) }
    if k == EXPR_LAMBDA() { return ck_lambda(c, e) }
    if k == EXPR_ERROR_PROPAGATE() { return ck_propagate(c, e) }
    if k == EXPR_GROUPED() or k == EXPR_COMPTIME() { return ck_expr(c, *e.operand) }
    if k == EXPR_CAST() { return ck_cast(c, e) }
    if k == EXPR_STRING_INTERP() {
        let parts = ck_exprs(c, e.interp_parts)
        let mut pc = parts.c
        let mut pi = 0
        while pi < parts.types.len() {
            let pt = parts.types[pi]
            if pt == "void" or (ty_known(pt) and ty_kind(pt) == "") {
                pc = ck_error(pc, "a value in an f-string must be a string, a number or a bool, not " + pt, e.interp_parts[pi].line)
            }
            pi = pi + 1
        }
        return ck_typed(pc, "string")
    }
    if k == EXPR_RANGE() {
        let low = ck_expr(c, *e.left)
        let high = ck_expr(low.c, *e.right)
        return ck_typed(high.c, "")
    }
    if k == EXPR_AWAIT() { return ck_await(c, e) }
    return ck_typed(c, "")
}

-- await f(args): the value of a call of an async function. The call
-- runs the function to its end: an async function is called under
-- `await` and nowhere else, so there is no call still running to wait
-- for, and no value that stands for one.
fn ck_await(c0: Checker, e: Expr) -> Typed {
    let mut c = c0
    let mut call = *e.operand
    while call.kind == EXPR_GROUPED() {
        call = *call.operand
    }
    let outer = c.awaited
    c.awaited = call.id
    let found = ck_expr(c, *e.operand)
    c = found.c
    let was_async = c.awaited == -3
    c.awaited = outer
    if was_async == false {
        c = ck_error(c, "'await' takes a call of an async function", e.line)
    }
    return ck_typed(c, found.t)
}

-- A call of the function with the signature, by the expression with
-- the id: an async function is called under `await`
fn ck_async_call(c: Checker, sig: FnSig, shown: string, id: int, line: int) -> Checker {
    if sig.is_async == false { return c }
    let mut out = c
    if id >= 0 and id == c.awaited {
        out.awaited = -3
        return out
    }
    return ck_error(out, "the call of the async function '" + shown + "' needs 'await'", line)
}

-- The types of the expressions, in order
fn ck_exprs(c0: Checker, exprs: List[Expr]) -> TypedList {
    let mut c = c0
    let mut types: List[string] = []
    let mut i = 0
    while i < exprs.len() {
        let r = ck_expr(c, exprs[i])
        c = ck_needs_value(r.c, exprs[i], false)
        types.push(r.t)
        i = i + 1
    }
    return TypedList { c: c, types: types }
}

-- Whether the name is a type's and no variable's
fn ck_names_type(c: Checker, name: string) -> bool {
    if ck_var(c, name) >= 0 or c.consts.contains(name) { return false }
    return c.structs.contains(name) or c.enums.contains(name) or c.traits.contains(name)
}

fn ck_identifier(c: Checker, e: Expr) -> Typed {
    let name = e.name
    if name == "true" or name == "false" { return ck_typed(c, "bool") }
    if name == "None" { return ck_typed(c, "Option[?]") }
    let at = ck_var(c, name)
    if at >= 0 { return ck_typed(c, c.var_types[at]) }
    if c.consts.contains(name) { return ck_typed(c, c.consts.get(name)) }
    -- A function's name is a value: its address. Naming a function
    -- that has effects is using them.
    if c.fns.contains(name) {
        let sig = c.fns.get(name)
        let named = ck_effects(c, name, sig.effects, " not in caller's effects", "uses", e.line)
        if is_builtin_fn(name) or sig.variadic { return ck_typed(named, "") }
        -- The value is called with what its type says, which has
        -- neither type parameters nor `mut` parameters
        if sig.generics.len() > 0 {
            return ck_typed(ck_error(named, "the generic function '" + name + "' cannot be used as a value: call it in a lambda", e.line), "")
        }
        let mut pi = 0
        while pi < sig.changes.len() {
            if sig.changes[pi] {
                return ck_typed(ck_error(named, "the function '" + name + "' has a 'mut' parameter, so it cannot be used as a value: call it in a lambda", e.line), "")
            }
            pi = pi + 1
        }
        return ck_typed(named, ty_fn_text(sig))
    }
    if is_builtin_fn(name) { return ck_typed(c, "") }
    if ck_names_type(c, name) { return ck_typed(c, "") }
    return ck_typed(ck_error(c, "undefined variable '" + name + "'", e.line), "")
}

fn ck_cast(c0: Checker, e: Expr) -> Typed {
    let operand = ck_expr(c0, *e.operand)
    let c = ck_type_exists(operand.c, e.cast_type, e.line)
    -- `as &T`: the checker has no reference types. IR generation
    -- decides whether the cast is one that is allowed.
    if e.cast_is_ref { return ck_typed(c, "") }
    let to = ck_norm(c, e.cast_type)
    if starts_with(to, DYN_PREFIX()) and ty_known(operand.t) {
        -- `x as dyn Trait` puts x in the dyn's variant
        if ck_fits(c, to, operand.t) == false {
            return ck_typed(ck_error(c, "cannot cast " + operand.t + " to " + to + ": it does not implement the trait", e.line), to)
        }
        return ck_typed(ck_settle(c, *e.operand, to), to)
    }
    return ck_typed(c, to)
}

-- The result of `left op right` for operands of the types, with an
-- error where the operator does not take them
fn ck_operator(c0: Checker, op: int, left: string, right: string, line: int) -> Typed {
    let mut c = c0
    let text = ty_op_text(op)
    if op == BINOP_AND() or op == BINOP_OR() {
        if ty_known(left) and left != "bool" {
            c = ck_error(c, "the left side of '" + text + "' is " + left + ", not bool", line)
        }
        if ty_known(right) and right != "bool" {
            c = ck_error(c, "the right side of '" + text + "' is " + right + ", not bool", line)
        }
        return ck_typed(c, "bool")
    }
    -- A struct or enum may have a method for the operator
    let method = ty_op_method(op)
    let left_head = ty_head(left)
    if method != "" and left_head != "" and c.fns.contains(left_head + "_" + method) {
        let sig = c.fns.get(left_head + "_" + method)
        return ck_typed(c, ty_apply(sig.ret, sig.generics, ty_unbound(0)))
    }
    let lk = ty_kind(left)
    let rk = ty_kind(right)
    if ty_is_comparison(op) {
        if lk != "" and rk != "" and lk != rk {
            c = ck_error(c, "cannot compare " + left + " with " + right + " ('" + text + "')", line)
        } else if (lk == "" or rk == "") and ty_known(left) and ty_known(right) {
            -- Values that are not numbers, strings or bools: two of
            -- one type are equal or not (EQUALITY in ir_gen_expr.dm
            -- says how), and have no order unless the type has the
            -- operator's method
            if ty_fits(left, right) == false and ty_fits(right, left) == false {
                c = ck_error(c, "cannot compare " + left + " with " + right + " ('" + text + "')", line)
            } else if op != BINOP_EQ() and op != BINOP_NE() and ty_whole(left) and ty_whole(right) {
                c = ck_error(c, "operator '" + text + "' does not take " + left + " and " + right, line)
            }
        }
        return ck_typed(c, "bool")
    }
    let bits = op == BINOP_BIT_AND() or op == BINOP_BIT_OR() or op == BINOP_BIT_XOR()
    if bits or op == BINOP_SHL() or op == BINOP_SHR() {
        -- Integers, and for & | ^ two bools
        if bits and left == "bool" and right == "bool" { return ck_typed(c, "bool") }
        if bits and ((left == "bool" and ty_is_int(right)) or (ty_is_int(left) and right == "bool")) {
            c = ck_error(c, "operator '" + text + "' does not take " + left + " and " + right, line)
            return ck_typed(c, "")
        }
        let mut wrong = ""
        if ty_known(right) and ty_is_int(right) == false { wrong = right }
        if ty_known(left) and ty_is_int(left) == false { wrong = left }
        if wrong != "" {
            let mut takes = "integers"
            if bits { takes = "integers or bools" }
            c = ck_error(c, "operator '" + text + "' takes " + takes + ", not " + wrong, line)
            return ck_typed(c, "")
        }
    }
    if lk != "" and rk != "" {
        if lk == "bool" and rk == "bool" and bits { return ck_typed(c, "bool") }
        if lk != rk or lk == "bool" or (lk == "string" and op != BINOP_ADD()) {
            c = ck_error(c, "operator '" + text + "' does not take " + left + " and " + right, line)
            return ck_typed(c, "")
        }
        if lk == "string" { return ck_typed(c, "string") }
        if ty_is_float(left) { return ck_typed(c, left) }
        if ty_is_float(right) { return ck_typed(c, right) }
        -- A literal takes the other operand's width
        if left == "int" { return ck_typed(c, right) }
        return ck_typed(c, left)
    }
    if lk == "string" and op == BINOP_ADD() { return ck_typed(c, "string") }
    -- Two values that are not numbers or strings, of a type without
    -- the operator's method
    if lk == "" and rk == "" and ty_whole(left) and ty_whole(right) and (method != "" or op == BINOP_MOD()) {
        if starts_with(left, "fn(") == false and ck_names_simd(left) == false {
            c = ck_error(c, "operator '" + text + "' does not take " + left + " and " + right, line)
            return ck_typed(c, "")
        }
    }
    if ty_known(left) and left == right { return ck_typed(c, left) }
    return ck_typed(c, "")
}

fn ck_names_simd(t: string) -> bool {
    return t == "f32x4" or t == "f32x8" or t == "f64x2" or t == "f64x4" or t == "i32x4" or t == "i32x8" or t == "i64x2" or t == "i64x4"
}

-- a op b op c ... nests one level per operator on the left, so the
-- chain is walked in a loop: a long one would overflow the stack
fn ck_binary(c0: Checker, e: Expr) -> Typed {
    let mut c = c0
    let mut ops: List[int] = []
    let mut lines: List[int] = []
    let mut ids: List[int] = []
    let mut rights: List[Expr] = []
    let mut cur = e
    while cur.kind == EXPR_BINARY() {
        ops.push(cur.op)
        lines.push(cur.line)
        ids.push(cur.id)
        rights.push(*cur.right)
        cur = *cur.left
    }
    let first = ck_expr(c, cur)
    c = first.c
    let mut t = first.t
    let mut t_literal = is_int_literal_expr(cur)
    let mut i = ops.len() - 1
    while i >= 0 {
        let mut right = ck_expr(c, rights[i])
        if (ops[i] == BINOP_EQ() or ops[i] == BINOP_NE()) and (ty_kind(t) == "" or ty_kind(right.t) == "") {
            -- What says its type only in part takes the rest from the
            -- other side: None in `o == None`, [] in `xs != []`
            right.c = ck_settle(right.c, rights[i], t)
            if i == ops.len() - 1 { right.c = ck_settle(right.c, cur, right.t) }
        }
        let result = ck_operator(right.c, ops[i], t, right.t, lines[i])
        let mut result_t = result.t
        -- Two integers give the type code generation computes with
        let right_literal = is_int_literal_expr(rights[i])
        if ty_is_int(result_t) and ty_is_int(t) and ty_is_int(right.t) {
            result_t = int_meet_type(t, t_literal, right.t, right_literal)
        }
        c = ck_note(result.c, ids[i], result_t)
        t = result_t
        -- is_int_literal_expr of the operator's expression
        t_literal = t_literal and right_literal and (ops[i] == BINOP_ADD() or ops[i] == BINOP_SUB() or ops[i] == BINOP_MUL())
        i = i - 1
    }
    return ck_typed(c, t)
}

fn ck_unary(c0: Checker, e: Expr) -> Typed {
    let operand = ck_expr(c0, *e.operand)
    if e.op == UNOP_NOT() {
        if ty_known(operand.t) and operand.t != "bool" {
            return ck_typed(ck_error(operand.c, "'not' takes a bool, not " + operand.t, e.line), "bool")
        }
        return ck_typed(operand.c, "bool")
    }
    if e.op == UNOP_NEG() {
        let kind = ty_kind(operand.t)
        if kind == "string" or kind == "bool" {
            return ck_typed(ck_error(operand.c, "'-' takes a number, not " + operand.t, e.line), "")
        }
        return operand
    }
    if e.op == UNOP_DEREF() {
        if ty_head(operand.t) == "Box" { return ck_typed(operand.c, ty_arg(operand.t, 0)) }
        if ty_known(operand.t) {
            return ck_typed(ck_error(operand.c, "'*' takes a Box, not " + operand.t, e.line), "")
        }
        return ck_typed(operand.c, "")
    }
    if e.op == UNOP_BIT_NOT() {
        if ty_known(operand.t) and ty_is_int(operand.t) == false {
            return ck_typed(ck_error(operand.c, "'~' takes an integer, not " + operand.t, e.line), "")
        }
        return operand
    }
    return operand
}

-- The type of field `field` of a struct of type `t`, or "?" when the
-- struct has no such field
fn ck_field_type(c: Checker, t: string, field: string) -> string {
    let sig = c.structs.get(ty_head(t))
    let at = ck_index_of(sig.field_names, field)
    if at < 0 { return "?" }
    return ty_apply(sig.field_types[at], sig.generics, ty_args(t))
}

fn ck_field(c0: Checker, e: Expr) -> Typed {
    -- Enum.variant, for a variant without values
    let named = *e.object
    if named.kind == EXPR_IDENTIFIER() {
        if c0.enums.contains(named.name) and ck_names_type(c0, named.name) {
            let variants = c0.enums.get(named.name)
            if ck_index_of(variants.variant_names, e.field) < 0 {
                return ck_typed(ck_error(c0, "enum '" + named.name + "' has no variant '" + e.field + "'", e.line), named.name)
            }
            return ck_typed(c0, named.name)
        }
    }
    let object = ck_expr(c0, named)
    let c = object.c
    let t = ty_unbox(object.t)
    let head = ty_head(t)
    let field = e.field
    if head == "Option" {
        if field == "has_value" { return ck_typed(c, "bool") }
        if field == "value" { return ck_typed(c, ty_arg(t, 0)) }
        return ck_typed(c, "")
    }
    if head == "Result" {
        if field == "is_ok" { return ck_typed(c, "bool") }
        if field == "ok" or field == "value" { return ck_typed(c, ty_arg(t, 0)) }
        if field == "err" or field == "error" { return ck_typed(c, ty_arg(t, 1)) }
        return ck_typed(c, "")
    }
    if head != "" and c.structs.contains(head) {
        let sig = c.structs.get(head)
        if ck_index_of(sig.field_names, field) < 0 {
            return ck_typed(ck_error(c, "struct '" + head + "' has no field '" + field + "'", e.line), "")
        }
        return ck_typed(c, ck_field_type(c, t, field))
    }
    return ck_typed(c, "")
}

fn ck_index(c0: Checker, e: Expr) -> Typed {
    let object = ck_expr(c0, *e.object)
    let index = ck_expr(object.c, *e.index)
    let mut c = index.c
    let t = ty_unbox(object.t)
    let head = ty_head(t)
    if head == "Map" { return ck_typed(c, ty_arg(t, 1)) }
    if head == "List" or t == "string" or starts_with(t, "[") {
        if ty_known(index.t) and ty_is_int(index.t) == false {
            c = ck_error(c, "an index is an integer, not " + index.t, e.line)
        }
        if t == "string" { return ck_typed(c, "string") }
        return ck_typed(c, ty_iterated(t))
    }
    return ck_typed(c, "")
}

-- Report a call of a method that passes another number of arguments
-- than the method takes after its parameter `first`. (The number of
-- arguments of a call by name is checked when its code is generated,
-- where the variadic externs are known.)
fn ck_arity(c: Checker, sig: FnSig, shown: string, first: int, count: int, line: int) -> Checker {
    if first + count == sig.params.len() { return c }
    if sig.variadic and first + count > sig.params.len() { return c }
    let mut expected = int_to_string(sig.params.len() - first)
    if sig.variadic { expected = "at least " + expected }
    return ck_error(c, "call to '" + shown + "' passes " + int_to_string(count) + " arguments, expected " + expected, line)
}

-- The type of the function as a value: "fn(int, string) -> bool".
-- A type parameter is "?".
fn ty_fn_text(sig: FnSig) -> string {
    let none: List[string] = []
    let mut text = "fn("
    let mut i = 0
    while i < sig.params.len() {
        if i > 0 { text = text + ", " }
        text = text + ty_apply(sig.params[i], sig.generics, none)
        i = i + 1
    }
    return text + ") -> " + ty_apply(sig.ret, sig.generics, none)
}

-- An error for each of the effects that the function being checked
-- does not declare. `shown` is what needs them, `how` what the
-- function does with it ("calls" or "uses"), and `tail` ends the
-- message. A function that declares no effects is not held to any.
fn ck_effects(c0: Checker, shown: string, effects: List[string], tail: string, how: string, line: int) -> Checker {
    let mut c = c0
    if c.fn_effects.len() == 0 { return c }
    let mut i = 0
    while i < effects.len() {
        if ck_index_of(c.fn_effects, effects[i]) < 0 {
            c = ck_error(c, "function '" + c.fn_name + "' " + how + " '" + shown + "' which requires effect '" + effects[i] + "'" + tail, line)
        }
        i = i + 1
    }
    return c
}

-- The type of a place, read from the types of its parts without
-- checking it: a variable's, a field's, an element's. "" for any other
-- expression.
fn ck_place_type(c: Checker, e: Expr) -> string {
    if e.kind == EXPR_IDENTIFIER() {
        let at = ck_var(c, e.name)
        if at >= 0 { return c.var_types[at] }
        return ""
    }
    if e.kind == EXPR_GROUPED() { return ck_place_type(c, *e.operand) }
    if e.kind == EXPR_FIELD_ACCESS() {
        return ck_field_type(c, ty_unbox(ck_place_type(c, *e.object)), e.field)
    }
    if e.kind == EXPR_INDEX_ACCESS() {
        let held = ty_unbox(ck_place_type(c, *e.object))
        if ty_head(held) == "Map" { return ty_arg(held, 1) }
        return ty_iterated(held)
    }
    return ""
}

-- The variable that must be `mut` for the place to be changed, when it
-- is not: p for p.x and for p.xs[i].y. "" when the place may be
-- changed: its variable is `mut`, it is no part of a variable (the
-- result of a call, say), or it is reached through a Box. A Box is a
-- pointer to a value of its own, which every copy of the Box shares:
-- `mut` on a variable that holds one is about the variable.
fn ck_fixed_root(c: Checker, e: Expr) -> string {
    let mut cur = e
    let mut walking = true
    while walking {
        if ty_head(ck_place_type(c, cur)) == "Box" { return "" }
        if cur.kind == EXPR_FIELD_ACCESS() or cur.kind == EXPR_INDEX_ACCESS() {
            cur = *cur.object
        } else if cur.kind == EXPR_GROUPED() {
            cur = *cur.operand
        } else if cur.kind == EXPR_UNARY() and cur.op == UNOP_DEREF() {
            return ""
        } else {
            walking = false
        }
    }
    if cur.kind != EXPR_IDENTIFIER() { return "" }
    let at = ck_var(c, cur.name)
    if at < 0 { return "" }
    if c.var_flags[at] != 0 and at >= c.lambda_floor { return "" }
    return cur.name
}

-- Why the variable cannot be changed: it is not `mut`, or it is a
-- variable of the function around the lambda being checked
fn ck_fixed_why(c: Checker, name: string) -> string {
    let at = ck_var(c, name)
    if at >= 0 and at < c.lambda_floor {
        return "'" + name + "', a variable of the function around this lambda: the lambda has its own copy of it"
    }
    return "'" + name + "', which is not declared 'mut'"
}

-- A value that a call changes must be one that may be changed. `what`
-- says what changes it.
fn ck_changes(c: Checker, e: Expr, what: string, line: int) -> Checker {
    let root = ck_fixed_root(c, e)
    if root == "" { return c }
    if e.kind == EXPR_IDENTIFIER() {
        return ck_error(c, what + " changes " + ck_fixed_why(c, root), line)
    }
    return ck_error(c, what + " changes a part of " + ck_fixed_why(c, root), line)
}

-- The arguments that go to `mut` parameters of the function are
-- changed by the call, from its parameter `first` on
fn ck_mut_args(c0: Checker, sig: FnSig, shown: string, first: int, args: List[Expr]) -> Checker {
    let mut c = c0
    let mut i = 0
    while i < args.len() and first + i < sig.changes.len() {
        if sig.changes[first + i] {
            c = ck_changes(c, args[i], "the call of '" + shown + "'", args[i].line)
        }
        i = i + 1
    }
    return c
}

-- ---- Builtin functions ----

-- The parameter types of a builtin function, joined with "|"; "" for
-- one that takes nothing. "*" is a parameter of any type, and
-- "printable" one that print() takes: a string, a number or a bool.
-- "skip" for a builtin whose arguments code generation checks.
fn ck_builtin_params(name: string) -> string {
    if name == "print" or name == "println" or name == "eprint" or name == "eprintln" { return "printable" }
    if name == "panic" or name == "parse_int" or name == "parse_float" or name == "string_to_int" { return "string" }
    if name == "string_trim" or name == "string_to_upper" or name == "string_to_lower" { return "string" }
    if name == "is_alpha" or name == "is_digit" or name == "is_whitespace" or name == "is_alnum" or name == "char_to_string" { return "string" }
    if name == "file_read" or name == "file_exists" or name == "system" { return "string" }
    if name == "path_dirname" or name == "path_basename" or name == "path_extension" or name == "path_stem" { return "string" }
    if name == "fs_readdir" or name == "fs_mkdir" or name == "fs_remove" or name == "os_getenv" or name == "env_get" { return "string" }
    if name == "tcp_listen" or name == "tcp_connect" { return "string" }
    if name == "exit" or name == "int_to_string" or name == "args_get" or name == "mem_sweep" or name == "chr" or name == "sleep_ms" { return "int" }
    if name == "tcp_accept" or name == "tcp_close" or name == "thread_join" { return "int" }
    if name == "mutex_lock" or name == "mutex_unlock" or name == "mutex_destroy" { return "int" }
    if name == "float_to_string" { return "float" }
    if name == "bool_to_string" or name == "assert" { return "bool" }
    if name == "char_at" or name == "byte_at" { return "string|int" }
    if name == "substr" { return "string|int|int" }
    if name == "string_contains" or name == "string_find" or name == "starts_with" or name == "ends_with" or name == "string_split" { return "string|string" }
    if name == "file_write" or name == "file_append" or name == "path_join" or name == "fs_rename" { return "string|string" }
    if name == "string_replace" { return "string|string|string" }
    if name == "tcp_read" { return "int|int" }
    if name == "tcp_write" { return "int|string" }
    if name == "read_line" or name == "args_len" or name == "mem_mark" or name == "flush" or name == "fs_getcwd" { return "" }
    if name == "read_key" or name == "read_key_nb" or name == "term_width" or name == "term_height" or name == "time_ms" or name == "mutex_new" { return "" }
    if name == "Box_null" or name == "Map_new" { return "" }
    if name == "Box_new" or name == "hash_key" or name == "len" { return "*" }
    if name == "assert_eq" { return "*|*" }
    return "skip"
}

-- Check the arguments of a call of a builtin function, and the
-- effect it needs
fn ck_builtin_call(c0: Checker, name: string, arg_types: List[string], args: List[Expr], line: int) -> Checker {
    let mut c = c0
    let effect = builtin_required_effect(name)
    if effect != "" {
        let mut needs: List[string] = []
        needs.push(effect)
        c = ck_effects(c, name, needs, "", "calls", line)
    }
    let joined = ck_builtin_params(name)
    if joined == "skip" { return c }
    let mut params: List[string] = []
    if joined != "" { params = string_split(joined, "|") }
    if params.len() != arg_types.len() {
        return ck_error(c, name + "() takes " + arguments_text(params.len()) + ", not " + int_to_string(arg_types.len()), line)
    }
    let mut i = 0
    while i < params.len() {
        let got = arg_types[i]
        if got == "void" {
            c = ck_error(c, "argument " + int_to_string(i + 1) + " of '" + name + "' is the result of a call that returns no value", args[i].line)
        } else if params[i] == "printable" {
            if ty_known(got) and ty_kind(got) == "" {
                c = ck_error(c, "type mismatch in argument 1 of '" + name + "': expected a string, a number or a bool, found " + got, args[i].line)
            }
        } else if params[i] != "*" {
            if ck_fits_value(c, params[i], got, args[i]) == false {
                c = ck_error(c, "type mismatch in argument " + int_to_string(i + 1) + " of '" + name + "': expected " + params[i] + ", found " + got, args[i].line)
            } else {
                c = ck_settle(c, args[i], params[i])
            }
        }
        i = i + 1
    }
    if name == "assert_eq" {
        if ck_fits(c, arg_types[0], arg_types[1]) == false and ck_fits(c, arg_types[1], arg_types[0]) == false {
            c = ck_error(c, "assert_eq() compares two values of one type, not " + arg_types[0] + " and " + arg_types[1], line)
        }
    }
    return c
}

-- What the signature's type parameters stand for in a call with
-- arguments of the types, from its parameter `first` on. `binds0` is
-- what is known before the arguments are looked at.
fn ck_binds(sig: FnSig, first: int, binds0: List[string], arg_types: List[string]) -> List[string] {
    let mut binds = binds0
    let mut i = 0
    while i < arg_types.len() and first + i < sig.params.len() {
        binds = ty_bind(sig.params[first + i], arg_types[i], sig.generics, binds)
        i = i + 1
    }
    return binds
}

-- Record the type arguments of the call with the id, when all are known
fn ck_note_type_args(c: Checker, id: int, binds: List[string]) -> Checker {
    if c.record == false or id < 0 or id >= c.type_args.len() or binds.len() == 0 { return c }
    let mut joined = ""
    let mut i = 0
    while i < binds.len() {
        if ty_whole(binds[i]) == false or binds[i] == "void" { return c }
        if i > 0 { joined = joined + "|" }
        joined = joined + binds[i]
        i = i + 1
    }
    let mut out = c
    out.type_args[id] = joined
    return out
}

-- Whether the type has an `impl Trait for` it
fn ck_implements(c: Checker, t: string, trait_name: string) -> bool {
    let head = ty_head(t)
    if head == "" or c.type_traits.contains(head) == false { return false }
    return string_contains(c.type_traits.get(head), "|" + trait_name + "|")
}

-- Check the arguments of a call against the signature, starting at
-- its parameter `first`, and give what the call returns. `binds` is
-- what the signature's type parameters are known to stand for.
fn ck_apply(c0: Checker, sig: FnSig, shown: string, first: int, binds0: List[string], arg_types: List[string], args: List[Expr], line: int) -> Typed {
    let mut c = c0
    let binds = ck_binds(sig, first, binds0, arg_types)
    -- What a type parameter stands for must implement the parameter's traits
    let mut bi = 0
    while bi < sig.bounds.len() and bi < binds.len() {
        if sig.bounds[bi] != "" and ty_whole(binds[bi]) {
            let wanted = string_split(sig.bounds[bi], "+")
            let mut wi = 0
            while wi < wanted.len() {
                if c.traits.contains(wanted[wi]) and ck_implements(c, binds[bi], wanted[wi]) == false {
                    c = ck_error(c, "'" + shown + "' takes for " + sig.generics[bi] + " a type that implements " + wanted[wi] + ", which " + binds[bi] + " does not", line)
                }
                wi = wi + 1
            }
        }
        bi = bi + 1
    }
    let mut i = 0
    while i < arg_types.len() and first + i < sig.params.len() {
        let want = ty_apply(sig.params[first + i], sig.generics, binds)
        if ck_fits_value(c, want, arg_types[i], args[i]) == false {
            c = ck_error(c, "type mismatch in argument " + int_to_string(i + 1) + " of '" + shown + "': expected " + want + ", found " + arg_types[i], args[i].line)
        } else {
            c = ck_settle(c, args[i], want)
        }
        i = i + 1
    }
    return ck_typed(c, ty_apply(sig.ret, sig.generics, binds))
}

-- A call of a value whose type is a function's, such as a variable
-- that holds a lambda
fn ck_call_value(c0: Checker, held: string, shown: string, arg_types: List[string], args: List[Expr], line: int) -> Typed {
    let mut c = c0
    if starts_with(held, "fn(") == false {
        if ty_known(held) == false { return ck_typed(c, "") }
        if shown == "a function value" {
            return ck_typed(ck_error(c, "a value of type " + held + " cannot be called", line), "")
        }
        return ck_typed(ck_error(c, "'" + shown + "' is a value of type " + held + ", which cannot be called", line), "")
    }
    let params = ty_fn_params(held)
    if params.len() != arg_types.len() {
        c = ck_error(c, "call to '" + shown + "' passes " + int_to_string(arg_types.len()) + " arguments, expected " + int_to_string(params.len()), line)
        return ck_typed(c, ty_fn_ret(held))
    }
    let mut i = 0
    while i < params.len() {
        if ck_fits_value(c, params[i], arg_types[i], args[i]) == false {
            c = ck_error(c, "type mismatch in argument " + int_to_string(i + 1) + " of '" + shown + "': expected " + params[i] + ", found " + arg_types[i], args[i].line)
        } else {
            c = ck_settle(c, args[i], params[i])
        }
        i = i + 1
    }
    return ck_typed(c, ty_fn_ret(held))
}

-- What a builtin function returns
fn ck_builtin_type(name: string) -> string {
    let ir_type = builtin_return_type(name)
    if ir_type == "void" { return "void" }
    if ir_type == "ptr" { return "" }
    return ty_alias(builtin_src_type(ir_type))
}

-- A call of `name` with arguments of the types. `generic_args` are
-- the type arguments written at the call, as in name[int](x).
-- `call_id` is the id of the call's expression, -1 when it has none
-- of its own (a pipeline).
fn ck_call_named(c0: Checker, name: string, generic_args: List[string], arg_types: List[string], args: List[Expr], line: int, call_id: int) -> Typed {
    let c = c0
    let mut first_type = "?"
    if arg_types.len() > 0 {
        if ty_known(arg_types[0]) { first_type = arg_types[0] }
    }
    if name == "Some" { return ck_typed(c, "Option[" + first_type + "]") }
    if name == "Ok" { return ck_typed(c, "Result[" + first_type + ", ?]") }
    if name == "Err" { return ck_typed(c, "Result[?, " + first_type + "]") }
    if name == "Box_new" { return ck_typed(c, "Box[" + first_type + "]") }
    if name == "Box_null" { return ck_typed(ck_builtin_call(c, name, arg_types, args, line), "Box[?]") }
    if name == "Map_new" { return ck_typed(ck_builtin_call(c, name, arg_types, args, line), "Map[?, ?]") }
    if name == "List_new" { return ck_typed(c, "List[?]") }
    -- A variable that holds a function
    let at = ck_var(c, name)
    if at >= 0 {
        let held = c.var_types[at]
        if starts_with(held, "fn(") or ty_known(held) == false or c.fns.contains(name) == false {
            return ck_call_value(c, held, name, arg_types, args, line)
        }
    }
    let builtin = is_builtin_fn(name)
    if c.fns.contains(name) {
        if builtin { return ck_typed(c, "") }
        let sig = c.fns.get(name)
        let mut binds = ty_unbound(sig.generics.len())
        let none: List[string] = []
        let mut gi = 0
        while gi < generic_args.len() and gi < binds.len() {
            binds[gi] = ty_rewrite(generic_args[gi], none, none)
            gi = gi + 1
        }
        let mut counted = ck_arity(c, sig, name, 0, arg_types.len(), line)
        counted = ck_async_call(counted, sig, name, call_id, line)
        counted = ck_effects(counted, name, sig.effects, " not in caller's effects", "calls", line)
        counted = ck_mut_args(counted, sig, name, 0, args)
        let applied = ck_apply(counted, sig, name, 0, binds, arg_types, args, line)
        if sig.generics.len() == 0 { return applied }
        return ck_typed(ck_note_type_args(applied.c, call_id, ck_binds(sig, 0, binds, arg_types)), applied.t)
    }
    if builtin { return ck_typed(ck_builtin_call(c, name, arg_types, args, line), ck_builtin_type(name)) }
    if is_simd_builtin(name) { return ck_simd_call(c, name, arg_types, args, line) }
    return ck_typed(ck_error(c, "undefined function '" + name + "'", line), "")
}

-- A call of a SIMD builtin. simd_splat_T(x) and simd_set_T(a, b, ...)
-- make a vector of the type T their name ends in, from floats for a
-- vector of floats and integers for one of integers. simd_add,
-- simd_sub, simd_mul and simd_div take two vectors of one type and
-- give a third. simd_extract(v, i) gives lane i as a float or an int.
fn ck_simd_call(c0: Checker, name: string, arg_types: List[string], args: List[Expr], line: int) -> Typed {
    let mut c = c0
    if starts_with(name, "simd_splat_") or starts_with(name, "simd_set_") {
        let vec = parse_simd_type_from_name(name)
        if is_simd_type(vec) == false {
            return ck_typed(ck_error(c, "undefined function '" + name + "'", line), "")
        }
        let mut wanted = 1
        if starts_with(name, "simd_set_") { wanted = simd_lane_count(vec) }
        if arg_types.len() != wanted {
            return ck_typed(ck_error(c, name + "() takes " + arguments_text(wanted) + ", not " + int_to_string(arg_types.len()), line), vec)
        }
        let mut lane = "int"
        if is_simd_float_type(vec) { lane = "float" }
        let mut i = 0
        while i < args.len() {
            if arg_types[i] == "void" {
                c = ck_error(c, "argument " + int_to_string(i + 1) + " of '" + name + "' is the result of a call that returns no value", args[i].line)
            } else if ck_fits(c, lane, arg_types[i]) == false {
                c = ck_error(c, "type mismatch in argument " + int_to_string(i + 1) + " of '" + name + "': expected " + lane + ", found " + arg_types[i], args[i].line)
            }
            i = i + 1
        }
        return ck_typed(c, vec)
    }
    if arg_types.len() != 2 {
        return ck_typed(ck_error(c, name + "() takes 2 arguments, not " + int_to_string(arg_types.len()), line), "")
    }
    let vec = arg_types[0]
    if name == "simd_extract" {
        if arg_types[1] == "void" or ck_fits(c, "int", arg_types[1]) == false {
            c = ck_error(c, "type mismatch in argument 2 of 'simd_extract': expected int, found " + arg_types[1], args[1].line)
        }
        if ty_known(vec) == false { return ck_typed(c, "") }
        if is_simd_type(vec) == false {
            return ck_typed(ck_error(c, "type mismatch in argument 1 of 'simd_extract': expected a SIMD vector, such as f32x4, found " + vec, args[0].line), "")
        }
        -- A lane that does not exist, where the index is written out
        let mut index = args[1]
        while index.kind == EXPR_GROUPED() {
            index = *index.operand
        }
        if index.kind == EXPR_LITERAL_INT() {
            if index.int_val >= simd_lane_count(vec) {
                c = ck_error(c, "simd_extract() of lane " + int_to_string(index.int_val) + " of a " + vec + ", which has lanes 0 to " + int_to_string(simd_lane_count(vec) - 1), args[1].line)
            }
        }
        if is_simd_float_type(vec) { return ck_typed(c, "float") }
        return ck_typed(c, "int")
    }
    let other = arg_types[1]
    if ty_known(vec) and is_simd_type(vec) == false {
        return ck_typed(ck_error(c, "type mismatch in argument 1 of '" + name + "': expected a SIMD vector, such as f32x4, found " + vec, args[0].line), "")
    }
    if ty_known(other) and is_simd_type(other) == false {
        return ck_typed(ck_error(c, "type mismatch in argument 2 of '" + name + "': expected a SIMD vector, such as f32x4, found " + other, args[1].line), "")
    }
    if ty_known(vec) and ty_known(other) and vec != other {
        return ck_typed(ck_error(c, name + "() takes two vectors of one type, not " + vec + " and " + other, line), vec)
    }
    if ty_known(vec) { return ck_typed(c, vec) }
    if ty_known(other) { return ck_typed(c, other) }
    return ck_typed(c, "")
}

fn ck_call(c0: Checker, e: Expr) -> Typed {
    let callee = *e.callee
    if callee.kind != EXPR_IDENTIFIER() {
        let called = ck_expr(c0, callee)
        let rest = ck_exprs(called.c, e.args)
        return ck_call_value(rest.c, called.t, "a function value", rest.types, e.args, e.line)
    }
    let found = ck_exprs(c0, e.args)
    return ck_call_named(found.c, callee.name, callee.generic_args, found.types, e.args, e.line, e.id)
}

-- Whether a trait the type implements has the method
fn ck_trait_method(c: Checker, type_name: string, method: string) -> string {
    if c.type_traits.contains(type_name) == false { return "" }
    let traits = string_split(c.type_traits.get(type_name), "|")
    let mut i = 0
    while i < traits.len() {
        if traits[i] != "" and c.fns.contains(traits[i] + "_" + method) { return traits[i] }
        i = i + 1
    }
    return ""
}

-- The types of the values a variant of an enum carries
fn ck_payloads(sig: EnumSig, at: int) -> List[string] {
    if sig.variant_payloads[at] == "" {
        let none: List[string] = []
        return none
    }
    return string_split(sig.variant_payloads[at], "|")
}

-- Check the values given to a variant of an enum against the number
-- and the types of the values the variant carries
fn ck_variant_values(c0: Checker, enum_name: string, variant: string, types: List[string], values: List[Expr], line: int) -> Checker {
    let mut c = c0
    let sig = c.enums.get(enum_name)
    let at = ck_index_of(sig.variant_names, variant)
    if at < 0 { return c }
    let payloads = ck_payloads(sig, at)
    if payloads.len() != types.len() {
        return ck_error(c, "variant '" + enum_name + "." + variant + "' carries " + values_text(payloads.len()) + ", not " + int_to_string(types.len()), line)
    }
    let mut i = 0
    while i < payloads.len() and i < types.len() {
        let want = ty_apply(payloads[i], sig.generics, ty_unbound(0))
        if ck_fits_value(c, want, types[i], values[i]) == false {
            c = ck_error(c, "type mismatch in value " + int_to_string(i + 1) + " of '" + enum_name + "." + variant + "': expected " + want + ", found " + types[i], values[i].line)
        } else {
            c = ck_settle(c, values[i], want)
        }
        i = i + 1
    }
    return c
}

-- The type of the value a variant's constructor makes: the enum, and
-- for a generic enum what its type parameters stand for as the types
-- of the values say, "Opt[int]" for Opt.Has(3) and "Opt[?]" for
-- Opt.Empty, whose place says the rest (ck_settle)
fn ck_enum_value_type(c: Checker, enum_name: string, variant: string, types: List[string]) -> string {
    let sig = c.enums.get(enum_name)
    if sig.generics.len() == 0 { return enum_name }
    let mut binds = ty_unbound(sig.generics.len())
    let at = ck_index_of(sig.variant_names, variant)
    if at >= 0 {
        -- A wrong number of values, which is reported, says nothing
        let mut payloads = ck_payloads(sig, at)
        if payloads.len() != types.len() { payloads = ty_unbound(0) }
        let mut i = 0
        while i < payloads.len() and i < types.len() {
            binds = ty_bind(payloads[i], types[i], sig.generics, binds)
            i = i + 1
        }
    }
    let mut t = enum_name + "["
    let mut bi = 0
    while bi < binds.len() {
        if bi > 0 { t = t + ", " }
        if binds[bi] == "" { t = t + "?" } else { t = t + binds[bi] }
        bi = bi + 1
    }
    return t + "]"
}

-- The generic enum that the expression makes a value of, when it is a
-- variant's constructor (`Opt.Has(3)`, `Opt.Empty`); else ""
fn ck_generic_variant(c: Checker, e: Expr) -> string {
    let mut name = ""
    let mut variant = ""
    if e.kind == EXPR_ENUM_LITERAL() {
        name = e.enum_name
        variant = e.variant_name
    } else if e.kind == EXPR_METHOD_CALL() {
        let object = *e.object
        if object.kind != EXPR_IDENTIFIER() { return "" }
        name = object.name
        variant = e.method
    } else {
        return ""
    }
    if ck_var(c, name) >= 0 or c.enums.contains(name) == false { return "" }
    let sig = c.enums.get(name)
    if sig.generics.len() == 0 or ck_index_of(sig.variant_names, variant) < 0 { return "" }
    return name
}

-- ck_settle for the constructor of a variant of the generic enum
-- `name`, whose value goes to a place of the type `want`
fn ck_settle_variant(c0: Checker, e: Expr, name: string, want: string) -> Checker {
    let mut c = c0
    let have = c.types[e.id]
    if have != want and ty_fits(want, have) {
        c = ck_note(c, e.id, want)
    }
    let sig = c.enums.get(name)
    let mut variant = e.variant_name
    let mut values = e.payload
    if e.kind == EXPR_METHOD_CALL() {
        variant = e.method
        values = e.args
    }
    let payloads = ck_payloads(sig, ck_index_of(sig.variant_names, variant))
    let enum_args = ty_args(want)
    let mut i = 0
    while i < payloads.len() and i < values.len() {
        c = ck_settle(c, values[i], ty_apply(payloads[i], sig.generics, enum_args))
        i = i + 1
    }
    return c
}

-- Type.name(args): a constructor of Box, Map or List, a variant of
-- an enum, or a function of the type's impl block
fn ck_static_call(c: Checker, type_name: string, e: Expr, arg_types: List[string]) -> Typed {
    let method = e.method
    if type_name == "Box" and method == "new" {
        if arg_types.len() > 0 {
            if ty_known(arg_types[0]) { return ck_typed(c, "Box[" + arg_types[0] + "]") }
        }
        return ck_typed(c, "Box[?]")
    }
    if type_name == "Box" and method == "null" { return ck_typed(c, "Box[?]") }
    if type_name == "Map" and method == "new" { return ck_typed(c, "Map[?, ?]") }
    if type_name == "List" and method == "new" { return ck_typed(c, "List[?]") }
    if c.enums.contains(type_name) {
        let sig = c.enums.get(type_name)
        if ck_index_of(sig.variant_names, method) >= 0 {
            return ck_typed(ck_variant_values(c, type_name, method, arg_types, e.args, e.line), ck_enum_value_type(c, type_name, method, arg_types))
        }
        if c.fns.contains(type_name + "_" + method) == false and ck_trait_method(c, type_name, method) == "" {
            return ck_typed(ck_error(c, "enum '" + type_name + "' has no variant or function '" + method + "'", e.line), type_name)
        }
    }
    let key = type_name + "_" + method
    if c.fns.contains(key) {
        let sig = c.fns.get(key)
        let mut counted = ck_arity(c, sig, type_name + "." + method, 0, arg_types.len(), e.line)
        counted = ck_async_call(counted, sig, type_name + "." + method, e.id, e.line)
        counted = ck_effects(counted, type_name + "." + method, sig.effects, " not in caller's effects", "calls", e.line)
        counted = ck_mut_args(counted, sig, type_name + "." + method, 0, e.args)
        return ck_apply(counted, sig, type_name + "." + method, 0, ty_unbound(sig.generics.len()), arg_types, e.args, e.line)
    }
    return ck_typed(c, "")
}

fn ck_method_arity(c: Checker, recv: string, method: string, want: int, got: int, line: int) -> Checker {
    if want == got { return c }
    return ck_error(c, "'" + method + "' of a " + ty_head(recv) + " takes " + arguments_text(want) + ", not " + int_to_string(got), line)
}

-- A method call on a value whose type has no such method: x.f(a) is
-- f(x, a) when there is a function f, and else the error `message`
fn ck_no_method(c0: Checker, e: Expr, recv: string, arg_types: List[string], message: string) -> Typed {
    let mut c = c0
    let method = e.method
    if c.fns.contains(method) == false or is_builtin_fn(method) or ck_var(c, method) >= 0 {
        return ck_typed(ck_error(c, message, e.line), "")
    }
    let mut types: List[string] = []
    types.push(recv)
    let mut args: List[Expr] = []
    args.push(*e.object)
    let mut i = 0
    while i < e.args.len() {
        types.push(arg_types[i])
        args.push(e.args[i])
        i = i + 1
    }
    if c.record and e.id >= 0 and e.id < c.targets.len() {
        c.targets[e.id] = "call:" + method
    }
    let none: List[string] = []
    return ck_call_named(c, method, none, types, args, e.line, e.id)
}

fn ck_method_call(c0: Checker, e: Expr) -> Typed {
    let mut c = c0
    let object = *e.object
    let method = e.method
    -- A name that is no variable may be a type's
    let mut type_name = ""
    if object.kind == EXPR_IDENTIFIER() {
        let name = object.name
        if ck_names_type(c, name) {
            type_name = name
        } else if ck_var(c, name) < 0 and (name == "Box" or name == "Map" or name == "List") {
            type_name = name
        }
    }
    let mut recv = ""
    if type_name == "" {
        let found = ck_expr(c, object)
        c = found.c
        recv = ty_unbox(found.t)
    }
    let found_args = ck_exprs(c, e.args)
    c = found_args.c
    let arg_types = found_args.types
    if type_name != "" { return ck_static_call(c, type_name, e, arg_types) }

    let head = ty_head(recv)
    if ty_known(head) == false { return ck_typed(c, "") }
    if c.fns.contains(head + "_" + method) {
        let sig = c.fns.get(head + "_" + method)
        c = ck_effects(c, head + "." + method, sig.effects, " not in caller's effects", "calls", e.line)
        c = ck_async_call(c, sig, head + "." + method, e.id, e.line)
        if sig.has_self {
            if sig.changes[0] { c = ck_changes(c, object, "'" + head + "." + method + "'", e.line) }
        }
        -- The receiver's type arguments are the impl block's type parameters
        let mut binds = ty_unbound(sig.generics.len())
        let recv_args = ty_args(recv)
        let mut bi = 0
        while bi < recv_args.len() and bi < binds.len() {
            binds[bi] = recv_args[bi]
            bi = bi + 1
        }
        let mut first = 0
        if sig.has_self { first = 1 }
        c = ck_arity(c, sig, head + "." + method, first, arg_types.len(), e.line)
        c = ck_mut_args(c, sig, head + "." + method, first, e.args)
        return ck_apply(c, sig, head + "." + method, first, binds, arg_types, e.args, e.line)
    }
    if head == "List" {
        let elem = ty_arg(recv, 0)
        if method == "push" {
            c = ck_method_arity(c, recv, method, 1, arg_types.len(), e.line)
            c = ck_changes(c, object, "'push'", e.line)
            if arg_types.len() == 1 {
                if ck_fits_value(c, elem, arg_types[0], e.args[0]) == false {
                    c = ck_error(c, "type mismatch in the value pushed to a " + recv + ": expected " + elem + ", found " + arg_types[0], e.line)
                } else {
                    c = ck_settle(c, e.args[0], elem)
                }
            }
            return ck_typed(c, "void")
        }
        if method == "pop" {
            c = ck_method_arity(c, recv, method, 0, arg_types.len(), e.line)
            return ck_typed(ck_changes(c, object, "'pop'", e.line), elem)
        }
        if method == "len" { return ck_typed(ck_method_arity(c, recv, method, 0, arg_types.len(), e.line), "int") }
        if method == "contains" {
            c = ck_method_arity(c, recv, method, 1, arg_types.len(), e.line)
            if arg_types.len() == 1 {
                if ck_fits(c, elem, arg_types[0]) == false {
                    c = ck_error(c, "type mismatch in the value looked for in a " + recv + ": expected " + elem + ", found " + arg_types[0], e.line)
                } else {
                    c = ck_settle(c, e.args[0], elem)
                }
            }
            return ck_typed(c, "bool")
        }
        return ck_no_method(c, e, recv, arg_types, "a " + recv + " has no method '" + method + "': a list has push, pop, len and contains")
    }
    if recv == "string" {
        if method == "len" { return ck_typed(ck_method_arity(c, recv, method, 0, arg_types.len(), e.line), "int") }
        return ck_no_method(c, e, recv, arg_types, "a string has no method '" + method + "': it has len, and the string functions take it as an argument")
    }
    if c.structs.contains(head) or c.enums.contains(head) {
        -- A field that holds a function is called like a method
        if c.structs.contains(head) {
            let sig = c.structs.get(head)
            let at = ck_index_of(sig.field_names, method)
            if at >= 0 {
                let held = ty_apply(sig.field_types[at], sig.generics, ty_args(recv))
                if starts_with(held, "fn(") == false {
                    return ck_typed(ck_error(c, "field '" + method + "' of '" + head + "' is a " + held + ", which cannot be called", e.line), "")
                }
                return ck_call_value(c, held, head + "." + method, arg_types, e.args, e.line)
            }
        }
        let from_trait = ck_trait_method(c, head, method)
        if from_trait != "" {
            let sig = c.fns.get(from_trait + "_" + method)
            c = ck_effects(c, from_trait + "." + method, sig.effects, " not in caller's effects", "calls", e.line)
            return ck_typed(c, ty_apply(sig.ret, sig.generics, ty_unbound(0)))
        }
        if starts_with(head, DYN_PREFIX()) {
            -- A method of the trait that its `dyn` does not have
            let trait_name = substr(head, len(DYN_PREFIX()), len(head) - len(DYN_PREFIX()))
            if c.fns.contains(trait_name + "_" + method) {
                return ck_no_method(c, e, recv, arg_types, "the method '" + method + "' of the trait '" + trait_name + "' cannot be called on a '" + head + "': a 'dyn' has the methods that take 'self', have no type parameters and do not name 'Self' elsewhere")
            }
        }
        return ck_no_method(c, e, recv, arg_types, "type '" + head + "' has no method '" + method + "'")
    }
    -- A `dyn` that is reported where it is written
    if starts_with(recv, DYN_PREFIX()) { return ck_typed(c, "") }
    return ck_no_method(c, e, recv, arg_types, "type '" + recv + "' has no method '" + method + "'")
}

fn ck_struct_literal(c0: Checker, e: Expr) -> Typed {
    let mut c = ck_type_exists(c0, e.type_name, e.line)
    let t = ck_norm(c, e.type_name)
    let head = ty_head(t)
    let values = ck_exprs(c, e.field_values)
    c = values.c
    if head == "" or c.structs.contains(head) == false { return ck_typed(c, "") }
    let sig = c.structs.get(head)
    let mut i = 0
    while i < e.field_names.len() and i < values.types.len() {
        let field = e.field_names[i]
        if ck_index_of(sig.field_names, field) < 0 {
            c = ck_error(c, "struct '" + head + "' has no field '" + field + "'", e.field_values[i].line)
        } else {
            let want = ck_field_type(c, t, field)
            if ck_fits_value(c, want, values.types[i], e.field_values[i]) == false {
                c = ck_error(c, "type mismatch in field '" + field + "' of '" + head + "': expected " + want + ", found " + values.types[i], e.field_values[i].line)
            } else {
                c = ck_settle(c, e.field_values[i], want)
            }
        }
        i = i + 1
    }
    i = 0
    while i < sig.field_names.len() {
        if ck_index_of(e.field_names, sig.field_names[i]) < 0 {
            c = ck_error(c, "the struct literal of '" + head + "' leaves out the field '" + sig.field_names[i] + "'", e.line)
        }
        i = i + 1
    }
    return ck_typed(c, t)
}

fn ck_enum_literal(c0: Checker, e: Expr) -> Typed {
    let values = ck_exprs(c0, e.payload)
    let c = values.c
    let name = e.enum_name
    if ck_var(c, name) >= 0 { return ck_typed(c, "") }
    if c.enums.contains(name) {
        let sig = c.enums.get(name)
        if ck_index_of(sig.variant_names, e.variant_name) >= 0 {
            return ck_typed(ck_variant_values(c, name, e.variant_name, values.types, e.payload, e.line), ck_enum_value_type(c, name, e.variant_name, values.types))
        }
        if c.fns.contains(name + "_" + e.variant_name) == false and ck_trait_method(c, name, e.variant_name) == "" {
            return ck_typed(ck_error(c, "enum '" + name + "' has no variant or function '" + e.variant_name + "'", e.line), name)
        }
    }
    -- Type.Name(args), a function of the type's impl block
    let key = name + "_" + e.variant_name
    if c.fns.contains(key) {
        let sig = c.fns.get(key)
        let counted = ck_arity(c, sig, name + "." + e.variant_name, 0, values.types.len(), e.line)
        return ck_apply(counted, sig, name + "." + e.variant_name, 0, ty_unbound(sig.generics.len()), values.types, e.payload, e.line)
    }
    return ck_typed(c, "")
}

fn ck_array_literal(c0: Checker, e: Expr) -> Typed {
    let values = ck_exprs(c0, e.elements)
    let mut c = values.c
    -- The first element's type, with what the later ones know of its parts
    let mut elem = "?"
    let mut i = 0
    while i < values.types.len() {
        if ty_known(values.types[i]) and values.types[i] != "void" {
            if elem == "?" {
                elem = values.types[i]
            } else if ty_fits(elem, values.types[i]) {
                elem = ty_merge(elem, values.types[i])
            }
        }
        i = i + 1
    }
    i = 0
    while i < e.elements.len() {
        c = ck_settle(c, e.elements[i], elem)
        i = i + 1
    }
    return ck_typed(c, "List[" + elem + "]")
}

fn ck_condition(c: Checker, t: string, what: string, line: int) -> Checker {
    if ty_known(t) and t != "bool" {
        return ck_error(c, "the condition of " + what + " is " + t + ", not bool", line)
    }
    return c
}

-- The statements, and the value of the last when it is an expression
fn ck_body_value(c0: Checker, stmts: List[Stmt], used: bool) -> Typed {
    let n = stmts.len()
    if n == 0 { return ck_typed(c0, "void") }
    let mut c = c0
    let mut i = 0
    while i < n - 1 {
        c = ck_stmt(c, stmts[i])
        i = i + 1
    }
    let last = stmts[n - 1]
    if last.kind == STMT_EXPRESSION() { return ck_expr(c, *last.expr) }
    -- A block that is used as a value and ends in an `if` with an
    -- `else`, or in a `match`, has the value of that statement
    if used and stmt_gives_value(last) { return ck_expr(c, stmt_value_expr(last)) }
    return ck_typed(ck_stmt(c, last), "void")
}

fn ck_block(c0: Checker, e: Expr) -> Typed {
    let mark = c0.var_names.len()
    if e.has_result {
        let c = ck_stmts(c0, e.stmts)
        let result = ck_expr(c, *e.result)
        return ck_typed(ck_unbind(result.c, mark), result.t)
    }
    let value = ck_body_value(c0, e.stmts, true)
    return ck_typed(ck_unbind(value.c, mark), value.t)
}

fn ck_if_expr(c0: Checker, e: Expr) -> Typed {
    let cond = ck_expr(c0, *e.condition)
    let mut c = ck_condition(cond.c, cond.t, "'if'", e.line)
    let then_value = ck_expr(c, *e.then_branch)
    c = then_value.c
    let mut t = ""
    if ty_known(then_value.t) and then_value.t != "void" { t = then_value.t }
    if e.has_else {
        let else_value = ck_expr(c, *e.else_branch)
        c = else_value.c
        if t == "" and ty_known(else_value.t) and else_value.t != "void" { t = else_value.t }
        if t != "" and else_value.t != "void" and ck_fits(c, t, else_value.t) == false and ck_fits(c, else_value.t, t) == false {
            c = ck_error(c, "the branches of this 'if' give " + t + " and " + else_value.t, e.line)
        } else if ty_is_int(t) and ty_is_int(else_value.t) and ty_is_int(then_value.t) {
            -- Integers of two widths give one value
            t = int_meet_type(t, is_int_literal_expr(branch_value_expr(*e.then_branch)), else_value.t, is_int_literal_expr(branch_value_expr(*e.else_branch)))
        } else if t != "" and else_value.t != "void" {
            -- Each branch may know what the other does not: Some(n) and None
            t = ty_merge(t, else_value.t)
        }
        c = ck_settle(c, *e.then_branch, t)
        c = ck_settle(c, *e.else_branch, t)
    }
    return ck_typed(c, t)
}

-- The types of a variant's values in a pattern on a value of type t
fn ck_variant_types(c: Checker, p: Pattern, t: string) -> List[string] {
    let mut types: List[string] = []
    let head = ty_head(t)
    if p.variant == "Some" {
        if head == "Option" { types.push(ty_arg(t, 0)) }
        return types
    }
    if p.variant == "Ok" {
        if head == "Result" { types.push(ty_arg(t, 0)) }
        return types
    }
    if p.variant == "Err" {
        if head == "Result" { types.push(ty_arg(t, 1)) }
        return types
    }
    let mut enum_name = p.enum_type
    if enum_name == "" { enum_name = head }
    if enum_name == "" or c.enums.contains(enum_name) == false { return types }
    let sig = c.enums.get(enum_name)
    let at = ck_index_of(sig.variant_names, p.variant)
    if at < 0 or sig.variant_payloads[at] == "" { return types }
    -- The enum's type parameters are what the matched value's type gives them
    let mut enum_args: List[string] = []
    if head == enum_name { enum_args = ty_args(t) }
    let payloads = string_split(sig.variant_payloads[at], "|")
    let mut i = 0
    while i < payloads.len() {
        types.push(ty_apply(payloads[i], sig.generics, enum_args))
        i = i + 1
    }
    return types
}

-- Declare the variables a pattern binds when it meets a value of type t
fn ck_bind_pattern(c0: Checker, p: Pattern, t: string) -> Checker {
    let mut c = c0
    if p.kind == PAT_IDENTIFIER() {
        return ck_bind(c, p.name, t, 1)
    }
    if p.kind == PAT_ENUM_VARIANT() {
        let types = ck_variant_types(c, p, t)
        let mut i = 0
        while i < p.bindings.len() {
            let mut bound = ""
            if i < types.len() { bound = types[i] }
            c = ck_bind(c, p.bindings[i], bound, 1)
            i = i + 1
        }
        return c
    }
    return c
}

-- "string", "bool" or "number" for a pattern that is a literal
fn ck_literal_kind(p: Pattern) -> string {
    if p.kind != PAT_LITERAL() { return "" }
    let lit = *p.literal_expr
    if lit.kind == EXPR_LITERAL_STRING() { return "string" }
    if lit.kind == EXPR_LITERAL_BOOL() { return "bool" }
    return "number"
}

-- Whether an arm of the match takes the variant, guards aside
fn ck_arm_for(e: Expr, variant: string) -> bool {
    let mut i = 0
    while i < e.match_arms.len() {
        let arm = e.match_arms[i]
        if arm.has_guard == false and arm.pattern.kind == PAT_ENUM_VARIANT() and arm.pattern.variant == variant { return true }
        i = i + 1
    }
    return false
}

-- Whether an arm of the match takes the bool
fn ck_arm_for_bool(e: Expr, value: bool) -> bool {
    let mut i = 0
    while i < e.match_arms.len() {
        let arm = e.match_arms[i]
        if arm.has_guard == false and arm.pattern.kind == PAT_LITERAL() {
            let lit = *arm.pattern.literal_expr
            if lit.kind == EXPR_LITERAL_BOOL() and lit.bool_val == value { return true }
        }
        i = i + 1
    }
    return false
}

-- What a match on a value of type t leaves out, "" when its arms
-- take every value. `used` says that the match gives a value, which
-- it must then give whatever is matched.
fn ck_match_missing(c: Checker, e: Expr, t: string, used: bool) -> string {
    let mut enum_name = ""
    let mut i = 0
    while i < e.match_arms.len() {
        let arm = e.match_arms[i]
        let kind = arm.pattern.kind
        if arm.has_guard == false and (kind == PAT_WILDCARD() or kind == PAT_IDENTIFIER()) { return "" }
        if kind == PAT_ENUM_VARIANT() and enum_name == "" { enum_name = arm.pattern.enum_type }
        i = i + 1
    }
    let head = ty_head(t)
    if head == "Option" {
        if ck_arm_for(e, "Some") == false { return "Some" }
        if ck_arm_for(e, "None") == false { return "None" }
        return ""
    }
    if head == "Result" {
        if ck_arm_for(e, "Ok") == false { return "Ok" }
        if ck_arm_for(e, "Err") == false { return "Err" }
        return ""
    }
    if t == "bool" {
        if ck_arm_for_bool(e, true) == false { return "true" }
        if ck_arm_for_bool(e, false) == false { return "false" }
        return ""
    }
    if ty_known(head) and c.enums.contains(head) { enum_name = head }
    if enum_name != "" and c.enums.contains(enum_name) and (ty_known(head) == false or head == enum_name) {
        let sig = c.enums.get(enum_name)
        let mut v = 0
        while v < sig.variant_names.len() {
            if ck_arm_for(e, sig.variant_names[v]) == false { return enum_name + "." + sig.variant_names[v] }
            v = v + 1
        }
        return ""
    }
    if used and ty_kind(t) != "" { return "every other " + t }
    return ""
}

-- Report a pattern that names a variant the enum does not have, or
-- binds more values than the variant carries
fn ck_variant_pattern(c: Checker, p: Pattern, t: string, line: int) -> Checker {
    if p.kind != PAT_ENUM_VARIANT() { return c }
    let mut enum_name = p.enum_type
    if enum_name == "" { enum_name = ty_head(t) }
    if enum_name == "" or c.enums.contains(enum_name) == false { return c }
    let sig = c.enums.get(enum_name)
    let at = ck_index_of(sig.variant_names, p.variant)
    if at < 0 {
        return ck_error(c, "enum '" + enum_name + "' has no variant '" + p.variant + "'", line)
    }
    let payloads = ck_payloads(sig, at)
    if p.bindings.len() > payloads.len() {
        return ck_error(c, "variant '" + enum_name + "." + p.variant + "' carries " + values_text(payloads.len()) + ", but the pattern binds " + int_to_string(p.bindings.len()), line)
    }
    return c
}

-- A match. `used` says that its value goes somewhere.
fn ck_match(c0: Checker, e: Expr, used: bool) -> Typed {
    let scrutinee = ck_expr(c0, *e.scrutinee)
    let mut c = scrutinee.c
    let mut t = ""
    -- Whether every arm so far gives an integer literal
    let mut t_literal = false
    let scrutinee_kind = ty_kind(scrutinee.t)
    let mut i = 0
    while i < e.match_arms.len() {
        let arm = e.match_arms[i]
        let mark = c.var_names.len()
        let pattern_kind = ck_literal_kind(arm.pattern)
        if pattern_kind != "" and scrutinee_kind != "" and pattern_kind != scrutinee_kind {
            let lit = *arm.pattern.literal_expr
            c = ck_error(c, "a pattern is a " + pattern_kind + ", but the matched value is " + scrutinee.t, lit.line)
        }
        c = ck_variant_pattern(c, arm.pattern, scrutinee.t, e.line)
        c = ck_bind_pattern(c, arm.pattern, scrutinee.t)
        if arm.has_guard {
            let guard_expr = *arm.guard
            let guard = ck_expr(c, guard_expr)
            c = ck_condition(guard.c, guard.t, "a match guard", guard_expr.line)
        }
        let mut arm_type = ""
        let mut arm_literal = false
        if arm.is_expr_body {
            let value = ck_expr(c, *arm.body_expr)
            c = value.c
            arm_type = value.t
            arm_literal = is_int_literal_expr(branch_value_expr(*arm.body_expr))
        } else {
            let value = ck_body_value(c, arm.body, used)
            c = value.c
            arm_type = value.t
            arm_literal = stmts_value_is_int_literal(arm.body)
        }
        c = ck_unbind(c, mark)
        if t == "" and ty_known(arm_type) and arm_type != "void" {
            t = arm_type
            t_literal = arm_literal
        }
        if used and t != "" and arm_type != "void" and ck_fits(c, t, arm_type) == false and ck_fits(c, arm_type, t) == false {
            c = ck_error(c, "the arms of this match give " + t + " and " + arm_type, e.line)
        } else if ty_is_int(t) and ty_is_int(arm_type) {
            -- Integers of two widths give one value
            t = int_meet_type(t, t_literal, arm_type, arm_literal)
            t_literal = t_literal and arm_literal
        } else if t != "" and ty_known(arm_type) and arm_type != "void" {
            t = ty_merge(t, arm_type)
        }
        i = i + 1
    }
    -- Each arm gives a value of the type the arms give together
    i = 0
    while i < e.match_arms.len() {
        let arm = e.match_arms[i]
        if arm.is_expr_body {
            c = ck_settle(c, *arm.body_expr, t)
        } else {
            c = ck_settle_last(c, arm.body, t)
        }
        i = i + 1
    }
    let missing = ck_match_missing(c, e, scrutinee.t, used)
    if missing != "" {
        c = ck_error(c, "this match has no arm for " + missing, e.line)
    }
    return ck_typed(c, t)
}

fn ck_lambda(c0: Checker, e: Expr) -> Typed {
    let mut c = c0
    let mark = c.var_names.len()
    let outer_ret = c.ret_type
    let outer_floor = c.lambda_floor
    c.lambda_floor = mark
    let mut text = "fn("
    let mut i = 0
    while i < e.lambda_params.len() {
        let lp = e.lambda_params[i]
        let mut t = ""
        if lp.type_name != "" {
            c = ck_type_exists(c, lp.type_name, e.line)
            t = ck_norm(c, lp.type_name)
        }
        c = ck_bind(c, lp.name, t, 1)
        if i > 0 { text = text + ", " }
        if t == "" { text = text + "?" } else { text = text + t }
        i = i + 1
    }
    let mut ret = ""
    if e.lambda_ret_type != "" {
        c = ck_type_exists(c, e.lambda_ret_type, e.line)
        ret = ck_norm(c, e.lambda_ret_type)
    }
    c.ret_type = ret
    let outer_lambda_ret = c.lambda_ret
    c.lambda_ret = "-"
    if ret == "" { c.lambda_ret = "" }
    let body = *e.lambda_body
    let value = ck_expr(c, body)
    c = value.c
    let returned = c.lambda_ret
    c.lambda_ret = outer_lambda_ret
    if body.kind == EXPR_BLOCK() {
        -- A block's lambda returns what its first `return` gives, else
        -- the block's value
        if ret == "" {
            if returned != "" and returned != "-" {
                ret = returned
            } else if ty_known(value.t) {
                ret = value.t
            }
        }
    } else {
        if ret == "" {
            if ty_known(value.t) { ret = value.t }
        } else if value.t != "void" and ck_fits_value(c, ret, value.t, body) == false {
            c = ck_error(c, "type mismatch in the lambda's value: expected " + ret + ", found " + value.t, body.line)
        } else {
            c = ck_settle(c, body, ret)
        }
    }
    c.ret_type = outer_ret
    c.lambda_floor = outer_floor
    c = ck_unbind(c, mark)
    if ret == "" { ret = "?" }
    return ck_typed(c, text + ") -> " + ret)
}

-- value? is the value of an Ok or a Some
-- `value?`: the value of an Ok or a Some. An Err or a None leaves
-- the function, which must return a Result with that error type, or
-- an Option.
fn ck_propagate(c0: Checker, e: Expr) -> Typed {
    let operand = ck_expr(c0, *e.operand)
    let mut c = operand.c
    let head = ty_head(operand.t)
    if head != "Result" and head != "Option" {
        if ty_known(operand.t) {
            c = ck_error(c, "'?' needs a Result or an Option, found " + operand.t, e.line)
        }
        return ck_typed(c, "")
    }
    let returns = c.ret_type
    if ty_known(returns) {
        if ty_head(returns) != head {
            let mut leaves = "an Err"
            let mut needs = "a Result"
            if head == "Option" {
                leaves = "a None"
                needs = "an Option"
            }
            let mut found = "returns " + returns
            if returns == "void" { found = "returns no value" }
            c = ck_error(c, "'?' leaves the function with " + leaves + ", so the function must return " + needs + "; it " + found, e.line)
        } else if head == "Result" {
            let given = ty_arg(operand.t, 1)
            let wanted = ty_arg(returns, 1)
            if ty_known(given) and ty_known(wanted) and ty_same(given, wanted) == false {
                c = ck_error(c, "'?' leaves the function with an error of type " + given + ", but the function returns " + returns, e.line)
            }
        }
    }
    return ck_typed(c, ty_arg(operand.t, 0))
}

-- ============================================================
-- STATEMENTS
-- ============================================================

fn ck_stmts(c0: Checker, stmts: List[Stmt]) -> Checker {
    let mut c = c0
    let mut i = 0
    while i < stmts.len() {
        c = ck_stmt(c, stmts[i])
        i = i + 1
    }
    return c
}

-- The statements, in a scope of their own
fn ck_scope(c0: Checker, stmts: List[Stmt]) -> Checker {
    let mark = c0.var_names.len()
    return ck_unbind(ck_stmts(c0, stmts), mark)
}

fn ck_let(c0: Checker, s: Stmt) -> Checker {
    let value = *s.let_value
    let found = ck_expr(c0, value)
    let mut c = ck_needs_value(found.c, value, false)
    let mut t = found.t
    if t == "void" {
        c = ck_error(c, "a variable holds the result of a call that returns no value", value.line)
        t = ""
    }
    if s.let_type != "" {
        c = ck_type_exists(c, s.let_type, s.line)
        let want = ck_norm(c, s.let_type)
        if ck_fits_value(c, want, t, value) == false {
            c = ck_error(c, "type mismatch in the value of '" + s.let_name + "': expected " + want + ", found " + t, value.line)
        } else {
            c = ck_settle(c, value, want)
        }
        t = want
    }
    let mut flag = 0
    if s.let_is_mut { flag = 1 }
    return ck_bind(c, s.let_name, t, flag)
}

fn ck_return(c0: Checker, s: Stmt) -> Checker {
    let want = c0.ret_type
    if s.has_ret_value == false {
        if want == "" and c0.lambda_ret == "" {
            -- The first return of a lambda says what the lambda returns
            let mut first = c0
            first.lambda_ret = "void"
            first.ret_type = "void"
            return first
        }
        if ty_known(want) and want != "void" {
            return ck_error(c0, "this return has no value, but the function returns " + want, s.line)
        }
        return c0
    }
    let value = *s.ret_value
    let found = ck_expr(c0, value)
    let mut c = found.c
    if want != "void" { c = ck_needs_value(c, value, false) }
    if want == "void" {
        if ty_known(found.t) and found.t != "void" {
            return ck_error(c, "this return has a value, but the function returns none", s.line)
        }
        return c
    }
    if found.t == "void" {
        if ty_known(want) {
            return ck_error(c, "the return value is a call that returns no value", s.line)
        }
        return c
    }
    if want == "" and c.lambda_ret == "" and ty_known(found.t) {
        -- The first return of a lambda says what the lambda returns
        c.lambda_ret = found.t
        c.ret_type = found.t
        return c
    }
    if ck_fits_value(c, want, found.t, value) == false {
        return ck_error(c, "type mismatch in the return value: expected " + want + ", found " + found.t, value.line)
    }
    return ck_settle(c, value, want)
}

fn ck_assign_op(op: int) -> int {
    if op == ASSIGN_ADD() { return BINOP_ADD() }
    if op == ASSIGN_SUB() { return BINOP_SUB() }
    if op == ASSIGN_MUL() { return BINOP_MUL() }
    if op == ASSIGN_DIV() { return BINOP_DIV() }
    return BINOP_MOD()
}

fn ck_assignment(c0: Checker, s: Stmt) -> Checker {
    let mut c = c0
    let target = *s.assign_target
    let mut shown = ""
    let mut place = target
    while place.kind == EXPR_GROUPED() {
        place = *place.operand
    }
    let is_box_value = place.kind == EXPR_UNARY() and place.op == UNOP_DEREF()
    if place.kind != EXPR_IDENTIFIER() and place.kind != EXPR_FIELD_ACCESS() and place.kind != EXPR_INDEX_ACCESS() and is_box_value == false {
        c = ck_error(c, "cannot assign to this expression: it is not a variable, a field, an element or the value of a box", s.line)
    }
    if target.kind == EXPR_FIELD_ACCESS() or target.kind == EXPR_INDEX_ACCESS() {
        let root = ck_fixed_root(c, *target.object)
        if root != "" {
            c = ck_error(c, "cannot assign to a part of " + ck_fixed_why(c, root), s.line)
        }
    }
    if target.kind == EXPR_IDENTIFIER() {
        shown = " to '" + target.name + "'"
        let at = ck_var(c, target.name)
        if at >= 0 {
            if c.var_flags[at] == 0 or at < c.lambda_floor {
                c = ck_error(c, "cannot assign to " + ck_fixed_why(c, target.name), s.line)
            }
        } else if c.consts.contains(target.name) {
            c = ck_error(c, "cannot assign to the constant '" + target.name + "'", s.line)
        }
    }
    let to = ck_expr(c, target)
    let value = ck_expr(to.c, *s.assign_value)
    c = ck_needs_value(value.c, *s.assign_value, false)
    if value.t == "void" {
        return ck_error(c, "the assignment" + shown + " takes the result of a call that returns no value", s.line)
    }
    if s.assign_op == ASSIGN_EQ() {
        if ck_fits_value(c, to.t, value.t, *s.assign_value) == false {
            c = ck_error(c, "type mismatch in the assignment" + shown + ": expected " + to.t + ", found " + value.t, s.line)
        } else {
            c = ck_settle(c, *s.assign_value, to.t)
        }
        return c
    }
    let combined = ck_operator(c, ck_assign_op(s.assign_op), to.t, value.t, s.line)
    return combined.c
}

fn ck_for(c0: Checker, s: Stmt) -> Checker {
    let mut c = c0
    let iter = *s.for_iter
    let mut elem = ""
    if iter.kind == EXPR_RANGE() {
        let low = ck_expr(c, *iter.left)
        let high = ck_expr(low.c, *iter.right)
        c = high.c
        elem = "int"
    } else {
        let over = ck_expr(c, iter)
        c = over.c
        elem = ty_iterated(ty_unbox(over.t))
    }
    let mark = c.var_names.len()
    c = ck_bind(c, s.for_var, elem, 1)
    c = ck_stmts(c, s.for_body)
    return ck_unbind(c, mark)
}

fn ck_stmt(c0: Checker, s: Stmt) -> Checker {
    let k = s.kind
    if k == STMT_LET() { return ck_let(c0, s) }
    if k == STMT_RETURN() { return ck_return(c0, s) }
    if k == STMT_EXPRESSION() {
        let stated = *s.expr
        if stated.kind == EXPR_BLOCK() and stated.has_result == false {
            -- A block that is a statement of its own gives no value
            return ck_note(ck_scope(c0, stated.stmts), stated.id, "void")
        }
        let value = ck_expr(c0, stated)
        return value.c
    }
    if k == STMT_ASSIGNMENT() { return ck_assignment(c0, s) }
    if k == STMT_IF() {
        let cond = ck_expr(c0, *s.if_cond)
        let mut c = ck_condition(cond.c, cond.t, "'if'", s.line)
        c = ck_scope(c, s.if_then)
        if s.has_else_branch {
            c = ck_scope(c, s.if_else)
        }
        return c
    }
    if k == STMT_WHILE() {
        let cond = ck_expr(c0, *s.while_cond)
        let c = ck_condition(cond.c, cond.t, "'while'", s.line)
        return ck_scope(c, s.while_body)
    }
    if k == STMT_FOR() { return ck_for(c0, s) }
    if k == STMT_LOOP() { return ck_scope(c0, s.loop_body) }
    if k == STMT_REGION() { return ck_scope(c0, s.region_body) }
    if k == STMT_MATCH() {
        let matched = *s.match_expr
        if matched.kind == EXPR_MATCH() {
            let value = ck_match(c0, matched, false)
            return value.c
        }
        let value = ck_expr(c0, matched)
        return value.c
    }
    return c0
}

-- ============================================================
-- FUNCTIONS
-- ============================================================

-- Whether the expression never gives control to what follows it: a
-- call of panic or exit, or branches that all return
fn ck_diverges(e: Expr) -> bool {
    if e.kind == EXPR_FUNCTION_CALL() {
        let callee = *e.callee
        return callee.kind == EXPR_IDENTIFIER() and (callee.name == "panic" or callee.name == "exit")
    }
    if e.kind == EXPR_GROUPED() { return ck_diverges(*e.operand) }
    if e.kind == EXPR_BLOCK() { return ck_always_returns(e.stmts) }
    if e.kind == EXPR_IF() {
        if e.has_else == false { return false }
        return ck_diverges(*e.then_branch) and ck_diverges(*e.else_branch)
    }
    if e.kind == EXPR_MATCH() {
        let mut i = 0
        while i < e.match_arms.len() {
            let arm = e.match_arms[i]
            if arm.is_expr_body {
                if ck_diverges(*arm.body_expr) == false { return false }
            } else if ck_always_returns(arm.body) == false {
                return false
            }
            i = i + 1
        }
        return e.match_arms.len() > 0
    }
    return false
}

-- Whether the statements end by leaving the code around them: what
-- ck_always_returns finds, a break or a continue
fn ck_leaves(stmts: List[Stmt]) -> bool {
    if stmts.len() == 0 { return false }
    let s = stmts[stmts.len() - 1]
    if s.kind == STMT_BREAK() or s.kind == STMT_CONTINUE() { return true }
    if s.kind == STMT_IF() {
        return s.has_else_branch and ck_leaves(s.if_then) and ck_leaves(s.if_else)
    }
    return ck_always_returns(stmts)
}

-- The value of the expression is used, so each of its branches must
-- give one: report an `if` without an `else`, and a branch or an arm
-- that ends in a statement or in a call that returns nothing. A
-- branch that leaves (return, break, continue, panic) needs no value.
-- `inner` says that the expression is a branch of the one in use.
fn ck_needs_value(c: Checker, e: Expr, inner: bool) -> Checker {
    let k = e.kind
    if k == EXPR_GROUPED() { return ck_needs_value(c, *e.operand, inner) }
    if k == EXPR_IF() {
        if e.has_else == false {
            return ck_error(c, "this 'if' is used as a value, and has no 'else' to give one", e.line)
        }
        return ck_needs_value(ck_needs_value(c, *e.then_branch, true), *e.else_branch, true)
    }
    if k == EXPR_BLOCK() {
        if e.has_result { return ck_needs_value(c, *e.result, true) }
        return ck_block_needs_value(c, e.stmts, e.line)
    }
    if k == EXPR_MATCH() {
        let mut out = c
        let mut i = 0
        while i < e.match_arms.len() {
            let arm = e.match_arms[i]
            if arm.is_expr_body {
                out = ck_needs_value(out, *arm.body_expr, true)
            } else {
                out = ck_block_needs_value(out, arm.body, e.line)
            }
            i = i + 1
        }
        return out
    }
    -- A call that returns nothing. (One that is the whole value is
    -- reported where the value goes.)
    if inner and c.record and e.id >= 0 and e.id < c.types.len() {
        if c.types[e.id] == "void" and ck_diverges(e) == false {
            return ck_error(c, "this is used as a value, and it is a call that returns none", e.line)
        }
    }
    return c
}

-- ck_needs_value for the statements of a block
fn ck_block_needs_value(c: Checker, stmts: List[Stmt], line: int) -> Checker {
    if stmts.len() == 0 {
        return ck_error(c, "this block is used as a value, and it is empty", line)
    }
    let last = stmts[stmts.len() - 1]
    if stmt_gives_value(last) { return ck_needs_value(c, stmt_value_expr(last), true) }
    if ck_leaves(stmts) { return c }
    if last.kind == STMT_IF() {
        return ck_error(c, "this block is used as a value, and it ends in an 'if' that has no 'else' to give one", last.line)
    }
    return ck_error(c, "this block is used as a value, and it ends in a statement that gives none", last.line)
}

-- Whether the statements cannot reach their end: the last one
-- returns, or never ends, on every path
fn ck_always_returns(stmts: List[Stmt]) -> bool {
    if stmts.len() == 0 { return false }
    let s = stmts[stmts.len() - 1]
    let k = s.kind
    if k == STMT_RETURN() or k == STMT_LOOP() { return true }
    if k == STMT_IF() {
        return s.has_else_branch and ck_always_returns(s.if_then) and ck_always_returns(s.if_else)
    }
    if k == STMT_WHILE() {
        let cond = *s.while_cond
        if cond.kind == EXPR_LITERAL_BOOL() { return cond.bool_val }
        return cond.kind == EXPR_IDENTIFIER() and cond.name == "true"
    }
    if k == STMT_REGION() { return ck_always_returns(s.region_body) }
    if k == STMT_MATCH() { return ck_diverges(*s.match_expr) }
    if k == STMT_EXPRESSION() { return ck_diverges(*s.expr) }
    return false
}

-- Check a function's body. self_type is the type of the impl block it
-- is in, "" for a function; outer_generics are that block's type
-- parameters.
-- What type parameter `i` stands for in an instance; "?", any type,
-- where the function is checked for all its instances at once
fn ck_bound(binds: List[string], i: int) -> string {
    if i < binds.len() and binds[i] != "" { return binds[i] }
    return "?"
}

-- `binds` are what the type parameters stand for, the outer ones and
-- then the function's own, when one instance is checked (`instance`)
fn ck_function(c0: Checker, fd: FunctionDecl, self_type: string, outer_generics: List[string], binds: List[string], instance: bool) -> Checker {
    let mut c = c0
    let mut names: List[string] = []
    names.push("Self")
    let mut repls: List[string] = []
    repls.push(self_type)
    let mut gi = 0
    while gi < outer_generics.len() {
        names.push(outer_generics[gi])
        repls.push(ck_bound(binds, gi))
        gi = gi + 1
    }
    gi = 0
    while gi < fd.generic_params.len() {
        names.push(fd.generic_params[gi])
        repls.push(ck_bound(binds, outer_generics.len() + gi))
        gi = gi + 1
    }
    c.norm_names = names
    c.norm_repls = repls
    -- A generic function is compiled once for each set of type
    -- arguments, and a trait's own method once for each type that
    -- takes it: its expressions have no one type, until one instance
    -- is checked
    c.record = instance or (outer_generics.len() == 0 and fd.generic_params.len() == 0 and self_type != "?")
    let no_names: List[string] = []
    let no_types: List[string] = []
    let no_flags: List[int] = []
    c.var_names = no_names
    c.var_types = no_types
    c.var_flags = no_flags

    let mut i = 0
    while i < fd.params.len() {
        let p = fd.params[i]
        c = ck_type_exists(c, p.type_name, fd.line)
        let mut flag = 0
        if p.is_mut { flag = 1 }
        c = ck_bind(c, p.name, ck_norm(c, p.type_name), flag)
        i = i + 1
    }
    c = ck_type_exists(c, fd.return_type, fd.line)
    if instance == false {
        let mut bi = 0
        while bi < fd.generic_bounds.len() {
            if fd.generic_bounds[bi] != "" {
                let wanted = string_split(fd.generic_bounds[bi], "+")
                let mut wi = 0
                while wi < wanted.len() {
                    if c.traits.contains(wanted[wi]) == false {
                        c = ck_error(c, "undefined trait '" + wanted[wi] + "'", fd.line)
                    }
                    wi = wi + 1
                }
            }
            bi = bi + 1
        }
    }
    if fd.is_extern { return c }

    let ret = ck_norm(c, fd.return_type)
    c.ret_type = ret
    c.fn_name = fd.name
    c.fn_effects = fd.effects
    c = ck_stmts(c, fd.body)
    if ty_known(ret) and ret != "void" and fd.name != "main" and ck_always_returns(fd.body) == false {
        c = ck_error(c, "function '" + fd.name + "' can reach its end without returning a value of type " + ret, fd.line)
    }
    return c
}

fn ck_struct_decl(c0: Checker, sd: StructDecl) -> Checker {
    let mut c = c0
    c.norm_names = sd.generic_params
    let mut i = 0
    while i < sd.fields.len() {
        c = ck_type_exists(c, sd.fields[i].type_name, sd.line)
        i = i + 1
    }
    return c
}

fn ck_enum_decl(c0: Checker, ed: EnumDecl) -> Checker {
    let mut c = c0
    c.norm_names = ed.generic_params
    let mut i = 0
    while i < ed.variants.len() {
        let v = ed.variants[i]
        let mut j = 0
        while j < v.payload_types.len() {
            c = ck_type_exists(c, v.payload_types[j], ed.line)
            j = j + 1
        }
        i = i + 1
    }
    return c
}

fn ck_const_decl(c0: Checker, cd: ConstDecl) -> Checker {
    let mut c = c0
    let no_generics: List[string] = []
    c.norm_names = no_generics
    let no_repls: List[string] = []
    c.norm_repls = no_repls
    let no_names: List[string] = []
    c.var_names = no_names
    let no_types: List[string] = []
    c.var_types = no_types
    let no_flags: List[int] = []
    c.var_flags = no_flags
    c.record = true
    let value = *cd.value
    let found = ck_expr(c, value)
    c = found.c
    if cd.type_name == "" {
        c.consts.insert(cd.name, found.t)
        return c
    }
    c = ck_type_exists(c, cd.type_name, cd.line)
    let want = c.consts.get(cd.name)
    if ck_fits_value(c, want, found.t, value) == false {
        c = ck_error(c, "type mismatch in the value of '" + cd.name + "': expected " + want + ", found " + found.t, value.line)
    } else {
        c = ck_settle(c, value, want)
    }
    return c
}

fn ck_impl(c0: Checker, ib: ImplBlock) -> Checker {
    let mut c = c0
    -- Inside the block its type parameters stand for any type
    let self_type = ty_apply(ck_generic_type(ib.target_type, ib.generic_params), ib.generic_params, ty_unbound(0))
    let no_binds: List[string] = []
    let errors_before = c.errors.len()
    let mut i = 0
    while i < ib.methods.len() {
        c = ck_function(c, ib.methods[i], self_type, ib.generic_params, no_binds, false)
        i = i + 1
    }
    -- The methods of a `dyn Trait` are written by the compiler (TRAITS
    -- in main_split.dm): what is wrong in one is wrong in an impl of
    -- the trait, and is reported there
    if starts_with(ib.target_type, DYN_PREFIX()) {
        while c.errors.len() > errors_before {
            c.errors.pop()
        }
        return c
    }
    if ib.trait_name != "" { c = ck_impl_of_trait(c, ib) }
    return c
}

-- An impl of a trait is of a trait there is, and has each of the
-- trait's methods, with the parameters and the result the trait gives
-- it (a method the trait has a body for is in the impl already, see
-- TRAITS in main_split.dm)
fn ck_impl_of_trait(c0: Checker, ib: ImplBlock) -> Checker {
    let mut c = c0
    if c.traits.contains(ib.trait_name) == false {
        return ck_error(c, "undefined trait '" + ib.trait_name + "'", ib.line)
    }
    let shown = "the impl of '" + ib.trait_name + "' for '" + ib.target_type + "'"
    let names = string_split(c.traits.get(ib.trait_name), "|")
    let mut i = 0
    while i < names.len() {
        let name = names[i]
        i = i + 1
        if name == "" { continue }
        let mut found = -1
        let mut mi = 0
        while mi < ib.methods.len() {
            if ib.methods[mi].name == name { found = mi }
            mi = mi + 1
        }
        if found < 0 {
            c = ck_error(c, shown + " has no method '" + name + "', which the trait declares without a body", ib.line)
            continue
        }
        let line = ib.methods[found].line
        let want = c.fns.get(ib.trait_name + "_" + name)
        let have = c.fns.get(ib.target_type + "_" + name)
        if want.params.len() != have.params.len() or want.has_self != have.has_self {
            c = ck_error(c, "the method '" + name + "' of " + shown + " does not take the parameters the trait gives it", line)
            continue
        }
        let mut pi = 0
        if want.has_self { pi = 1 }
        while pi < want.params.len() {
            if ty_same(want.params[pi], have.params[pi]) == false {
                c = ck_error(c, "parameter " + int_to_string(pi + 1) + " of the method '" + name + "' of " + shown + " has the type " + have.params[pi] + ", and the trait gives it the type " + want.params[pi], line)
            } else if want.changes[pi] != have.changes[pi] {
                c = ck_error(c, "parameter " + int_to_string(pi + 1) + " of the method '" + name + "' of " + shown + " is 'mut' in one of the trait and the impl and not in the other", line)
            }
            pi = pi + 1
        }
        if want.has_self and want.changes.len() > 0 and have.changes.len() > 0 {
            if want.changes[0] != have.changes[0] {
                c = ck_error(c, "the method '" + name + "' of " + shown + " takes 'mut self' in one of the trait and the impl and 'self' in the other", line)
            }
        }
        if ty_same(want.ret, have.ret) == false {
            c = ck_error(c, "the method '" + name + "' of " + shown + " returns " + have.ret + ", and the trait says it returns " + want.ret, line)
        }
    }
    return c
}

fn ck_trait(c0: Checker, td: TraitDecl) -> Checker {
    let mut c = c0
    let no_binds: List[string] = []
    let mut i = 0
    while i < td.methods.len() {
        -- A method without a body is only a signature
        if td.methods[i].body.len() > 0 {
            c = ck_function(c, td.methods[i], "?", td.generic_params, no_binds, false)
        }
        i = i + 1
    }
    return c
}

-- The errors of the names and types of a program, which is the file
-- being compiled with the files it imports and the runtime; and the
-- type of each of its expressions
fn check_program(sf: SourceFile) -> Checked {
    -- Two lists: a copy of a list shares its storage
    let mut types: List[string] = []
    let mut type_args: List[string] = []
    let mut targets: List[string] = []
    let count = expr_id_count()
    let mut ti = 0
    while ti < count {
        types.push("")
        type_args.push("")
        targets.push("")
        ti = ti + 1
    }
    let mut c = Checker {
        files: sf.files,
        errors: [],
        fns: Map_new(),
        structs: Map_new(),
        enums: Map_new(),
        traits: Map_new(),
        type_traits: Map_new(),
        consts: Map_new(),
        var_names: [],
        var_types: [],
        var_flags: [],
        lambda_floor: 0,
        lambda_ret: "-",
        ret_type: "",
        awaited: -2,
        fn_name: "",
        fn_effects: [],
        norm_names: [],
        norm_repls: [],
        types: types,
        type_args: type_args,
        targets: targets,
        record: true
    }
    c = ck_collect(c, sf)
    -- Constants first: a function may use one declared after it
    let mut i = 0
    while i < sf.declarations.len() {
        let decl = sf.declarations[i]
        if decl.kind == DECL_CONST() {
            c = ck_const_decl(c, *decl.const_decl)
        }
        i = i + 1
    }
    let no_generics: List[string] = []
    i = 0
    while i < sf.declarations.len() {
        let decl = sf.declarations[i]
        if decl.kind == DECL_FUNCTION() {
            c = ck_function(c, *decl.func_decl, "", no_generics, no_generics, false)
        } else if decl.kind == DECL_IMPL() {
            c = ck_impl(c, *decl.impl_block)
        } else if decl.kind == DECL_TRAIT() {
            c = ck_trait(c, *decl.trait_decl)
        } else if decl.kind == DECL_STRUCT() {
            c = ck_struct_decl(c, *decl.struct_decl)
        } else if decl.kind == DECL_ENUM() {
            c = ck_enum_decl(c, *decl.enum_decl)
        }
        i = i + 1
    }
    return Checked { errors: c.errors, types: c.types, type_args: c.type_args, targets: c.targets, checker: Box_new(c) }
}

-- ============================================================
-- INSTANCES
-- The body of a generic function, and of a method of a generic struct
-- or enum, is checked above with its type parameters standing for any
-- type, and no types are recorded for its expressions. Code generation
-- makes one copy of the function for each set of type arguments, and
-- before it generates a copy it has the function checked again with
-- the type parameters standing for those arguments
-- (instance_types_begin). The types are recorded at the same
-- expression ids for every instance, so the ones that were there are
-- kept and put back when the instance is generated
-- (instance_types_end): an instance may be generated in the middle of
-- another of the same function.
-- ============================================================

-- Whether every name in the type is one the checker knows
fn ck_knows_type(c: Checker, t: string) -> bool {
    if t == "" or string_contains(t, "?") { return false }
    let n = len(t)
    let mut i = 0
    let mut in_size = false
    while i < n {
        let b = byte_at(t, i)
        if b == 59 { in_size = true }
        if b == 93 { in_size = false }
        if ty_ident_byte(b) == false {
            i = i + 1
            continue
        }
        let start = i
        while i < n and ty_ident_byte(byte_at(t, i)) {
            i = i + 1
        }
        if in_size or (b >= 48 and b <= 57) { continue }
        let word = substr(t, start, i - start)
        if ck_builtin_type_name(word) { continue }
        if c.structs.contains(word) or c.enums.contains(word) or c.traits.contains(word) { continue }
        return false
    }
    return true
}

-- Check one instance of the function: `binds` are what the type
-- parameters stand for (outer_generics, then the function's own), ""
-- for one that is not known. The lists of types grow to hold the
-- expressions made since the program was checked.
fn check_instance(c0: Checker, fd: FunctionDecl, self_type: string, outer_generics: List[string], binds: List[string]) -> Checker {
    let mut c = c0
    let count = expr_id_count()
    while c.types.len() < count {
        c.types.push("")
        c.type_args.push("")
        c.targets.push("")
    }
    let mut id = fd.expr_from
    while id < fd.expr_to and id < count {
        c.types[id] = ""
        c.type_args[id] = ""
        c.targets[id] = ""
        id = id + 1
    }
    return ck_function(c, fd, self_type, outer_generics, binds, true)
}

-- The checked types of a function's expressions as they were before
-- one of its instances was checked
struct InstanceTypes {
    gen: IRGenerator,
    active: bool,
    from: int,
    types: List[string],
    type_args: List[string],
    targets: List[string]
}

-- A type of code generation (canon_type: i64, Pair_i64_string) as the
-- checker writes it (int, Pair[int, string])
fn checker_type(gen: IRGenerator, t: string) -> string {
    if t == "i64" { return "int" }
    if t == "f64" { return "float" }
    if t == "String" { return "string" }
    let mut base = t
    let mut args: List[string] = []
    if gen.generic_instances.contains(t) {
        base = gen.generic_instances.get(t)
        args = string_split(gen.generic_instance_args.get(t), "|")
    } else {
        let bracket = string_find(t, "[")
        if bracket <= 0 or ends_with(t, "]") == false { return t }
        base = substr(t, 0, bracket)
        args = split_type_args(substr(t, bracket + 1, len(t) - bracket - 2))
    }
    let mut out = base + "["
    let mut i = 0
    while i < args.len() {
        if i > 0 { out = out + ", " }
        out = out + checker_type(gen, args[i])
        i = i + 1
    }
    return out + "]"
}

-- Check the instance of `fd` that is about to be generated. `binds`
-- are the type arguments as code generation has them, `self_type` the
-- type the method is of ("" for a function) and `what` names the
-- instance in an error. Give the result to instance_types_end when
-- the instance is generated.
fn instance_types_begin(gen: IRGenerator, fd: FunctionDecl, self_type: string, outer_generics: List[string], binds: List[string], what: string) -> InstanceTypes {
    let mut out = InstanceTypes { gen: gen, active: false, from: fd.expr_from, types: [], type_args: [], targets: [] }
    if gen.has_checker == false or fd.expr_to <= fd.expr_from { return out }
    let mut g = gen
    let mut c = *g.checker
    c.types = g.checked_types
    c.type_args = g.checked_type_args
    c.targets = g.checked_targets
    let no_errors: List[string] = []
    c.errors = no_errors

    let mut id = fd.expr_from
    while id < fd.expr_to {
        if id < g.checked_types.len() {
            out.types.push(g.checked_types[id])
            out.type_args.push(g.checked_type_args[id])
            out.targets.push(g.checked_targets[id])
        } else {
            out.types.push("")
            out.type_args.push("")
            out.targets.push("")
        }
        id = id + 1
    }

    -- A type argument code generation only guessed, or has in a form
    -- the checker does not know, stands for any type
    let mut known: List[string] = []
    let mut bi = 0
    while bi < binds.len() {
        let t = checker_type(g, binds[bi])
        if ck_knows_type(c, t) {
            known.push(t)
        } else {
            known.push("")
        }
        bi = bi + 1
    }
    let mut self_known = ""
    if self_type != "" {
        self_known = checker_type(g, self_type)
        if ck_knows_type(c, self_known) == false { self_known = "?" }
    }
    c = check_instance(c, fd, self_known, outer_generics, known)
    g.checked_types = c.types
    g.checked_type_args = c.type_args
    g.checked_targets = c.targets
    let mut ei = 0
    while ei < c.errors.len() {
        let text = c.errors[ei] + " (in " + what + ")"
        let mut have = false
        let mut hi = 0
        while hi < g.type_errors.len() {
            if g.type_errors[hi] == text { have = true }
            hi = hi + 1
        }
        if have == false { g.type_errors.push(text) }
        ei = ei + 1
    }
    out.gen = g
    out.active = true
    return out
}

-- Put back the types that were recorded before the instance was checked
fn instance_types_end(gen: IRGenerator, saved: InstanceTypes) -> IRGenerator {
    if saved.active == false { return gen }
    let mut g = gen
    let mut i = 0
    while i < saved.types.len() {
        let id = saved.from + i
        if id < g.checked_types.len() {
            g.checked_types[id] = saved.types[i]
            g.checked_type_args[id] = saved.type_args[i]
            g.checked_targets[id] = saved.targets[i]
        }
        i = i + 1
    }
    return g
}


-- ============================================================
-- LLVM IR Generator
-- Translates dAImond IR (from ir.dm) into LLVM IR using
-- the LLVM-C bridge functions declared in llvm.dm.
--
-- Key design: All LLVM refs (context, module, builder, types,
-- values, basic blocks) are represented as int (int64_t on C side).
--
-- String ABI: dm_string is { ptr, i64, i64 } (24 bytes). dAImond
-- functions, the runtime's included, take strings by value and return
-- them through a pointer the caller passes first (sret). A C function
-- declared with `extern fn` takes and returns char*.
-- ============================================================

-- ============================================================
-- LLVM GENERATOR STRUCT
-- ============================================================

struct LLVMGenerator {
    context: int,
    llvm_module: int,
    builder: int,
    -- Maps
    value_map: Map[string, int],
    function_map: Map[string, int],
    fn_type_map: Map[string, int],
    block_map: Map[string, int],
    struct_type_map: Map[string, int],
    global_var_map: Map[string, int],
    -- String handling
    dm_string_type: int,
    has_dm_string_type: bool,
    string_counter: int,
    sret_counter: int,
    -- Track which instruction IDs are string pointers
    string_ptrs: Map[string, bool],
    -- Track wrapper functions for string ABI
    wrapper_returns_string: Map[string, bool],
    -- Track which functions have wrappers
    has_wrapper: Map[string, bool],
    -- Track which functions use sret return convention (result/option types)
    returns_sret: Map[string, bool],
    -- The LLVM function of each C symbol declared so far. Extern
    -- functions bound to the same symbol share it; each keeps its own
    -- function type in fn_type_map.
    c_symbols: Map[string, int],
    -- Every C symbol the module's extern declarations name. A dAImond
    -- function of the same name gets another symbol (see dm_symbol_of).
    c_symbol_names: Map[string, bool],
    -- The LLVM global of each data symbol declared so far: main's
    -- argument count and vector, and the symbols symbol_addr names
    data_symbols: Map[string, int],
    -- The size in bytes of each block of storage static_addr names
    static_sizes: Map[string, int],
    -- Runtime functions written in dAImond: "dm_X" is here when the
    -- program defines rt_X, which then stands in for the C function
    rt_ports: Map[string, bool],
    -- The blocks of the function being generated that report a failed
    -- runtime check and exit, by message
    panic_blocks: Map[string, int],
    -- Reference to IR module for type lookups
    ir_module: IRModule,
    -- Current function being generated (for param lookups)
    current_func_name: string,
    -- Source line of the IR instruction being lowered (0 if unknown)
    current_line: int,
    -- Debug info (see DEBUG INFO). Whether to write it, and whether
    -- the program is being optimized, are set before
    -- lg_generate_module.
    debug_info: bool,
    debug_optimized: bool,
    -- The builder of debug info, 0 when none is written
    di_builder: int,
    -- The debug info's file of each of the program's files, at its
    -- number; 0 for one that is no file
    di_files: List[int],
    -- The function being generated, in debug info (0 when it has
    -- none), and the number of the file it is in
    di_scope: int,
    di_file: int,
    -- The line that function is declared at, and whether one of its
    -- instructions has been given a line yet
    di_function_line: int,
    di_located: bool,
    -- The debug info's type of each dAImond type met so far, by name
    di_types: Map[string, int],
    -- Call argument type mismatches found while lowering; reported as
    -- compile errors instead of handing invalid IR to the LLVM verifier
    type_errors: List[string]
}

-- ============================================================
-- CONSTRUCTOR / DESTRUCTOR
-- ============================================================

fn llvm_gen_new(ir_mod: IRModule, module_name: string) -> LLVMGenerator {
    unsafe {
        let ctx = dm_llvm_context_create()
        let mod = dm_llvm_module_create(ctx, module_name)
        let bld = dm_llvm_create_builder(ctx)
        return LLVMGenerator {
            context: ctx,
            llvm_module: mod,
            builder: bld,
            value_map: Map_new(),
            function_map: Map_new(),
            fn_type_map: Map_new(),
            block_map: Map_new(),
            struct_type_map: Map_new(),
            global_var_map: Map_new(),
            dm_string_type: 0,
            has_dm_string_type: false,
            string_counter: 0,
            sret_counter: 0,
            string_ptrs: Map_new(),
            wrapper_returns_string: Map_new(),
            has_wrapper: Map_new(),
            returns_sret: Map_new(),
            c_symbols: Map_new(),
            c_symbol_names: Map_new(),
            data_symbols: Map_new(),
            static_sizes: Map_new(),
            rt_ports: Map_new(),
            panic_blocks: Map_new(),
            ir_module: ir_mod,
            current_func_name: "",
            current_line: 0,
            debug_info: false,
            debug_optimized: false,
            di_builder: 0,
            di_files: [],
            di_scope: 0,
            di_file: 0,
            di_function_line: 0,
            di_located: false,
            di_types: Map_new(),
            type_errors: []
        }
    }
}

fn llvm_gen_dispose(gen: LLVMGenerator) {
    unsafe {
        dm_llvm_dispose_builder(gen.builder)
        dm_llvm_module_dispose(gen.llvm_module)
        dm_llvm_context_dispose(gen.context)
    }
}

-- ============================================================
-- DM_STRING TYPE
-- ============================================================

fn get_dm_string_type(gen: LLVMGenerator) -> LLVMGenerator {
    unsafe {
        let mut g = gen
        if g.has_dm_string_type {
            return g
        }
        let ctx = g.context
        let str_ty = dm_llvm_struct_create_named(ctx, "dm_string")
        -- Body: { ptr (data), i64 (len), i64 (capacity) }
        dm_llvm_buf_clear()
        dm_llvm_buf_push(dm_llvm_pointer_type(ctx))
        dm_llvm_buf_push(dm_llvm_int64_type(ctx))
        dm_llvm_buf_push(dm_llvm_int64_type(ctx))
        dm_llvm_struct_set_body_buf(str_ty, 0)
        g.dm_string_type = str_ty
        g.has_dm_string_type = true
        return g
    }
}

-- ============================================================
-- TYPE MAPPING
-- ============================================================

-- Check if a type name represents a float type
fn lg_is_float_type(type_name: string) -> bool {
    return type_name == "f32" or type_name == "f64"
}

-- Check if a type name represents an integer type
fn llvm_type_name(ty: int) -> string {
    unsafe {
        -- Named structs print as %Name rather than their full body
        if dm_llvm_get_type_kind(ty) == 10 {
            let sname = dm_llvm_get_struct_name(ty)
            if sname != "" { return "%" + sname }
        }
        let ptr = dm_llvm_print_type_to_string(ty)
        let name = dm_llvm_c_str_to_string(ptr)
        dm_llvm_free_c_string(ptr)
        return name
    }
}

-- " (in function 'f') at line N" for errors found while lowering an instruction.
fn type_error_location(g: LLVMGenerator) -> string {
    let mut loc = " (in function '" + g.current_func_name + "')"
    if g.current_line > 0 { loc = loc + " at line " + int_to_string(line_in_file(g.current_line)) }
    return loc
}

-- The text of an error found while lowering an instruction, which
-- names the file when it is not the one being compiled
fn lg_error(g: LLVMGenerator, msg: string) -> string {
    return file_prefix(g.ir_module.files, g.current_line) + "Error: " + msg + type_error_location(g)
}

-- Check the arguments in the call buffer against fn_ty's parameter types.
-- Call this right before dm_llvm_build_call2_buf. A mismatch means IR
-- generation could not type an expression; it becomes a compile error
-- at the source line instead of invalid IR for the LLVM verifier.
fn check_call_args(gen: LLVMGenerator, fn_ty: int, callee: int) -> LLVMGenerator {
    unsafe {
        let mut g = gen
        let nparams = dm_llvm_count_param_types(fn_ty)
        let nargs = dm_llvm_buf_len()
        let mut callee_name = dm_llvm_get_value_name(callee)
        if callee_name == "" { callee_name = "<function pointer>" }
        let var_arg = dm_llvm_is_function_var_arg(fn_ty) != 0
        if nargs < nparams or (nargs > nparams and var_arg == false) {
            g.type_errors.push(lg_error(g, "call to '" + callee_name + "' passes " + int_to_string(nargs) + " arguments, expected " + int_to_string(nparams)))
            return g
        }
        let mut i = 0
        while i < nparams {
            let want = dm_llvm_param_type_at(fn_ty, i)
            let got = dm_llvm_type_of(dm_llvm_buf_get(i))
            if got != want {
                g.type_errors.push(lg_error(g, "call to '" + callee_name + "' argument " + int_to_string(i + 1) + " has type " + llvm_type_name(got) + ", expected " + llvm_type_name(want)))
            }
            i = i + 1
        }
        return g
    }
}

fn is_list_ir_type(type_name: string) -> bool {
    return starts_with(type_name, "List[") or starts_with(type_name, "dm_list_")
}

fn is_int_type(type_name: string) -> bool {
    if type_name == "i8" { return true }
    if type_name == "i16" { return true }
    if type_name == "i32" { return true }
    if type_name == "i64" { return true }
    if type_name == "u8" { return true }
    if type_name == "u16" { return true }
    if type_name == "u32" { return true }
    if type_name == "u64" { return true }
    return false
}

-- Check if a type name represents an unsigned integer type
fn lg_is_unsigned_type(type_name: string) -> bool {
    if type_name == "u8" { return true }
    if type_name == "u16" { return true }
    if type_name == "u32" { return true }
    if type_name == "u64" { return true }
    return false
}

-- Check if a type is a SIMD vector type
fn lg_is_simd_type(type_name: string) -> bool {
    if type_name == "f32x4" { return true }
    if type_name == "f32x8" { return true }
    if type_name == "f64x2" { return true }
    if type_name == "f64x4" { return true }
    if type_name == "i32x4" { return true }
    if type_name == "i32x8" { return true }
    if type_name == "i64x2" { return true }
    if type_name == "i64x4" { return true }
    return false
}

-- Map IR type name string to LLVM type ref
fn map_ir_type_to_llvm(gen: LLVMGenerator, type_name: string) -> int {
    unsafe {
        let ctx = gen.context
        if type_name == "i8" { return dm_llvm_int8_type(ctx) }
        if type_name == "i16" { return dm_llvm_int16_type(ctx) }
        if type_name == "i32" { return dm_llvm_int32_type(ctx) }
        if type_name == "i64" { return dm_llvm_int64_type(ctx) }
        -- The source names of i64 and f64, which reach here inside
        -- Option[...] and Result[...] taken from a function's signature
        if type_name == "int" { return dm_llvm_int64_type(ctx) }
        if type_name == "float" { return dm_llvm_double_type(ctx) }
        -- Unsigned types map to same LLVM int types (signedness is in instructions, not types)
        if type_name == "u8" { return dm_llvm_int8_type(ctx) }
        if type_name == "u16" { return dm_llvm_int16_type(ctx) }
        if type_name == "u32" { return dm_llvm_int32_type(ctx) }
        if type_name == "u64" { return dm_llvm_int64_type(ctx) }
        if type_name == "f32" { return dm_llvm_float_type(ctx) }
        if type_name == "f64" { return dm_llvm_double_type(ctx) }
        if type_name == "bool" { return dm_llvm_int1_type(ctx) }
        if type_name == "void" { return dm_llvm_void_type(ctx) }
        if type_name == "string" { return gen.dm_string_type }
        if type_name == "ptr" { return dm_llvm_pointer_type(ctx) }
        -- A function type that reached here by its source name: a
        -- function value is the address of its closure
        if starts_with(type_name, "fn(") { return dm_llvm_pointer_type(ctx) }
        -- Pointer types: ptr(...)
        if starts_with(type_name, "ptr(") { return dm_llvm_pointer_type(ctx) }
        -- Box types are heap pointers
        if starts_with(type_name, "Box[") { return dm_llvm_pointer_type(ctx) }
        -- List types: use dm_string type {ptr, i64, i64} since lists share the same layout
        if starts_with(type_name, "dm_list_") or starts_with(type_name, "list") or type_name == "list" or starts_with(type_name, "List[") {
            if gen.has_dm_string_type { return gen.dm_string_type }
            return dm_llvm_pointer_type(ctx)
        }
        -- Result type: { i32 tag, ok_type, err_type }
        -- Parse inner types from Result[T, E] for correct LLVM struct layout
        if type_name == "result" or starts_with(type_name, "Result[") or starts_with(type_name, "result_") {
            let i32_ty = dm_llvm_int32_type(ctx)
            let mut ok_ty = dm_llvm_int64_type(ctx)
            let mut err_ty = dm_llvm_int64_type(ctx)
            if starts_with(type_name, "Result[") {
                -- Parse Result[T, E] -> extract T and E
                let inner = substr(type_name, 7, len(type_name) - 8)
                -- Find comma separating T and E, respecting nested brackets
                let mut comma_pos = 0 - 1
                let mut depth = 0
                let mut ci = 0
                while ci < len(inner) {
                    let ch = char_at(inner, ci)
                    if ch == "[" { depth = depth + 1 }
                    if ch == "]" { depth = depth - 1 }
                    if ch == "," and depth == 0 {
                        comma_pos = ci
                        ci = len(inner)
                    }
                    ci = ci + 1
                }
                if comma_pos >= 0 {
                    let ok_str = substr(inner, 0, comma_pos)
                    let mut err_start = comma_pos + 1
                    if err_start < len(inner) and char_at(inner, err_start) == " " {
                        err_start = err_start + 1
                    }
                    let err_str = substr(inner, err_start, len(inner) - err_start)
                    ok_ty = map_ir_type_to_llvm(gen, ok_str)
                    err_ty = map_ir_type_to_llvm(gen, err_str)
                }
            }
            dm_llvm_buf_clear()
            dm_llvm_buf_push(i32_ty)
            dm_llvm_buf_push(ok_ty)
            dm_llvm_buf_push(err_ty)
            return dm_llvm_struct_type_buf(ctx, 3, 0)
        }
        -- Option type: { i32 has_value, inner_type }
        -- Parse inner type from Option[T] for correct LLVM struct layout
        if type_name == "option" or starts_with(type_name, "Option[") or starts_with(type_name, "option_") {
            let i32_ty = dm_llvm_int32_type(ctx)
            let mut inner_ty = dm_llvm_int64_type(ctx)
            if starts_with(type_name, "Option[") {
                let inner = substr(type_name, 7, len(type_name) - 8)
                inner_ty = map_ir_type_to_llvm(gen, inner)
            }
            dm_llvm_buf_clear()
            dm_llvm_buf_push(i32_ty)
            dm_llvm_buf_push(inner_ty)
            return dm_llvm_struct_type_buf(ctx, 2, 0)
        }
        -- SIMD vector types
        if lg_is_simd_type(type_name) {
            return get_simd_llvm_type(gen, type_name)
        }
        -- Struct types: look up in struct_type_map
        if gen.struct_type_map.contains(type_name) {
            return gen.struct_type_map.get(type_name)
        }
        -- Struct names prefixed with "struct "
        if starts_with(type_name, "struct ") {
            let sname = substr(type_name, 7, len(type_name) - 7)
            if gen.struct_type_map.contains(sname) {
                return gen.struct_type_map.get(sname)
            }
        }
        -- Fallback: i64 (default integer type)
        return dm_llvm_int64_type(ctx)
    }
}

-- ============================================================
-- STRUCT TYPE DECLARATION
-- ============================================================

fn register_builtin_struct_types(gen: LLVMGenerator) -> LLVMGenerator {
    unsafe {
        let mut g = gen
        let ctx = g.context

        -- Register Result type: { i64 tag, i64 ok_val, i64 err_val }
        -- All fields are i64 for uniform insertvalue/extractvalue (avoids i32/i64 mismatch)
        if g.struct_type_map.contains("result") == false {
            let result_struct = dm_llvm_struct_create_named(ctx, "result")
            dm_llvm_buf_clear()
            dm_llvm_buf_push(dm_llvm_int64_type(ctx))
            dm_llvm_buf_push(dm_llvm_int64_type(ctx))
            dm_llvm_buf_push(dm_llvm_int64_type(ctx))
            dm_llvm_struct_set_body_buf(result_struct, 0)
            g.struct_type_map.insert("result", result_struct)
            g.struct_type_map.insert("Result", result_struct)
        }

        -- Register Option type: { i64 has_value, i64 value }
        if g.struct_type_map.contains("option") == false {
            let option_struct = dm_llvm_struct_create_named(ctx, "option")
            dm_llvm_buf_clear()
            dm_llvm_buf_push(dm_llvm_int64_type(ctx))
            dm_llvm_buf_push(dm_llvm_int64_type(ctx))
            dm_llvm_struct_set_body_buf(option_struct, 0)
            g.struct_type_map.insert("option", option_struct)
            g.struct_type_map.insert("Option", option_struct)
        }

        -- Register list and map runtime struct types: { ptr, i64, i64 }
        -- All list types share one LLVM named struct, same for all map types.
        -- This avoids type mismatches when list values move between contexts.
        let list_struct = dm_llvm_struct_create_named(ctx, "dm_list")
        dm_llvm_buf_clear()
        dm_llvm_buf_push(dm_llvm_pointer_type(ctx))
        dm_llvm_buf_push(dm_llvm_int64_type(ctx))
        dm_llvm_buf_push(dm_llvm_int64_type(ctx))
        dm_llvm_struct_set_body_buf(list_struct, 0)
        g.struct_type_map.insert("dm_list", list_struct)
        g.struct_type_map.insert("dm_list_int64", list_struct)
        g.struct_type_map.insert("dm_list_double", list_struct)
        g.struct_type_map.insert("dm_list_dm_string", list_struct)
        g.struct_type_map.insert("dm_list_generic", list_struct)
        g.struct_type_map.insert("list", list_struct)

        return g
    }
}

fn declare_struct_types(gen: LLVMGenerator) -> LLVMGenerator {
    unsafe {
        let mut g = gen
        let ctx = g.context
        -- Phase 1: Create opaque named struct types (forward declarations)
        let struct_keys = g.ir_module.struct_defs.keys()
        let mut i = 0
        while i < struct_keys.len() {
            let name = struct_keys[i]
            let ir_ty = g.ir_module.struct_defs.get(name)
            if ir_ty.kind == IR_TYPE_STRUCT() {
                let sname = ir_ty.name
                if sname != "" {
                    let llvm_struct = dm_llvm_struct_create_named(ctx, sname)
                    g.struct_type_map.insert(sname, llvm_struct)
                }
            }
            i = i + 1
        }
        -- Phase 2: Set struct bodies (all types now registered)
        i = 0
        while i < struct_keys.len() {
            let name = struct_keys[i]
            let ir_ty = g.ir_module.struct_defs.get(name)
            if ir_ty.kind == IR_TYPE_STRUCT() {
                let sname = ir_ty.name
                if sname != "" and g.struct_type_map.contains(sname) {
                    let llvm_struct = g.struct_type_map.get(sname)
                    -- Collect field types into list first (avoid buffer clobbering)
                    let mut field_types: List[int] = []
                    let mut fi = 0
                    while fi < ir_ty.fields.len() {
                        let field = ir_ty.fields[fi]
                        field_types.push(map_ir_type_to_llvm(g, field.type_id))
                        fi = fi + 1
                    }
                    -- A struct without fields has a body too, an empty
                    -- one: a type without a body has no size
                    dm_llvm_buf_clear()
                    fi = 0
                    while fi < field_types.len() {
                        dm_llvm_buf_push(field_types[fi])
                        fi = fi + 1
                    }
                    dm_llvm_struct_set_body_buf(llvm_struct, 0)
                }
            }
            i = i + 1
        }
        return g
    }
}

-- ============================================================
-- GLOBAL VARIABLES
-- ============================================================

fn generate_globals(gen: LLVMGenerator) -> LLVMGenerator {
    unsafe {
        let mut g = gen
        let mut i = 0
        while i < g.ir_module.globals.len() {
            let global = g.ir_module.globals[i]
            -- Skip comptime bookkeeping globals (array elements, markers)
            if starts_with(global.name, "__ct_arr_") {
                i = i + 1
                continue
            }
            -- Skip string-type globals (they are resolved inline by generate_identifier)
            if global.has_init and global.init_value.kind == VAL_CONST_STRING() {
                i = i + 1
                continue
            }
            let llvm_ty = map_ir_type_to_llvm(g, global.type_id)
            let gvar = dm_llvm_module_add_global(g.llvm_module, llvm_ty, global.name)
            -- Set initializer
            if global.has_init {
                let init = global.init_value
                if init.kind == VAL_CONST_INT() {
                    dm_llvm_set_initializer(gvar, dm_llvm_const_int(llvm_ty, init.int_val, 1))
                } else if init.kind == VAL_CONST_FLOAT() {
                    dm_llvm_set_initializer(gvar, dm_llvm_const_real(llvm_ty, init.float_val))
                } else if init.kind == VAL_CONST_BOOL() {
                    let mut bval = 0
                    if init.bool_val { bval = 1 }
                    dm_llvm_set_initializer(gvar, dm_llvm_const_int(llvm_ty, bval, 0))
                } else {
                    dm_llvm_set_initializer(gvar, dm_llvm_const_null(llvm_ty))
                }
            } else {
                dm_llvm_set_initializer(gvar, dm_llvm_const_null(llvm_ty))
            }
            if global.is_const {
                dm_llvm_set_global_constant(gvar, 1)
            }
            g.global_var_map.insert(global.name, gvar)
            i = i + 1
        }
        return g
    }
}

-- ============================================================
-- FUNCTION DECLARATION
-- ============================================================

-- Check if a return type needs sret (struct return) convention.
-- Result ({i32, i64, i64} = 20 bytes) and Option ({i32, i64} = 12 bytes)
-- are too large for register return on x86_64 and cause LLVM errors.
-- ============================================================
-- RUNTIME FUNCTIONS
-- The IR names a runtime function dm_X. It is one of two things:
--   inline: lowered to instructions here, with no function behind it
--     (is_inline_runtime_fn): len(s), the integer overflow and
--     range checks, xs.len() and the creation of an empty list;
--   the dAImond function rt_X, which stage5/runtime/*.dm defines
--     with the same signature and which is called like any other
--     dAImond function (strings by value, result through sret).
--     Where dm_X is declared with a pointer, rt_X takes an int, the
--     address.
-- A dm_X with neither is called as the C function llvm_dm_X, taking
-- strings by pointer, as every runtime function once was. None is
-- left, so such a call fails to link: write rt_X.
-- ============================================================

fn is_inline_runtime_fn(name: string) -> bool {
    return name == "dm_string_len" or overflow_intrinsic_of(name) != "" or is_range_check_fn(name) or is_list_len_fn(name) or is_list_new_fn(name)
}

-- Every list is { data, len, capacity }, whatever its elements are
fn is_list_len_fn(name: string) -> bool {
    return name == "dm_list_int64_len" or name == "dm_list_double_len" or name == "dm_list_string_len" or name == "dm_list_generic_len"
}

fn is_list_new_fn(name: string) -> bool {
    return name == "dm_list_int64_new" or name == "dm_list_double_new" or name == "dm_list_string_new" or name == "dm_list_generic_new"
}

-- Declare the data symbol `symbol` as a variable of type `ty`, unless
-- it is declared already; afterwards gen.data_symbols.get(symbol) is
-- its LLVM global. It is defined elsewhere unless it is later given
-- an initializer.
fn declare_data_symbol(gen: LLVMGenerator, symbol: string, ty: int) -> LLVMGenerator {
    unsafe {
        let mut g = gen
        if g.data_symbols.contains(symbol) == false {
            let global = dm_llvm_module_add_global(g.llvm_module, ty, symbol)
            dm_llvm_set_linkage(global, dm_llvm_external_linkage())
            g.data_symbols.insert(symbol, global)
        }
        return g
    }
}

-- The symbol of the storage static_addr("name", ...) names. No C
-- symbol has a "." in its name.
fn static_symbol(name: string) -> string {
    return "dm_static." + name
}

-- Define the storage static_addr(name, size) names, unless it is
-- defined already; afterwards gen.data_symbols.get(static_symbol(name))
-- is its LLVM global. It is an array of 8-byte words, so that it is
-- aligned for any load or store, and it starts as zeros. Its linkage
-- is weak: the program and the precompiled runtime object may each
-- define a name, and the linker keeps one.
fn define_static_storage(gen: LLVMGenerator, name: string, size: int) -> LLVMGenerator {
    unsafe {
        let mut g = gen
        if g.static_sizes.contains(name) {
            if g.static_sizes.get(name) != size {
                g.type_errors.push(lg_error(g, "static_addr(\"" + name + "\") has the size " + int_to_string(size) + " here and " + int_to_string(g.static_sizes.get(name)) + " elsewhere"))
            }
            return g
        }
        let words = dm_llvm_array_type(dm_llvm_int64_type(g.context), (size + 7) / 8)
        let global = dm_llvm_module_add_global(g.llvm_module, words, static_symbol(name))
        dm_llvm_set_initializer(global, dm_llvm_const_null(words))
        dm_llvm_set_linkage(global, dm_llvm_weak_linkage())
        g.data_symbols.insert(static_symbol(name), global)
        g.static_sizes.insert(name, size)
        return g
    }
}

-- Declare dm_argc and dm_argv, where main keeps its argument count and
-- vector for the runtime's args_len and args_get. The module that has
-- main defines them.
fn declare_main_args(gen: LLVMGenerator) -> LLVMGenerator {
    unsafe {
        let mut g = declare_data_symbol(gen, "dm_argc", dm_llvm_int32_type(gen.context))
        g = declare_data_symbol(g, "dm_argv", dm_llvm_pointer_type(gen.context))
        return g
    }
}

-- Whether rt_X may stand in for a parameter or return of type
-- `declared`: with the same type, or with an int where dm_X has a pointer
fn port_type_matches(declared: string, ported: string) -> bool {
    return declared == ported or (declared == "ptr" and ported == "i64")
}

-- Record which dm_X functions the module defines as rt_X
fn find_runtime_ports(gen: LLVMGenerator) -> LLVMGenerator {
    let mut g = gen
    let mut i = 0
    while i < g.ir_module.functions.len() {
        let f = g.ir_module.functions[i]
        if f.is_extern == false and starts_with(f.name, "rt_") {
            g.rt_ports.insert("dm_" + substr(f.name, 3, len(f.name) - 3), true)
        }
        i = i + 1
    }
    return g
}

-- After rt_X is declared: calls to dm_X go to it. Its signature must
-- be the one the IR generator calls dm_X with.
fn bind_runtime_port(gen: LLVMGenerator, func: IRFunction) -> LLVMGenerator {
    let mut g = gen
    let c_name = "dm_" + substr(func.name, 3, len(func.name) - 3)
    if g.rt_ports.contains(c_name) == false { return g }
    let mut decl = ir_function_new("", "void")
    let mut found = false
    let mut i = 0
    while i < g.ir_module.functions.len() {
        if g.ir_module.functions[i].name == c_name and g.ir_module.functions[i].is_extern {
            decl = g.ir_module.functions[i]
            found = true
        }
        i = i + 1
    }
    -- No such runtime function: rt_X is a helper of the runtime's own
    if found == false { return g }
    let mut same = decl.return_type == func.return_type and decl.params.len() == func.params.len()
    i = 0
    while same and i < decl.params.len() {
        if port_type_matches(decl.params[i].type_id, func.params[i].type_id) == false { same = false }
        i = i + 1
    }
    if same == false {
        g.type_errors.push("Error: runtime function '" + func.name + "' does not have the signature the compiler calls '" + c_name + "' with")
        return g
    }
    g.function_map.insert(c_name, g.function_map.get(func.name))
    g.fn_type_map.insert(c_name, g.fn_type_map.get(func.name))
    if g.returns_sret.contains(func.name) {
        g.returns_sret.insert(c_name, true)
    }
    return g
}

-- Fill the string at `dst` with { data, len, 0 }: a string that does
-- not own its bytes, such as a literal
fn store_borrowed_string(gen: LLVMGenerator, dst: int, data: int, str_len: int) {
    unsafe {
        let b = gen.builder
        let i64_ty = dm_llvm_int64_type(gen.context)
        dm_llvm_build_store(b, data, dm_llvm_build_struct_gep2(b, gen.dm_string_type, dst, 0, "str.data"))
        dm_llvm_build_store(b, str_len, dm_llvm_build_struct_gep2(b, gen.dm_string_type, dst, 1, "str.len"))
        dm_llvm_build_store(b, dm_llvm_const_int(i64_ty, 0, 0), dm_llvm_build_struct_gep2(b, gen.dm_string_type, dst, 2, "str.cap"))
    }
}

-- The length of string literal `val` as an LLVM constant. LLVM stores
-- the literal as a C string, so its length is strlen's.
fn literal_len_const(gen: LLVMGenerator, val: IRValue) -> int {
    unsafe {
        return dm_llvm_const_int(dm_llvm_int64_type(gen.context), strlen(val.str_val) as int, 0)
    }
}

-- The C symbol an extern function names
fn c_symbol_of(func: IRFunction) -> string {
    if func.link_name != "" { return func.link_name }
    return func.name
}

-- Record the C symbols the module's extern declarations name, and
-- strlen, which the compiler declares for itself
fn find_c_symbol_names(gen: LLVMGenerator) -> LLVMGenerator {
    let mut g = gen
    g.c_symbol_names.insert("strlen", true)
    let mut i = 0
    while i < g.ir_module.functions.len() {
        let f = g.ir_module.functions[i]
        if f.is_extern {
            g.c_symbol_names.insert(c_symbol_of(f), true)
        }
        i = i + 1
    }
    return g
}

-- The symbol of dAImond function `func`: its name, unless the module
-- also declares a C function of that name. A program may define a
-- function named `rename` or `free`; the runtime's calls of the C
-- functions must still reach C. No C symbol has a "." in its name.
fn dm_symbol_of(gen: LLVMGenerator, func: IRFunction) -> string {
    if func.name != "main" and gen.c_symbol_names.contains(func.name) {
        return func.name + ".dm"
    }
    return func.name
}

-- Declare C symbol `symbol` with type `fn_ty` unless it already is;
-- afterwards gen.c_symbols.get(symbol) is its LLVM function. A later
-- declaration with another type calls the same function with its own type.
fn declare_c_symbol(gen: LLVMGenerator, symbol: string, fn_ty: int) -> LLVMGenerator {
    unsafe {
        let mut g = gen
        if g.c_symbols.contains(symbol) == false {
            g.c_symbols.insert(symbol, dm_llvm_module_add_function(g.llvm_module, symbol, fn_ty))
        }
        return g
    }
}

fn func_needs_wrapper(func: IRFunction) -> bool {
    if func.is_extern == false { return false }
    if func.return_type == "string" { return true }
    let mut i = 0
    while i < func.params.len() {
        if func.params[i].type_id == "string" { return true }
        i = i + 1
    }
    return false
}

fn declare_wrapper(gen: LLVMGenerator, func: IRFunction) -> LLVMGenerator {
    unsafe {
        let mut g = gen
        let ctx = g.context
        let returns_string = func.return_type == "string"
        let ptr_ty = dm_llvm_pointer_type(ctx)
        let void_ty = dm_llvm_void_type(ctx)
        -- Compute return type BEFORE using buffer (map_ir_type_to_llvm may use buffer internally)
        let mut ret_ty = 0
        if returns_string {
            ret_ty = void_ty
        } else {
            ret_ty = map_ir_type_to_llvm(g, func.return_type)
        }
        -- Collect param types into a list first (avoid buffer clobbering)
        let mut param_types: List[int] = []
        if returns_string {
            param_types.push(ptr_ty)
        }
        let mut i = 0
        while i < func.params.len() {
            let p = func.params[i]
            if p.type_id == "string" {
                param_types.push(ptr_ty)
            } else {
                param_types.push(map_ir_type_to_llvm(g, p.type_id))
            }
            i = i + 1
        }
        -- Push all to shared buffer at once and create function type
        dm_llvm_buf_clear()
        i = 0
        while i < param_types.len() {
            dm_llvm_buf_push(param_types[i])
            i = i + 1
        }
        let fn_ty = dm_llvm_function_type_buf(ret_ty, 0)
        -- Wrapper name: "llvm_" + original name
        let wrapper_name = "llvm_" + func.name
        let llvm_fn = dm_llvm_module_add_function(g.llvm_module, wrapper_name, fn_ty)
        -- Store under ORIGINAL name for call resolution
        g.function_map.insert(func.name, llvm_fn)
        g.fn_type_map.insert(func.name, fn_ty)
        g.has_wrapper.insert(func.name, true)
        g.wrapper_returns_string.insert(func.name, returns_string)
        return g
    }
}

-- Declare and generate a wrapper for a user-declared extern function that uses dm_string.
-- For `extern fn getenv(name: string) -> string`:
-- 1. Declare the real C function `getenv` as `ptr getenv(ptr)`
-- 2. Generate a wrapper `llvm_getenv` that converts dm_string <-> char*

-- ============================================================
-- DEBUG INFO
-- With -g the program carries debug info (DWARF): its files, each
-- function's place, and the line of each instruction, which is what a
-- debugger needs to set breakpoints by file and line, step by lines
-- and print a backtrace; and each variable's name, type and storage
-- (OP_DEBUG_VAR), which is what it needs to print one. A function's
-- variables are all in one scope, so of two with one name a debugger
-- shows either.
--
-- A function has debug info when it is declared in a file. The
-- runtime's functions and those the compiler makes have none, so a
-- debugger steps over them.
-- ============================================================

-- Start the module's debug info: its files and its compile unit
fn di_begin(gen: LLVMGenerator) -> LLVMGenerator {
    unsafe {
        let mut g = gen
        let files = g.ir_module.files
        if files.len() == 0 or is_file_name(files[0]) == false { return g }
        -- The sizes of types come from the module's data layout
        let tm = set_module_target(g, 0)
        if tm == 0 { return g }
        dm_llvm_dispose_target_machine(tm)
        g.di_builder = dm_llvm_di_builder_create(g.llvm_module)
        -- A debugger finds a file by its name in the directory the
        -- compiler ran in
        let directory = env_get("PWD")
        let mut i = 0
        while i < files.len() {
            let mut file = 0
            if is_file_name(files[i]) {
                if starts_with(files[i], "/") {
                    file = dm_llvm_di_file(g.di_builder, files[i], "")
                } else {
                    file = dm_llvm_di_file(g.di_builder, files[i], directory)
                }
            }
            g.di_files.push(file)
            i = i + 1
        }
        let mut optimized = 0
        if g.debug_optimized { optimized = 1 }
        dm_llvm_di_compile_unit(g.di_builder, g.di_files[0], "daimond", optimized)
        return g
    }
}

-- Give the function being generated its debug info, when it is
-- declared in a file, and make it the scope of the lines that follow
fn di_enter_function(gen: LLVMGenerator, func: IRFunction, llvm_fn: int) -> LLVMGenerator {
    unsafe {
        let mut g = gen
        g.di_scope = 0
        if g.di_builder == 0 { return g }
        -- The instructions before the function's first line have no place
        dm_llvm_set_debug_location(g.builder, g.context, 0, 0, 0)
        let file = file_of_line(func.source_line)
        if func.source_line <= 0 or file >= g.di_files.len() { return g }
        if g.di_files[file] == 0 { return g }
        let mut optimized = 0
        if g.debug_optimized { optimized = 1 }
        g.di_file = file
        g.di_function_line = func.source_line
        g.di_located = false
        g.di_scope = dm_llvm_di_function(g.di_builder, g.di_files[file], func.name, dm_llvm_get_value_name(llvm_fn), line_in_file(func.source_line), optimized)
        dm_llvm_set_subprogram(llvm_fn, g.di_scope)
        return g
    }
}

-- Give the instructions built from now on the line of the IR
-- instruction being lowered. The stores that put a function's
-- parameters in their variables come first and have no line: they stay
-- without one, which makes them part of the function's prologue, so a
-- breakpoint on the function stops after them. Any other instruction
-- with no line, before the first that has one, is at the function's
-- line (a call must be at some line).
fn di_at_instruction(gen: LLVMGenerator, inst: IRInst) -> LLVMGenerator {
    unsafe {
        let mut g = gen
        if g.di_scope == 0 or inst.op == OP_ALLOCA() { return g }
        let mut line = inst.source_line
        if line <= 0 or file_of_line(line) != g.di_file {
            if g.di_located or inst.op == OP_STORE() { return g }
            line = g.di_function_line
        }
        dm_llvm_set_debug_location(g.builder, g.context, line_in_file(line), inst.source_col, g.di_scope)
        g.di_located = true
        return g
    }
}

-- Whether values of a type are addresses: boxes, pointers and functions
fn di_is_pointer_type(t: string) -> bool {
    return starts_with(t, "Box[") or t == "ptr" or starts_with(t, "ptr(") or starts_with(t, "fn(")
}

-- A struct type of three words, which is what a string and a list are:
-- the address of the data, of type `data`, a length and a capacity
fn di_header_struct(gen: LLVMGenerator, name: string, data: int) -> int {
    unsafe {
        let dib = gen.di_builder
        let word = gen.di_types.get("i64")
        let begun = dm_llvm_di_struct_begin(dib, name, 192)
        let data_member = dm_llvm_di_member(dib, begun, "data", 64, 0, data)
        let len_member = dm_llvm_di_member(dib, begun, "len", 64, 64, word)
        let capacity_member = dm_llvm_di_member(dib, begun, "capacity", 64, 128, word)
        dm_llvm_buf_clear()
        dm_llvm_buf_push(data_member)
        dm_llvm_buf_push(len_member)
        dm_llvm_buf_push(capacity_member)
        return dm_llvm_di_struct_end_buf(dib, begun, name, 192)
    }
}

-- Make the debug info's type of the type named `t`. gen.di_types has
-- it afterwards: 0 for a type that has no values.
fn di_make_type(gen: LLVMGenerator, t: string) -> LLVMGenerator {
    unsafe {
        let mut g = gen
        if g.di_types.contains(t) { return g }
        let dib = g.di_builder
        -- The encodings are DWARF's: 2 boolean, 4 float, 5 signed,
        -- 7 unsigned, 8 unsigned char
        let mut made = 0
        if t == "i64" or t == "int" {
            made = dm_llvm_di_basic_type(dib, "int", 64, 5)
        } else if t == "i32" {
            made = dm_llvm_di_basic_type(dib, "i32", 32, 5)
        } else if t == "i16" {
            made = dm_llvm_di_basic_type(dib, "i16", 16, 5)
        } else if t == "i8" {
            made = dm_llvm_di_basic_type(dib, "i8", 8, 5)
        } else if t == "u64" {
            made = dm_llvm_di_basic_type(dib, "u64", 64, 7)
        } else if t == "u32" {
            made = dm_llvm_di_basic_type(dib, "u32", 32, 7)
        } else if t == "u16" {
            made = dm_llvm_di_basic_type(dib, "u16", 16, 7)
        } else if t == "u8" {
            made = dm_llvm_di_basic_type(dib, "u8", 8, 7)
        } else if t == "bool" {
            made = dm_llvm_di_basic_type(dib, "bool", 8, 2)
        } else if t == "f64" or t == "float" {
            made = dm_llvm_di_basic_type(dib, "float", 64, 4)
        } else if t == "f32" {
            made = dm_llvm_di_basic_type(dib, "f32", 32, 4)
        } else if t == "string" {
            -- A debugger prints the address of characters as text
            g = di_make_type(g, "i64")
            let char_type = dm_llvm_di_basic_type(dib, "char", 8, 8)
            made = di_header_struct(g, "string", dm_llvm_di_pointer_type(dib, char_type, ""))
        } else if starts_with(t, "List[") or t == "list" or starts_with(t, "dm_list_") {
            g = di_make_type(g, "i64")
            let mut elem = 0
            if starts_with(t, "List[") and ends_with(t, "]") {
                let elem_name = substr(t, 5, len(t) - 6)
                g = di_make_type(g, elem_name)
                elem = g.di_types.get(elem_name)
            }
            made = di_header_struct(g, t, dm_llvm_di_pointer_type(dib, elem, ""))
        } else if starts_with(t, "Box[") and ends_with(t, "]") {
            let inner_name = substr(t, 4, len(t) - 5)
            g = di_make_type(g, inner_name)
            made = dm_llvm_di_pointer_type(dib, g.di_types.get(inner_name), t)
        } else if di_is_pointer_type(t) {
            made = dm_llvm_di_pointer_type(dib, 0, t)
        } else {
            -- A struct, with its fields where the program declares it
            -- with as many as it is lowered to; any other type of a
            -- known size, without
            let llvm_ty = map_ir_type_to_llvm(g, t)
            let kind = dm_llvm_get_type_kind(llvm_ty)
            let field_count = dm_llvm_struct_field_count(llvm_ty)
            -- 2 float, 3 double, 8 integer, 10 struct, 11 array,
            -- 12 pointer, 13 vector
            let sized = kind == 2 or kind == 3 or kind == 8 or (kind == 10 and field_count > 0) or kind == 11 or kind == 12 or kind == 13
            if sized {
                let bits = dm_llvm_abi_size_of(g.llvm_module, llvm_ty) * 8
                let begun = dm_llvm_di_struct_begin(dib, t, bits)
                -- The struct's fields may be of its own type
                g.di_types.insert(t, begun)
                let mut members: List[int] = []
                if g.ir_module.struct_defs.contains(t) {
                    let def = g.ir_module.struct_defs.get(t)
                    if def.fields.len() == field_count {
                        let mut fi = 0
                        while fi < field_count {
                            let field = def.fields[fi]
                            g = di_make_type(g, field.type_id)
                            let field_type = g.di_types.get(field.type_id)
                            let field_kind = dm_llvm_get_type_kind(map_ir_type_to_llvm(g, field.type_id))
                            if field_type != 0 and field_kind != 0 and field_kind != 9 {
                                let field_bits = dm_llvm_abi_size_of(g.llvm_module, map_ir_type_to_llvm(g, field.type_id)) * 8
                                let offset_bits = dm_llvm_offset_of_element(g.llvm_module, llvm_ty, fi) * 8
                                members.push(dm_llvm_di_member(dib, begun, field.name, field_bits, offset_bits, field_type))
                            }
                            fi = fi + 1
                        }
                    }
                }
                dm_llvm_buf_clear()
                let mut mi = 0
                while mi < members.len() {
                    dm_llvm_buf_push(members[mi])
                    mi = mi + 1
                }
                made = dm_llvm_di_struct_end_buf(dib, begun, t, bits)
            }
        }
        g.di_types.insert(t, made)
        return g
    }
}

-- Describe a variable to the debugger (OP_DEBUG_VAR): its name, its
-- type and the storage it lives in
fn di_declare_variable(gen: LLVMGenerator, inst: IRInst) -> LLVMGenerator {
    unsafe {
        let mut g = gen
        let line = inst.source_line
        if g.di_scope == 0 or line <= 0 or file_of_line(line) != g.di_file { return g }
        if inst.operand.kind == VAL_INST_REF() {
            if g.value_map.contains(int_to_string(inst.operand.ref_id)) == false { return g }
        } else if inst.operand.kind != VAL_PARAM_REF() {
            return g
        }
        g = di_make_type(g, inst.alloc_type)
        let ty = g.di_types.get(inst.alloc_type)
        if ty == 0 { return g }
        let mut storage = resolve_value(g, inst.operand)
        let mut deref = 0
        if dm_llvm_is_alloca(storage) == 0 {
            -- The variable is a value with no storage of its own: keep
            -- it where a debugger can find it. A string, list or struct
            -- that is a pointer is the address of the variable.
            let value_ty = dm_llvm_type_of(storage)
            let value_kind = dm_llvm_get_type_kind(value_ty)
            if value_kind == 0 or value_kind == 7 or value_kind == 9 { return g }
            if value_kind == 12 and (inst.field_type == "ref" or di_is_pointer_type(inst.alloc_type) == false) {
                deref = 1
            }
            let kept = dm_llvm_build_alloca(g.builder, value_ty, "debug." + inst.callee)
            dm_llvm_build_store(g.builder, storage, kept)
            storage = kept
        }
        let variable = dm_llvm_di_variable(g.di_builder, g.di_scope, inst.callee, g.di_files[g.di_file], line_in_file(line), ty, inst.field_index)
        dm_llvm_di_declare(g.di_builder, g.builder, storage, variable, g.context, line_in_file(line), g.di_scope, deref)
        return g
    }
}

fn lg_declare_function(gen: LLVMGenerator, func: IRFunction) -> LLVMGenerator {
    unsafe {
        let mut g = gen
        let ctx = g.context
        -- Runtime functions that are inline or written in dAImond have no
        -- C function to declare
        if func.is_extern and (is_inline_runtime_fn(func.name) or g.rt_ports.contains(func.name)) {
            return g
        }
        -- A variadic C function is called directly: a wrapper could not pass
        -- on its varargs. Call sites pass strings as char*.
        if func.is_variadic {
            let mut vparam_tys: List[int] = []
            let mut vi = 0
            while vi < func.params.len() {
                let pt = func.params[vi].type_id
                vparam_tys.push(if pt == "string" { dm_llvm_pointer_type(ctx) } else { map_ir_type_to_llvm(g, pt) })
                vi = vi + 1
            }
            let vret_ty = map_ir_type_to_llvm(g, func.return_type)
            dm_llvm_buf_clear()
            vi = 0
            while vi < vparam_tys.len() {
                dm_llvm_buf_push(vparam_tys[vi])
                vi = vi + 1
            }
            let vfn_ty = dm_llvm_function_type_buf(vret_ty, 1)
            g = declare_c_symbol(g, c_symbol_of(func), vfn_ty)
            let vfn = g.c_symbols.get(c_symbol_of(func))
            g.function_map.insert(func.name, vfn)
            g.fn_type_map.insert(func.name, vfn_ty)
            return g
        }
        -- Check if wrapper is needed for extern functions with string params/return
        if func_needs_wrapper(func) {
            -- Check if this is a user extern function
            if g.ir_module.user_extern_fns.contains(func.name) {
                g = declare_user_extern_wrapper(g, func)
                return g
            }
            g = declare_wrapper(g, func)
            return g
        }
        -- Regular function declaration
        -- Check if function returns result/option (needs sret convention)
        let needs_sret = is_sret_return_type(func.return_type) and func.name != "main"
        let is_main = func.name == "main"
        -- IMPORTANT: Compute return type and collect param types BEFORE using the shared
        -- buffer, because map_ir_type_to_llvm may use dm_llvm_buf internally for struct types
        let mut ret_ty = 0
        if is_main {
            ret_ty = dm_llvm_int32_type(ctx)
        } else if needs_sret {
            ret_ty = dm_llvm_void_type(ctx)
        } else {
            ret_ty = map_ir_type_to_llvm(g, func.return_type)
        }
        -- Collect all param types into a list first (avoid buffer clobbering)
        let mut param_types: List[int] = []
        if needs_sret {
            param_types.push(dm_llvm_pointer_type(ctx))
        }
        let mut i = 0
        while i < func.params.len() {
            param_types.push(map_ir_type_to_llvm(g, func.params[i].type_id))
            i = i + 1
        }
        if is_main {
            param_types.push(dm_llvm_int32_type(ctx))
            param_types.push(dm_llvm_pointer_type(ctx))
        }
        -- Now push all to shared buffer at once and create function type
        dm_llvm_buf_clear()
        i = 0
        while i < param_types.len() {
            dm_llvm_buf_push(param_types[i])
            i = i + 1
        }
        let fn_ty = dm_llvm_function_type_buf(ret_ty, 0)
        if func.is_extern {
            -- A C function: shared with any other declaration of its symbol
            g = declare_c_symbol(g, c_symbol_of(func), fn_ty)
            g.function_map.insert(func.name, g.c_symbols.get(c_symbol_of(func)))
            g.fn_type_map.insert(func.name, fn_ty)
            if needs_sret {
                g.returns_sret.insert(func.name, true)
            }
            return g
        }
        let llvm_fn = dm_llvm_module_add_function(g.llvm_module, dm_symbol_of(g, func), fn_ty)
        g.function_map.insert(func.name, llvm_fn)
        g.fn_type_map.insert(func.name, fn_ty)
        -- Track sret functions
        if needs_sret {
            g.returns_sret.insert(func.name, true)
        }
        -- Name parameters (offset by 1 for sret functions since param 0 is the sret ptr)
        i = 0
        if needs_sret {
            let sret_param = dm_llvm_get_param(llvm_fn, 0)
            dm_llvm_set_value_name(sret_param, "sret.out")
            while i < func.params.len() {
                let param_val = dm_llvm_get_param(llvm_fn, i + 1)
                dm_llvm_set_value_name(param_val, func.params[i].name)
                i = i + 1
            }
        } else {
            while i < func.params.len() {
                let param_val = dm_llvm_get_param(llvm_fn, i)
                dm_llvm_set_value_name(param_val, func.params[i].name)
                i = i + 1
            }
        }
        if starts_with(func.name, "rt_") {
            g = bind_runtime_port(g, func)
        }
        return g
    }
}

-- ============================================================
-- FUNCTION BODY GENERATION
-- ============================================================

fn lg_generate_function(gen: LLVMGenerator, func: IRFunction) -> LLVMGenerator {
    unsafe {
        let mut g = gen
        let ctx = g.context
        if g.function_map.contains(func.name) == false { return g }
        let llvm_fn = g.function_map.get(func.name)
        g.current_func_name = func.name
        g = di_enter_function(g, func, llvm_fn)
        -- Create basic blocks
        -- Clear block_map for this function
        g.block_map = Map_new()
        let mut bi = 0
        while bi < func.blocks.len() {
            let block = func.blocks[bi]
            let bb = dm_llvm_append_basic_block(ctx, llvm_fn, block.label)
            g.block_map.insert(block.label, bb)
            bi = bi + 1
        }
        -- Clear value_map and string_ptrs for this function
        g.value_map = Map_new()
        g.string_ptrs = Map_new()
        g.panic_blocks = Map_new()
        -- ALLOCA HOISTING: Generate all allocas in the entry block first.
        -- This ensures all allocas are available regardless of block processing order.
        -- Standard LLVM practice: all allocas belong in the entry block.
        if func.blocks.len() > 0 {
            let entry_label = func.blocks[0].label
            if g.block_map.contains(entry_label) {
                let entry_bb = g.block_map.get(entry_label)
                dm_llvm_position_at_end(g.builder, entry_bb)
                -- Pre-generate argc/argv for main
                if func.name == "main" {
                    -- This module defines the two symbols: giving them
                    -- an initial value makes them definitions
                    g = declare_main_args(g)
                    let argc_global = g.data_symbols.get("dm_argc")
                    let argv_global = g.data_symbols.get("dm_argv")
                    dm_llvm_set_initializer(argc_global, dm_llvm_const_null(dm_llvm_int32_type(ctx)))
                    dm_llvm_set_initializer(argv_global, dm_llvm_const_null(dm_llvm_pointer_type(ctx)))
                    let argc_param = dm_llvm_get_param(llvm_fn, func.params.len())
                    let argv_param = dm_llvm_get_param(llvm_fn, func.params.len() + 1)
                    dm_llvm_build_store(g.builder, argc_param, argc_global)
                    dm_llvm_build_store(g.builder, argv_param, argv_global)
                }
                -- Scan ALL blocks for OP_ALLOCA and generate them in entry block
                bi = 0
                while bi < func.blocks.len() {
                    let scan_block = func.blocks[bi]
                    let mut si = 0
                    while si < scan_block.instructions.len() {
                        let scan_inst = scan_block.instructions[si]
                        if scan_inst.op == OP_ALLOCA() {
                            g = generate_instruction(g, scan_inst)
                        }
                        si = si + 1
                    }
                    bi = bi + 1
                }
            }
        }
        -- Build BFS-ordered block list for correct processing order.
        -- Blocks must be processed in dominator order so that value_map is populated
        -- before any instruction references a value from an earlier block.
        let mut bfs_order: List[string] = []
        let mut bfs_visited: Map[string, bool] = Map_new()
        if func.blocks.len() > 0 {
            -- Start BFS from entry block
            let mut bfs_queue: List[string] = []
            bfs_queue.push(func.blocks[0].label)
            bfs_visited.insert(func.blocks[0].label, true)
            while bfs_queue.len() > 0 {
                let cur_label = bfs_queue[0]
                -- Shift: manual removal of first element by rebuilding
                let mut new_queue: List[string] = []
                let mut qi = 1
                while qi < bfs_queue.len() {
                    new_queue.push(bfs_queue[qi])
                    qi = qi + 1
                }
                bfs_queue = new_queue
                bfs_order.push(cur_label)
                -- Find this block and get its terminator targets
                let mut fi = 0
                while fi < func.blocks.len() {
                    if func.blocks[fi].label == cur_label {
                        let cur_block = func.blocks[fi]
                        if cur_block.has_terminator {
                            let t = *cur_block.terminator
                            if t.kind == TERM_BR() {
                                if bfs_visited.contains(t.target) == false {
                                    bfs_visited.insert(t.target, true)
                                    bfs_queue.push(t.target)
                                }
                            }
                            if t.kind == TERM_BR_COND() {
                                if bfs_visited.contains(t.true_label) == false {
                                    bfs_visited.insert(t.true_label, true)
                                    bfs_queue.push(t.true_label)
                                }
                                if bfs_visited.contains(t.false_label) == false {
                                    bfs_visited.insert(t.false_label, true)
                                    bfs_queue.push(t.false_label)
                                }
                            }
                        }
                    }
                    fi = fi + 1
                }
            }
            -- Add any blocks not reachable from entry (safety: shouldn't happen)
            bi = 0
            while bi < func.blocks.len() {
                if bfs_visited.contains(func.blocks[bi].label) == false {
                    bfs_order.push(func.blocks[bi].label)
                }
                bi = bi + 1
            }
        }
        -- Generate instructions and terminators for each block in BFS order (skip allocas)
        let mut bfs_i = 0
        while bfs_i < bfs_order.len() {
            let bfs_label = bfs_order[bfs_i]
            -- Find the block with this label
            let mut found_bi = 0
            while found_bi < func.blocks.len() {
                if func.blocks[found_bi].label == bfs_label {
                    let block = func.blocks[found_bi]
                    if g.block_map.contains(block.label) {
                        let bb = g.block_map.get(block.label)
                        dm_llvm_position_at_end(g.builder, bb)
                        -- Generate non-alloca instructions
                        let mut ii = 0
                        while ii < block.instructions.len() {
                            if block.instructions[ii].op != OP_ALLOCA() {
                                g = generate_instruction(g, block.instructions[ii])
                            }
                            ii = ii + 1
                        }
                        -- Generate terminator
                        if block.has_terminator {
                            let term = *block.terminator
                            g = generate_terminator(g, term, func)
                        }
                    }
                }
                found_bi = found_bi + 1
            }
            bfs_i = bfs_i + 1
        }
        return g
    }
}

-- ============================================================
-- VALUE RESOLUTION
-- ============================================================

fn resolve_value(gen: LLVMGenerator, val: IRValue) -> int {
    unsafe {
        let ctx = gen.context
        if val.kind == VAL_CONST_INT() {
            return dm_llvm_const_int(dm_llvm_int64_type(ctx), val.int_val, 1)
        }
        if val.kind == VAL_CONST_FLOAT() {
            return dm_llvm_const_real(dm_llvm_double_type(ctx), val.float_val)
        }
        if val.kind == VAL_CONST_BOOL() {
            let mut bval = 0
            if val.bool_val { bval = 1 }
            return dm_llvm_const_int(dm_llvm_int1_type(ctx), bval, 0)
        }
        if val.kind == VAL_CONST_STRING() {
            -- Build a global string pointer for the raw C string data
            let name = ".str." + int_to_string(gen.string_counter)
            return dm_llvm_build_global_string_ptr(gen.builder, val.str_val, name)
        }
        if val.kind == VAL_INST_REF() {
            let key = int_to_string(val.ref_id)
            if gen.value_map.contains(key) {
                return gen.value_map.get(key)
            }
            -- Fallback: return null
            return dm_llvm_const_null(dm_llvm_int64_type(ctx))
        }
        if val.kind == VAL_PARAM_REF() {
            if gen.function_map.contains(gen.current_func_name) {
                let llvm_fn = gen.function_map.get(gen.current_func_name)
                -- For sret functions, LLVM param 0 is the sret pointer, so user params start at index 1
                let mut param_offset = 0
                if gen.returns_sret.contains(gen.current_func_name) {
                    param_offset = 1
                }
                return dm_llvm_get_param(llvm_fn, val.ref_id + param_offset)
            }
            return dm_llvm_const_null(dm_llvm_int64_type(ctx))
        }
        if val.kind == VAL_GLOBAL_REF() {
            -- Check functions first, then global variables
            if gen.function_map.contains(val.str_val) {
                return gen.function_map.get(val.str_val)
            }
            if gen.global_var_map.contains(val.str_val) {
                let gvar = gen.global_var_map.get(val.str_val)
                -- Load the value from the global variable
                return dm_llvm_build_load2(gen.builder, dm_llvm_int64_type(ctx), gvar, "gload")
            }
            return dm_llvm_const_null(dm_llvm_int64_type(ctx))
        }
        if val.kind == VAL_UNDEF() {
            return dm_llvm_const_null(dm_llvm_int64_type(ctx))
        }
        if val.kind == VAL_SIZEOF() {
            if val.str_val == "" {
                let sized = resolve_value(gen, ir_val_inst(val.ref_id))
                return dm_llvm_sizeof_type(dm_llvm_type_of(sized))
            }
            return dm_llvm_sizeof_type(map_ir_type_to_llvm(gen, val.str_val))
        }
        return dm_llvm_const_null(dm_llvm_int64_type(ctx))
    }
}

-- Resolve value for const_string, incrementing string counter
fn resolve_value_with_counter(gen: LLVMGenerator, val: IRValue) -> LLVMGenerator {
    let mut g = gen
    if val.kind == VAL_CONST_STRING() {
        g.string_counter = g.string_counter + 1
    }
    return g
}

-- A string or list value is a pointer to its storage, and so is a
-- list literal that no variable holds. Where the value itself is
-- wanted (a by-value parameter or a return value of that struct
-- type), load it.
fn load_handle_as(gen: LLVMGenerator, val: IRValue, v: int, want_ty: int) -> int {
    unsafe {
        if dm_llvm_get_type_kind(want_ty) != 10 { return v }
        if dm_llvm_get_type_kind(dm_llvm_type_of(v)) != 12 { return v }
        return dm_llvm_build_load2(gen.builder, want_ty, v, "handle.val")
    }
}

-- Check if an IR value is a string pointer (alloca to dm_string)
fn is_string_ptr(gen: LLVMGenerator, val: IRValue) -> bool {
    if val.kind == VAL_INST_REF() {
        let key = int_to_string(val.ref_id)
        if gen.string_ptrs.contains(key) {
            return gen.string_ptrs.get(key)
        }
    }
    return false
}

-- Expected IR type of field `idx` of aggregate type `type_name`, or "".
fn expected_field_ir_type(gen: LLVMGenerator, type_name: string, idx: int) -> string {
    if gen.ir_module.struct_defs.contains(type_name) {
        let ir_struct = gen.ir_module.struct_defs.get(type_name)
        if idx < ir_struct.fields.len() {
            return ir_struct.fields[idx].type_id
        }
        return ""
    }
    if idx == 0 and (type_name == "result" or type_name == "option" or starts_with(type_name, "Result[") or starts_with(type_name, "Option[") or starts_with(type_name, "result_") or starts_with(type_name, "option_")) {
        return "i32"
    }
    if starts_with(type_name, "Result[") {
        let inner = substr(type_name, 7, len(type_name) - 8)
        let mut comma_pos = 0 - 1
        let mut depth = 0
        let mut ci = 0
        while ci < len(inner) {
            let ch = char_at(inner, ci)
            if ch == "[" { depth = depth + 1 }
            if ch == "]" { depth = depth - 1 }
            if ch == "," and depth == 0 {
                comma_pos = ci
                ci = len(inner)
            }
            ci = ci + 1
        }
        if comma_pos >= 0 {
            if idx == 1 {
                return substr(inner, 0, comma_pos)
            }
            if idx == 2 {
                let mut err_start = comma_pos + 1
                if err_start < len(inner) and char_at(inner, err_start) == " " {
                    err_start = err_start + 1
                }
                return substr(inner, err_start, len(inner) - err_start)
            }
        }
        return "i64"
    }
    if starts_with(type_name, "Option[") {
        if idx == 1 {
            return substr(type_name, 7, len(type_name) - 8)
        }
        return "i64"
    }
    if type_name == "result" or type_name == "option" {
        return "i64"
    }
    return ""
}

-- ============================================================
-- INSTRUCTION GENERATION
-- ============================================================

fn generate_instruction(gen: LLVMGenerator, inst: IRInst) -> LLVMGenerator {
    unsafe {
        let mut g = gen
        g.current_line = inst.source_line
        let b = g.builder
        let op = inst.op
        if op == OP_DEBUG_VAR() {
            return di_declare_variable(g, inst)
        }
        g = di_at_instruction(g, inst)
        let id_key = int_to_string(inst.id)
        -- Arithmetic
        if op == OP_ADD() {
            let lhs = resolve_value(g, inst.lhs)
            let rhs = resolve_value(g, inst.rhs)
            g = resolve_value_with_counter(g, inst.lhs)
            g = resolve_value_with_counter(g, inst.rhs)
            let mut result = 0
