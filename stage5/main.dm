    return g
}

-- Helper: declare extern with 4 params
fn declare_extern4(gen: IRGenerator, name: string, p1: string, p2: string, p3: string, p4: string, ret: string) -> IRGenerator {
    let mut g = gen
    let mut func = ir_function_new(name, ret)
